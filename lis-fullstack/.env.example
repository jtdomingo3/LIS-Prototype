# LIS Prototype - environment variables template
# Copy this file to .env and configure your environment settings
HOST=
NODE_ENV=development
PORT=3000

# Optional: set the thermal printer name to use for test prints
PRINTER_NAME="Xprinter XP-230H"

DOCTOR_1_NAME="Dr. Lorenzo"
DOCTOR_2_NAME="Dr. Arcilla"

ALLOW_PUBLIC_DATA_EXPORT=1
DISABLE_REPORT_GENERATION=1

# OpenRouter AI Assistant (GezyneBot) - Encrypted API Key or Raw Key
# Generate encrypted token using: node -e "console.log(require('./lib/cryptoHelper').encryptSecret('YOUR_API_KEY'))"
OPENROUTER_ENCRYPTED_KEY=""
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
