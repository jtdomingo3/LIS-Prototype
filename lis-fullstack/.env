# LIS Prototype - environment variables
# Do not commit secret values to version control in production
HOST=
NODE_ENV=development
PORT=3000

# Optional: set the thermal printer name to use for test prints
# Example: PRINTER_NAME="Xprinter XP-230H"
PRINTER_NAME="Xprinter XP-230H"

DOCTOR_1_NAME="Dr. Lorenzo"
DOCTOR_2_NAME="Dr. Arcilla"

ALLOW_PUBLIC_DATA_EXPORT=1

DISABLE_REPORT_GENERATION=1