    <!-- Monthly Breakdown Table (Screen-Only reference for HR) -->
    <div class="no-print" style="margin-top: 20px; border: 1px solid #cbd5e1; border-radius: 8px; overflow: hidden; background: white;">
        <div style="background: #f8fafc; padding: 10px 16px; font-weight: 700; font-size: 0.85rem; color: #334155; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <span>📊 Supporting Monthly Payroll Breakdown (<%= yearPayrolls.length %> Cycles in <%= year %>)</span>
            <small style="color: #64748b; font-weight: normal;">(Reference Only — Not Printed on Official BIR 2316)</small>
        </div>
        <% if (yearPayrolls.length === 0) { %>
            <div style="padding: 20px; text-align: center; color: #94a3b8; font-size: 0.85rem;">
                No payroll records found for year <%= year %>.
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem; text-align: left;">
                    <thead style="background: #f1f5f9; border-bottom: 1px solid #cbd5e1;">
                        <tr>
                            <th style="padding: 8px 12px;">Month</th>
                            <th style="padding: 8px 12px; text-align: right;">Gross Pay</th>
                            <th style="padding: 8px 12px; text-align: right;">SSS EE</th>
                            <th style="padding: 8px 12px; text-align: right;">PHIC EE</th>
                            <th style="padding: 8px 12px; text-align: right;">HDMF EE</th>
                            <th style="padding: 8px 12px; text-align: right;">Tax Withheld</th>
                            <th style="padding: 8px 12px; text-align: right;">Net Pay</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% yearPayrolls.forEach(function(p) { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 8px 12px; font-weight: 600;"><%= p.month %></td>
                                <td style="padding: 8px 12px; text-align: right;">₱<%= (Number(p.grossPay) || 0).toFixed(2) %></td>
                                <td style="padding: 8px 12px; text-align: right; color: #64748b;">₱<%= (Number(p.sssContribution) || 0).toFixed(2) %></td>
                                <td style="padding: 8px 12px; text-align: right; color: #64748b;">₱<%= (Number(p.philhealthContribution) || 0).toFixed(2) %></td>
                                <td style="padding: 8px 12px; text-align: right; color: #64748b;">₱<%= (Number(p.pagibigContribution) || 0).toFixed(2) %></td>
                                <td style="padding: 8px 12px; text-align: right; font-weight: 700; color: #4338ca;">₱<%= (Number(p.withholdingTax) || 0).toFixed(2) %></td>
                                <td style="padding: 8px 12px; text-align: right; font-weight: 700; color: #059669;">₱<%= (Number(p.netPay) || 0).toFixed(2) %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<script>
function handleDocBack() {
    if (window.opener && window.history.length <= 1) {
        window.close();
        return;
    }
    if (window.history.length > 1 && document.referrer) {
        window.history.back();
        return;
    }
    window.location.href = '/hr/my';
}

function changeYear(y) {
    const parts = window.location.pathname.split('/');
    parts[4] = y;
    window.location.href = parts.join('/');
}
</script>
</body>
</html>
