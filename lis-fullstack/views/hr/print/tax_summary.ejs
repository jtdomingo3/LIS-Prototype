<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    /* ─────────────── RESET ─────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    @page {
      size: letter portrait;
      margin: 0mm;
    }

    body {
      margin: 0; padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: #000;
      background: #e2e8f0;
      -webkit-font-smoothing: antialiased;
    }

    /* ─────── SCREEN CONTROLS ─────── */
    .screen-controls {
      display: flex; justify-content: space-between; align-items: center;
      max-width: 820px; margin: 12px auto 10px auto;
      padding: 8px 14px; background: #fff;
      border: 1px solid #cbd5e1; border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      font-family: 'Segoe UI', sans-serif;
    }

    /* ─────── BIR FORM CONTAINER ─────── */
    .bir-sheet {
      background: #fff;
      width: 100%; max-width: 820px;
      margin: 0 auto 16px auto;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 7.2px; line-height: 1.18;
      color: #000;
      border: 1.5pt solid #000;
    }
    .bir-sheet table { border-collapse: collapse; width: 100%; }

    /* ─── OFFICIAL BIR COLORS ─── */
    .part-hdr {
      background: #1a3764;
      color: #ffffff;
      font-weight: 900;
      font-size: 7.5px;
      text-transform: uppercase;
      padding: 2px 4px;
      border-top: 1pt solid #000;
      border-bottom: 1pt solid #000;
      letter-spacing: 0.3px;
    }

    .sub-hdr td {
      background: #c0c0c0;
      color: #000;
      font-weight: bold;
      font-size: 7px;
      padding: 1.5px 3px;
      border-top: 0.5pt solid #000;
      border-bottom: 0.5pt solid #000;
    }

    /* Field rows */
    .f-row {
      display: flex; align-items: center;
      padding: 1.5px 4px;
      border-bottom: 0.5pt solid #000;
      font-size: 7px;
      min-height: 14px;
    }

    /* Item description & amount cells */
    .i-desc {
      padding: 1.5px 4px;
      font-size: 6.8px;
      line-height: 1.18;
      border-bottom: 0.5pt solid #000;
      vertical-align: middle;
    }
    .i-amt {
      padding: 1.5px 4px;
      font-size: 7.5px;
      text-align: right;
      font-family: 'Courier New', Courier, monospace;
      font-weight: 600;
      border-left: 0.5pt solid #000;
      border-bottom: 0.5pt solid #000;
      width: 28%;
      background: #fff;
      white-space: nowrap;
      vertical-align: middle;
    }
    .i-amt-empty {
      padding: 1.5px 4px;
      font-size: 7.5px;
      border-left: 0.5pt solid #000;
      border-bottom: 0.5pt solid #000;
      width: 28%;
      background: #e8e8e8;
      vertical-align: middle;
    }

    /* Digit boxes */
    .dg {
      display: inline-block;
      width: 11px; height: 13px;
      border: 0.75pt solid #000;
      text-align: center;
      line-height: 12px;
      font-size: 8px;
      font-weight: bold;
      background: #fff;
      font-family: Arial, Helvetica, sans-serif;
      vertical-align: middle;
    }
    .dg-group {
      display: inline-flex;
      align-items: center;
      gap: 0.5px;
    }
    .dg-sep {
      font-size: 10px; font-weight: bold;
      margin: 0 1px;
      vertical-align: middle;
    }

    /* Checkbox box */
    .chk {
      display: inline-block;
      width: 11px; height: 11px;
      border: 0.75pt solid #000;
      text-align: center;
      line-height: 10px;
      font-size: 9px;
      font-weight: 900;
      vertical-align: middle;
      background: #fff;
    }

    /* ─── PRINT ─── */
    @media print {
      *, *::before, *::after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }
      html, body {
        margin: 0 !important; padding: 0 !important;
        background: #fff !important;
        width: 100% !important; height: 100% !important;
        overflow: hidden !important;
      }
      .no-print, .screen-controls, #gezynebot-container, .gezynebot-container {
        display: none !important;
      }
      .content-wrapper {
        border: none !important; box-shadow: none !important;
        padding: 3mm 4mm !important; margin: 0 !important;
        max-width: 100% !important;
        width: 100% !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .bir-sheet {
        width: 100% !important; max-width: 100% !important;
        margin: 0 !important; padding: 0 !important;
        border: 2pt solid #000 !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        font-size: 7.8px !important;
      }
      .bir-sheet .part-hdr {
        font-size: 8px !important;
        padding: 2.5px 5px !important;
      }
      .bir-sheet .sub-hdr td {
        font-size: 7.5px !important;
        padding: 2px 4px !important;
      }
      .bir-sheet .i-desc {
        font-size: 7.2px !important;
        padding: 2px 4px !important;
      }
      .bir-sheet .i-amt,
      .bir-sheet .i-amt-empty {
        font-size: 8px !important;
        padding: 2px 4px !important;
      }
      .bir-sheet .f-row {
        font-size: 7.5px !important;
        padding: 2px 4px !important;
        min-height: 16px !important;
      }
      .bir-sheet .dg {
        width: 12px !important; height: 14px !important;
        font-size: 9px !important;
        line-height: 13px !important;
      }
      .bir-sheet .chk {
        width: 12px !important; height: 12px !important;
        font-size: 10px !important;
        line-height: 11px !important;
      }
    }

    @media screen {
      .content-wrapper {
        padding: 10px 14px;
        max-width: 840px;
        margin: 5px auto;
      }
    }
  </style>
</head>
<body>
<div class="content-wrapper">
    <!-- Screen Controls Bar -->
    <div class="no-print screen-controls">
        <button type="button" onclick="handleDocBack()" style="padding: 6px 14px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
            ← Back to Portal
        </button>
        <div style="display: flex; gap: 10px; align-items: center;">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 600; color: #334155;">
                <span>Tax Year:</span>
                <select id="yearSelect" onchange="changeYear(this.value)" style="padding: 4px 10px; border: 1.5px solid #0f172a; border-radius: 6px; font-weight: 700; font-size: 0.85rem; background: #fff; cursor: pointer;">
                    <% for (let y = new Date().getFullYear(); y >= 2023; y--) { %>
                        <option value="<%= y %>" <%= year == y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </div>
            <span style="font-size: 0.76rem; color: #166534; background: #dcfce7; padding: 5px 10px; border-radius: 6px; font-weight: 600;">
                ✓ Official BIR 2316 • Fits 1 Page
            </span>
            <button onclick="window.print()" style="padding: 7px 18px; background: #009957; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; box-shadow: 0 2px 5px rgba(0,153,87,0.3);">
                <span>🖨️</span> Print Official BIR 2316
            </button>
        </div>
    </div>

    <%
        // ── Formatting helpers ──
        function fmt(val) {
            const n = Number(val) || 0;
            return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function getTinBoxes(tinStr, count) {
            const raw = (tinStr || '').replace(/\D/g, '');
            const arr = [];
            for (let i = 0; i < count; i++) arr.push(raw[i] || '');
            return arr;
        }

        function getDobDigits(dob) {
            if (!dob) return ['','','','','','','',''];
            const d = new Date(dob);
            if (isNaN(d.getTime())) {
                const raw = String(dob).replace(/\D/g, '');
                const res = [];
                for (let i = 0; i < 8; i++) res.push(raw[i] || '');
                return res;
            }
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            const yyyy = String(d.getFullYear());
            return (mm + dd + yyyy).split('');
        }

        function getZipDigits(zip) {
            const raw = String(zip || '').replace(/\D/g, '');
            const arr = [];
            for (let i = 0; i < 4; i++) arr.push(raw[i] || '');
            return arr;
        }

        function getRdoDigits(rdo) {
            const raw = String(rdo || '').replace(/\D/g, '');
            const arr = [];
            for (let i = 0; i < 3; i++) arr.push(raw[i] || '');
            return arr;
        }

        const currentEmpTin = employee.tinNumber || employee.tin || '';
        const empTin = getTinBoxes(currentEmpTin, 12);
        const currentLabTin = (typeof labTin !== 'undefined' && labTin) ? labTin : '009-876-543-000';
        const employerTin = getTinBoxes(currentLabTin, 12);
        const currentLabName = (typeof labName !== 'undefined' && labName) ? labName : 'GEZYNE CLINICAL LABORATORY';
        const currentLabAddress = (typeof labAddress !== 'undefined' && labAddress) ? labAddress : '0330 Vergel De Dios St., Poblacion, Plaridel, Bulacan';
        const currentLabZip = (typeof labZipCode !== 'undefined' && labZipCode) ? labZipCode : '3004';
        const labZipDig = getZipDigits(currentLabZip);
        const currentRdo = (typeof labRdoCode !== 'undefined' && labRdoCode) ? labRdoCode : '025';
        const rdoDig = getRdoDigits(currentRdo);
        const yearDigits = String(year || '2026').split('');
        const dobDigits = getDobDigits(employee.birthDate || employee.dateOfBirth);
        const empZip = getZipDigits(employee.zipCode || '3004');
    %>

    <!-- ═══════════ OFFICIAL BIR FORM NO. 2316 (SEPTEMBER 2021 ENCS) ═══════════ -->
    <div class="bir-sheet">

        <!-- ████ TOP HEADER AREA ████ -->
        <table style="width:100%; border-bottom:1.5pt solid #000;">
            <tr>
                <!-- LEFT: For BIR Use / Form No -->
                <td style="width:24%; vertical-align:top; border-right:1pt solid #000; padding:2px 3px;">
                    <table style="width:100%; border-collapse:collapse;">
                        <tr>
                            <td style="font-size:6px; border-bottom:0.5pt solid #000; padding-bottom:1px;">
                                <div style="display:flex; justify-content:space-between;">
                                    <span>For BIR<br>Use Only</span>
                                    <span style="text-align:right;">BCS/<br>Item:</span>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align:center; padding-top:2px;">
                                <div style="font-size:7px; font-weight:bold; text-transform:uppercase;">BIR Form No.</div>
                                <div style="font-size:22px; font-weight:900; line-height:1; letter-spacing:1px; font-family:Arial Black, Arial, sans-serif;">2316</div>
                                <div style="font-size:6px; font-weight:bold;">September 2021(ENCS)</div>
                            </td>
                        </tr>
                    </table>
                </td>

                <!-- CENTER: Republic Seal & Title -->
                <td style="width:53%; vertical-align:middle; text-align:center; padding:2px 4px;">
                    <!-- Official Seal -->
                    <div style="margin-bottom:1px;">
                        <svg width="24" height="24" viewBox="0 0 100 100">
                            <circle cx="50" cy="50" r="48" fill="#fff" stroke="#000" stroke-width="3"/>
                            <circle cx="50" cy="50" r="40" fill="none" stroke="#000" stroke-width="1.5"/>
                            <polygon points="50,15 54,30 68,30 57,39 61,54 50,45 39,54 43,39 32,30 46,30" fill="#000"/>
                            <text x="50" y="70" font-size="7" font-weight="bold" text-anchor="middle" font-family="Arial">BIR</text>
                            <text x="50" y="80" font-size="5" text-anchor="middle" font-family="Arial">PHILIPPINES</text>
                        </svg>
                    </div>
                    <div style="font-size:7.5px; font-weight:bold; text-transform:uppercase; line-height:1.15;">Republic of the Philippines</div>
                    <div style="font-size:6.5px; font-weight:bold; font-style:italic; line-height:1.15;">Department of Finance</div>
                    <div style="font-size:7.5px; font-weight:900; line-height:1.15;">Bureau of Internal Revenue</div>
                    <div style="font-size:11px; font-weight:900; line-height:1.15; margin-top:2px;">
                        Certificate of Compensation<br>Payment/Tax Withheld
                    </div>
                    <div style="font-size:6px; font-style:italic; margin-top:1px;">
                        For Compensation Payment With or Without Tax Withheld
                    </div>
                </td>

                <!-- RIGHT: Barcode -->
                <td style="width:23%; vertical-align:middle; text-align:center; border-left:1pt solid #000; padding:2px 3px;">
                    <svg width="110" height="26" viewBox="0 0 130 36">
                        <rect width="130" height="36" fill="#fff"/>
                        <rect x="2" y="2" width="2" height="32" fill="#000"/>
                        <rect x="6" y="2" width="4" height="32" fill="#000"/>
                        <rect x="12" y="2" width="1" height="32" fill="#000"/>
                        <rect x="15" y="2" width="3" height="32" fill="#000"/>
                        <rect x="20" y="2" width="2" height="32" fill="#000"/>
                        <rect x="24" y="2" width="5" height="32" fill="#000"/>
                        <rect x="31" y="2" width="1" height="32" fill="#000"/>
                        <rect x="34" y="2" width="4" height="32" fill="#000"/>
                        <rect x="40" y="2" width="2" height="32" fill="#000"/>
                        <rect x="44" y="2" width="3" height="32" fill="#000"/>
                        <rect x="49" y="2" width="1" height="32" fill="#000"/>
                        <rect x="52" y="2" width="5" height="32" fill="#000"/>
                        <rect x="59" y="2" width="2" height="32" fill="#000"/>
                        <rect x="63" y="2" width="4" height="32" fill="#000"/>
                        <rect x="69" y="2" width="1" height="32" fill="#000"/>
                        <rect x="72" y="2" width="3" height="32" fill="#000"/>
                        <rect x="77" y="2" width="2" height="32" fill="#000"/>
                        <rect x="81" y="2" width="6" height="32" fill="#000"/>
                        <rect x="89" y="2" width="1" height="32" fill="#000"/>
                        <rect x="92" y="2" width="4" height="32" fill="#000"/>
                        <rect x="98" y="2" width="2" height="32" fill="#000"/>
                        <rect x="102" y="2" width="3" height="32" fill="#000"/>
                        <rect x="107" y="2" width="1" height="32" fill="#000"/>
                        <rect x="110" y="2" width="4" height="32" fill="#000"/>
                        <rect x="116" y="2" width="2" height="32" fill="#000"/>
                        <rect x="120" y="2" width="4" height="32" fill="#000"/>
                        <rect x="126" y="2" width="2" height="32" fill="#000"/>
                    </svg>
                    <div style="font-size:7px; font-weight:bold; letter-spacing:0.5px; margin-top:1px;">2316 9/21ENCS</div>
                </td>
            </tr>
        </table>

        <!-- Fill instruction line -->
        <div style="border-bottom:0.5pt solid #000; padding:1px 4px; font-size:6.2px; font-style:italic; background:#e8e8e8;">
            Fill in all applicable spaces. Mark all appropriate boxes with an "X".
        </div>

        <!-- ████ YEAR & PERIOD ROW ████ -->
        <table style="width:100%; border-bottom:1pt solid #000;">
            <tr>
                <td style="width:50%; border-right:1pt solid #000; padding:1.5px 4px; background:#e8e8e8;">
                    <div style="display:flex; align-items:center; justify-content:space-between; font-size:6.8px;">
                        <span><strong>1</strong>&nbsp; For the Year (YYYY)</span>
                        <div class="dg-group">
                            <span class="dg"><%= yearDigits[0] || '2' %></span>
                            <span class="dg"><%= yearDigits[1] || '0' %></span>
                            <span class="dg"><%= yearDigits[2] || '2' %></span>
                            <span class="dg"><%= yearDigits[3] || '6' %></span>
                        </div>
                    </div>
                </td>
                <td style="width:50%; padding:1.5px 4px; background:#e8e8e8;">
                    <div style="display:flex; align-items:center; justify-content:space-between; font-size:6.8px;">
                        <span><strong>2</strong>&nbsp; For the Period</span>
                        <div style="display:flex; align-items:center; gap:3px;">
                            <span>From (MM/DD)</span>
                            <div class="dg-group">
                                <span class="dg">0</span><span class="dg">1</span>
                                <span class="dg-sep">/</span>
                                <span class="dg">0</span><span class="dg">1</span>
                            </div>
                            <span style="margin:0 2px;">To (MM/DD)</span>
                            <div class="dg-group">
                                <span class="dg">1</span><span class="dg">2</span>
                                <span class="dg-sep">/</span>
                                <span class="dg">3</span><span class="dg">1</span>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- ████████ MAIN 2-COLUMN BODY ████████ -->
        <table style="width:100%; border-bottom:1pt solid #000;">
            <tr>
                <!-- ════════ LEFT COLUMN ════════ -->
                <td style="width:50%; vertical-align:top; border-right:1pt solid #000; padding:0;">

                    <!-- ── PART I: EMPLOYEE INFORMATION ── -->
                    <div class="part-hdr">Part I - Employee Information</div>

                    <!-- 3 TIN -->
                    <div class="f-row" style="justify-content:space-between;">
                        <span style="font-size:6.8px;"><strong>3</strong>&nbsp; TIN</span>
                        <div style="display:flex; align-items:center; gap:1px;">
                            <div class="dg-group"><span class="dg"><%= empTin[0] %></span><span class="dg"><%= empTin[1] %></span><span class="dg"><%= empTin[2] %></span></div>
                            <span class="dg-sep">-</span>
                            <div class="dg-group"><span class="dg"><%= empTin[3] %></span><span class="dg"><%= empTin[4] %></span><span class="dg"><%= empTin[5] %></span></div>
                            <span class="dg-sep">-</span>
                            <div class="dg-group"><span class="dg"><%= empTin[6] %></span><span class="dg"><%= empTin[7] %></span><span class="dg"><%= empTin[8] %></span></div>
                            <span class="dg-sep">-</span>
                            <div class="dg-group"><span class="dg"><%= empTin[9] %></span><span class="dg"><%= empTin[10] %></span><span class="dg"><%= empTin[11] %></span></div>
                        </div>
                    </div>

                    <!-- 4 Employee Name / 5 RDO Code -->
                    <table style="width:100%; border-bottom:0.5pt solid #000;">
                        <tr>
                            <td style="width:76%; border-right:0.5pt solid #000; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px; color:#333;"><strong>4</strong>&nbsp; Employee's Name <span style="font-size:5.5px; font-style:italic;">(Last Name, First Name, Middle Name)</span></div>
                                <div style="font-size:8px; font-weight:900; padding-top:1px;"><%= employee.name.toUpperCase() %></div>
                            </td>
                            <td style="width:24%; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>5</strong> RDO Code</div>
                                <div class="dg-group" style="padding-top:1px;">
                                    <span class="dg"><%= rdoDig[0] %></span><span class="dg"><%= rdoDig[1] %></span><span class="dg"><%= rdoDig[2] %></span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6 Registered Address / 6A ZIP -->
                    <table style="width:100%; border-bottom:0.5pt solid #000;">
                        <tr>
                            <td style="width:76%; border-right:0.5pt solid #000; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>6</strong>&nbsp; Registered Address</div>
                                <div style="font-size:7px; padding-top:1px;"><%= employee.presentAddress || employee.permanentAddress || employee.address || 'Plaridel, Bulacan, Philippines' %></div>
                            </td>
                            <td style="width:24%; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>6A</strong> ZIP Code</div>
                                <div class="dg-group" style="padding-top:1px;">
                                    <span class="dg"><%= empZip[0] %></span><span class="dg"><%= empZip[1] %></span><span class="dg"><%= empZip[2] %></span><span class="dg"><%= empZip[3] %></span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6B Local Home Address / 6C ZIP -->
                    <table style="width:100%; border-bottom:0.5pt solid #000;">
                        <tr>
                            <td style="width:76%; border-right:0.5pt solid #000; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>6B</strong>&nbsp; Local Home Address</div>
                                <div style="font-size:7px; padding-top:1px;"><%= employee.presentAddress || employee.permanentAddress || employee.address || 'Plaridel, Bulacan, Philippines' %></div>
                            </td>
                            <td style="width:24%; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>6C</strong> ZIP Code</div>
                                <div class="dg-group" style="padding-top:1px;">
                                    <span class="dg"><%= empZip[0] %></span><span class="dg"><%= empZip[1] %></span><span class="dg"><%= empZip[2] %></span><span class="dg"><%= empZip[3] %></span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6D Foreign Address -->
                    <div style="padding:1px 3px; border-bottom:0.5pt solid #000; font-size:6.2px; min-height:13px;">
                        <strong>6D</strong>&nbsp; Foreign Address
                        <span style="margin-left:4px;">—</span>
                    </div>

                    <!-- 7 Date of Birth / 8 Contact Number -->
                    <table style="width:100%; border-bottom:0.5pt solid #000;">
                        <tr>
                            <td style="width:55%; border-right:0.5pt solid #000; padding:1px 3px; vertical-align:top;">
                                <div style="font-size:6.2px;"><strong>7</strong>&nbsp; Date of Birth <span style="font-size:5.5px; font-style:italic;">(MM/DD/YYYY)</span></div>
                                <div class="dg-group" style="padding-top:1px;">
                                    <span class="dg"><%= dobDigits[0] %></span><span class="dg"><%= dobDigits[1] %></span>
                                    <span class="dg-sep">/</span>
                                    <span class="dg"><%= dobDigits[2] %></span><span class="dg"><%= dobDigits[3] %></span>
                                    <span class="dg-sep">/</span>
