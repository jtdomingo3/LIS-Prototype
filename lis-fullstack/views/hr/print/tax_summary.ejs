<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    @page {
      size: letter portrait;
      margin: 2mm 3.5mm;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
      color: #000000;
      background: #f1f5f9;
      -webkit-font-smoothing: antialiased;
    }

    /* Screen Controls Bar */
    .screen-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 840px;
      margin: 10px auto 8px auto;
      padding: 8px 14px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
      font-family: 'Segoe UI', sans-serif;
    }

    /* Authentic Compact BIR Sheet Styling (Calibrated for strict 1-Page Letter output) */
    .bir-sheet {
      background: #ffffff;
      width: 100%;
      max-width: 840px;
      margin: 0 auto 16px auto;
      color: #000000;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 7px;
      line-height: 1.1;
      border: 2px solid #000000;
    }

    .sec-hdr {
      background: #d1d5db;
      color: #000000;
      font-weight: 900;
      font-size: 7px;
      text-transform: uppercase;
      padding: 1.2px 3px;
      border-bottom: 1px solid #000000;
      letter-spacing: 0.2px;
    }

    .sub-sec-hdr td {
      background: #e5e7eb;
      color: #000000;
      padding: 1px 3px;
      border-top: 1px solid #000000;
      border-bottom: 1px solid #000000;
      font-size: 6.5px;
      font-weight: bold;
    }

    .item-desc {
      padding: 0.6px 3px;
      font-size: 6.5px;
      line-height: 1.1;
      border-bottom: 1px solid #000000;
      vertical-align: middle;
    }

    .item-amt {
      padding: 0.6px 3px;
      font-size: 7px;
      text-align: right;
      font-family: 'Courier New', Courier, monospace;
      font-weight: 600;
      border-left: 1px solid #000000;
      border-bottom: 1px solid #000000;
      width: 30%;
      background: #ffffff;
      white-space: nowrap;
      vertical-align: middle;
    }

    /* Single Digit Box styling for TIN, Year, Dates */
    .box-digit-group {
      display: inline-flex;
      align-items: center;
      gap: 1px;
    }

    .digit-box {
      display: inline-block;
      width: 9.5px;
      height: 11px;
      border: 1px solid #000000;
      text-align: center;
      line-height: 10px;
      font-size: 7px;
      font-weight: bold;
      background: #ffffff;
      font-family: Arial, Helvetica, sans-serif;
    }

    .bir-box {
      display: inline-block;
      width: 9px;
      height: 9px;
      border: 1px solid #000000;
      text-align: center;
      line-height: 8px;
      font-size: 7px;
      font-weight: 900;
      vertical-align: middle;
      background: #ffffff;
    }

    .amt-field-short {
      border: 1px solid #000000;
      display: inline-block;
      width: 60px;
      height: 10px;
      padding: 0 2px;
      text-align: right;
      font-family: 'Courier New', Courier, monospace;
      font-size: 6.5px;
      background: #ffffff;
    }

    @media screen {
      .content-wrapper {
        padding: 10px 14px;
        max-width: 860px;
        margin: 5px auto;
      }
    }

    @media print {
      *, *:before, *:after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        width: 100% !important;
        height: 100% !important;
        overflow: hidden !important;
      }
      .screen-controls,
      .no-print,
      .alert,
      #gezynebot-container,
      .gezynebot-container {
        display: none !important;
      }
      .content-wrapper {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
        margin: 0 !important;
        max-width: 100% !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .bir-sheet {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 auto !important;
        padding: 0 !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
        border: 1.5px solid #000000 !important;
      }
    }
  </style>
</head>
<body>
<div class="content-wrapper">
    <!-- Screen Controls Bar (visible on screen, hidden on print) -->
    <div class="no-print screen-controls" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom: 1px solid #e2e8f0; font-family: 'Segoe UI', sans-serif;">
        <button type="button" onclick="handleDocBack()" style="padding: 6px 14px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 6px;">
            ← Back to Portal
        </button>
        <div style="display: flex; gap: 10px; align-items: center;">
            <div style="display: flex; align-items: center; gap: 6px; font-size: 0.82rem; font-weight: 600; color: #334155;">
                <span>Tax Year:</span>
                <select id="yearSelect" onchange="changeYear(this.value)" style="padding: 4px 10px; border: 1.5px solid #0f172a; border-radius: 6px; font-weight: 700; font-size: 0.85rem; background: #fff; cursor: pointer;">
                    <% for (let y = new Date().getFullYear(); y >= 2023; y--) { %>
                        <option value="<%= y %>" <%= year == y ? 'selected' : '' %>><%= y %></option>
                    <% } %>
                </select>
            </div>
            <span style="font-size: 0.76rem; color: #166534; background: #dcfce7; padding: 5px 10px; border-radius: 6px; font-weight: 600;">
                ✓ Official BIR 2316 • Fits 1 Page Only
            </span>
            <button onclick="window.print()" style="padding: 7px 18px; background: #009957; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; box-shadow: 0 2px 5px rgba(0, 153, 87, 0.3);">
                <span>🖨️</span> Print Official BIR 2316
            </button>
        </div>
    </div>

    <%
        // Formatting helper for currency
        function fmt(val) {
            const n = Number(val) || 0;
            return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        // Helper to extract digits for TIN box rendering
        function getTinBoxes(tinStr, count) {
            const raw = (tinStr || '').replace(/\D/g, '');
            const arr = [];
            for (let i = 0; i < count; i++) {
                arr.push(raw[i] || '');
            }
            return arr;
        }

        function getDobDigits(dob) {
            if (!dob) return ['', '', '', '', '', '', '', ''];
            const d = new Date(dob);
            if (isNaN(d.getTime())) {
                const raw = String(dob).replace(/\D/g, '');
                const res = [];
                for (let i = 0; i < 8; i++) res.push(raw[i] || '');
                return res;
            }
            const mm = String(d.getMonth() + 1).padStart(2, '0');
            const dd = String(d.getDate()).padStart(2, '0');
            const yyyy = String(d.getFullYear());
            return (mm + dd + yyyy).split('');
        }

        const currentEmpTin = employee.tinNumber || employee.tin || '';
        const empTin = getTinBoxes(currentEmpTin, 12);
        const currentLabTin = (typeof labTin !== 'undefined' && labTin) ? labTin : '009-876-543-000';
        const employerTin = getTinBoxes(currentLabTin, 12);
        const currentLabName = (typeof labName !== 'undefined' && labName) ? labName : 'GEZYNE CLINICAL LABORATORY';
        const currentLabAddress = (typeof labAddress !== 'undefined' && labAddress) ? labAddress : '0330 Vergel De Dios St., Poblacion, Plaridel, Bulacan';
        const currentLabZip = (typeof labZipCode !== 'undefined' && labZipCode) ? labZipCode : '3004';
        const labZipDigits = currentLabZip.split('');
        const yearDigits = String(year || '2026').split('');
        const dobDigits = getDobDigits(employee.birthDate || employee.dateOfBirth);
    %>

    <!-- OFFICIAL BIR FORM NO. 2316 (SEPTEMBER 2021 ENCS) -->
    <div class="bir-sheet">
        <!-- TOP HEADER -->
        <table class="bir-table" style="width: 100%; border-collapse: collapse; border-bottom: 1.5px solid #000;">
            <tr>
                <!-- Box Left: For BIR Use / Form No. -->
                <td style="width: 25%; vertical-align: top; border-right: 1.5px solid #000; padding: 1.5px 3px;">
                    <div style="display: flex; justify-content: space-between; font-size: 6.5px; border-bottom: 1px solid #000; padding-bottom: 1px;">
                        <span>For BIR<br>Use Only</span>
                        <span>BCS/<br>Item:</span>
                    </div>
                    <div style="text-align: center; padding-top: 1px;">
                        <div style="font-size: 7px; font-weight: bold; text-transform: uppercase;">BIR Form No.</div>
                        <div style="font-size: 19px; font-weight: 900; line-height: 1; letter-spacing: 0.5px;">2316</div>
                        <div style="font-size: 6.5px; font-weight: bold;">September 2021(ENCS)</div>
                    </div>
                </td>

                <!-- Center: Republic Seal & Main Title -->
                <td style="width: 52%; vertical-align: middle; text-align: center; padding: 1px 4px;">
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
                        <!-- Official Republic / BIR Seal SVG -->
                        <svg width="22" height="22" viewBox="0 0 100 100" style="margin-bottom: 1px;">
                            <circle cx="50" cy="50" r="48" fill="#fff" stroke="#000" stroke-width="3" />
                            <circle cx="50" cy="50" r="40" fill="none" stroke="#000" stroke-width="1.5" />
                            <polygon points="50,15 54,30 68,30 57,39 61,54 50,45 39,54 43,39 32,30 46,30" fill="#000" />
                            <text x="50" y="70" font-size="7" font-weight="bold" text-anchor="middle" font-family="Arial">BIR</text>
                            <text x="50" y="80" font-size="5" text-anchor="middle" font-family="Arial">PHILIPPINES</text>
                        </svg>
                        <div style="font-size: 7px; font-weight: bold; text-transform: uppercase; line-height: 1.1;">Republic of the Philippines</div>
                        <div style="font-size: 6.5px; font-weight: bold; line-height: 1.1;">Department of Finance</div>
                        <div style="font-size: 7px; font-weight: bold; line-height: 1.1;">Bureau of Internal Revenue</div>
                        <div style="font-size: 10.5px; font-weight: 900; line-height: 1.1; margin-top: 1px;">
                            Certificate of Compensation<br>Payment/Tax Withheld
                        </div>
                        <div style="font-size: 6.5px; font-style: italic;">
                            For Compensation Payment With or Without Tax Withheld
                        </div>
                    </div>
                </td>

                <!-- Right: Barcode Graphic -->
                <td style="width: 23%; vertical-align: middle; text-align: center; border-left: 1.5px solid #000; padding: 1.5px 3px;">
                    <div style="display: inline-block;">
                        <svg width="110" height="24" viewBox="0 0 130 36">
                            <rect width="130" height="36" fill="#fff" />
                            <rect x="2" y="2" width="2" height="32" fill="#000" />
                            <rect x="6" y="2" width="4" height="32" fill="#000" />
                            <rect x="12" y="2" width="1" height="32" fill="#000" />
                            <rect x="15" y="2" width="3" height="32" fill="#000" />
                            <rect x="20" y="2" width="2" height="32" fill="#000" />
                            <rect x="24" y="2" width="5" height="32" fill="#000" />
                            <rect x="31" y="2" width="1" height="32" fill="#000" />
                            <rect x="34" y="2" width="4" height="32" fill="#000" />
                            <rect x="40" y="2" width="2" height="32" fill="#000" />
                            <rect x="44" y="2" width="3" height="32" fill="#000" />
                            <rect x="49" y="2" width="1" height="32" fill="#000" />
                            <rect x="52" y="2" width="5" height="32" fill="#000" />
                            <rect x="59" y="2" width="2" height="32" fill="#000" />
                            <rect x="63" y="2" width="4" height="32" fill="#000" />
                            <rect x="69" y="2" width="1" height="32" fill="#000" />
                            <rect x="72" y="2" width="3" height="32" fill="#000" />
                            <rect x="77" y="2" width="2" height="32" fill="#000" />
                            <rect x="81" y="2" width="6" height="32" fill="#000" />
                            <rect x="89" y="2" width="1" height="32" fill="#000" />
                            <rect x="92" y="2" width="4" height="32" fill="#000" />
                            <rect x="98" y="2" width="2" height="32" fill="#000" />
                            <rect x="102" y="2" width="3" height="32" fill="#000" />
                            <rect x="107" y="2" width="1" height="32" fill="#000" />
                            <rect x="110" y="2" width="4" height="32" fill="#000" />
                            <rect x="116" y="2" width="2" height="32" fill="#000" />
                            <rect x="120" y="2" width="4" height="32" fill="#000" />
                            <rect x="126" y="2" width="2" height="32" fill="#000" />
                        </svg>
                        <div style="font-size: 6.5px; font-weight: bold; letter-spacing: 0.5px;">2316 9/21ENCS</div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- Fill-in instruction line -->
        <div style="border-bottom: 1px solid #000; padding: 1px 4px; font-size: 6.8px; font-style: italic;">
            Fill in all applicable spaces. Mark all appropriate boxes with an "X".
        </div>

        <!-- Year and Period Header Bar -->
        <table class="bir-table" style="width: 100%; border-collapse: collapse; border-bottom: 1.5px solid #000;">
            <tr>
                <td style="width: 50%; border-right: 1.5px solid #000; padding: 1px 4px;">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <span style="font-size: 7.2px;"><strong>1</strong> For the Year (YYYY)</span>
                        <div class="box-digit-group">
                            <span class="digit-box"><%= yearDigits[0] || '2' %></span>
                            <span class="digit-box"><%= yearDigits[1] || '0' %></span>
                            <span class="digit-box"><%= yearDigits[2] || '2' %></span>
                            <span class="digit-box"><%= yearDigits[3] || '6' %></span>
                        </div>
                    </div>
                </td>
                <td style="width: 50%; padding: 1px 4px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; font-size: 7.2px;">
                        <span><strong>2</strong> For the Period</span>
                        <div style="display: flex; align-items: center; gap: 4px;">
                            <span>From (MM/DD)</span>
                            <div class="box-digit-group">
                                <span class="digit-box">0</span><span class="digit-box">1</span>
                                <span style="font-size: 8px;">/</span>
                                <span class="digit-box">0</span><span class="digit-box">1</span>
                            </div>
                            <span>To (MM/DD)</span>
                            <div class="box-digit-group">
                                <span class="digit-box">1</span><span class="digit-box">2</span>
                                <span style="font-size: 8px;">/</span>
                                <span class="digit-box">3</span><span class="digit-box">1</span>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
        </table>

        <!-- MAIN 2-COLUMN BODY -->
        <table class="bir-table" style="width: 100%; border-collapse: collapse; border-bottom: 1.5px solid #000;">
            <tr>
                <!-- LEFT COLUMN: PARTS I, II, III, IVA -->
                <td style="width: 50%; vertical-align: top; border-right: 1.5px solid #000; padding: 0;">
                    
                    <!-- PART I: EMPLOYEE INFORMATION -->
                    <div class="sec-hdr">Part I - Employee Information</div>
                    
                    <!-- 3 TIN -->
                    <div class="field-row" style="display: flex; align-items: center; justify-content: space-between; padding: 1px 3px; border-bottom: 1px solid #000;">
                        <span style="font-size: 7px;"><strong>3</strong> TIN</span>
                        <div style="display: flex; align-items: center; gap: 2px;">
                            <div class="box-digit-group">
                                <span class="digit-box"><%= empTin[0] %></span>
                                <span class="digit-box"><%= empTin[1] %></span>
                                <span class="digit-box"><%= empTin[2] %></span>
                            </div>
                            <span>-</span>
                            <div class="box-digit-group">
                                <span class="digit-box"><%= empTin[3] %></span>
                                <span class="digit-box"><%= empTin[4] %></span>
                                <span class="digit-box"><%= empTin[5] %></span>
                            </div>
                            <span>-</span>
                            <div class="box-digit-group">
                                <span class="digit-box"><%= empTin[6] %></span>
                                <span class="digit-box"><%= empTin[7] %></span>
                                <span class="digit-box"><%= empTin[8] %></span>
                            </div>
                            <span>-</span>
                            <div class="box-digit-group">
                                <span class="digit-box"><%= empTin[9] %></span>
                                <span class="digit-box"><%= empTin[10] %></span>
                                <span class="digit-box"><%= empTin[11] %></span>
                            </div>
                        </div>
                    </div>

                    <!-- 4 Employee's Name & 5 RDO Code -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <tr>
                            <td style="width: 78%; border-right: 1px solid #000; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>4</strong> Employee's Name (Last Name, First Name, Middle Name)</div>
                                <div style="font-size: 8px; font-weight: bold; color: #000;">
                                    <%= employee.name.toUpperCase() %>
                                </div>
                            </td>
                            <td style="width: 22%; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>5</strong> RDO Code</div>
                                <div class="box-digit-group" style="padding-top: 1px;">
                                    <span class="digit-box">0</span><span class="digit-box">2</span><span class="digit-box">5</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6 Registered Address & 6A ZIP -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <tr>
                            <td style="width: 78%; border-right: 1px solid #000; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>6</strong> Registered Address</div>
                                <div style="font-size: 7.5px;"><%= employee.presentAddress || employee.permanentAddress || employee.address || 'Plaridel, Bulacan, Philippines' %></div>
                            </td>
                            <td style="width: 22%; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>6A</strong> ZIP Code</div>
                                <div class="box-digit-group" style="padding-top: 1px;">
                                    <span class="digit-box">3</span><span class="digit-box">0</span><span class="digit-box">0</span><span class="digit-box">4</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6B Local Home Address & 6C ZIP -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <tr>
                            <td style="width: 78%; border-right: 1px solid #000; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>6B</strong> Local Home Address</div>
                                <div style="font-size: 7.5px;"><%= employee.presentAddress || employee.permanentAddress || employee.address || 'Plaridel, Bulacan, Philippines' %></div>
                            </td>
                            <td style="width: 22%; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>6C</strong> ZIP Code</div>
                                <div class="box-digit-group" style="padding-top: 1px;">
                                    <span class="digit-box">3</span><span class="digit-box">0</span><span class="digit-box">0</span><span class="digit-box">4</span>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- 6D Foreign Address -->
                    <div style="padding: 1px 3px; border-bottom: 1px solid #000; font-size: 6.8px;">
                        <span><strong>6D</strong> Foreign Address: </span>
                        <span>—</span>
                    </div>

                    <!-- 7 Date of Birth & 8 Contact Number -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <tr>
                            <td style="width: 58%; border-right: 1px solid #000; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>7</strong> Date of Birth (MM/DD/YYYY)</div>
                                <div class="box-digit-group" style="padding-top: 1px;">
                                    <span class="digit-box"><%= dobDigits[0] %></span><span class="digit-box"><%= dobDigits[1] %></span>
                                    <span style="font-size: 7px;">/</span>
                                    <span class="digit-box"><%= dobDigits[2] %></span><span class="digit-box"><%= dobDigits[3] %></span>
                                    <span style="font-size: 7px;">/</span>
                                    <span class="digit-box"><%= dobDigits[4] %></span><span class="digit-box"><%= dobDigits[5] %></span><span class="digit-box"><%= dobDigits[6] %></span><span class="digit-box"><%= dobDigits[7] %></span>
                                </div>
                            </td>
                            <td style="width: 42%; padding: 1px 3px; vertical-align: top;">
                                <div style="font-size: 6.8px;"><strong>8</strong> Contact Number</div>
                                <div style="font-size: 7.5px; padding-top: 1px;"><%= employee.phone || employee.contactNumber || '—' %></div>
                            </td>
                        </tr>
                    </table>

                    <!-- 9 & 10 Statutory Minimum Wage -->
                    <table style="width: 100%; border-collapse: collapse; border-bottom: 1px solid #000;">
                        <tr>
                            <td style="width: 78%; border-right: 1px solid #000; padding: 1px 3px; font-size: 6.8px;">
                                <strong>9</strong> Statutory Minimum Wage rate per day
                            </td>
                            <td style="width: 22%; padding: 1px 3px; text-align: right;">
                                <span class="amt-field-short">—</span>
                            </td>
                        </tr>
                        <tr>
                            <td style="border-right: 1px solid #000; padding: 1px 3px; font-size: 6.8px;">
                                <strong>10</strong> Statutory Minimum Wage rate per month
                            </td>
                            <td style="padding: 1px 3px; text-align: right;">
                                <span class="amt-field-short">—</span>
                            </td>
                        </tr>
                    </table>

                    <!-- 11 Minimum Wage Earner checkbox -->
                    <div style="padding: 1px 3px; border-bottom: 1.2px solid #000; font-size: 6.6px; line-height: 1.15;">
                        <span class="bir-box" style="margin-right: 2px;"></span>
                        <strong>11</strong> Minimum Wage Earner (MWE) whose compensation is exempt from withholding tax and not subject to income tax
                    </div>

                    <!-- PART II: EMPLOYER INFORMATION (PRESENT) -->
                    <div class="sec-hdr">Part II - Employer Information (Present)</div>
                    
                    <!-- 12 TIN -->
