<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : `Exit Clearance — ${typeof employee !== 'undefined' && employee ? employee.name : ''}` %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    @page {
      size: Letter portrait;
      margin: 8mm 12mm;
    }
    body {
      margin: 0;
      padding: 0;
      font-family: 'Times New Roman', Times, serif;
      background: #f1f5f9;
      color: #000;
      -webkit-font-smoothing: antialiased;
    }
    *, *:before, *:after { box-sizing: inherit; }

    /* Screen Container - perfectly aligned to printable Letter width */
    .report-page {
      position: relative;
      width: 100%;
      max-width: 760px;
      margin: 0 auto;
      padding: 20px 24px;
      font-family: 'Times New Roman', Times, serif;
      color: #000;
      font-size: 13px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-shadow: 0 4px 16px rgba(0,0,0,0.06);
      box-sizing: border-box;
    }
    .report-container { position: relative; z-index: 1; width: 100%; box-sizing: border-box; }
    .doc-letterhead {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
      border-bottom: 1.5px solid #000;
      padding-bottom: 8px;
      width: 100%;
      box-sizing: border-box;
    }
    .logo { width: 68px; height: auto; margin-right: 4px; }
    .lab-title { text-align: center; flex: 1; min-width: 0; }
    .lab-title h1 { margin: 0; font-size: 22px; color: #009957; letter-spacing: 1px; font-family: 'Times New Roman', Times, serif; font-weight: bold; line-height: 1.15; }
    .lab-sub { font-size: 10.5px; margin-top: 2px; color: #334155; line-height: 1.3; }
    .section-title { text-align: center; margin: 14px 0 12px 0; font-size: 16px; font-weight: bold; text-decoration: underline; letter-spacing: 0.8px; width: 100%; }
    
    .info-table, .checklist-table {
      width: 100% !important;
      max-width: 100% !important;
      border-collapse: collapse !important;
      table-layout: fixed !important;
      font-size: 12px;
      margin-bottom: 12px;
      border: 1px solid #000 !important;
      box-sizing: border-box !important;
    }
    .info-table td, .checklist-table th, .checklist-table td {
      padding: 6px 10px;
      border: 1px solid #000 !important;
      box-sizing: border-box !important;
    }
    .checklist-table th {
      background: #f1f5f9;
      font-weight: bold;
      font-size: 11.5px;
    }
    .policy-note {
      font-size: 11px;
      color: #222;
      border: 1px solid #000 !important;
      padding: 7px 12px;
      margin-bottom: 12px;
      line-height: 1.35;
      background: #fafafa;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .quitclaim-box {
      border: 1px solid #000 !important;
      padding: 10px 14px;
      margin-bottom: 18px;
      background: #fafafa;
      width: 100% !important;
      box-sizing: border-box !important;
    }
    .signatures { display: flex; justify-content: space-between; margin-top: 18px; width: 100% !important; box-sizing: border-box !important; }
    .sig { text-align: center; width: 45%; position: relative; min-height: 90px; box-sizing: border-box; }
    .sig .name { border-top: 1px solid #000; padding-top: 3px; margin-bottom: 2px; }
    .chk-box {
      display: inline-block;
      width: 14px;
      height: 14px;
      border: 1px solid #000;
      text-align: center;
      line-height: 12px;
      font-size: 11px;
      font-weight: 900;
      vertical-align: middle;
      margin-right: 5px;
      background: #fff;
      box-sizing: border-box;
    }

    /* Screen Controls */
    .screen-controls {
      display: flex;
      justify-content: space-between;
      align-items: center;
      max-width: 760px;
      margin: 12px auto 10px auto;
      padding: 8px 14px;
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      font-family: 'Segoe UI', sans-serif;
      box-sizing: border-box;
    }

    @media print {
      *, *:before, *:after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
      }
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        width: 100% !important;
        height: auto !important;
      }
      .no-print, .screen-controls, .alert, #gezynebot-container {
        display: none !important;
      }
      .report-page {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        break-inside: avoid !important;
      }
      .report-container {
        width: 100% !important;
        max-width: 100% !important;
      }
      .doc-letterhead,
      .report-container .doc-letterhead {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;
        visibility: visible !important;
        opacity: 1 !important;
        width: 100% !important;
      }
      .doc-letterhead *,
      .report-container .doc-letterhead * {
        visibility: visible !important;
      }
      .logo {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;
      }
      .lab-title h1 {
        color: #009957 !important;
        visibility: visible !important;
      }
      .lab-sub {
        color: #334155 !important;
        visibility: visible !important;
      }
    }
  </style>
</head>
<body>
  <!-- Screen Controls Bar (visible on screen, hidden on print) -->
  <div class="screen-controls no-print">
    <button type="button" onclick="handleDocBack()" style="padding: 7px 16px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; cursor: pointer; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px;">
      ← Back to Portal
    </button>
    <div style="display: flex; gap: 10px; align-items: center;">
      <span style="font-size: 0.78rem; color: #166534; background: #dcfce7; padding: 6px 12px; border-radius: 6px; font-weight: 600;">
        ✓ Clearance Slip Generated • Ready to Print
      </span>
      <button onclick="window.print()" style="padding: 8px 20px; background: #009957; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; box-shadow: 0 2px 5px rgba(0, 153, 87, 0.3);">
        <span>🖨️</span> Print Clearance Slip
      </button>
    </div>
  </div>

  <% 
    function formatNumericDate(d) {
      if (!d || d === '—') return '—';
      const parsed = new Date(d);
      if (isNaN(parsed.getTime())) return d;
      const mm = String(parsed.getMonth() + 1).padStart(2, '0');
      const dd = String(parsed.getDate()).padStart(2, '0');
      const yyyy = parsed.getFullYear();
      return `${mm}/${dd}/${yyyy}`;
    }
    const effectiveDateStr = formatNumericDate(employee.dateTerminated || new Date());
    const hiredDateStr = formatNumericDate(employee.dateHired);
  %>

  <!-- Official Clearance Form Page (Exact same clinical styling as Leave Slip) -->
  <div class="report-page">
    <div class="report-container">
      <!-- Letterhead -->
      <div class="doc-letterhead">
        <div>
          <img src="/assets/gezyne-logo.png" class="logo" alt="logo">
        </div>
        <div class="lab-title">
          <h1>GEZYNE CLINICAL LABORATORY</h1>
          <div class="lab-sub" style="font-weight: 600;">0330 VERGEL DE DIOS ST POBLACION PLARIDEL • NEAR MUNICIPAL BASKETBALL COURT</div>
          <div class="lab-sub">Tel: 0917-649-0807 / 0960-390-0921 / 795-5007 • Lic. No. 03-435-15CL-20</div>
        </div>	
        <div style="min-width: 155px; font-size: 12px; text-align: right;">
          <table style="border-collapse: collapse; width: 100%; font-size: 12px; border: 1px solid #000; box-sizing: border-box;">
            <tr>
              <td style="border: 1px solid #000; padding: 4px 6px; text-align: left; background: #fafafa; font-weight: 600; width: 45%;">Form Ref:</td>
              <td style="border: 1px solid #000; padding: 4px 6px; font-weight: bold; text-align: left; width: 55%;">GCL-HR-CLR</td>
            </tr>
            <tr>
              <td style="border: 1px solid #000; padding: 4px 6px; text-align: left; background: #fafafa; font-weight: 600;">Date:</td>
              <td style="border: 1px solid #000; padding: 4px 6px; font-weight: bold; text-align: left;"><%= currentDate %></td>
            </tr>
          </table>
        </div>
      </div>

      <!-- Form Title -->
      <div class="section-title">
        EMPLOYEE EXIT CLEARANCE &amp; ACCOUNTABILITY CHECKLIST
      </div>

      <!-- Employee Information Grid -->
      <table class="info-table">
        <colgroup>
          <col style="width: 18%;">
          <col style="width: 42%;">
          <col style="width: 18%;">
          <col style="width: 22%;">
        </colgroup>
        <tr>
          <td style="background: #fafafa; font-weight: 600;">Employee Name:</td>
          <td style="font-size: 13.5px;"><strong><%= employee ? employee.name.toUpperCase() : '' %></strong></td>
          <td style="background: #fafafa; font-weight: 600;">Employee ID:</td>
          <td><strong><%= employee ? (employee.employeeCode || '—') : '—' %></strong></td>
        </tr>
        <tr>
          <td style="background: #fafafa; font-weight: 600;">Position / Designation:</td>
          <td><strong><%= employee ? (employee.position || 'Laboratory Staff') : 'Laboratory Staff' %></strong></td>
          <td style="background: #fafafa; font-weight: 600;">Department:</td>
          <td><strong><%= employee ? (employee.department || 'Clinical Laboratory') : 'Clinical Laboratory' %></strong></td>
        </tr>
        <tr>
          <td style="background: #fafafa; font-weight: 600;">Date Hired:</td>
          <td><%= hiredDateStr %></td>
          <td style="background: #fafafa; font-weight: 600;">Separation Effective:</td>
          <td><strong><%= effectiveDateStr %></strong></td>
        </tr>
      </table>

      <!-- Policy Notice Note -->
      <div class="policy-note">
        <strong>Clearance Policy:</strong> The departing employee must secure clearance sign-off from all designated unit heads below. All laboratory property, records, credentials, and equipment must be properly turned over prior to the release of final pay, COE, and BIR Form 2316.
      </div>

      <!-- 5-Point Core Clinical Laboratory Clearance Checklist -->
      <table class="checklist-table">
        <colgroup>
          <col style="width: 6%;">
          <col style="width: 32%;">
          <col style="width: 34%;">
          <col style="width: 12%;">
          <col style="width: 16%;">
        </colgroup>
        <thead>
          <tr>
            <th style="text-align: center;">#</th>
            <th style="text-align: left;">Department / Clearing Officer</th>
            <th style="text-align: left;">Items &amp; Accountabilities Surrendered</th>
            <th style="text-align: center;">Status</th>
            <th style="text-align: center;">Officer Signature / Date</th>
          </tr>
        </thead>
        <tbody>
          <% 
            const checklist = [
              { num: 1, dept: 'Laboratory / Clinical Unit', head: 'Chief Medical Technologist', items: 'Reagent turnover, laboratory equipment, glassware, QC records, bench logbooks' },
              { num: 2, dept: 'Radiology / Imaging', head: 'Chief RadTech / RSO', items: 'X-ray accessories, lead aprons, TLD radiation badge return, darkroom keys' },
              { num: 3, dept: 'Information Technology & LIS', head: 'LIS System Admin', items: 'Revocation of LIS account credentials, official email deactivation, system access' },
              { num: 4, dept: 'Administration & Property', head: 'HR / Property Custodian', items: 'Surrender of company ID, laboratory coats/scrubs, locker keys, security badge' },
              { num: 5, dept: 'Accounting & Finance', head: 'Finance Officer / Cashier', items: 'Settlement of cash advances/loans, petty cash liquidation, final pay clearance' }
            ];

            checklist.forEach(function(item, idx) {
          %>
            <tr style="<%= idx % 2 === 1 ? 'background: #fafafa;' : '' %>">
              <td style="text-align: center; font-weight: bold; color: #334155;"><%= item.num %></td>
              <td>
                <strong style="font-size: 12.5px;"><%= item.dept %></strong>
                <div style="font-size: 10.5px; color: #555; margin-top: 1px;"><%= item.head %></div>
              </td>
              <td style="font-size: 11px; line-height: 1.35; color: #222;">
                <%= item.items %>
              </td>
              <td style="text-align: center;">
                <span style="font-size: 10.5px; font-weight: bold; color: #166534;">
                  <span class="chk-box">✓</span> Cleared
                </span>
              </td>
              <td style="text-align: center; vertical-align: bottom; padding-bottom: 4px;">
                <div style="height: 22px;"></div>
                <div style="border-top: 1px solid #000; font-size: 9.5px; color: #444; padding-top: 2px;">
                  Signature / Date
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>

      <!-- Employee Quitclaim & Waiver Box -->
      <div class="quitclaim-box">
        <div style="font-weight: bold; font-size: 12px; margin-bottom: 4px; text-transform: uppercase;">
          Employee Acknowledgment, Waiver &amp; Quitclaim Statement:
        </div>
        <p style="font-size: 10.5px; line-height: 1.4; text-align: justify; color: #222; margin-bottom: 4px;">
          I hereby declare that I have turned over all company property, equipment, supplies, records, and proprietary laboratory information in my custody. Upon receipt of my full and final pay, I unconditionally release and discharge Gezyne Clinical Laboratory from any and all claims, actions, or liabilities arising out of or in connection with my employment.
        </p>
      </div>

      <!-- Signatures (Exact same layout as Leave Slip) -->
      <div class="signatures">
        <!-- Staff Signature -->
        <div class="sig">
          <div style="font-size: 11px; color: #555; font-style: italic; margin-bottom: 38px;">
            I hereby acknowledge and certify to the above turnover:
          </div>
          <div class="name">
            <strong style="font-size: 13.5px;"><%= employee ? employee.name.toUpperCase() : 'EMPLOYEE SIGNATURE' %></strong>
          </div>
          <div style="font-size: 11px; color: #444;">Staff Signature over Printed Name • Date</div>
        </div>

        <!-- Laboratory Owner Signature -->
        <div class="sig">
          <div style="display: flex; justify-content: center; gap: 16px; margin-bottom: 6px; font-size: 12px; font-weight: bold;">
            <span><span class="chk-box">✓</span> APPROVED FOR FINAL RELEASE</span>
          </div>
          <div style="height: 34px; position: relative;">
            <% if (typeof owner !== 'undefined' && owner && owner.signature) { %>
              <img src="<%= owner.signature %>" alt="Owner Signature" style="max-height: 34px; max-width: 130px; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); pointer-events: none;">
            <% } %>
          </div>
          <div class="name" style="font-size: 13.5px;">
            <strong><%= (typeof owner !== 'undefined' && owner && owner.name) ? owner.name.toUpperCase() : 'GENALYN LOPEZ' %></strong>
          </div>
          <div style="font-size: 11px; font-weight: bold;">
            <%= (typeof owner !== 'undefined' && owner && owner.title) ? owner.title : 'Laboratory Owner' %>
          </div>
          <div style="font-size: 10px; color: #555; margin-top: 2px;">
            Gezyne Clinical Laboratory • Date: <strong><%= currentDate %></strong>
          </div>
        </div>
      </div>

      <!-- Footer Note -->
      <div style="font-size: 9.5px; color: #64748b; text-align: center; margin-top: 14px;">
        Form Ref: CLR-<%= employee ? employee.employeeCode : 'STAFF' %>-<%= new Date().getFullYear() %> • Gezyne Clinical Laboratory HR Records • Official Exit Clearance Form
      </div>
    </div>
  </div>

  <script>
  function handleDocBack() {
    if (window.opener && window.history.length <= 1) {
      window.close();
      return;
    }
    if (window.history.length > 1 && document.referrer) {
      window.history.back();
      return;
    }
    window.location.href = '/hr/my';
  }
  </script>
</body>
</html>
