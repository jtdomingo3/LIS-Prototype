<div style="width: 100%; box-sizing: border-box;">
    <%
      const payrollRecords = (typeof records !== 'undefined' && Array.isArray(records)) ? records : ((typeof payrolls !== 'undefined' && Array.isArray(payrolls)) ? payrolls : []);
      const grossVal = (typeof totalGross !== 'undefined') ? totalGross : payrollRecords.reduce((s, p) => s + (p.grossPay || 0), 0);
      const dedVal = (typeof totalDeductions !== 'undefined') ? totalDeductions : payrollRecords.reduce((s, p) => s + (p.totalDeductions || 0), 0);
      const netVal = (typeof totalNet !== 'undefined') ? totalNet : payrollRecords.reduce((s, p) => s + (p.netPay || 0), 0);
      const empCostVal = (typeof totalEmployerCost !== 'undefined') ? totalEmployerCost : payrollRecords.reduce((s, p) => s + (p.totalEmployerCost || 0), 0);
      const selMonth = (typeof selectedMonth !== 'undefined') ? selectedMonth : new Date().toISOString().slice(0, 7);
      const curStatusFilter = (typeof statusFilter !== 'undefined') ? statusFilter : '';
    %>
    <!-- Top Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <a href="/hr" style="color: #64748b; text-decoration: none; font-size: 1.2rem;">←</a>
                <h2 style="margin: 0; font-size: 1.5rem; color: #1e1b4b; font-weight: 700;">Payroll Register & Processing</h2>
            </div>
            <p style="margin: 4px 0 0 28px; color: #64748b; font-size: 0.88rem;">
                Monthly and semi-monthly compensation records, statutory deductions, net payouts, and personnel costs
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <form action="/hr/payroll" method="GET" style="display: flex; align-items: center; gap: 8px;">
                <label for="monthPicker" style="font-size: 0.85rem; font-weight: 600; color: #475569;">Month:</label>
                <input type="month" id="monthPicker" name="month" value="<%= selMonth %>" onchange="this.form.submit()" style="padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 600; color: #0f172a; background: #fff;">
            </form>
            <a href="/hr/export/payroll?month=<%= selMonth %>" class="btn btn-secondary btn-small" style="padding: 8px 14px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; font-weight: 600;">
                <span>📥</span> Export Payroll
            </a>
            <a href="/hr/payroll/compute" class="btn btn-primary" style="padding: 8px 16px; background: #4f46e5; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>⚡</span> Run Payroll Wizard
            </a>
        </div>
    </div>

    <!-- Summary Metrics Bar -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 22px;">
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e0e7ff;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Gross Pay</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #0f172a; margin-top: 4px;">
                ₱<%= grossVal.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Basic + allowances + OT</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e0e7ff;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Deductions</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #dc2626; margin-top: 4px;">
                -₱<%= dedVal.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Gov shares + tax + loans</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e0e7ff;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Net Take-Home Pay</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #059669; margin-top: 4px;">
                ₱<%= netVal.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Disbursed to staff</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e0e7ff;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Employer Cost</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #4f46e5; margin-top: 4px;">
                ₱<%= empCostVal.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Gross + ER Gov shares (P&L)</div>
        </div>
    </div>

    <!-- Status Tabs -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 8px;">
        <a href="/hr/payroll?month=<%= selMonth %>" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= !curStatusFilter ? 'background: #1e1b4b; color: white;' : 'background: #f1f5f9; color: #475569;' %>">All Statuses</a>
        <a href="/hr/payroll?month=<%= selMonth %>&status=Draft" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= curStatusFilter === 'Draft' ? 'background: #f59e0b; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Drafts</a>
        <a href="/hr/payroll?month=<%= selMonth %>&status=Approved" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= curStatusFilter === 'Approved' ? 'background: #10b981; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Approved</a>
        <a href="/hr/payroll?month=<%= selMonth %>&status=Paid" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= curStatusFilter === 'Paid' ? 'background: #3b82f6; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Paid</a>
    </div>

    <!-- Payroll Records Table -->
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04); overflow: hidden;">
        <div style="padding: 16px 22px; border-bottom: 1px solid #e2e8f0; font-weight: 700; color: #1e1b4b;">
            <%= payrollRecords.length %> Payroll Records (<%= selMonth %>)
        </div>

        <% if (payrollRecords.length === 0) { %>
            <div style="padding: 50px 20px; text-align: center; color: #94a3b8;">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">💳</div>
                <div style="font-weight: 600; font-size: 1rem; color: #475569;">No payroll calculated for <%= selectedMonth %></div>
                <p style="font-size: 0.85rem; margin: 4px 0 16px 0;">Run the computation wizard to calculate salaries, tax, and SSS/PhilHealth/HDMF.</p>
                <a href="/hr/payroll/compute" class="btn btn-primary btn-small" style="padding: 8px 16px; background: #4f46e5; color: white; border-radius: 8px; text-decoration: none; font-weight: 600;">
                    + Run Computation Wizard
                </a>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 12px 16px;">Employee</th>
                            <th style="padding: 12px 16px;">Period</th>
                            <th style="padding: 12px 16px; text-align: right;">Basic Pay</th>
                            <th style="padding: 12px 16px; text-align: right;">Gross Pay</th>
                            <th style="padding: 12px 16px; text-align: right;">Gov Deductions</th>
                            <th style="padding: 12px 16px; text-align: right;">Tax</th>
                            <th style="padding: 12px 16px; text-align: right;">Net Pay</th>
                            <th style="padding: 12px 16px; text-align: center;">Status</th>
                            <th style="padding: 12px 16px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% payrollRecords.forEach(p => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">
                                    <a href="/hr/payroll/<%= p.id %>" style="color: inherit; text-decoration: none;">
                                        <%= p.employeeName %>
                                    </a>
                                    <div style="font-size: 0.78rem; color: #94a3b8; font-weight: normal;"><%= p.department %></div>
                                </td>
                                <td style="padding: 12px 16px; color: #64748b; white-space: nowrap;">
                                    <%= p.payPeriodStart.slice(5, 10) %> to <%= p.payPeriodEnd.slice(5, 10) %>
                                </td>
                                <td style="padding: 12px 16px; text-align: right; color: #475569;">
                                    ₱<%= (Number(p.basicPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 16px; text-align: right; font-weight: 600; color: #0f172a;">
                                    ₱<%= (Number(p.grossPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 16px; text-align: right; color: #dc2626;">
                                    -₱<%= ((Number(p.sssContribution) || 0) + (Number(p.philhealthContribution) || 0) + (Number(p.pagibigContribution) || 0)).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 16px; text-align: right; color: #dc2626;">
                                    <%= p.withholdingTax > 0 ? '-₱' + Number(p.withholdingTax).toLocaleString('en-US', { minimumFractionDigits: 2 }) : '₱0.00' %>
                                </td>
                                <td style="padding: 12px 16px; text-align: right; font-weight: 800; color: #059669;">
                                    ₱<%= (Number(p.netPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 16px; text-align: center;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; <%= p.status === 'Approved' ? 'background: #dcfce7; color: #166534;' : (p.status === 'Paid' ? 'background: #e0e7ff; color: #3730a3;' : 'background: #fef3c7; color: #92400e;') %>">
                                        <%= p.status %>
                                    </span>
                                </td>
                                <td style="padding: 12px 16px; text-align: center; white-space: nowrap;">
                                    <a href="/hr/payroll/<%= p.id %>" style="display: inline-block; padding: 4px 8px; background: #f1f5f9; color: #334155; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.8rem; margin-right: 4px;">View</a>
                                    <a href="/hr/print/payslip/<%= p.id %>" target="_blank" style="display: inline-block; padding: 4px 8px; background: #e0e7ff; color: #4338ca; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.8rem;">Print 🖨️</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
