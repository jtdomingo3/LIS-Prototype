<div style="width: 100%; box-sizing: border-box;">
    <!-- Page Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <a href="/hr" style="color: #64748b; text-decoration: none; font-size: 1.2rem;">←</a>
                <h2 style="margin: 0; font-size: 1.5rem; color: #1e1b4b; font-weight: 700;">Employee Directory</h2>
            </div>
            <p style="margin: 4px 0 0 28px; color: #64748b; font-size: 0.88rem;">
                Staff profiles, role assignments, compensation rates, duty schedules, and government contributions
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="/hr/export/employees" class="btn btn-secondary btn-small" style="padding: 8px 14px; background: #f1f5f9; color: #334155; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>📥</span> Export Masterlist
            </a>
            <a href="/hr/employees/new" class="btn btn-primary" style="padding: 8px 16px; background: #4f46e5; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>➕</span> Add Employee Record
            </a>
        </div>
    </div>

    <!-- Directory Tabs (Staff Directory vs System Accounts) -->
    <div style="display: flex; gap: 8px; margin-bottom: 14px; align-items: center; border-bottom: 2px solid #e2e8f0; padding-bottom: 8px;">
        <a href="/hr/employees?view=staff" style="text-decoration: none; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease; <%= (!viewFilter || viewFilter === 'staff') ? 'background: #4f46e5; color: white;' : 'background: #f1f5f9; color: #475569;' %>">
            <span>👥 Staff Directory</span>
            <span style="padding: 1px 6px; border-radius: 10px; font-size: 0.75rem; <%= (!viewFilter || viewFilter === 'staff') ? 'background: rgba(255,255,255,0.25); color: white;' : 'background: #e2e8f0; color: #334155;' %>"><%= typeof totalStaffCount !== 'undefined' ? totalStaffCount : employees.length %></span>
        </a>
        <a href="/hr/employees?view=system" style="text-decoration: none; padding: 6px 14px; border-radius: 8px; font-weight: 700; font-size: 0.88rem; display: inline-flex; align-items: center; gap: 6px; transition: all 0.15s ease; <%= viewFilter === 'system' ? 'background: #475569; color: white;' : 'background: #f1f5f9; color: #475569;' %>">
            <span>⚙️ System Accounts</span>
            <span style="padding: 1px 6px; border-radius: 10px; font-size: 0.75rem; <%= viewFilter === 'system' ? 'background: rgba(255,255,255,0.25); color: white;' : 'background: #e2e8f0; color: #334155;' %>"><%= typeof totalSystemCount !== 'undefined' ? totalSystemCount : 0 %></span>
        </a>
        <a href="/hr/employees?view=all" style="text-decoration: none; padding: 6px 12px; border-radius: 8px; font-weight: 600; font-size: 0.85rem; color: #64748b; margin-left: auto;">
            All Accounts (<%= (typeof totalStaffCount !== 'undefined' && typeof totalSystemCount !== 'undefined') ? (totalStaffCount + totalSystemCount) : employees.length %>)
        </a>
    </div>

    <!-- Search & Filters (Strictly One Horizontal Row) -->
    <div style="background: white; border-radius: 10px; padding: 10px 14px; border: 1px solid #e2e8f0; margin-bottom: 20px; box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);">
        <form action="/hr/employees" method="GET" style="display: flex; gap: 10px; align-items: center; width: 100%; margin: 0; flex-wrap: nowrap;">
            <input type="hidden" name="view" value="<%= viewFilter || 'staff' %>">
            <!-- Search Text -->
            <div style="position: relative; flex: 2; min-width: 220px;">
                <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #94a3b8; pointer-events: none; font-size: 0.88rem;">🔍</span>
                <input type="text" name="search" value="<%= search || '' %>" placeholder="Search by name, employee code, or position..." style="width: 100%; height: 38px; box-sizing: border-box; padding: 6px 12px 6px 34px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88rem; background: #f8fafc; outline: none;">
            </div>

            <!-- Department Filter -->
            <div style="flex: 1; min-width: 170px; max-width: 230px; flex-shrink: 0;">
                <select name="department" onchange="this.form.submit()" style="width: 100%; height: 38px; box-sizing: border-box; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88rem; background: #fff; cursor: pointer;">
                    <option value="">All Departments</option>
                    <option value="Clinical Laboratory" <%= deptFilter === 'Clinical Laboratory' ? 'selected' : '' %>>Clinical Laboratory</option>
                    <option value="Radiology" <%= deptFilter === 'Radiology' ? 'selected' : '' %>>Radiology</option>
                    <option value="Reception" <%= deptFilter === 'Reception' ? 'selected' : '' %>>Reception</option>
                    <option value="Administration" <%= deptFilter === 'Administration' ? 'selected' : '' %>>Administration</option>
                </select>
            </div>

            <!-- Status Filter -->
            <div style="flex: 1; min-width: 140px; max-width: 180px; flex-shrink: 0;">
                <select name="status" onchange="this.form.submit()" style="width: 100%; height: 38px; box-sizing: border-box; padding: 6px 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.88rem; background: #fff; cursor: pointer;">
                    <option value="">All Statuses</option>
                    <option value="Active" <%= statusFilter === 'Active' ? 'selected' : '' %>>Active</option>
                    <option value="Resigned" <%= statusFilter === 'Resigned' ? 'selected' : '' %>>Resigned</option>
                    <option value="AWOL" <%= statusFilter === 'AWOL' ? 'selected' : '' %>>AWOL (Absence Without Leave)</option>
                    <option value="Terminated" <%= statusFilter === 'Terminated' ? 'selected' : '' %>>Terminated</option>
                    <option value="On Leave" <%= statusFilter === 'On Leave' ? 'selected' : '' %>>On Leave</option>
                </select>
            </div>

            <!-- Filter Button -->
            <button type="submit" style="height: 38px; padding: 0 18px; background: #0f172a; color: white; border: none; border-radius: 8px; font-weight: 600; font-size: 0.88rem; cursor: pointer; flex-shrink: 0; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px;">
                Filter
            </button>

            <!-- Reset Filter Link -->
            <% if (search || deptFilter || statusFilter) { %>
                <a href="/hr/employees?view=<%= viewFilter || 'staff' %>" style="height: 38px; padding: 0 12px; background: #fef2f2; color: #ef4444; border: 1px solid #fecaca; border-radius: 8px; font-size: 0.85rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; flex-shrink: 0; white-space: nowrap;">
                    ✕ Clear
                </a>
            <% } %>
        </form>
    </div>

    <!-- Employees Table -->
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04); overflow: hidden;">
        <div style="padding: 16px 22px; border-bottom: 1px solid #e2e8f0; font-weight: 700; color: #1e1b4b; display: flex; justify-content: space-between; align-items: center;">
            <span>Showing <%= employees.length %> <%= (viewFilter === 'system') ? 'System Accounts' : 'Staff Members' %></span>
            <span style="font-size: 0.82rem; font-weight: normal; color: #64748b;">
                <%= (viewFilter === 'system') ? 'These accounts are tagged as generic/operational logins and excluded from active staff headcount and payroll.' : 'Click "💵 Set Pay" to configure Daily Duty Rate, Fixed Monthly, or Commission Exemption' %>
            </span>
        </div>
        <div style="overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                <thead>
                    <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                        <th style="padding: 12px 18px;">Emp Code</th>
                        <th style="padding: 12px 18px;">Employee Name</th>
                        <th style="padding: 12px 18px;">Role / Position</th>
                        <th style="padding: 12px 18px;">Department</th>
                        <th style="padding: 12px 18px;">Type</th>
                        <th style="padding: 12px 18px; text-align: right;">Compensation / Duty Pay</th>
                        <th style="padding: 12px 18px; text-align: center;">Status</th>
                        <th style="padding: 12px 18px; text-align: center;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (employees.length === 0) { %>
                        <tr>
                            <td colspan="8" style="padding: 40px; text-align: center; color: #94a3b8;">
                                No staff members found matching your search criteria.
                            </td>
                        </tr>
                    <% } %>
                    <% employees.forEach(e => { 
                        const isDoc = (e.isDoctorOrPathologist && e.isDoctorOrPathologist());
                        const isComm = (e.payType === 'Commission Only' || e.isPayrollExempt);
                        const isFixed = (e.payType === 'Fixed Monthly' || (isDoc && !e.dailyRate && e.basicSalary > 0));
                    %>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 12px 18px; font-weight: 700; color: #4f46e5; font-size: 0.85rem;">
                                <%= e.employeeCode || '—' %>
                            </td>
                            <td style="padding: 12px 18px; font-weight: 600; color: #0f172a;">
                                <a href="/hr/employees/<%= e.id %>" style="color: inherit; text-decoration: none;">
                                    <%= e.name %>
                                </a>
                                <% if (e.isSystemAccount) { %>
                                    <span style="display: inline-block; padding: 1px 6px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 4px; font-size: 0.68rem; font-weight: 700; margin-left: 6px;">⚙️ SYSTEM</span>
                                <% } %>
                                <% if (e.email) { %>
                                    <div style="font-size: 0.78rem; color: #94a3b8; font-weight: normal;"><%= e.email %></div>
                                <% } %>
                            </td>
                            <td style="padding: 12px 18px; color: #334155;">
                                <div><%= e.position || e.role %></div>
                                <% if (isDoc) { %>
                                    <span style="display: inline-block; padding: 1px 6px; background: #ede9fe; color: #6d28d9; border-radius: 4px; font-size: 0.68rem; font-weight: 700;">
                                        <%= (e.position && e.position.toLowerCase().includes('patholog')) ? 'PATHOLOGIST' : 'DOCTOR' %>
                                    </span>
                                <% } %>
                            </td>
                            <td style="padding: 12px 18px; color: #64748b;"><%= e.department %></td>
                            <td style="padding: 12px 18px; color: #64748b; font-size: 0.85rem;"><%= e.employmentType %></td>

                            <!-- Compensation Column -->
                            <td style="padding: 12px 18px; text-align: right;">
                                <% if (isComm) { %>
                                    <!-- Commission Only / Payroll Exempt Doctor -->
                                    <span style="display: inline-block; padding: 3px 8px; background: #f8fafc; color: #475569; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 700; font-size: 0.8rem;">
                                        Commission Only
                                    </span>
                                    <div style="font-size: 0.72rem; color: #94a3b8; margin-top: 2px;">Payroll Exempt</div>
                                <% } else if (isFixed) { %>
                                    <!-- Fixed Monthly Retainer (Pathologist / Doctor) -->
                                    <div style="font-weight: 800; color: #4338ca; font-size: 0.95rem;">
                                        ₱<%= (Number(e.basicSalary) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> <span style="font-size: 0.75rem; font-weight: 600; color: #6366f1;">/ mo</span>
                                    </div>
                                    <div style="font-size: 0.72rem; color: #64748b; margin-top: 1px;">Fixed Monthly Retainer</div>
                                    <% if (e.isTaxExempt) { %>
                                        <div style="margin-top: 2px;">
                                            <span style="display: inline-block; padding: 1px 6px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; border-radius: 4px; font-size: 0.68rem; font-weight: 700;">TAX EXEMPT</span>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <!-- Daily Duty Rate (Staff) -->
                                    <div style="font-weight: 800; color: #059669; font-size: 0.95rem;">
                                        ₱<%= (Number(e.dailyRate) || (e.basicSalary > 0 ? Math.round((e.basicSalary / 22) * 100) / 100 : 0)).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> <span style="font-size: 0.75rem; font-weight: 600; color: #047857;">/ duty</span>
                                    </div>
                                    <div style="font-size: 0.72rem; color: #64748b; margin-top: 1px;">
                                        Max 5 days/wk (~₱<%= (Number(e.basicSalary) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>/mo)
                                    </div>
                                    <% if (e.isTaxExempt) { %>
                                        <div style="margin-top: 2px;">
                                            <span style="display: inline-block; padding: 1px 6px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; border-radius: 4px; font-size: 0.68rem; font-weight: 700;">TAX EXEMPT</span>
                                        </div>
                                    <% } %>
                                <% } %>
                            </td>

                            <td style="padding: 12px 18px; text-align: center;">
                                <% 
                                    let statusBg = '#dcfce7', statusColor = '#166534', statusIcon = '●';
                                    if (e.employmentStatus === 'Resigned') {
                                        statusBg = '#fef3c7'; statusColor = '#92400e'; statusIcon = '⏹';
                                    } else if (e.employmentStatus === 'AWOL') {
                                        statusBg = '#fee2e2'; statusColor = '#b91c1c'; statusIcon = '⚠️';
                                    } else if (e.employmentStatus === 'Terminated') {
                                        statusBg = '#fee2e2'; statusColor = '#991b1b'; statusIcon = '✖';
                                    } else if (e.employmentStatus === 'On Leave') {
                                        statusBg = '#ede9fe'; statusColor = '#6d28d9'; statusIcon = '🏖️';
                                    }
                                    const safeName = (e.name || '').replace(/'/g, "\\'");
                                    const safeReason = (e.resignationReason || '').replace(/'/g, "\\'");
                                    const sepDate = e.dateResigned || e.dateTerminated || e.endDate || '';
                                %>
                                <button type="button" 
                                    onclick="openStatusModal('<%= e.id %>', '<%= safeName %>', '<%= e.employeeCode %>', '<%= e.employmentStatus %>', '<%= sepDate %>', '<%= safeReason %>')"
                                    style="border: none; background: transparent; cursor: pointer; padding: 0; outline: none;"
                                    title="Click to change status or set separation/end date">
                                    <span style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; border-radius: 6px; font-size: 0.76rem; font-weight: 700; background: <%= statusBg %>; color: <%= statusColor %>; border: 1px solid rgba(0,0,0,0.06); box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
                                        <span><%= statusIcon %></span> <%= e.employmentStatus %>
                                    </span>
                                </button>
                                <% if ((e.employmentStatus === 'Resigned' || e.employmentStatus === 'AWOL' || e.employmentStatus === 'Terminated') && sepDate) { %>
                                    <div style="font-size: 0.7rem; color: #64748b; font-weight: 600; margin-top: 3px;">
                                        End: <%= sepDate %>
                                    </div>
                                <% } %>
                            </td>

                            <td style="padding: 12px 18px; text-align: center; white-space: nowrap;">
                                <!-- Set Pay Button -->
                                <button type="button" 
                                    class="btn-set-pay"
                                    data-id="<%= e.id %>"
                                    data-name="<%= e.name %>"
                                    data-code="<%= e.employeeCode || '' %>"
                                    data-role="<%= e.position || e.role || '' %>"
                                    data-isdoctor="<%= isDoc ? '1' : '0' %>"
                                    data-paytype="<%= isComm ? 'Commission Only' : (isFixed ? 'Fixed Monthly' : 'Daily Duty') %>"
                                    data-dailyrate="<%= e.dailyRate || (e.basicSalary > 0 ? Math.round((e.basicSalary / 22) * 100) / 100 : 0) %>"
                                    data-monthlypay="<%= e.basicSalary || 0 %>"
                                    data-frequency="<%= e.salaryFrequency || 'Per Duty / Day' %>"
                                    data-taxexempt="<%= (e.isTaxExempt === 1 || e.isTaxExempt === true || e.isTaxExempt === '1') ? '1' : '0' %>"
                                    data-payrollexempt="<%= isComm ? '1' : '0' %>"
                                    data-maxdays="<%= e.maxDaysPerWeek !== undefined ? e.maxDaysPerWeek : (isDoc ? 0 : 5) %>"
                                    data-rice="<%= e.riceAllowance || '' %>"
                                    data-transport="<%= e.transportAllowance || '' %>"
                                    data-meal="<%= e.mealAllowance || '' %>"
                                    onclick="openSalaryModalFromBtn(this)"
                                    style="display: inline-flex; align-items: center; gap: 4px; padding: 5px 11px; background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; border-radius: 6px; font-weight: 700; font-size: 0.8rem; cursor: pointer; margin-right: 4px; transition: background 0.15s ease;"
                                    title="Set Pay, Duty Schedule & Tax Exemption">
                                    <span>💵</span> Set Pay
                                </button>

                                <a href="/hr/employees/<%= e.id %>" style="display: inline-block; padding: 5px 10px; background: #e0e7ff; color: #4f46e5; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.8rem; margin-right: 4px;">Profile</a>
                                <% if (!e.isSystemAccount) { %>
                                    <a href="/hr/print/coe/<%= e.id %>" target="_blank" style="display: inline-block; padding: 5px 8px; background: #f1f5f9; color: #475569; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 0.8rem; margin-right: 4px;" title="Print Certificate of Employment">COE</a>
                                    <form action="/hr/employees/<%= e.id %>/toggle-system-account" method="POST" style="display: inline;" onsubmit="return confirm('Tag <%= e.name %> as a System Account? It will be removed from the active employee directory and payroll.');">
                                        <button type="submit" style="display: inline-flex; align-items: center; gap: 3px; padding: 5px 8px; background: #f8fafc; color: #64748b; border: 1px solid #cbd5e1; border-radius: 6px; font-weight: 600; font-size: 0.8rem; cursor: pointer;" title="Tag as System Account (Exclude from staff directory)">
                                            <span>⚙️</span> Tag System
                                        </button>
                                    </form>
                                <% } else { %>
                                    <form action="/hr/employees/<%= e.id %>/toggle-system-account" method="POST" style="display: inline;" onsubmit="return confirm('Restore <%= e.name %> to the active staff directory?');">
                                        <button type="submit" style="display: inline-flex; align-items: center; gap: 3px; padding: 5px 8px; background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; border-radius: 6px; font-weight: 700; font-size: 0.8rem; cursor: pointer;" title="Untag and restore to Staff Directory">
                                            <span>↩️</span> Restore Staff
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Salary & Tax Exemption Modal Dialog -->
<div id="salaryModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(2px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 530px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); overflow: hidden;">
        <!-- Modal Header -->
        <div style="padding: 16px 22px; background: #0f172a; color: white; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 1.35rem;">💵</span>
                <div>
                    <h3 style="margin: 0; font-size: 1.1rem; font-weight: 700; color: white;">Set Compensation &amp; Tax Status</h3>
                    <div id="modalEmpTitle" style="font-size: 0.82rem; color: #94a3b8; margin-top: 2px;">Staff Member</div>
                </div>
            </div>
            <button type="button" onclick="closeSalaryModal()" style="background: transparent; border: none; color: #94a3b8; font-size: 1.5rem; cursor: pointer; padding: 0 4px; line-height: 1;" title="Close">&times;</button>
        </div>

        <!-- Modal Form -->
        <form id="salaryModalForm" method="POST" action="" style="padding: 20px 22px; margin: 0;">
            <div style="display: flex; flex-direction: column; gap: 14px;">
                
                <!-- Compensation Model Selector (Pills) -->
                <div>
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #475569; text-transform: uppercase; margin-bottom: 8px;">
                        Compensation Model *
                    </label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                        <!-- Option 1: Daily Duty (Staff) -->
                        <label id="pillDailyDuty" style="border: 2px solid #cbd5e1; border-radius: 8px; padding: 8px 10px; cursor: pointer; text-align: center; background: #f8fafc; transition: all 0.15s ease;">
                            <input type="radio" name="payType" value="Daily Duty" id="radioDailyDuty" onchange="onPayTypeChanged()" style="display: none;">
                            <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Daily Duty</div>
                            <div style="font-size: 0.7rem; color: #64748b; margin-top: 2px;">Staff (Per Day)</div>
                        </label>

                        <!-- Option 2: Fixed Monthly (Pathologist / Doctor) -->
                        <label id="pillFixedMonthly" style="border: 2px solid #cbd5e1; border-radius: 8px; padding: 8px 10px; cursor: pointer; text-align: center; background: #f8fafc; transition: all 0.15s ease;">
                            <input type="radio" name="payType" value="Fixed Monthly" id="radioFixedMonthly" onchange="onPayTypeChanged()" style="display: none;">
                            <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Fixed Monthly</div>
                            <div style="font-size: 0.7rem; color: #64748b; margin-top: 2px;">Pathologist / Retainer</div>
                        </label>

                        <!-- Option 3: Commission Only (Exempt Doctor) -->
                        <label id="pillCommissionOnly" style="border: 2px solid #cbd5e1; border-radius: 8px; padding: 8px 10px; cursor: pointer; text-align: center; background: #f8fafc; transition: all 0.15s ease;">
                            <input type="radio" name="payType" value="Commission Only" id="radioCommissionOnly" onchange="onPayTypeChanged()" style="display: none;">
                            <div style="font-size: 0.85rem; font-weight: 700; color: #0f172a;">Commission Only</div>
                            <div style="font-size: 0.7rem; color: #64748b; margin-top: 2px;">Visiting Doctor</div>
                        </label>
                    </div>
                </div>

                <!-- Section A: Daily Duty Inputs (Staff) -->
                <div id="sectionDailyDuty" style="display: block;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #065f46; text-transform: uppercase; margin-bottom: 6px;">
                        Rate per Day of Duty (PHP ₱) *
                    </label>
                    <div style="position: relative;">
                        <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 700; color: #64748b; font-size: 1.1rem; pointer-events: none;">₱</span>
                        <input type="number" step="0.01" min="0" name="dailyRate" id="modalDailyRate" oninput="updateDailyEst()" placeholder="800.00" style="width: 100%; height: 42px; box-sizing: border-box; padding: 6px 12px 6px 32px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 1.15rem; font-weight: 700; color: #0f172a; outline: none;">
                    </div>

                    <!-- Duty Schedule Cap & Real-Time Calculation -->
                    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; padding: 10px 12px; margin-top: 8px; font-size: 0.8rem; color: #166534; line-height: 1.4;">
                        <div>
                            📅 <strong>Duty Schedule Rule:</strong> Maximum <strong>5 duties per week</strong> by default (8-hour standard duty).
                        </div>
                        <div style="margin-top: 4px;">
                            ≈ <strong>Monthly Est. (22 duties):</strong> <span id="modalEstMonthly" style="font-weight: 800; color: #065f46;">₱0.00</span> | <strong>Hourly:</strong> <span id="modalEstHourly" style="font-weight: 800; color: #065f46;">₱0.00/hr</span>
                        </div>
                    </div>
                </div>

                <!-- Section B: Fixed Monthly Inputs (Pathologist / Doctor) -->
                <div id="sectionFixedMonthly" style="display: none;">
                    <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #4338ca; text-transform: uppercase; margin-bottom: 6px;">
                        Fixed Monthly Retainer / Pay (PHP ₱) *
                    </label>
                    <div style="position: relative;">
                        <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font-weight: 700; color: #64748b; font-size: 1.1rem; pointer-events: none;">₱</span>
                        <input type="number" step="0.01" min="0" name="fixedMonthlyPay" id="modalFixedMonthlyPay" placeholder="30000.00" style="width: 100%; height: 42px; box-sizing: border-box; padding: 6px 12px 6px 32px; border: 2px solid #cbd5e1; border-radius: 8px; font-size: 1.15rem; font-weight: 700; color: #0f172a; outline: none;">
                    </div>
                    <div style="background: #ede9fe; border: 1px solid #ddd6fe; border-radius: 8px; padding: 8px 12px; margin-top: 8px; font-size: 0.8rem; color: #5b21b6;">
                        ⭐ <strong>Doctor Schedule Notice:</strong> Doctors &amp; Pathologists are <strong>exempt from the 5 duties/week cap</strong> and paid on fixed monthly basis.
                    </div>
                </div>

                <!-- Section C: Commission Only Notice (Exempt Clinic Doctor) -->
                <div id="sectionCommissionOnly" style="display: none;">
                    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px 14px; font-size: 0.85rem; color: #334155; line-height: 1.45;">
                        <div style="font-weight: 700; color: #0f172a; margin-bottom: 4px;">🤝 Commission-Only Visiting Doctor</div>
                        This doctor only uses the laboratory clinic to examine patients. The laboratory takes a commission/share per patient procedure. <strong>No basic pay or monthly retainer is disbursed by the lab.</strong>
                        <div style="margin-top: 6px; font-weight: 600; color: #059669;">
                            ✓ Automatically excluded from batch payroll generation.
                        </div>
                    </div>
                </div>

                <!-- Tax Exemption Toggle Box -->
                <div style="background: #f0fdf4; border: 1px solid #86efac; border-radius: 10px; padding: 12px 14px;">
                    <label style="display: flex; align-items: flex-start; gap: 10px; cursor: pointer; margin: 0;">
                        <input type="checkbox" name="isTaxExempt" id="modalIsTaxExempt" value="1" style="width: 18px; height: 18px; margin-top: 2px; accent-color: #059669; flex-shrink: 0; cursor: pointer;">
                        <div>
                            <div style="font-weight: 700; color: #065f46; font-size: 0.9rem; display: flex; align-items: center; gap: 6px;">
                                <span>Tax Exempt</span>
                                <span style="font-size: 0.7rem; background: #dcfce7; color: #166534; padding: 1px 6px; border-radius: 4px; border: 1px solid #bbf7d0; font-weight: 700;">0% BIR W-Tax</span>
                            </div>
                            <div style="font-size: 0.78rem; color: #166534; margin-top: 3px; line-height: 1.35;">
                                Check if staff is a statutory Minimum Wage Earner (MWE) or tax-exempt under RA 9504 / TRAIN Law (gross compensation ≤ ₱250,000/yr). No withholding income tax will be deducted.
                            </div>
                        </div>
                    </label>
                </div>

                <!-- Optional Allowances Collapsible -->
                <details style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 12px;">
                    <summary style="font-size: 0.82rem; font-weight: 700; color: #475569; cursor: pointer; user-select: none;">
                        Additional Monthly Allowances (Optional De Minimis)
                    </summary>
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-top: 10px; padding-top: 10px; border-top: 1px solid #e2e8f0;">
                        <div>
                            <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #64748b; margin-bottom: 4px;">Rice (₱)</label>
                            <input type="number" step="0.01" min="0" name="riceAllowance" id="modalRice" placeholder="0.00" style="width: 100%; height: 34px; box-sizing: border-box; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem;">
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #64748b; margin-bottom: 4px;">Transport (₱)</label>
                            <input type="number" step="0.01" min="0" name="transportAllowance" id="modalTransport" placeholder="0.00" style="width: 100%; height: 34px; box-sizing: border-box; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem;">
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #64748b; margin-bottom: 4px;">Meal (₱)</label>
                            <input type="number" step="0.01" min="0" name="mealAllowance" id="modalMeal" placeholder="0.00" style="width: 100%; height: 34px; box-sizing: border-box; padding: 4px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem;">
                        </div>
                    </div>
                </details>
            </div>

            <!-- Modal Action Buttons -->
            <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; padding-top: 14px; border-top: 1px solid #e2e8f0;">
                <button type="button" onclick="closeSalaryModal()" style="padding: 8px 16px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600; font-size: 0.88rem; cursor: pointer;">
                    Cancel
                </button>
                <button type="submit" style="padding: 8px 20px; background: #059669; color: white; border: none; border-radius: 8px; font-weight: 700; font-size: 0.88rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(5, 150, 105, 0.3);">
                    <span>💾</span> Save Compensation
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function openSalaryModalFromBtn(btn) {
    const id = btn.getAttribute('data-id');
    const name = btn.getAttribute('data-name');
    const code = btn.getAttribute('data-code');
    const role = btn.getAttribute('data-role');
    const isDoctor = btn.getAttribute('data-isdoctor') === '1';
    const payType = btn.getAttribute('data-paytype') || (isDoctor ? 'Fixed Monthly' : 'Daily Duty');
    const dailyRate = parseFloat(btn.getAttribute('data-dailyrate')) || 0;
    const monthlyPay = parseFloat(btn.getAttribute('data-monthlypay')) || 0;
    const isTaxExempt = btn.getAttribute('data-taxexempt') === '1';
    const rice = btn.getAttribute('data-rice') || '';
    const transport = btn.getAttribute('data-transport') || '';
    const meal = btn.getAttribute('data-meal') || '';

    const modal = document.getElementById('salaryModal');
    const form = document.getElementById('salaryModalForm');
    const empTitle = document.getElementById('modalEmpTitle');
    const dailyInput = document.getElementById('modalDailyRate');
    const fixedInput = document.getElementById('modalFixedMonthlyPay');
    const taxCheckbox = document.getElementById('modalIsTaxExempt');
    const riceInput = document.getElementById('modalRice');
    const transInput = document.getElementById('modalTransport');
    const mealInput = document.getElementById('modalMeal');

    form.action = '/hr/employees/' + id + '/quick-salary';
    empTitle.textContent = name + (code ? ' (' + code + ')' : '') + (role ? ' • ' + role : '');
    
    dailyInput.value = dailyRate > 0 ? dailyRate : '';
    fixedInput.value = monthlyPay > 0 ? monthlyPay : '';
    taxCheckbox.checked = isTaxExempt;
    riceInput.value = rice;
    transInput.value = transport;
    mealInput.value = meal;

    // Set radio option
    if (payType === 'Commission Only') {
        document.getElementById('radioCommissionOnly').checked = true;
    } else if (payType === 'Fixed Monthly') {
        document.getElementById('radioFixedMonthly').checked = true;
    } else {
        document.getElementById('radioDailyDuty').checked = true;
    }
    onPayTypeChanged();

    modal.style.display = 'flex';
    setTimeout(() => {
        if (payType === 'Fixed Monthly') {
            fixedInput.focus();
        } else if (payType === 'Daily Duty') {
            dailyInput.focus();
        }
    }, 50);
}

function onPayTypeChanged() {
    const isDaily = document.getElementById('radioDailyDuty').checked;
    const isFixed = document.getElementById('radioFixedMonthly').checked;
    const isComm = document.getElementById('radioCommissionOnly').checked;

    document.getElementById('sectionDailyDuty').style.display = isDaily ? 'block' : 'none';
    document.getElementById('sectionFixedMonthly').style.display = isFixed ? 'block' : 'none';
    document.getElementById('sectionCommissionOnly').style.display = isComm ? 'block' : 'none';

    // Style pills
    const pillDaily = document.getElementById('pillDailyDuty');
    const pillFixed = document.getElementById('pillFixedMonthly');
    const pillComm = document.getElementById('pillCommissionOnly');

    pillDaily.style.borderColor = isDaily ? '#059669' : '#cbd5e1';
    pillDaily.style.background = isDaily ? '#ecfdf5' : '#f8fafc';

    pillFixed.style.borderColor = isFixed ? '#6366f1' : '#cbd5e1';
    pillFixed.style.background = isFixed ? '#ede9fe' : '#f8fafc';

    pillComm.style.borderColor = isComm ? '#475569' : '#cbd5e1';
    pillComm.style.background = isComm ? '#f1f5f9' : '#f8fafc';

    if (isDaily) updateDailyEst();
}

function updateDailyEst() {
    const rate = parseFloat(document.getElementById('modalDailyRate').value) || 0;
    const monthly = Math.round(rate * 22 * 100) / 100;
    const hourly = rate > 0 ? Math.round((rate / 8) * 100) / 100 : 0;

    document.getElementById('modalEstMonthly').textContent = '₱' + monthly.toLocaleString('en-US', { minimumFractionDigits: 2 });
    document.getElementById('modalEstHourly').textContent = '₱' + hourly.toLocaleString('en-US', { minimumFractionDigits: 2 }) + '/hr';
}

function closeSalaryModal() {
    const modal = document.getElementById('salaryModal');
    if (modal) modal.style.display = 'none';
}

// Close on backdrop click
document.getElementById('salaryModal').addEventListener('click', function(e) {
    if (e.target === this) closeSalaryModal();
});

// Close on Escape key
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeSalaryModal();
        closeStatusModal();
    }
});
</script>

<!-- Quick Employment Status Modal Dialog -->
<div id="statusModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(2px); z-index: 9999; align-items: center; justify-content: center; padding: 16px;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 480px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2); overflow: hidden;">
        <!-- Header -->
        <div style="padding: 16px 20px; background: #0f172a; color: white; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 id="statusModalEmpName" style="margin: 0; font-size: 1.1rem; font-weight: 700;">Update Employment Status</h3>
                <div id="statusModalEmpCode" style="font-size: 0.8rem; color: #94a3b8; margin-top: 2px;">EMP-CODE</div>
            </div>
            <button type="button" onclick="closeStatusModal()" style="background: transparent; border: none; color: #94a3b8; font-size: 1.4rem; cursor: pointer; line-height: 1;">✕</button>
        </div>

        <!-- Form -->
        <form id="statusModalForm" method="POST" action="">
            <div style="padding: 20px; display: flex; flex-direction: column; gap: 16px;">
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Employment Status *</label>
                    <select name="employmentStatus" id="statusModalSelect" onchange="handleStatusModalChange(this.value)" style="width: 100%; height: 42px; border: 1.5px solid #cbd5e1; border-radius: 8px; padding: 6px 12px; font-size: 0.95rem; font-weight: 700; cursor: pointer;">
                        <option value="Active">● Active (Regular Duty / Active Roster)</option>
                        <option value="Resigned">⏹ Resigned</option>
                        <option value="AWOL">⚠️ AWOL (Absence Without Official Leave)</option>
                        <option value="Terminated">✖ Terminated</option>
                        <option value="On Leave">🏖️ On Leave</option>
                    </select>
                </div>

                <div id="statusModalDateRow">
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #b91c1c; margin-bottom: 6px; text-transform: uppercase;">
                        📅 End Date / Separation Date
                    </label>
                    <input type="date" name="dateResigned" id="statusModalDate" style="width: 100%; height: 40px; border: 1.5px solid #f87171; border-radius: 8px; padding: 6px 12px; font-size: 0.9rem; box-sizing: border-box; background: #fff5f5;">
                    <div style="font-size: 0.75rem; color: #64748b; margin-top: 3px;">
                        Effective date when duties ceased (printed on Certificate of Employment and Clearance)
                    </div>
                </div>

                <div id="statusModalReasonRow">
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">
                        📝 Separation Remarks / Reason
                    </label>
                    <input type="text" name="resignationReason" id="statusModalReason" placeholder="e.g. Voluntary resignation, Failure to report to duty, Personal reasons" style="width: 100%; height: 40px; border: 1px solid #cbd5e1; border-radius: 8px; padding: 6px 12px; font-size: 0.9rem; box-sizing: border-box;">
                </div>
            </div>

            <!-- Footer -->
            <div style="padding: 14px 20px; background: #f8fafc; border-top: 1px solid #e2e8f0; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="closeStatusModal()" style="padding: 8px 16px; border: 1px solid #cbd5e1; background: white; border-radius: 8px; font-weight: 600; color: #475569; cursor: pointer;">Cancel</button>
                <button type="submit" style="padding: 8px 22px; background: #0f172a; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Save Status</button>
            </div>
        </form>
    </div>
</div>

<script>
function openStatusModal(empId, empName, empCode, currentStatus, sepDate, reason) {
    document.getElementById('statusModalForm').action = '/hr/employees/' + empId + '/status';
    document.getElementById('statusModalEmpName').textContent = empName;
    document.getElementById('statusModalEmpCode').textContent = empCode || 'Staff Member';
    document.getElementById('statusModalSelect').value = currentStatus || 'Active';
    document.getElementById('statusModalDate').value = sepDate || (currentStatus !== 'Active' ? new Date().toISOString().slice(0, 10) : '');
    document.getElementById('statusModalReason').value = reason || '';
    handleStatusModalChange(currentStatus || 'Active');
    document.getElementById('statusModal').style.display = 'flex';
}

function handleStatusModalChange(val) {
    const isSeparated = (val === 'Resigned' || val === 'AWOL' || val === 'Terminated');
    const dateRow = document.getElementById('statusModalDateRow');
    const reasonRow = document.getElementById('statusModalReasonRow');
    if (dateRow) dateRow.style.display = isSeparated ? 'block' : 'none';
    if (reasonRow) reasonRow.style.display = isSeparated ? 'block' : 'none';
    if (isSeparated) {
        const dateInput = document.getElementById('statusModalDate');
        if (dateInput && !dateInput.value) {
            dateInput.value = new Date().toISOString().slice(0, 10);
        }
    }
}

function closeStatusModal() {
    const modal = document.getElementById('statusModal');
    if (modal) modal.style.display = 'none';
}

// Close status modal on backdrop click
document.getElementById('statusModal').addEventListener('click', function(e) {
    if (e.target === this) closeStatusModal();
});
</script>
