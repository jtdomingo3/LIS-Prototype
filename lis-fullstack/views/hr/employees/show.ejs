<div style="width: 100%; box-sizing: border-box;">
    <!-- Top Bar -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <a href="/hr/employees" style="color: #64748b; text-decoration: none; font-size: 1.3rem;">←</a>
            <div>
                <h2 style="margin: 0; font-size: 1.6rem; color: #1e1b4b; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                    <%= employee.name %>
                    <span style="font-size: 0.78rem; font-weight: 700; padding: 3px 8px; border-radius: 6px; <%= employee.employmentStatus === 'Active' ? 'background: #dcfce7; color: #166534;' : 'background: #fee2e2; color: #991b1b;' %>">
                        <%= employee.employmentStatus %>
                    </span>
                </h2>
                <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.88rem;">
                    <%= employee.employeeCode %> • <%= employee.position || employee.role %> • <%= employee.department %>
                </p>
            </div>
        </div>
        <!-- Quick Action Buttons -->
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <a href="/hr/employees/<%= employee.id %>/edit" class="btn btn-secondary btn-small" style="padding: 8px 14px; background: #f1f5f9; color: #1e293b; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; font-weight: 600;">
                ✏️ Edit Profile
            </a>
            <a href="/hr/print/coe/<%= employee.id %>" target="_blank" class="btn btn-small" style="padding: 8px 14px; background: #e0e7ff; color: #4338ca; border-radius: 8px; text-decoration: none; font-weight: 600;">
                📄 Print COE
            </a>
            <a href="/hr/print/clearance/<%= employee.id %>" target="_blank" class="btn btn-small" style="padding: 8px 14px; background: #fef3c7; color: #92400e; border-radius: 8px; text-decoration: none; font-weight: 600;">
                📋 Clearance Form
            </a>
            <a href="/hr/print/tax-summary/<%= employee.id %>/<%= new Date().getFullYear() %>" target="_blank" class="btn btn-small" style="padding: 8px 14px; background: #f1f5f9; color: #475569; border-radius: 8px; text-decoration: none; font-weight: 600;">
                📑 BIR 2316 Reference
            </a>
        </div>
    </div>

    <!-- KPI Summary Row -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 24px;">
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Basic Salary</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #059669; margin-top: 4px;">
                ₱<%= (Number(employee.basicSalary) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;"><%= employee.salaryFrequency %> rate</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Total Allowances</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #3b82f6; margin-top: 4px;">
                ₱<%= employee.totalAllowances.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Rice, Meal, Transport</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Employer Share</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #d97706; margin-top: 4px;">
                ₱<%= employee.estimatedEmployerContributions.toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Monthly SSS, PHIC, HDMF</div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.75rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Leave Balances</div>
            <div style="font-size: 1.4rem; font-weight: 800; color: #7e22ce; margin-top: 4px;">
                <%= employee.vacationLeaveBalance %> VL / <%= employee.sickLeaveBalance %> SL
            </div>
            <div style="font-size: 0.78rem; color: #94a3b8;">Remaining days available</div>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <div style="display: flex; gap: 6px; border-bottom: 2px solid #e2e8f0; margin-bottom: 22px;">
        <button onclick="switchTab('personal')" id="tab-btn-personal" class="profile-tab active" style="padding: 10px 18px; border: none; background: transparent; font-weight: 700; font-size: 0.9rem; cursor: pointer; border-bottom: 3px solid #4f46e5; color: #4f46e5;">Personal & Employment</button>
        <button onclick="switchTab('compensation')" id="tab-btn-compensation" class="profile-tab" style="padding: 10px 18px; border: none; background: transparent; font-weight: 600; font-size: 0.9rem; cursor: pointer; border-bottom: 3px solid transparent; color: #64748b;">Compensation & Government</button>
        <button onclick="switchTab('payrolls')" id="tab-btn-payrolls" class="profile-tab" style="padding: 10px 18px; border: none; background: transparent; font-weight: 600; font-size: 0.9rem; cursor: pointer; border-bottom: 3px solid transparent; color: #64748b;">Payroll History (<%= payrolls.length %>)</button>
        <button onclick="switchTab('documents')" id="tab-btn-documents" class="profile-tab" style="padding: 10px 18px; border: none; background: transparent; font-weight: 600; font-size: 0.9rem; cursor: pointer; border-bottom: 3px solid transparent; color: #64748b;">Documents & Tax Forms (<%= documents.length %>)</button>
        <button onclick="switchTab('leaves')" id="tab-btn-leaves" class="profile-tab" style="padding: 10px 18px; border: none; background: transparent; font-weight: 600; font-size: 0.9rem; cursor: pointer; border-bottom: 3px solid transparent; color: #64748b;">Leaves (<%= leaves.length %>)</button>
    </div>

    <!-- Tab 1: Personal & Employment -->
    <div id="tab-personal" class="tab-pane">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Employment Info Card -->
            <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0;">
                <h3 style="margin: 0 0 16px 0; font-size: 1.05rem; color: #1e1b4b; font-weight: 700;">Employment Details</h3>
                <div style="display: grid; grid-template-columns: 140px 1fr; gap: 12px; font-size: 0.9rem;">
                    <span style="color: #64748b; font-weight: 600;">Employee Code:</span>
                    <span style="font-weight: 700; color: #0f172a;"><%= employee.employeeCode %></span>

                    <span style="color: #64748b; font-weight: 600;">Department:</span>
                    <span style="color: #0f172a;"><%= employee.department %></span>

                    <span style="color: #64748b; font-weight: 600;">Position / Title:</span>
                    <span style="color: #0f172a;"><%= employee.position || employee.role %></span>

                    <span style="color: #64748b; font-weight: 600;">Employment Type:</span>
                    <span style="color: #0f172a;"><%= employee.employmentType %></span>

                    <span style="color: #64748b; font-weight: 600;">Date Hired:</span>
                    <span style="color: #0f172a;"><%= employee.dateHired || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Date Regularized:</span>
                    <span style="color: #0f172a;"><%= employee.dateRegularized || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Status:</span>
                    <span style="color: #0f172a;"><%= employee.employmentStatus %></span>

                    <% if (employee.dateResigned) { %>
                        <span style="color: #dc2626; font-weight: 600;">Date Resigned:</span>
                        <span style="color: #dc2626;"><%= employee.dateResigned %></span>

                        <span style="color: #dc2626; font-weight: 600;">Separation Reason:</span>
                        <span style="color: #dc2626;"><%= employee.resignationReason || '—' %></span>
                    <% } %>
                </div>
            </div>

            <!-- Personal Info Card -->
            <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0;">
                <h3 style="margin: 0 0 16px 0; font-size: 1.05rem; color: #1e1b4b; font-weight: 700;">Personal Information</h3>
                <div style="display: grid; grid-template-columns: 140px 1fr; gap: 12px; font-size: 0.9rem;">
                    <span style="color: #64748b; font-weight: 600;">Date of Birth:</span>
                    <span style="color: #0f172a;"><%= employee.birthDate || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Civil Status:</span>
                    <span style="color: #0f172a;"><%= employee.civilStatus %></span>

                    <span style="color: #64748b; font-weight: 600;">Dependents:</span>
                    <span style="color: #0f172a;"><%= employee.numberOfDependents %></span>

                    <span style="color: #64748b; font-weight: 600;">Contact Phone:</span>
                    <span style="color: #0f172a;"><%= employee.contactPhone || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Email:</span>
                    <span style="color: #0f172a;"><%= employee.email || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Present Address:</span>
                    <span style="color: #0f172a;"><%= employee.presentAddress || '—' %></span>

                    <span style="color: #64748b; font-weight: 600;">Emergency Contact:</span>
                    <span style="color: #0f172a;">
                        <%= employee.emergencyContactName ? `${employee.emergencyContactName} (${employee.emergencyContactRelation || 'Contact'}) - ${employee.emergencyContactPhone}` : '—' %>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Tab 2: Compensation & Government -->
    <div id="tab-compensation" class="tab-pane" style="display: none;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <!-- Compensation Breakdown -->
            <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0;">
                <h3 style="margin: 0 0 16px 0; font-size: 1.05rem; color: #1e1b4b; font-weight: 700;">Compensation Structure</h3>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
                    <tbody>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0; color: #475569;">Compensation Model</td>
                            <td style="padding: 8px 0; text-align: right; font-weight: 700; color: #0f172a;">
                                <% if (employee.payType === 'Commission Only' || employee.isPayrollExempt) { %>
                                    <span style="background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem;">Commission Only (Payroll Exempt)</span>
                                <% } else if (employee.payType === 'Fixed Monthly') { %>
                                    <span style="background: #ede9fe; color: #6d28d9; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem;">Fixed Monthly Retainer</span>
                                <% } else { %>
                                    <span style="background: #ecfdf5; color: #065f46; padding: 2px 8px; border-radius: 4px; font-size: 0.8rem;">Daily Duty (Max 5 days/wk)</span>
                                <% } %>
                            </td>
                        </tr>
                        <% if (employee.payType !== 'Commission Only' && !employee.isPayrollExempt) { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 8px 0; color: #475569;">
                                    <%= employee.payType === 'Fixed Monthly' ? 'Fixed Monthly Retainer' : 'Rate per Day of Duty' %>
                                    <% if (employee.isTaxExempt) { %>
                                        <span style="display: inline-block; margin-left: 6px; padding: 1px 6px; background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; border-radius: 4px; font-size: 0.7rem; font-weight: 700;">TAX EXEMPT (0% W-TAX)</span>
                                    <% } %>
                                </td>
                                <td style="padding: 8px 0; text-align: right; font-weight: 700; color: #0f172a;">
                                    <% if (employee.payType === 'Fixed Monthly') { %>
                                        ₱<%= (Number(employee.basicSalary) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> / mo
                                    <% } else { %>
                                        ₱<%= (Number(employee.dailyRate) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %> / duty day
                                        <div style="font-size: 0.75rem; color: #64748b; font-weight: normal;">(~₱<%= (Number(employee.basicSalary) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>/mo @ 22 duties)</div>
                                    <% } %>
                                </td>
                            </tr>
                        <% } %>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0; color: #475569;">Rice Allowance</td>
                            <td style="padding: 8px 0; text-align: right; color: #334155;">₱<%= (Number(employee.riceAllowance) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0; color: #475569;">Transportation Allowance</td>
                            <td style="padding: 8px 0; text-align: right; color: #334155;">₱<%= (Number(employee.transportAllowance) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0; color: #475569;">Meal Allowance</td>
                            <td style="padding: 8px 0; text-align: right; color: #334155;">₱<%= (Number(employee.mealAllowance) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 8px 0; color: #475569;">Other Allowances</td>
                            <td style="padding: 8px 0; text-align: right; color: #334155;">₱<%= (Number(employee.otherAllowances) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                        <tr style="border-bottom: 2px solid #e2e8f0; font-weight: 800; background: #f8fafc;">
                            <td style="padding: 10px 4px; color: #0f172a;">GROSS MONTHLY PACKAGE</td>
                            <td style="padding: 10px 4px; text-align: right; color: #059669;">₱<%= employee.grossMonthlySalary.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                        </tr>
                    </tbody>
                </table>

                <h4 style="margin: 20px 0 10px 0; font-size: 0.95rem; color: #1e1b4b;">Disbursement / Bank Details</h4>
                <div style="font-size: 0.88rem; color: #334155; line-height: 1.6;">
                    <div><strong>Bank:</strong> <%= employee.bankName || 'Not configured' %></div>
                    <div><strong>Account #:</strong> <%= employee.bankAccountNumber || 'Not configured' %></div>
                    <div><strong>Account Name:</strong> <%= employee.bankAccountName || employee.name %></div>
                </div>
            </div>

            <!-- Statutory Contributions Schedule -->
            <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0;">
                <h3 style="margin: 0 0 16px 0; font-size: 1.05rem; color: #1e1b4b; font-weight: 700;">Government Identifiers & Contributions</h3>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; font-size: 0.88rem;">
                    <div style="background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <span style="font-size: 0.75rem; color: #64748b; font-weight: 700;">SSS NUMBER</span>
                        <div style="font-weight: 700; color: #0f172a; margin-top: 2px;"><%= employee.sssNumber || 'Not configured' %></div>
                    </div>
                    <div style="background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <span style="font-size: 0.75rem; color: #64748b; font-weight: 700;">PHILHEALTH NUMBER</span>
                        <div style="font-weight: 700; color: #0f172a; margin-top: 2px;"><%= employee.philhealthNumber || 'Not configured' %></div>
                    </div>
                    <div style="background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0;">
                        <span style="font-size: 0.75rem; color: #64748b; font-weight: 700;">PAG-IBIG (HDMF) #</span>
                        <div style="font-weight: 700; color: #0f172a; margin-top: 2px;"><%= employee.pagibigNumber || 'Not configured' %></div>
                    </div>
                    <div style="background: #f8fafc; padding: 10px; border-radius: 8px; border: 1px solid #e2e8f0; position: relative;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.75rem; color: #64748b; font-weight: 700;">BIR TIN #</span>
                            <% if (typeof isMgmt !== 'undefined' && isMgmt) { %>
                                <button type="button" onclick="openQuickTinPrompt()" style="background: none; border: none; color: #4f46e5; font-size: 0.74rem; font-weight: 700; cursor: pointer; padding: 0; display: inline-flex; align-items: center; gap: 2px;">
                                    ✏️ Edit
                                </button>
                            <% } %>
                        </div>
                        <div id="displayEmpTin" style="font-weight: 700; color: #0f172a; margin-top: 2px; font-family: monospace;"><%= employee.tinNumber || 'Not configured' %></div>
                    </div>
                </div>

                <h4 style="margin: 0 0 10px 0; font-size: 0.95rem; color: #1e1b4b;">Statutory Monthly Shares (2024 Table)</h4>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
                    <thead>
                        <tr style="border-bottom: 1px solid #cbd5e1; text-align: left; color: #64748b;">
                            <th style="padding: 6px 0;">Agency</th>
                            <th style="padding: 6px 0; text-align: right;">Employee</th>
                            <th style="padding: 6px 0; text-align: right;">Employer</th>
                            <th style="padding: 6px 0; text-align: right;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 6px 0;">SSS + EC</td>
                            <td style="padding: 6px 0; text-align: right; color: #dc2626;">₱<%= statutory.sss.fullMonthlyEE %></td>
                            <td style="padding: 6px 0; text-align: right; color: #4338ca;">₱<%= statutory.sss.fullMonthlyER %></td>
                            <td style="padding: 6px 0; text-align: right; font-weight: 700;">₱<%= (statutory.sss.fullMonthlyEE + statutory.sss.fullMonthlyER).toFixed(2) %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 6px 0;">PhilHealth</td>
                            <td style="padding: 6px 0; text-align: right; color: #dc2626;">₱<%= statutory.philhealth.fullMonthlyEE %></td>
                            <td style="padding: 6px 0; text-align: right; color: #4338ca;">₱<%= statutory.philhealth.fullMonthlyER %></td>
                            <td style="padding: 6px 0; text-align: right; font-weight: 700;">₱<%= (statutory.philhealth.fullMonthlyEE + statutory.philhealth.fullMonthlyER).toFixed(2) %></td>
                        </tr>
                        <tr style="border-bottom: 1px solid #f1f5f9;">
                            <td style="padding: 6px 0;">Pag-IBIG</td>
                            <td style="padding: 6px 0; text-align: right; color: #dc2626;">₱<%= statutory.pagibig.fullMonthlyEE %></td>
                            <td style="padding: 6px 0; text-align: right; color: #4338ca;">₱<%= statutory.pagibig.fullMonthlyER %></td>
                            <td style="padding: 6px 0; text-align: right; font-weight: 700;">₱<%= (statutory.pagibig.fullMonthlyEE + statutory.pagibig.fullMonthlyER).toFixed(2) %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tab 3: Payroll History -->
    <div id="tab-payrolls" class="tab-pane" style="display: none;">
        <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden;">
            <% if (payrolls.length === 0) { %>
                <div style="padding: 40px; text-align: center; color: #94a3b8;">
                    No payroll computed for this employee yet.
                </div>
            <% } else { %>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 12px 18px;">Period</th>
                            <th style="padding: 12px 18px; text-align: right;">Gross Pay</th>
                            <th style="padding: 12px 18px; text-align: right;">Total Deductions</th>
                            <th style="padding: 12px 18px; text-align: right;">Net Pay</th>
                            <th style="padding: 12px 18px; text-align: center;">Status</th>
                            <th style="padding: 12px 18px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% payrolls.forEach(p => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px 18px; color: #0f172a; font-weight: 600;">
                                    <%= p.payPeriodStart.slice(0, 10) %> to <%= p.payPeriodEnd.slice(0, 10) %>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; color: #0f172a;">₱<%= (Number(p.grossPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 12px 18px; text-align: right; color: #dc2626;">-₱<%= (Number(p.totalDeductions) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 12px 18px; text-align: right; font-weight: 700; color: #059669;">₱<%= (Number(p.netPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 12px 18px; text-align: center;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; <%= p.status === 'Approved' ? 'background: #dcfce7; color: #166534;' : 'background: #fef3c7; color: #92400e;' %>">
                                        <%= p.status %>
                                    </span>
                                </td>
                                <td style="padding: 12px 18px; text-align: center; white-space: nowrap;">
                                    <a href="/hr/payroll/<%= p.id %>" style="color: #4f46e5; text-decoration: none; font-weight: 600; font-size: 0.82rem; margin-right: 6px;">Details</a>
                                    <a href="/hr/print/payslip/<%= p.id %>" target="_blank" style="color: #059669; text-decoration: none; font-weight: 600; font-size: 0.82rem;">Print 🖨️</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>

    <!-- Tab 4: Documents & Tax Forms -->
    <div id="tab-documents" class="tab-pane" style="display: none;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="margin: 0; font-size: 1.05rem; color: #1e1b4b; font-weight: 700;">Uploaded Documents & Compliance</h3>
            <button onclick="document.getElementById('uploadDocModal').style.display='flex'" class="btn btn-primary btn-small" style="padding: 6px 14px; background: #4f46e5; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                + Upload Document
            </button>
        </div>

        <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden;">
            <% if (documents.length === 0) { %>
                <div style="padding: 40px; text-align: center; color: #94a3b8;">
                    No documents uploaded yet (Contracts, Tax Form 2316, NBI clearances, etc.)
                </div>
            <% } else { %>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 10px 18px;">Type</th>
                            <th style="padding: 10px 18px;">Title</th>
                            <th style="padding: 10px 18px;">Period</th>
                            <th style="padding: 10px 18px;">Uploaded Date</th>
                            <th style="padding: 10px 18px; text-align: center;">File</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% documents.forEach(d => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 10px 18px;">
                                    <span style="display: inline-block; padding: 2px 7px; border-radius: 4px; font-size: 0.75rem; font-weight: 700; background: #e0e7ff; color: #3730a3;">
                                        <%= d.documentType %>
                                    </span>
                                </td>
                                <td style="padding: 10px 18px; font-weight: 600; color: #0f172a;"><%= d.title %></td>
                                <td style="padding: 10px 18px; color: #64748b;"><%= d.forPeriod || '—' %></td>
                                <td style="padding: 10px 18px; color: #64748b;"><%= d.createdAt ? d.createdAt.slice(0, 10) : '' %></td>
                                <td style="padding: 10px 18px; text-align: center;">
                                    <% if (d.filePath) { %>
                                        <a href="<%= d.filePath %>" target="_blank" style="color: #4f46e5; text-decoration: none; font-weight: 600;">View ↗</a>
                                    <% } else { %>—<% } %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>

    <!-- Tab 5: Leaves -->
    <div id="tab-leaves" class="tab-pane" style="display: none;">
        <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; overflow: hidden;">
            <% if (leaves.length === 0) { %>
                <div style="padding: 40px; text-align: center; color: #94a3b8;">
                    No leave requests on record for this employee.
                </div>
            <% } else { %>
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 10px 18px;">Type</th>
                            <th style="padding: 10px 18px;">Start Date</th>
                            <th style="padding: 10px 18px;">End Date</th>
                            <th style="padding: 10px 18px;">Days</th>
                            <th style="padding: 10px 18px;">Reason</th>
                            <th style="padding: 10px 18px; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% leaves.forEach(l => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 10px 18px; font-weight: 600; color: #0f172a;"><%= l.leaveType %></td>
                                <td style="padding: 10px 18px; color: #64748b;"><%= l.startDate %></td>
                                <td style="padding: 10px 18px; color: #64748b;"><%= l.endDate %></td>
                                <td style="padding: 10px 18px; font-weight: 700;"><%= l.totalDays %></td>
                                <td style="padding: 10px 18px; color: #475569;"><%= l.reason || '—' %></td>
                                <td style="padding: 10px 18px; text-align: center;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; <%= l.status === 'Approved' ? 'background: #dcfce7; color: #166534;' : (l.status === 'Rejected' ? 'background: #fee2e2; color: #991b1b;' : 'background: #fef3c7; color: #92400e;') %>">
                                        <%= l.status %>
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div>

<!-- Modal: Upload Document -->
<div id="uploadDocModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 500px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
        <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #1e1b4b;">Upload HR Document</h3>
            <button onclick="document.getElementById('uploadDocModal').style.display='none'" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #94a3b8;">✕</button>
        </div>
        <form action="/hr/documents/upload" method="POST" enctype="multipart/form-data" style="padding: 24px;">
            <input type="hidden" name="employeeId" value="<%= employee.id %>">

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Document Type *</label>
                <select name="documentType" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; background: #fff;">
                    <option value="TaxForm">BIR Form 2316 (Annual Tax Return)</option>
                    <option value="Contract">Employment Contract / MOA</option>
                    <option value="NBI">NBI / Police Clearance</option>
                    <option value="MedCert">Medical Certificate / Fit to Work</option>
                    <option value="Memo">Company Memo / Notice</option>
                    <option value="Other">Other Document</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Title *</label>
                <input type="text" name="title" required placeholder="e.g. 2024 Signed BIR 2316" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Year / Period (Optional)</label>
                <input type="text" name="forPeriod" placeholder="e.g. 2024" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">File (PDF, PNG, JPG) *</label>
                <input type="file" name="documentFile" required style="width: 100%; font-size: 0.85rem;">
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('uploadDocModal').style.display='none'" style="padding: 10px 18px; border: 1px solid #cbd5e1; background: #fff; color: #475569; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel</button>
                <button type="submit" style="padding: 10px 22px; background: #4f46e5; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Upload</button>
            </div>
        </form>
    </div>
</div>

<script>
    function switchTab(name) {
        document.querySelectorAll('.tab-pane').forEach(el => el.style.display = 'none');
        document.querySelectorAll('.profile-tab').forEach(el => {
            el.style.borderBottomColor = 'transparent';
            el.style.color = '#64748b';
            el.style.fontWeight = '600';
        });

        const activePane = document.getElementById('tab-' + name);
        const activeBtn = document.getElementById('tab-btn-' + name);
        if (activePane) activePane.style.display = 'block';
        if (activeBtn) {
            activeBtn.style.borderBottomColor = '#4f46e5';
            activeBtn.style.color = '#4f46e5';
            activeBtn.style.fontWeight = '700';
        }
    }

    <% if (typeof isMgmt !== 'undefined' && isMgmt) { %>
    async function openQuickTinPrompt() {
        const current = '<%= employee.tinNumber || '' %>';
        const newTin = prompt('Enter new BIR TIN for <%= employee.name %> (e.g. 123-456-789-000):', current);
        if (newTin === null) return;
        try {
            const res = await fetch('/hr/employees/<%= employee.id %>/quick-tin', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ tinNumber: newTin })
            });
            const data = await res.json();
            if (data.success) {
                document.getElementById('displayEmpTin').textContent = data.tinNumber || 'Not configured';
                alert('✓ BIR TIN updated successfully!');
            } else {
                alert(data.error || 'Failed to update TIN');
            }
        } catch (e) {
            alert('Network error updating TIN');
        }
    }
    <% } %>
</script>
