<div style="width: 100%; box-sizing: border-box;">
    <%
      const empTotal = (typeof totalEmployees !== 'undefined') ? totalEmployees : (typeof employees !== 'undefined' && Array.isArray(employees) ? employees.length : 0);
      const pendingLeavesCnt = (typeof pendingLeavesCount !== 'undefined') ? pendingLeavesCount : (typeof pendingLeaves !== 'undefined' && Array.isArray(pendingLeaves) ? pendingLeaves.length : 0);
      const activeEmpCnt = (typeof activeEmployeesCount !== 'undefined') ? activeEmployeesCount : empTotal;
    %>
    <!-- Top Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <h2 style="margin: 0; font-size: 1.6rem; color: #1e1b4b; font-weight: 700; display: flex; align-items: center; gap: 10px;">
                <span style="background: #4f46e5; color: white; border-radius: 8px; width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem;">👥</span>
                HR & Payroll Management
            </h2>
            <p style="margin: 4px 0 0 0; color: #64748b; font-size: 0.9rem;">
                Employee profiles, compensation & statutory contributions, payroll processing, and staff documentation
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <% if (typeof isMgmt !== 'undefined' && isMgmt) { %>
            <button type="button" onclick="openLabTaxModal()" class="btn btn-secondary" style="padding: 8px 16px; background: #e0e7ff; color: #4338ca; border: 1px solid #c7d2fe; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                <span>🏛️</span> Tax &amp; BIR Settings
            </button>
            <% } %>
            <a href="/hr/payroll/compute" class="btn btn-primary" style="padding: 8px 16px; background: #4f46e5; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>⚡</span> Run Payroll
            </a>
            <a href="/hr/employees/new" class="btn btn-secondary" style="padding: 8px 16px; background: #f1f5f9; color: #1e293b; border: 1px solid #cbd5e1; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>➕</span> New Employee
            </a>
            <a href="/costing" class="btn" style="padding: 8px 16px; background: #0f172a; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>💰</span> Costing Panel →
            </a>
        </div>
    </div>

    <!-- HR Navigation Bar with Indigo Identity -->
    <div style="display: flex; gap: 8px; margin-bottom: 24px; border-bottom: 2px solid #e0e7ff; padding-bottom: 12px; overflow-x: auto;">
        <a href="/hr" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #4f46e5; color: white;">Dashboard</a>
        <a href="/hr/employees" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">Employees (<%= empTotal %>)</a>
        <a href="/hr/payroll" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">Payroll Register</a>
        <a href="/hr/leaves" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">
            Leaves <% if (pendingLeavesCnt > 0) { %><span style="background: #ef4444; color: white; border-radius: 10px; padding: 1px 6px; font-size: 0.72rem;"><%= pendingLeavesCnt %></span><% } %>
        </a>
        <a href="/hr/documents" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">Documents & Tax Forms</a>
        <a href="/hr/my/dtr" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">⏱️ Time Records (DTR)</a>
        <a href="/hr/my" style="padding: 8px 16px; border-radius: 20px; font-size: 0.88rem; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #4f46e5; margin-left: auto;">👤 View My Portal</a>
    </div>

    <!-- 4 Summary KPI Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; margin-bottom: 28px;">
        <!-- Active Employees -->
        <div style="background: white; border-radius: 14px; padding: 20px; border: 1px solid #e0e7ff; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Active Headcount</span>
                <span style="background: rgba(79, 70, 229, 0.12); color: #4f46e5; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">Personnel</span>
            </div>
            <div style="font-size: 2rem; font-weight: 800; color: #1e1b4b;">
                <%= activeEmployeesCount %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">/ <%= totalEmployees %> staff</span>
            </div>
            <% 
                const separatedCount = (employees || []).filter(e => e.employmentStatus === 'Resigned' || e.employmentStatus === 'AWOL' || e.employmentStatus === 'Terminated').length;
            %>
            <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">
                <%= activeEmployeesCount %> Active <%= separatedCount > 0 ? ('• ' + separatedCount + ' Resigned / AWOL') : '• 0 Separated' %>
            </div>
        </div>

        <!-- Monthly Payroll Projection / Actual -->
        <div style="background: white; border-radius: 14px; padding: 20px; border: 1px solid #e0e7ff; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase;">
                    <%= (recentPayrolls && recentPayrolls.length > 0) ? 'Processed Payroll' : 'Monthly Base Payroll' %>
                </span>
                <span style="background: rgba(16, 185, 129, 0.12); color: #059669; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">
                    <%= (recentPayrolls && recentPayrolls.length > 0) ? (recentPayrolls.length + ' Staff Processed') : 'Base Projection' %>
                </span>
            </div>
            <div style="font-size: 1.85rem; font-weight: 800; color: #059669;">
                ₱<%= ((recentPayrolls && recentPayrolls.length > 0) ? actualGrossPay : projectedMonthlyPayroll).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">
                <%= (recentPayrolls && recentPayrolls.length > 0) ? ('Actual gross salaries for ' + currentMonth) : 'Monthly basic pay + recurring allowances' %>
            </div>
        </div>

        <!-- Employer Gov Contributions -->
        <div style="background: white; border-radius: 14px; padding: 20px; border: 1px solid #e0e7ff; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Employer Gov Shares</span>
                <span style="background: rgba(245, 158, 11, 0.12); color: #d97706; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">Statutory</span>
            </div>
            <div style="font-size: 1.85rem; font-weight: 800; color: #d97706;">
                ₱<%= ((recentPayrolls && recentPayrolls.length > 0) ? actualEmployerContributions : totalEmployerContributions).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">
                SSS + PhilHealth + Pag-IBIG ER shares
            </div>
        </div>

        <!-- Total Personnel Cost -->
        <div style="background: white; border-radius: 14px; padding: 20px; border: 1px solid #e0e7ff; box-shadow: 0 4px 12px rgba(79, 70, 229, 0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.82rem; font-weight: 700; color: #64748b; text-transform: uppercase;">Full Personnel Cost</span>
                <span style="background: rgba(79, 70, 229, 0.12); color: #4f46e5; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700;">Total P&L</span>
            </div>
            <div style="font-size: 1.85rem; font-weight: 800; color: #4f46e5;">
                ₱<%= ((recentPayrolls && recentPayrolls.length > 0) ? actualMonthlyCost : (projectedMonthlyPayroll + totalEmployerContributions)).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
            </div>
            <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">
                Automatically reflected in Costing module
            </div>
        </div>
    </div>

    <!-- Main Grid: Department Distribution & Recent Payrolls -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px;">
        <!-- Staff by Department -->
        <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1e1b4b;">Staff by Department</h3>
                <a href="/hr/employees" style="font-size: 0.82rem; color: #4f46e5; font-weight: 600; text-decoration: none;">View Directory →</a>
            </div>
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <% Object.entries(departmentCounts).forEach(([dept, count]) => { %>
                    <div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.88rem; font-weight: 600; margin-bottom: 4px;">
                            <span style="color: #334155;"><%= dept %></span>
                            <span style="color: #4f46e5;"><%= count %> staff</span>
                        </div>
                        <div style="background: #f1f5f9; height: 8px; border-radius: 4px; overflow: hidden;">
                            <div style="background: #4f46e5; height: 100%; width: <%= activeEmployeesCount > 0 ? (count / activeEmployeesCount) * 100 : 0 %>%;"></div>
                        </div>
                    </div>
                <% }) %>
                <% if (Object.keys(departmentCounts).length === 0) { %>
                    <div style="color: #94a3b8; text-align: center; padding: 20px;">No departments registered yet.</div>
                <% } %>
            </div>
        </div>

        <!-- Pending Leave Requests -->
        <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1e1b4b;">Pending Leave Approvals</h3>
                <a href="/hr/leaves" style="font-size: 0.82rem; color: #4f46e5; font-weight: 600; text-decoration: none;">All Leaves (<%= pendingLeavesCount %>) →</a>
            </div>

            <% if (pendingLeaves.length === 0) { %>
                <div style="padding: 30px; text-align: center; color: #94a3b8; font-size: 0.9rem;">
                    ✅ All leave requests are up to date. No pending approvals.
                </div>
            <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <% pendingLeaves.forEach(l => { %>
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px;">
                            <div>
                                <div style="font-weight: 700; color: #0f172a; font-size: 0.88rem;"><%= l.employeeName || (l.getEmployee && l.getEmployee()?.name) || 'Employee' %></div>
                                <div style="font-size: 0.78rem; color: #64748b;">
                                    <%= l.leaveType %> Leave • <%= l.totalDays %> day(s) (<%= l.startDate %>)
                                </div>
                            </div>
                            <div style="display: flex; gap: 6px;">
                                <form action="/hr/leaves/<%= l.id %>/approve" method="POST" style="display: inline;">
                                    <button type="submit" style="padding: 4px 10px; background: #10b981; color: white; border: none; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer;">Approve</button>
                                </form>
                                <form action="/hr/leaves/<%= l.id %>/reject" method="POST" style="display: inline;">
                                    <button type="submit" style="padding: 4px 10px; background: #ef4444; color: white; border: none; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer;">Reject</button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Recent Payroll Runs -->
    <div style="background: white; border-radius: 14px; padding: 22px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1e1b4b;">Recent Payroll Computations (<%= currentMonth %>)</h3>
            <a href="/hr/payroll?month=<%= currentMonth %>" style="font-size: 0.82rem; color: #4f46e5; font-weight: 600; text-decoration: none;">View Payroll Register →</a>
        </div>
        <% if (recentPayrolls.length === 0) { %>
            <div style="padding: 30px; text-align: center; color: #94a3b8; font-size: 0.9rem;">
                No payroll calculated for <%= currentMonth %> yet.
                <div style="margin-top: 10px;">
                    <a href="/hr/payroll/compute" style="color: #4f46e5; font-weight: 700;">+ Run Payroll Computation</a>
                </div>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.78rem; text-transform: uppercase;">
                            <th style="padding: 10px 14px;">Employee</th>
                            <th style="padding: 10px 14px;">Period</th>
                            <th style="padding: 10px 14px; text-align: right;">Gross Pay</th>
                            <th style="padding: 10px 14px; text-align: right;">Total Deductions</th>
                            <th style="padding: 10px 14px; text-align: right;">Net Pay</th>
                            <th style="padding: 10px 14px; text-align: center;">Status</th>
                            <th style="padding: 10px 14px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPayrolls.forEach(p => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 10px 14px; font-weight: 600; color: #0f172a;"><%= p.employeeName || (p.getEmployee && p.getEmployee()?.name) || 'Staff' %></td>
                                <td style="padding: 10px 14px; color: #64748b;"><%= p.payPeriodStart.slice(0, 10) %> to <%= p.payPeriodEnd.slice(0, 10) %></td>
                                <td style="padding: 10px 14px; text-align: right; color: #0f172a;">₱<%= (Number(p.grossPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 10px 14px; text-align: right; color: #dc2626;">-₱<%= (Number(p.totalDeductions) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 10px 14px; text-align: right; font-weight: 700; color: #059669;">₱<%= (Number(p.netPay) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %></td>
                                <td style="padding: 10px 14px; text-align: center;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; <%= p.status === 'Approved' ? 'background: #dcfce7; color: #166534;' : (p.status === 'Paid' ? 'background: #e0e7ff; color: #3730a3;' : 'background: #fef3c7; color: #92400e;') %>">
                                        <%= p.status %>
                                    </span>
                                </td>
                                <td style="padding: 10px 14px; text-align: center;">
                                    <a href="/hr/payroll/<%= p.id %>" style="color: #4f46e5; text-decoration: none; font-weight: 600; font-size: 0.82rem;">Details →</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Laboratory Tax Profile & Employee TIN Management Modal -->
    <div id="labTaxModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.65); z-index: 9999; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
        <div style="background: white; border-radius: 16px; max-width: 680px; width: 94%; max-height: 90vh; overflow-y: auto; padding: 26px; box-shadow: 0 25px 50px rgba(0,0,0,0.25); border: 1px solid #cbd5e1;">
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; border-bottom: 1.5px solid #e2e8f0; padding-bottom: 14px;">
                <div>
                    <h3 style="margin: 0; font-size: 1.3rem; color: #1e1b4b; font-weight: 800; display: flex; align-items: center; gap: 10px;">
                        <span>🏛️</span> Laboratory Tax Profile &amp; Employee TINs
                    </h3>
                    <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: #64748b;">
                        Configure official BIR details for Gezyne Clinical Laboratory and update employee tax numbers.
                    </p>
                </div>
                <button type="button" onclick="closeLabTaxModal()" style="background: none; border: none; font-size: 1.5rem; color: #94a3b8; cursor: pointer; padding: 0 4px; line-height: 1;">&times;</button>
            </div>

            <!-- Tab / Section 1: Laboratory Employer Tax Settings -->
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px; margin-bottom: 24px;">
                <h4 style="margin: 0 0 12px 0; font-size: 0.95rem; color: #1e1b4b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                    <span>🏢</span> Laboratory BIR Employer Registration
                </h4>
                
                <form id="labTaxForm" onsubmit="submitLabTaxSettings(event)">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">LABORATORY BIR TIN</label>
                            <input type="text" id="settingLabTin" name="labTin" value="<%= (typeof labTin !== 'undefined' && labTin) ? labTin : '009-876-543-000' %>" placeholder="e.g. 009-876-543-000" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-family: monospace; font-weight: 700; color: #0f172a; box-sizing: border-box;">
                            <span style="font-size: 0.72rem; color: #64748b;">Used in Part II (Item 12) of BIR Form 2316</span>
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">REGISTERED NAME</label>
                            <input type="text" id="settingLabName" name="labName" value="<%= (typeof labName !== 'undefined' && labName) ? labName : 'GEZYNE CLINICAL LABORATORY' %>" placeholder="GEZYNE CLINICAL LABORATORY" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 600; color: #0f172a; box-sizing: border-box;">
                        </div>
                    </div>

                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">REGISTERED ADDRESS</label>
                        <input type="text" id="settingLabAddress" name="labAddress" value="<%= (typeof labAddress !== 'undefined' && labAddress) ? labAddress : '0330 Vergel De Dios St., Poblacion, Plaridel, Bulacan' %>" placeholder="Registered Address" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; color: #0f172a; box-sizing: border-box;">
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">RDO CODE</label>
                            <input type="text" id="settingLabRdo" name="labRdoCode" value="<%= (typeof labRdoCode !== 'undefined' && labRdoCode) ? labRdoCode : '025' %>" placeholder="e.g. 025" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-family: monospace; font-weight: 700; color: #0f172a; box-sizing: border-box;">
                        </div>
                        <div>
                            <label style="display: block; font-size: 0.8rem; font-weight: 700; color: #334155; margin-bottom: 4px;">ZIP CODE</label>
                            <input type="text" id="settingLabZip" name="labZipCode" value="<%= (typeof labZipCode !== 'undefined' && labZipCode) ? labZipCode : '3004' %>" placeholder="e.g. 3004" style="width: 100%; padding: 9px 12px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-family: monospace; font-weight: 700; color: #0f172a; box-sizing: border-box;">
                        </div>
                    </div>

                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span id="labTaxMsg" style="font-size: 0.82rem; font-weight: 600;"></span>
                        <button type="submit" id="btnSaveLabTax" style="padding: 8px 18px; background: #009957; color: white; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 0.85rem; box-shadow: 0 2px 5px rgba(0, 153, 87, 0.3);">
                            💾 Save Lab Tax Profile
                        </button>
                    </div>
                </form>
            </div>

            <!-- Section 2: Employee TIN Quick Manager -->
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <h4 style="margin: 0; font-size: 0.95rem; color: #1e1b4b; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px;">
                        <span>👥</span> Employee BIR TIN Quick Manager
                    </h4>
                    <span style="font-size: 0.78rem; color: #64748b;">
                        Update individual employee TINs directly
                    </span>
                </div>

                <div style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; max-height: 260px; overflow-y: auto;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.84rem; text-align: left;">
                        <thead style="background: #f1f5f9; border-bottom: 1px solid #cbd5e1; position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th style="padding: 8px 12px; color: #475569;">Employee</th>
                                <th style="padding: 8px 12px; color: #475569;">Department</th>
                                <th style="padding: 8px 12px; color: #475569;">BIR TIN</th>
                                <th style="padding: 8px 12px; text-align: center; color: #475569;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof employees !== 'undefined' && employees) { %>
                                <% employees.forEach(function(emp) { %>
                                    <tr style="border-bottom: 1px solid #f1f5f9;">
                                        <td style="padding: 8px 12px; font-weight: 600; color: #1e293b;">
                                            <%= emp.name %>
                                            <div style="font-size: 0.72rem; color: #64748b;"><%= emp.employeeCode %></div>
                                        </td>
                                        <td style="padding: 8px 12px; color: #64748b; font-size: 0.78rem;"><%= emp.department %></td>
                                        <td style="padding: 8px 12px;">
                                            <input type="text" id="empTin_<%= emp.id %>" value="<%= emp.tinNumber || '' %>" placeholder="e.g. 123-456-789-000" style="padding: 5px 8px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 0.82rem; font-family: monospace; font-weight: 600; width: 140px;">
                                        </td>
                                        <td style="padding: 8px 12px; text-align: center;">
                                            <button type="button" onclick="saveIndividualTin('<%= emp.id %>', this)" style="padding: 5px 12px; background: #4f46e5; color: white; border: none; border-radius: 6px; font-size: 0.78rem; font-weight: 600; cursor: pointer;">
                                                Save
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end; margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 14px;">
                <button type="button" onclick="closeLabTaxModal()" style="padding: 8px 20px; background: #f1f5f9; color: #475569; border: 1px solid #cbd5e1; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

<script>
function openLabTaxModal() {
    document.getElementById('labTaxModal').style.display = 'flex';
}

function closeLabTaxModal() {
    document.getElementById('labTaxModal').style.display = 'none';
}

async function submitLabTaxSettings(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSaveLabTax');
    const msg = document.getElementById('labTaxMsg');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const payload = {
        labTin: document.getElementById('settingLabTin').value,
        labName: document.getElementById('settingLabName').value,
        labAddress: document.getElementById('settingLabAddress').value,
        labRdoCode: document.getElementById('settingLabRdo').value,
        labZipCode: document.getElementById('settingLabZip').value
    };

    try {
        const res = await fetch('/hr/settings/lab-tax-info', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            msg.style.color = '#16a34a';
            msg.textContent = '✓ Laboratory Tax Settings Saved!';
            setTimeout(() => { msg.textContent = ''; }, 3000);
        } else {
            msg.style.color = '#dc2626';
            msg.textContent = data.error || 'Failed to save';
        }
    } catch (err) {
        msg.style.color = '#dc2626';
        msg.textContent = 'Network error saving settings';
    } finally {
        btn.disabled = false;
        btn.textContent = '💾 Save Lab Tax Profile';
    }
}

async function saveIndividualTin(empId, btn) {
    const input = document.getElementById('empTin_' + empId);
    if (!input) return;
    const oldText = btn.textContent;
    btn.disabled = true;
    btn.textContent = '...';

    try {
        const res = await fetch('/hr/employees/' + empId + '/quick-tin', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({ tinNumber: input.value })
        });
        const data = await res.json();
        if (data.success) {
            btn.style.background = '#059669';
            btn.textContent = '✓ Saved';
            setTimeout(() => {
                btn.style.background = '#4f46e5';
                btn.textContent = 'Save';
                btn.disabled = false;
            }, 1800);
        } else {
            alert(data.error || 'Failed to save employee TIN');
            btn.textContent = oldText;
            btn.disabled = false;
        }
    } catch (err) {
        alert('Network error saving TIN');
        btn.textContent = oldText;
        btn.disabled = false;
    }
}
</script>
