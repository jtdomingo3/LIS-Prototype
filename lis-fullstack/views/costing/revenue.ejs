<div style="width: 100%; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <a href="/costing?month=<%= selectedMonth %>" style="color: #64748b; text-decoration: none; font-size: 1.2rem;">←</a>
                <h2 style="margin: 0; font-size: 1.5rem; color: #0f172a; font-weight: 700;">Revenue Details Log</h2>
            </div>
            <p style="margin: 4px 0 0 28px; color: #64748b; font-size: 0.88rem;">
                Historical earnings breakdown from completed patient transactions (Cash, PhilHealth, Health Cards)
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <form action="/costing/revenue" method="GET" style="display: flex; align-items: center; gap: 8px;">
                <label for="monthPicker" style="font-size: 0.85rem; font-weight: 600; color: #475569;">Month:</label>
                <input type="month" id="monthPicker" name="month" value="<%= selectedMonth %>" onchange="this.form.submit()" style="padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 600; color: #0f172a; background: #fff;">
            </form>
            <a href="/costing/export/excel?month=<%= selectedMonth %>&type=pnl" class="btn btn-primary btn-small" style="padding: 8px 14px; background: #10b981; color: white; border-radius: 8px; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                <span>📥</span> Export
            </a>
        </div>
    </div>

    <!-- Summary Metrics Bar -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 22px;">
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Total Collections</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #059669; margin-top: 4px;">₱<%= totalRev.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Clinical Laboratory</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #0f172a; margin-top: 4px;">₱<%= totalClin.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Radiology / X-Ray</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #0f172a; margin-top: 4px;">₱<%= totalXray.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></div>
        </div>
        <div style="background: white; border-radius: 12px; padding: 16px; border: 1px solid #e2e8f0;">
            <div style="font-size: 0.78rem; font-weight: 600; color: #64748b; text-transform: uppercase;">Transactions</div>
            <div style="font-size: 1.45rem; font-weight: 800; color: #3b82f6; margin-top: 4px;"><%= entries.length %></div>
        </div>
    </div>

    <!-- Revenue Entries Table -->
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04); overflow: hidden;">
        <% if (entries.length === 0) { %>
            <div style="padding: 50px 20px; text-align: center; color: #94a3b8;">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">🧾</div>
                <div style="font-weight: 600; font-size: 1rem; color: #475569;">No revenue records found for <%= selectedMonth %></div>
                <p style="font-size: 0.85rem; margin: 4px 0 16px 0;">Transactions recorded at reception Payment Area will automatically appear here.</p>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.8rem; text-transform: uppercase;">
                            <th style="padding: 12px 18px;">Date & Time</th>
                            <th style="padding: 12px 18px;">Method</th>
                            <th style="padding: 12px 18px; text-align: right;">Clinical</th>
                            <th style="padding: 12px 18px; text-align: right;">X-Ray</th>
                            <th style="padding: 12px 18px; text-align: right;">Discount</th>
                            <th style="padding: 12px 18px; text-align: right;">Total Amount</th>
                            <th style="padding: 12px 18px;">Recorded By</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% entries.forEach(r => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px 18px; color: #475569; white-space: nowrap;">
                                    <%= r.revenueDate ? new Date(r.revenueDate).toLocaleDateString() : '' %>
                                    <span style="font-size: 0.78rem; color: #94a3b8;"><%= r.revenueDate ? new Date(r.revenueDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '' %></span>
                                </td>
                                <td style="padding: 12px 18px;">
                                    <span style="display: inline-block; padding: 2px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 700; background: <%= r.paymentMethod.includes('PhilHealth') ? '#dcfce7; color: #166534;' : (r.paymentMethod.includes('Health') ? '#e0e7ff; color: #3730a3;' : '#f1f5f9; color: #334155;') %>">
                                        <%= r.paymentMethod %>
                                    </span>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; color: #475569;">
                                    ₱<%= (Number(r.clinicalAmount) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; color: #475569;">
                                    ₱<%= (Number(r.xrayAmount) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; color: <%= r.discountAmount > 0 ? '#dc2626' : '#94a3b8' %>;">
                                    <%= r.discountAmount > 0 ? '-₱' + Number(r.discountAmount).toLocaleString('en-US', { minimumFractionDigits: 2 }) : '—' %>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; font-weight: 700; color: #059669;">
                                    ₱<%= (Number(r.totalAmount) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 18px; color: #64748b; font-size: 0.82rem;">
                                    <%= r.recordedBy || 'System' %>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>
