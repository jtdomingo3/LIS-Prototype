<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title || 'Levey-Jennings Quality Control Report' %></title>
  <style>
    @page {
      size: letter portrait;
      margin: 0.35in;
    }
    *, *:before, *:after { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 0;
      background: #f1f5f9;
      font-family: 'Times New Roman', Times, serif;
      color: #000;
      font-size: 11px;
    }
    .no-print-bar {
      position: sticky;
      top: 0;
      background: #0f172a;
      color: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 9999;
      box-shadow: 0 2px 8px rgba(0,0,0,0.15);
      font-family: Arial, sans-serif;
      font-size: 13px;
    }
    .no-print-bar button {
      padding: 8px 16px;
      border-radius: 6px;
      font-weight: 600;
      cursor: pointer;
      border: none;
      font-size: 13px;
    }
    .btn-print {
      background: #16a34a;
      color: #fff;
    }
    .btn-back {
      background: #475569;
      color: #fff;
      margin-right: 8px;
    }
    .page {
      width: 8.5in;
      min-height: 11in;
      padding: 0.35in;
      margin: 20px auto;
      background: #fff;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      position: relative;
    }
    @media print {
      body { background: #fff; }
      .no-print { display: none !important; }
      .page {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        min-height: auto !important;
        box-shadow: none !important;
      }
    }
    .header {
      display: flex;
      align-items: flex-start;
      border-bottom: 2px solid #009957;
      padding-bottom: 8px;
      margin-bottom: 10px;
    }
    .logo {
      width: 70px;
      height: auto;
      margin-right: 12px;
    }
    .lab-title {
      flex: 1;
      text-align: center;
    }
    .lab-title h1 {
      margin: 0;
      font-size: 20px;
      color: #009957;
      letter-spacing: 0.5px;
    }
    .lab-sub {
      font-size: 9.5px;
      color: #333;
      margin-top: 2px;
    }
    .report-title-box {
      text-align: center;
      margin: 10px 0;
      padding: 4px;
      background: #f0fdf4;
      border: 1px solid #86efac;
    }
    .report-title {
      font-size: 14px;
      font-weight: bold;
      color: #166534;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .report-subtitle {
      font-size: 9px;
      color: #4b5563;
      margin-top: 2px;
    }
    .meta-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10px;
      margin-bottom: 10px;
    }
    .meta-table td {
      border: 1px solid #000;
      padding: 4px 6px;
      vertical-align: top;
    }
    .meta-label {
      font-weight: bold;
      color: #333;
      width: 25%;
    }
    .stats-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 10px;
      margin-bottom: 10px;
      text-align: center;
    }
    .stats-table th, .stats-table td {
      border: 1px solid #000;
      padding: 4px;
    }
    .stats-table th {
      background: #e2e8f0;
      font-weight: bold;
    }
    .chart-box {
      width: 100%;
      border: 1px solid #000;
      padding: 6px;
      margin-bottom: 10px;
      background: #fff;
    }
    .chart-svg {
      width: 100%;
      height: 250px;
      display: block;
    }
    .runs-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9.5px;
      margin-bottom: 12px;
    }
    .runs-table th, .runs-table td {
      border: 1px solid #000;
      padding: 3px 5px;
    }
    .runs-table th {
      background: #f1f5f9;
      font-weight: bold;
      text-align: left;
    }
    .flag-reject {
      color: #dc2626;
      font-weight: bold;
    }
    .flag-warn {
      color: #d97706;
      font-weight: bold;
    }
    .signatures-grid {
      display: grid;
      gap: 16px;
      margin-top: 25px;
      text-align: center;
      font-size: 9.5px;
    }
    .sig-line {
      border-top: 1px solid #000;
      margin-top: 36px;
      padding-top: 4px;
      font-weight: bold;
    }
    .sig-sub {
      font-size: 8.5px;
      color: #444;
      margin-top: 1px;
    }
  </style>
</head>
<body>

  <%
    const pts = (dataset && dataset.points) ? dataset.points : [];
    const isXray = Boolean(
      equipment && (
        equipment.isXRay ||
        (equipment.department && (equipment.department.toLowerCase().includes('radiolog') || equipment.department.toLowerCase().includes('imaging') || equipment.department.toLowerCase().includes('x-ray'))) ||
        (equipment.category && (equipment.category.toLowerCase().includes('x-ray') || equipment.category.toLowerCase().includes('radiolog') || equipment.category.toLowerCase().includes('imaging')))
      )
    );

    const usersList = (typeof allUsers !== 'undefined' && Array.isArray(allUsers)) ? allUsers : [];

    // Deduplicate staff by name
    const uniqueUsersByName = [];
    const seenNames = new Set();
    usersList.forEach(u => {
      const k = (u.name || '').trim().toLowerCase();
      if (k && !seenNames.has(k)) {
        seenNames.add(k);
        uniqueUsersByName.push(u);
      }
    });

    const medtechs = uniqueUsersByName.filter(u =>
      u.role === 'Medical Technologist' ||
      ((u.name && u.name.includes('RMT')) && u.role !== 'Admin' && u.role !== 'Receptionist')
    );
    const radtechs = uniqueUsersByName.filter(u =>
      u.role === 'X-Ray Technologist' ||
      ((u.name && (u.name.includes('RXT') || u.name.includes('RadTech'))) && u.role !== 'Admin')
    );
    const pathologists = uniqueUsersByName.filter(u =>
      u.role === 'Pathologist' || (u.name && u.name.includes('Espiritu'))
    );
    const radiologists = uniqueUsersByName.filter(u => u.role === 'Radiologist');
    const otherDoctors = uniqueUsersByName.filter(u =>
      (u.role === 'Doctor' || u.role === 'Internist' || (u.name && (u.name.includes('MD') || u.name.includes('M.D.')))) &&
      !pathologists.includes(u) && !radiologists.includes(u)
    );
    const allDoctors = [...pathologists, ...otherDoctors];

    // For Clinical equipment: strictly MedTechs only. For Radiology equipment: strictly RadTechs only.
    const operatorCandidates = isXray
      ? (radtechs.length ? radtechs : [{ name: 'John Kevin R. Estanislao, RXT', licenseNumber: '' }])
      : (medtechs.length ? medtechs : [{ name: 'Gezyne M. Lopez, RMT', licenseNumber: '67820' }]);

    const validatorCandidates = isXray
      ? (radtechs.length ? radtechs : [{ name: 'Chief Radiologic Technologist', licenseNumber: '' }])
      : (medtechs.length ? medtechs : [{ name: 'Jeff Louine Jamir T. Domingo, RMT, PMSDA', licenseNumber: '68285' }]);

    const pathologistCandidates = isXray
      ? (radiologists.length ? radiologists : (allDoctors.length ? allDoctors : [{ name: 'Alberto J. Gabriel, MD, FPCR', licenseNumber: '' }]))
      : (pathologists.length ? pathologists : (allDoctors.length ? allDoctors : [{ name: 'Bernadette R. Espiritu, M.D.', licenseNumber: '75547' }]));

    const pathologist2Candidates = isXray
      ? (radiologists.length ? radiologists : allDoctors)
      : (allDoctors.length ? allDoctors : [{ name: 'Bernadette R. Espiritu, M.D.', licenseNumber: '75547' }]);

    const sigs = (typeof signatories !== 'undefined' && signatories) ? signatories : {
      operatorName: (operatorCandidates[0] && operatorCandidates[0].name) || 'Gezyne M. Lopez, RMT',
      operatorTitle: isXray ? 'Performed By (X-Ray Technologist)' : 'Performed By (Medical Technologist)',
      operatorLicense: (operatorCandidates[0] && operatorCandidates[0].licenseNumber) || '67820',
      validatorName: (validatorCandidates.find(u => u.name && u.name.includes('Domingo')) || validatorCandidates[0] || {}).name || 'Jeff Louine Jamir T. Domingo, RMT, PMSDA',
      validatorTitle: isXray ? 'Reviewed & Verified By (Radiology Supervisor)' : 'Reviewed & Verified By (QC Supervisor)',
      validatorLicense: '68285',
      pathologistName: (pathologistCandidates[0] && pathologistCandidates[0].name) || 'Bernadette R. Espiritu, M.D.',
      pathologistTitle: isXray ? 'Approved By (Radiologist)' : 'Approved By (Head of Laboratory / Pathologist)',
      pathologistLicense: '75547',
      hasPathologist2: false,
      pathologist2Name: '',
      pathologist2Title: isXray ? 'Approved By (Associate Radiologist)' : 'Approved By (Associate Pathologist)',
      pathologist2License: ''
    };
  %>

  <!-- Floating Print Control (Hidden on Print) -->
  <div class="no-print-bar no-print">
    <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
      <div>
        <strong>Gezyne LIS Quality Control</strong> &bull; Levey-Jennings Report (<%= dataset.analyteName %> - <%= dataset.unit %>)
      </div>
      <button type="button" class="btn-sig-toggle" onclick="toggleSigEditor()" style="background: #334155; color: #f8fafc; border: 1px solid #64748b; font-size: 12px; padding: 5px 12px; border-radius: 4px; cursor: pointer;">
        ✍️ Signatories (<span id="sigCountBadge"><%= sigs.hasPathologist2 ? '4 Signatories' : '3 Signatories (1 Pathologist)' %></span>)
      </button>
    </div>
    <div style="display: flex; gap: 8px;">
      <button class="btn-back" onclick="window.close(); history.back();">&larr; Back to Equipment</button>
      <button class="btn-print" onclick="window.print();"><i class="fa fa-print"></i> 🖨️ Print / Save as PDF</button>
    </div>
  </div>

  <!-- Interactive Signatory Dropdown Selection Drawer (Hidden on Print) -->
  <div id="sigEditorDrawer" class="no-print" style="display: none; background: #1e293b; color: #fff; padding: 14px 20px; font-family: Arial, sans-serif; font-size: 12px; border-bottom: 2px solid #0284c7;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; flex-wrap: wrap; gap: 8px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <strong style="color: #38bdf8; font-size: 13px;">Select Report Signatories (<%= isXray ? 'Radiology Section' : 'Clinical Laboratory' %>)</strong>
        <span id="drawerToast" style="display: none; background: #059669; color: #fff; font-size: 11px; padding: 2px 8px; border-radius: 4px; font-weight: 600;"></span>
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <button type="button" onclick="executeAutoRefresh()" style="background: #0284c7; color: #fff; border: 1px solid #38bdf8; font-size: 11px; padding: 4px 10px; border-radius: 4px; cursor: pointer; font-weight: 600;">
          🔄 Refresh Report Now
        </button>
        <button onclick="toggleSigEditor()" style="background: none; border: none; color: #94a3b8; font-size: 16px; cursor: pointer;">&times; Close</button>
      </div>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
      <!-- 1. Operator Dropdown -->
      <div style="background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid #334155;">
        <span style="font-weight: bold; color: #38bdf8; font-size: 11px;">1. Operator (<%= isXray ? 'X-Ray Tech' : 'Medical Technologist' %>)</span>
        <select id="edit_op_select" onchange="onSelectOperator(this)" style="width:100%; margin-top:5px; padding:6px 8px; font-size:12px; border-radius:4px; border:1px solid #475569; background:#fff; color:#000; font-weight:500;">
          <% operatorCandidates.forEach(u => { %>
            <option value="<%= u.name %>" data-license="<%= u.licenseNumber || '' %>" <%= sigs.operatorName === u.name ? 'selected' : '' %>>
              <%= u.name %><%= u.licenseNumber ? ' (PRC: ' + u.licenseNumber + ')' : '' %>
            </option>
          <% }); %>
        </select>
        <div style="font-size: 10.5px; color: #94a3b8; margin-top: 4px;" id="disp_op_lic_badge">PRC License: <%= sigs.operatorLicense || 'None' %></div>
      </div>

      <!-- 2. Validator Dropdown -->
      <div style="background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid #334155;">
        <span style="font-weight: bold; color: #38bdf8; font-size: 11px;">2. Validator (QC Supervisor)</span>
        <select id="edit_val_select" onchange="onSelectValidator(this)" style="width:100%; margin-top:5px; padding:6px 8px; font-size:12px; border-radius:4px; border:1px solid #475569; background:#fff; color:#000; font-weight:500;">
          <% validatorCandidates.forEach(u => { %>
            <option value="<%= u.name %>" data-license="<%= u.licenseNumber || '' %>" <%= sigs.validatorName === u.name ? 'selected' : '' %>>
              <%= u.name %><%= u.licenseNumber ? ' (PRC: ' + u.licenseNumber + ')' : '' %>
            </option>
          <% }); %>
        </select>
        <div style="font-size: 10.5px; color: #94a3b8; margin-top: 4px;" id="disp_val_lic_badge">PRC License: <%= sigs.validatorLicense || 'None' %></div>
      </div>

      <!-- 3. Approving Pathologist Dropdown -->
      <div style="background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid #334155;">
        <span style="font-weight: bold; color: #38bdf8; font-size: 11px;">3. <%= isXray ? 'Radiologist' : 'Approving Pathologist' %></span>
        <select id="edit_p1_select" onchange="onSelectPathologist(this)" style="width:100%; margin-top:5px; padding:6px 8px; font-size:12px; border-radius:4px; border:1px solid #475569; background:#fff; color:#000; font-weight:500;">
          <% pathologistCandidates.forEach(u => { %>
            <option value="<%= u.name %>" data-license="<%= u.licenseNumber || '' %>" <%= sigs.pathologistName === u.name ? 'selected' : '' %>>
              <%= u.name %><%= u.licenseNumber ? ' (PRC: ' + u.licenseNumber + ')' : '' %>
            </option>
          <% }); %>
        </select>
        <div style="font-size: 10.5px; color: #94a3b8; margin-top: 4px;" id="disp_p1_lic_badge">PRC License: <%= sigs.pathologistLicense || 'None' %></div>
      </div>

      <!-- 4. Second Pathologist (Optional) Dropdown -->
      <div style="background: #0f172a; padding: 10px; border-radius: 6px; border: 1px solid #334155;">
        <label style="font-weight: bold; color: #38bdf8; font-size: 11px; cursor: pointer; display: flex; align-items: center; gap: 5px;">
          <input type="checkbox" id="edit_enable_p2" <%= sigs.hasPathologist2 ? 'checked' : '' %> onchange="toggleP2Live(this.checked)">
          <span>4. Second Pathologist</span>
        </label>
        <div id="p2_live_fields" style="display: <%= sigs.hasPathologist2 ? 'block' : 'none' %>; margin-top: 5px;">
          <select id="edit_p2_select" onchange="onSelectPathologist2(this)" style="width:100%; padding:6px 8px; font-size:12px; border-radius:4px; border:1px solid #475569; background:#fff; color:#000; font-weight:500;">
            <option value="">-- Choose 2nd Pathologist --</option>
            <% pathologist2Candidates.forEach(u => { %>
              <option value="<%= u.name %>" data-license="<%= u.licenseNumber || '' %>" <%= sigs.pathologist2Name === u.name ? 'selected' : '' %>>
                <%= u.name %><%= u.licenseNumber ? ' (PRC: ' + u.licenseNumber + ')' : '' %>
              </option>
            <% }); %>
          </select>
          <div style="font-size: 10.5px; color: #94a3b8; margin-top: 4px;" id="disp_p2_lic_badge">PRC License: <%= sigs.pathologist2License || 'None' %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="page">
    <!-- Lab Header -->
    <div class="header">
      <img src="/assets/gezyne-logo.png" class="logo" alt="Logo" onerror="this.style.display='none'">
      <div class="lab-title">
        <h1>GEZYNE CLINICAL LABORATORY</h1>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL, BULACAN</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT &bull; TEL: 0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub"><strong>DOH License No.: 03-435-15CL-20</strong></div>
      </div>
      <div style="font-size: 9px; text-align: right; min-width: 140px;">
        <strong>Date Printed:</strong> <%= new Date().toLocaleDateString() %><br>
        <strong>Time:</strong> <%= new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %><br>
        <strong>Form Ref:</strong> DOH-LIS-IQC-01<br>
        <% if (dataset && dataset.filterRange && (dataset.filterRange.startDate || dataset.filterRange.endDate)) { %>
          <strong>Period:</strong> <%= dataset.filterRange.startDate || 'Start' %> to <%= dataset.filterRange.endDate || 'Present' %><br>
        <% } %>
      </div>
    </div>

    <!-- Report Title -->
    <div class="report-title-box">
      <div class="report-title">
        <%= (dataset && dataset.filterRange && (dataset.filterRange.startDate || dataset.filterRange.endDate)) ? 'INTERNAL QUALITY CONTROL (IQC) REPORT • LEVEY-JENNINGS CHART' : 'MONTHLY INTERNAL QUALITY CONTROL (IQC) REPORT • LEVEY-JENNINGS CHART' %>
      </div>
      <div class="report-subtitle">Compliant with Philippine DOH AO No. 2020-0035, AO No. 2021-0037, and CLSI C24-Ed4 Statistical Quality Control</div>
    </div>

    <!-- Metadata Table -->
    <table class="meta-table">
      <tr>
        <td class="meta-label">Analyzer / Instrument:</td>
        <td><strong><%= equipment ? equipment.name : 'Clinical Chemistry Analyzer' %></strong></td>
        <td class="meta-label">Control Material:</td>
        <td><strong><%= dataset.controlName %></strong></td>
      </tr>
      <tr>
        <td class="meta-label">Asset Code / Tag:</td>
        <td><%= equipment ? equipment.equipmentCode : 'EQ-CHEM-001' %></td>
        <td class="meta-label">Control Lot / Expiry:</td>
        <td><%= dataset.lotNumber %> <%= dataset.expirationDate ? '(Exp: ' + new Date(dataset.expirationDate).toLocaleDateString() + ')' : '' %></td>
      </tr>
      <tr>
        <td class="meta-label">Model & Serial #:</td>
        <td><%= equipment ? (equipment.modelNumber + ' / SN: ' + equipment.serialNumber) : 'BS-240' %></td>
        <td class="meta-label">Control Level:</td>
        <td><%= dataset.level %></td>
      </tr>
      <tr>
        <td class="meta-label">Analyte / Test Parameter:</td>
        <td><strong><%= (dataset.analyteName && dataset.analyteName.includes('(')) ? dataset.analyteName : (dataset.analyteName + (dataset.analyteCode && dataset.analyteCode.length <= 5 && !dataset.analyteName.toUpperCase().includes(dataset.analyteCode.toUpperCase()) ? ' (' + dataset.analyteCode.toUpperCase() + ')' : '')) %></strong></td>
        <td class="meta-label">Target Mean &plusmn; SD:</td>
        <td><strong><%= dataset.targetMean %> &plusmn; <%= dataset.targetSd %> <%= dataset.unit %></strong></td>
      </tr>
      <tr>
        <td class="meta-label">Next Instrument Calibration:</td>
        <td><%= equipment && equipment.nextCalibrationDate ? new Date(equipment.nextCalibrationDate).toLocaleDateString() : 'Active' %></td>
        <td class="meta-label">Allowable Total Error (TEa):</td>
        <td><%= dataset.teaPercent %>% (CLIA / DOH Standard Limit)</td>
      </tr>
    </table>

    <!-- Statistical Performance Table -->
    <% const st = dataset.statistics; %>
    <table class="stats-table">
      <thead>
        <tr>
          <th>Total Runs (N)</th>
          <th>Observed Mean (x̄)</th>
          <th>Observed SD (s)</th>
          <th>CV% (Precision)</th>
          <th>Bias% (Accuracy)</th>
          <th>Total Error (TEobs)</th>
          <th>Allowable TE (TEa)</th>
          <th>Overall Evaluation</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong><%= st.n %></strong></td>
          <td><strong><%= st.observedMean !== null ? st.observedMean : '—' %> <%= dataset.unit %></strong></td>
          <td><%= st.observedSd !== null ? st.observedSd : '—' %></td>
          <td><%= st.cvPercent !== null ? st.cvPercent + '%' : '—' %></td>
          <td><%= st.biasPercent !== null ? st.biasPercent + '%' : '—' %></td>
          <td><%= st.totalErrorObserved !== null ? st.totalErrorObserved + '%' : '—' %></td>
          <td>&le; <%= st.teaPercent %>%</td>
          <td>
            <% if (st.inControl) { %>
              <strong style="color: #16a34a;">✓ IN CONTROL (PASS)</strong>
            <% } else { %>
              <strong style="color: #dc2626;">❌ OUT OF CONTROL (FAIL)</strong>
            <% } %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- Vector SVG Levey-Jennings Chart (Prints in crisp 300+ DPI vector graphics!) -->
    <div class="chart-box">
      <div style="font-weight: bold; font-size: 10px; margin-bottom: 4px; display: flex; justify-content: space-between;">
        <span>LEVEY-JENNINGS PLOT: <%= dataset.analyteName.toUpperCase() %> (<%= dataset.unit %>)</span>
        <span style="font-size: 9px; color: #555;">Target: <%= dataset.targetMean %> &plusmn; <%= dataset.targetSd %></span>
      </div>

      <%
        const W = 740;
        const H = 220;
        const padL = 70;
        const padR = 25;
        const padT = 20;
        const padB = 30;
        const gW = W - padL - padR;
        const gH = H - padT - padB;

        const mean = dataset.targetMean;
        const sd = dataset.targetSd;
        const minVal = mean - (3.5 * sd);
        const maxVal = mean + (3.5 * sd);

        function calcY(v) {
          const norm = (v - minVal) / (maxVal - minVal);
          return (H - padB) - (norm * gH);
        }

        // pts already initialized at top of view
        const stepX = pts.length > 1 ? gW / (pts.length - 1) : gW / 2;
      %>

      <svg viewBox="0 0 <%= W %> <%= H %>" class="chart-svg">
        <!-- Background grid -->
        <rect x="<%= padL %>" y="<%= padT %>" width="<%= gW %>" height="<%= gH %>" fill="#fafafa" stroke="#000" stroke-width="1" />

        <!-- Reference Lines -->
        <!-- +3SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean + 3*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean + 3*sd) %>" stroke="#dc2626" stroke-dasharray="4,4" stroke-width="1" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean + 3*sd) + 3 %>" text-anchor="end" font-size="8" fill="#dc2626" font-family="monospace">+3SD (<%= (mean + 3*sd).toFixed(1) %>)</text>

        <!-- +2SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean + 2*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean + 2*sd) %>" stroke="#d97706" stroke-dasharray="4,4" stroke-width="1" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean + 2*sd) + 3 %>" text-anchor="end" font-size="8" fill="#d97706" font-family="monospace">+2SD (<%= (mean + 2*sd).toFixed(1) %>)</text>

        <!-- +1SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean + 1*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean + 1*sd) %>" stroke="#94a3b8" stroke-dasharray="2,2" stroke-width="0.8" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean + 1*sd) + 3 %>" text-anchor="end" font-size="8" fill="#64748b" font-family="monospace">+1SD</text>

        <!-- Mean Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean) %>" x2="<%= W - padR %>" y2="<%= calcY(mean) %>" stroke="#16a34a" stroke-width="1.5" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean) + 3 %>" text-anchor="end" font-size="9" fill="#16a34a" font-weight="bold" font-family="monospace">MEAN (<%= mean.toFixed(1) %>)</text>

        <!-- -1SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean - 1*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean - 1*sd) %>" stroke="#94a3b8" stroke-dasharray="2,2" stroke-width="0.8" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean - 1*sd) + 3 %>" text-anchor="end" font-size="8" fill="#64748b" font-family="monospace">-1SD</text>

        <!-- -2SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean - 2*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean - 2*sd) %>" stroke="#d97706" stroke-dasharray="4,4" stroke-width="1" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean - 2*sd) + 3 %>" text-anchor="end" font-size="8" fill="#d97706" font-family="monospace">-2SD (<%= (mean - 2*sd).toFixed(1) %>)</text>

        <!-- -3SD Line -->
        <line x1="<%= padL %>" y1="<%= calcY(mean - 3*sd) %>" x2="<%= W - padR %>" y2="<%= calcY(mean - 3*sd) %>" stroke="#dc2626" stroke-dasharray="4,4" stroke-width="1" />
        <text x="<%= padL - 6 %>" y="<%= calcY(mean - 3*sd) + 3 %>" text-anchor="end" font-size="8" fill="#dc2626" font-family="monospace">-3SD (<%= (mean - 3*sd).toFixed(1) %>)</text>

        <!-- Connecting Line between points -->
        <% if (pts.length > 1) { %>
          <% 
            let pathD = '';
            pts.forEach((p, i) => {
              const x = padL + (i * stepX);
              const y = calcY(p.measuredValue);
              pathD += (i === 0 ? `M ${x} ${y}` : ` L ${x} ${y}`);
            });
          %>
          <path d="<%= pathD %>" fill="none" stroke="#0284c7" stroke-width="1.8" />
        <% } %>

        <!-- Point Dots -->
        <% pts.forEach((p, i) => { %>
          <%
            const x = pts.length === 1 ? padL + gW/2 : padL + (i * stepX);
            const y = calcY(p.measuredValue);
            let fill = '#0284c7';
            if (p.status === 'REJECTED') fill = '#dc2626';
            else if (p.status === 'WARNING') fill = '#d97706';
            const d = new Date(p.runDate);
          %>
          <circle cx="<%= x %>" cy="<%= y %>" r="3.5" fill="<%= fill %>" stroke="#fff" stroke-width="1" />
          <text x="<%= x %>" y="<%= H - padB + 12 %>" text-anchor="middle" font-size="8" fill="#333"><%= d.getDate() %></text>
          <% if (p.status === 'REJECTED' && p.rulesViolated && p.rulesViolated.length) { %>
            <text x="<%= x %>" y="<%= y - 6 %>" text-anchor="middle" font-size="7.5" font-weight="bold" fill="#dc2626"><%= p.rulesViolated.join(',') %></text>
          <% } %>
        <% }); %>
      </svg>
      <div style="display: flex; justify-content: space-between; font-size: 8.5px; color: #555; margin-top: 2px;">
        <div>Legend: &bull; Blue = Accepted &nbsp;&bull; Amber = Warning (1:2s) &nbsp;&bull; Red = Rejected (Westgard Rule Failure)</div>
        <div>Days of the Month plotted on X-axis</div>
      </div>
    </div>

    <!-- Daily Control Run Log Table -->
    <div style="font-weight: bold; font-size: 10px; margin-bottom: 4px;">DAILY CONTROL MEASUREMENTS & WESTGARD MULTI-RULE AUDIT LOG</div>
    <table class="runs-table">
      <thead>
        <tr>
          <th style="width: 40px;">Run #</th>
          <th style="width: 85px;">Date & Time</th>
          <th style="width: 80px;">Measured (x)</th>
          <th style="width: 70px;">Deviation</th>
          <th style="width: 55px;">Z-Score</th>
          <th style="width: 75px;">Status</th>
          <th style="width: 90px;">Westgard Rules</th>
          <th>Corrective Action / Resolution (Required if Rejected)</th>
          <th style="width: 80px;">Operator</th>
        </tr>
      </thead>
      <tbody>
        <% if (pts.length === 0) { %>
          <tr><td colspan="9" style="text-align: center; color: #666; padding: 10px;">No control measurements recorded for this evaluation period.</td></tr>
        <% } else { %>
          <% pts.forEach((p, idx) => { %>
            <tr>
              <td style="text-align: center;"><%= idx + 1 %></td>
              <td><%= new Date(p.runDate).toLocaleDateString() %> <%= new Date(p.runDate).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></td>
              <td><strong><%= p.measuredValue %> <%= dataset.unit %></strong></td>
              <td><%= (p.measuredValue - dataset.targetMean).toFixed(2) %></td>
              <td><strong><%= p.zScore %></strong></td>
              <td>
                <% if (p.status === 'ACCEPTED') { %>
                  <span style="color: #16a34a; font-weight: bold;">✓ ACCEPT</span>
                <% } else if (p.status === 'WARNING') { %>
                  <span class="flag-warn">⚠️ WARN</span>
                <% } else { %>
                  <span class="flag-reject">❌ REJECT</span>
                <% } %>
              </td>
              <td><%= (p.rulesViolated && p.rulesViolated.length) ? p.rulesViolated.join(', ') : 'None' %></td>
              <td>
                <% if (p.correctiveAction && p.correctiveAction.actionTaken) { %>
                  <%= p.correctiveAction.actionTaken %>
                <% } else if (p.status === 'REJECTED') { %>
                  <span style="color: #dc2626;">Pending Documentation</span>
                <% } else { %>
                  <span style="color: #999;">In Tolerance</span>
                <% } %>
              </td>
              <td><%= p.operatorName || 'MedTech' %></td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>

    <!-- Official Regulatory Sign-Off Section -->
    <div id="signaturesGrid" class="signatures-grid" style="grid-template-columns: repeat(<%= sigs.hasPathologist2 ? 4 : 3 %>, 1fr);">
      <!-- Column 1: Operator (Medical Technologist) -->
      <div id="col_operator">
        <div class="sig-line" id="disp_op_name"><%= sigs.operatorName %></div>
        <div class="sig-sub" id="disp_op_title"><%= sigs.operatorTitle %></div>
        <div class="sig-sub" id="disp_op_lic">PRC License No.: <%= sigs.operatorLicense || '________________' %></div>
      </div>

      <!-- Column 2: Validator (QC Supervisor) -->
      <div id="col_validator">
        <div class="sig-line" id="disp_val_name"><%= sigs.validatorName %></div>
        <div class="sig-sub" id="disp_val_title"><%= sigs.validatorTitle %></div>
        <div class="sig-sub" id="disp_val_lic">PRC License No.: <%= sigs.validatorLicense || '________________' %></div>
      </div>

      <!-- Column 3: Approving Pathologist 1 -->
      <div id="col_pathologist1">
        <div class="sig-line" id="disp_p1_name"><%= sigs.pathologistName %></div>
        <div class="sig-sub" id="disp_p1_title"><%= sigs.pathologistTitle %></div>
        <div class="sig-sub" id="disp_p1_lic">PRC License No.: <%= sigs.pathologistLicense || '________________' %></div>
      </div>

      <!-- Column 4: Approving Pathologist 2 (Optional) -->
      <div id="col_pathologist2" style="display: <%= sigs.hasPathologist2 ? 'block' : 'none' %>;">
        <div class="sig-line" id="disp_p2_name"><%= sigs.pathologist2Name || 'Associate Pathologist, M.D.' %></div>
        <div class="sig-sub" id="disp_p2_title"><%= sigs.pathologist2Title %></div>
        <div class="sig-sub" id="disp_p2_lic">PRC License No.: <%= sigs.pathologist2License || '________________' %></div>
      </div>
    </div>
  </div>

  <script>
    let autoRefreshTimer = null;

    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      if (params.get('openDrawer') === '1') {
        const drawer = document.getElementById('sigEditorDrawer');
        if (drawer) drawer.style.display = 'block';
        showToast('✓ Signatory updated and report refreshed!');
      }
    });

    function showToast(msg) {
      const toast = document.getElementById('drawerToast');
      if (toast) {
        toast.textContent = msg;
        toast.style.display = 'inline-block';
        setTimeout(() => { toast.style.display = 'none'; }, 4000);
      }
    }

    function toggleSigEditor() {
      const drawer = document.getElementById('sigEditorDrawer');
      if (!drawer) return;
      const isOpen = drawer.style.display === 'block';
      drawer.style.display = isOpen ? 'none' : 'block';
    }

    function toggleP2Live(enabled) {
      const p2Fields = document.getElementById('p2_live_fields');
      const col2 = document.getElementById('col_pathologist2');
      const grid = document.getElementById('signaturesGrid');
      const badge = document.getElementById('sigCountBadge');

      if (p2Fields) p2Fields.style.display = enabled ? 'block' : 'none';
      if (col2) col2.style.display = enabled ? 'block' : 'none';
      if (grid) grid.style.gridTemplateColumns = enabled ? 'repeat(4, 1fr)' : 'repeat(3, 1fr)';
      if (badge) badge.textContent = enabled ? '4 Signatories (2 Pathologists)' : '3 Signatories (1 Pathologist)';

      const p2Sel = document.getElementById('edit_p2_select');
      if (enabled && p2Sel && (!p2Sel.value || p2Sel.selectedIndex === 0)) {
        if (p2Sel.options.length > 1) {
          p2Sel.selectedIndex = 1;
          onSelectPathologist2(p2Sel);
          return;
        }
      }
      scheduleAutoRefresh();
    }

    function onSelectOperator(sel) {
      const opt = sel.options[sel.selectedIndex];
      const name = opt ? opt.value : '';
      const lic = opt ? (opt.dataset.license || '') : '';
      const elName = document.getElementById('disp_op_name');
      const elLic = document.getElementById('disp_op_lic');
      const elBadge = document.getElementById('disp_op_lic_badge');
      if (elName) elName.textContent = name || 'Registered Medical Technologist';
      if (elLic) elLic.textContent = 'PRC License No.: ' + (lic || '________________');
      if (elBadge) elBadge.textContent = 'PRC License: ' + (lic || 'None');
      scheduleAutoRefresh();
    }

    function onSelectValidator(sel) {
      const opt = sel.options[sel.selectedIndex];
      const name = opt ? opt.value : '';
      const lic = opt ? (opt.dataset.license || '') : '';
      const elName = document.getElementById('disp_val_name');
      const elLic = document.getElementById('disp_val_lic');
      const elBadge = document.getElementById('disp_val_lic_badge');
      if (elName) elName.textContent = name || 'Chief Medical Technologist, RMT';
      if (elLic) elLic.textContent = 'PRC License No.: ' + (lic || '________________');
      if (elBadge) elBadge.textContent = 'PRC License: ' + (lic || 'None');
      scheduleAutoRefresh();
    }

    function onSelectPathologist(sel) {
      const opt = sel.options[sel.selectedIndex];
      const name = opt ? opt.value : '';
      const lic = opt ? (opt.dataset.license || '') : '';
      const elName = document.getElementById('disp_p1_name');
      const elLic = document.getElementById('disp_p1_lic');
      const elBadge = document.getElementById('disp_p1_lic_badge');
      if (elName) elName.textContent = name || 'Bernadette R. Espiritu, M.D.';
      if (elLic) elLic.textContent = 'PRC License No.: ' + (lic || '________________');
      if (elBadge) elBadge.textContent = 'PRC License: ' + (lic || 'None');
      scheduleAutoRefresh();
    }

    function onSelectPathologist2(sel) {
      const opt = sel.options[sel.selectedIndex];
      const name = opt ? opt.value : '';
      const lic = opt ? (opt.dataset.license || '') : '';
      const elName = document.getElementById('disp_p2_name');
      const elLic = document.getElementById('disp_p2_lic');
      const elBadge = document.getElementById('disp_p2_lic_badge');
      if (elName) elName.textContent = name || 'Associate Pathologist, M.D.';
      if (elLic) elLic.textContent = 'PRC License No.: ' + (lic || '________________');
      if (elBadge) elBadge.textContent = 'PRC License: ' + (lic || 'None');
      scheduleAutoRefresh();
    }

    function scheduleAutoRefresh() {
      showToast('Refreshing report with updated signatory...');
      clearTimeout(autoRefreshTimer);
      autoRefreshTimer = setTimeout(() => {
        executeAutoRefresh();
      }, 500);
    }

    function executeAutoRefresh() {
      const opSel = document.getElementById('edit_op_select');
      const valSel = document.getElementById('edit_val_select');
      const p1Sel = document.getElementById('edit_p1_select');
      const p2Sel = document.getElementById('edit_p2_select');
      const p2Check = document.getElementById('edit_enable_p2');

      const opOpt = opSel ? opSel.options[opSel.selectedIndex] : null;
      const valOpt = valSel ? valSel.options[valSel.selectedIndex] : null;
      const p1Opt = p1Sel ? p1Sel.options[p1Sel.selectedIndex] : null;
      const p2Opt = p2Sel ? p2Sel.options[p2Sel.selectedIndex] : null;

      const params = new URLSearchParams(window.location.search);

      if (opOpt && opOpt.value) {
        params.set('operatorName', opOpt.value);
        if (opOpt.dataset.license) params.set('operatorLicense', opOpt.dataset.license);
        else params.delete('operatorLicense');
      }

      if (valOpt && valOpt.value) {
        params.set('validatorName', valOpt.value);
        if (valOpt.dataset.license) params.set('validatorLicense', valOpt.dataset.license);
        else params.delete('validatorLicense');
      }

      if (p1Opt && p1Opt.value) {
        params.set('pathologistName', p1Opt.value);
        if (p1Opt.dataset.license) params.set('pathologistLicense', p1Opt.dataset.license);
        else params.delete('pathologistLicense');
      }

      if (p2Check && p2Check.checked && p2Opt && p2Opt.value) {
        params.set('hasPathologist2', '1');
        params.set('pathologist2Name', p2Opt.value);
        if (p2Opt.dataset.license) params.set('pathologist2License', p2Opt.dataset.license);
        else params.delete('pathologist2License');
      } else {
        params.delete('hasPathologist2');
        params.delete('pathologist2Name');
        params.delete('pathologist2License');
      }

      params.set('openDrawer', '1');
      window.location.search = params.toString();
    }
  </script>
</body>
</html>
