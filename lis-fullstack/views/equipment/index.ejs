<!-- MODAL 4: CONFIGURE NEW QC ANALYTE / PARAMETER           -->
<!-- ======================================================== -->
<div id="modalAddAnalyte" class="eq-modal">
  <div class="eq-modal-content" style="max-width: 650px;">
    <div class="eq-modal-header">
      <h3 style="margin: 0; display: flex; align-items: center; gap: 8px;">
        <i class="fa fa-vial" style="color: #0284c7;"></i> Configure QC Analyte / Parameter
      </h3>
      <button type="button" onclick="closeModal('modalAddAnalyte')" style="background:none; border:none; font-size:1.4em; cursor:pointer;">&times;</button>
    </div>
    <form id="formAddAnalyte" onsubmit="saveNewAnalyte(event)">
      <div class="eq-modal-body">
        <p style="font-size: 0.85em; color: #64748b; margin-top: 0; margin-bottom: 14px;">
          Define target Mean and Standard Deviation (SD) for statistical Levey-Jennings QC monitoring and Westgard multi-rule surveillance on this instrument.
        </p>

        <div class="form-group" style="margin-bottom: 14px;">
          <label style="font-weight: 600;">Target Equipment / Analyzer *</label>
          <select id="add_analyte_eqId" required style="width: 100%; padding: 6px 8px; font-size: 0.9em; border: 1px solid #cbd5e1; border-radius: 4px;"></select>
        </div>

        <!-- Control Material Details -->
        <div style="background: #f8fafc; padding: 12px; border-radius: 6px; border: 1px solid #e2e8f0; margin-bottom: 14px;">
          <h4 style="margin: 0 0 8px; font-size: 0.88em; color: #1e293b;"><i class="fa fa-box" style="color: #0284c7;"></i> Control Material / Lot Information</h4>
          <div class="form-grid">
            <div class="form-group">
              <label>Control Material Name *</label>
              <input type="text" id="add_analyte_ctrlName" required placeholder="e.g. Sysmex e-CHECK / Bio-Rad Lyphochek / Stago Coag Control">
            </div>
            <div class="form-group">
              <label>Control Lot Number *</label>
              <input type="text" id="add_analyte_lotNumber" required placeholder="e.g. LOT-HEMA-2026-N1">
            </div>
            <div class="form-group">
              <label>Control Level</label>
              <select id="add_analyte_level">
                <option value="Level 1 (Normal)">Level 1 (Normal)</option>
                <option value="Level 2 (High / Pathological)">Level 2 (High / Pathological)</option>
                <option value="Level 3 (Low)">Level 3 (Low)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Lot Expiration Date</label>
              <input type="date" id="add_analyte_expDate">
            </div>
          </div>
        </div>

        <!-- Blood Chemistry Official Panel Presets & 1-Click Pre-Add -->
        <div style="margin-bottom: 16px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px; padding: 14px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; flex-wrap: wrap; gap: 8px;">
            <label style="font-size: 0.9em; font-weight: 700; color: #0369a1; margin: 0; display: flex; align-items: center; gap: 6px;">
              <i class="fa fa-clipboard-list" style="color: #0284c7;"></i> Blood Chemistry Form Presets (21 Official Analytes)
            </label>
            <button type="button" class="button" onclick="preloadAllBloodChemAnalytes()" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: #ffffff; font-weight: 600; font-size: 0.82em; padding: 6px 12px; border-radius: 6px; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(2,132,199,0.25);">
              <i class="fa fa-bolt"></i> ⚡ Pre-add All 21 Blood Chemistry Analytes
            </button>
          </div>
          <p style="font-size: 0.78em; color: #0284c7; margin: 0 0 8px 0; line-height: 1.4;">
            Pre-loaded from our laboratory's Blood Chemistry test entry form. Select any analyte to autofill standard target Mean, SD, Unit, and TEa%:
          </p>
          <select id="add_analyte_bc_preset" onchange="applyAnalytePreset(this.value)" style="width: 100%; padding: 7px 10px; font-size: 0.88em; font-weight: 600; border: 1px solid #7dd3fc; border-radius: 6px; background: #ffffff; color: #0f172a; margin-bottom: 8px;">
            <option value="">-- Select Blood Chemistry Preset to Autofill --</option>
            <optgroup label="🩸 Blood Sugar &amp; Glycemic Profile">
              <option value="fbs">FBS - Fasting Blood Sugar (70-110 mg/dL)</option>
              <option value="rbs">RBS - Random Blood Sugar (80-130 mg/dL)</option>
              <option value="firstHour">1st Hour OGTT (90-140 mg/dL)</option>
              <option value="secondHour">2nd Hour OGTT (80-120 mg/dL)</option>
              <option value="hba1c">HbA1c - Glycated Hemoglobin (4.0-6.5 %)</option>
            </optgroup>
            <optgroup label="🫀 Lipid Profile">
              <option value="chol">Total Cholesterol (0-200 mg/dL)</option>
              <option value="tg">Triglycerides (60-150 mg/dL)</option>
              <option value="hdl">HDL-C - Good Cholesterol (35-80 mg/dL)</option>
              <option value="ldl">LDL - Bad Cholesterol (66-178 mg/dL)</option>
              <option value="vldl">VLDL (0-30 mg/dL)</option>
            </optgroup>
            <optgroup label="🫘 Renal &amp; Kidney Function">
              <option value="bun">BUN - Blood Urea Nitrogen (4.67-23.36 mg/dL)</option>
              <option value="crea">Creatinine (0.50-1.00 mg/dL)</option>
              <option value="urea">Blood Urea (10.00-50.00 mg/dL)</option>
              <option value="uric">Uric Acid (2.40-5.70 mg/dL)</option>
            </optgroup>
            <optgroup label="🧪 Liver Function &amp; Proteins">
              <option value="alt">SGPT (ALT) (0-32 U/L)</option>
              <option value="ast">SGOT (AST) (0-31 U/L)</option>
              <option value="alb">Albumin - ALB (3.00-6.00 g/L)</option>
            </optgroup>
            <optgroup label="⚡ Electrolytes &amp; Minerals">
              <option value="sodium">Sodium - Na (136-148 mmol/L)</option>
              <option value="potassium">Potassium - K (3.50-5.10 mmol/L)</option>
              <option value="chloride">Chloride - Cl (98-107 mmol/L)</option>
              <option value="calcium">Calcium - Ca (8.50-10.20 mg/dL)</option>
            </optgroup>
            <optgroup label="🔬 Other Instruments (Hematology / Coagulation)">
              <option value="wbc">WBC - White Blood Cells (10^3/uL)</option>
              <option value="rbc">RBC - Red Blood Cells (10^6/uL)</option>
              <option value="hgb">HGB - Hemoglobin (g/dL)</option>
              <option value="hct">HCT - Hematocrit (%)</option>
              <option value="plt">PLT - Platelet Count (10^3/uL)</option>
              <option value="pt">PT - Prothrombin Time (seconds)</option>
              <option value="inr">INR - International Normalized Ratio</option>
              <option value="aptt">APTT - Activated Partial Thromboplastin Time (sec)</option>
            </optgroup>
          </select>
          <div style="display: flex; gap: 5px; flex-wrap: wrap;">
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('fbs')" style="font-size:0.75em; padding:2px 8px;">FBS</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('chol')" style="font-size:0.75em; padding:2px 8px;">Cholesterol</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('crea')" style="font-size:0.75em; padding:2px 8px;">Creatinine</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('uric')" style="font-size:0.75em; padding:2px 8px;">Uric Acid</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('alt')" style="font-size:0.75em; padding:2px 8px;">SGPT</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('ast')" style="font-size:0.75em; padding:2px 8px;">SGOT</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('bun')" style="font-size:0.75em; padding:2px 8px;">BUN</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('sodium')" style="font-size:0.75em; padding:2px 8px;">Na+</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('potassium')" style="font-size:0.75em; padding:2px 8px;">K+</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('chloride')" style="font-size:0.75em; padding:2px 8px;">Cl-</button>
            <button type="button" class="button btn-small btn-secondary" onclick="applyAnalytePreset('calcium')" style="font-size:0.75em; padding:2px 8px;">Calcium</button>
          </div>
        </div>

        <!-- Analyte Specifications -->
        <div class="form-grid">
          <div class="form-group">
            <label>Analyte / Parameter Name *</label>
            <input type="text" id="add_analyte_name" required placeholder="e.g. White Blood Cells (WBC) or Prothrombin Time" oninput="autoDeriveAnalyteCode()">
          </div>
          <div class="form-group">
            <label>Analyte Short Code *</label>
            <input type="text" id="add_analyte_code" required placeholder="e.g. wbc, plt, pt, inr, na" style="font-family: monospace;">
          </div>
          <div class="form-group">
            <label>Reporting Unit *</label>
            <input type="text" id="add_analyte_unit" required placeholder="e.g. 10^3/uL, seconds, g/dL, mmol/L, mg/dL">
          </div>
          <div class="form-group">
            <label>Assigned Mean (x̄ Target) *</label>
            <input type="number" step="any" id="add_analyte_mean" required placeholder="e.g. 7.50">
          </div>
          <div class="form-group">
            <label>Target Standard Deviation (s) *</label>
            <input type="number" step="any" id="add_analyte_sd" required placeholder="e.g. 0.35">
          </div>
          <div class="form-group">
            <label>Allowable Total Error (TEa %)</label>
            <input type="number" step="0.1" id="add_analyte_tea" value="10.0" placeholder="e.g. 10.0">
          </div>
        </div>
      </div>
      <div class="eq-modal-footer">
        <button type="button" class="button btn-secondary" onclick="closeModal('modalAddAnalyte')">Cancel</button>
        <button type="submit" class="button btn-primary" style="background: #0284c7; border-color: #0369a1;">
          <i class="fa fa-check"></i> Save &amp; Activate QC Analyte
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // Global state
  let allEquipment = <%- JSON.stringify(equipment || []) %>;
  let allUsers = <%- JSON.stringify((typeof users !== 'undefined' && Array.isArray(users)) ? users.map(u => ({ id: u.id, name: u.name, role: u.role, license: u.licenseNumber || '' })) : []) %>;
  let allNeqasRecords = [];
  let currentLjData = null;
  let currentEqControls = [];
  let canEditEquipment = <%= Boolean(canEdit) %>;
  let qcEntryCounts = <%- JSON.stringify(typeof qcEntryCounts !== 'undefined' ? qcEntryCounts : {}) %>;

  document.addEventListener('DOMContentLoaded', () => {
    // Set default dates to today
    const today = new Date().toISOString().split('T')[0];
    const dateInputs = ['log_date', 'qc_date', 'eq_lastCalDate', 'eq_lastPmDate'];
    dateInputs.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = today;
    });

    // Initialize Levey-Jennings default date range to past 30 days so all 25 daily runs are immediately visible
    const now = new Date();
    const past30 = new Date(now.getTime() - (30 * 24 * 60 * 60 * 1000));
    const firstDay = past30.toISOString().split('T')[0];
    const lastDay = now.toISOString().split('T')[0];
    const ljStart = document.getElementById('lj_startDate');
    const ljEnd = document.getElementById('lj_endDate');
    if (ljStart && !ljStart.value) ljStart.value = firstDay;
    if (ljEnd && !ljEnd.value) ljEnd.value = lastDay;

    populateAnalyzerDropdowns();
    populateSignatoryDropdowns();
    loadNeqasTable();

    // High-DPI dynamic resize listeners for crisp Levey-Jennings canvas across all screen sizes
    window.addEventListener('resize', handleLjResize);
    if (window.ResizeObserver) {
      const ctn = document.getElementById('lj_canvasContainer');
      if (ctn) new ResizeObserver(handleLjResize).observe(ctn);
    }
  });

  function populateSignatoryDropdowns() {
    const eqId = document.getElementById('lj_analyzerSelect')?.value;
    const eq = allEquipment.find(e => e.id === eqId) || allEquipment[0];
    const isXray = eq && (
      (eq.category && eq.category.toLowerCase().includes('x-ray')) ||
      (eq.department && eq.department.toLowerCase().includes('radiolog'))
    );

    const opRoleLbl = document.getElementById('lj_op_role_label');
    const p1RoleLbl = document.getElementById('lj_p1_role_label');
    if (opRoleLbl) opRoleLbl.textContent = isXray ? 'X-Ray Tech' : 'MedTech';
    if (p1RoleLbl) p1RoleLbl.textContent = isXray ? 'Approving Radiologist' : 'Approving Pathologist';

    const opSelect = document.getElementById('lj_operatorSelect');
    const valSelect = document.getElementById('lj_validatorSelect');
    const p1Select = document.getElementById('lj_pathologistSelect');
    const p2Select = document.getElementById('lj_pathologist2Select');

    if (!opSelect || !valSelect || !p1Select || !p2Select) return;

    opSelect.innerHTML = '';
    valSelect.innerHTML = '';
    p1Select.innerHTML = '';
    p2Select.innerHTML = '<option value="">-- Choose 2nd Signatory --</option>';

    // Deduplicate staff by name
    const uniqueUsersByName = [];
    const seenNames = new Set();
    (allUsers || []).forEach(u => {
      const k = (u.name || '').trim().toLowerCase();
      if (k && !seenNames.has(k)) {
        seenNames.add(k);
        uniqueUsersByName.push(u);
      }
    });

    // Filter staff strictly according to equipment type
    const medtechs = uniqueUsersByName.filter(u =>
      u.role === 'Medical Technologist' ||
      ((u.name && u.name.includes('RMT')) && u.role !== 'Admin' && u.role !== 'Receptionist')
    );
    const radtechs = uniqueUsersByName.filter(u =>
      u.role === 'X-Ray Technologist' ||
      ((u.name && (u.name.includes('RXT') || u.name.includes('RadTech'))) && u.role !== 'Admin')
    );
    const pathologists = uniqueUsersByName.filter(u =>
      u.role === 'Pathologist' || (u.name && u.name.includes('Espiritu'))
    );
    const radiologists = uniqueUsersByName.filter(u => u.role === 'Radiologist');
    const otherDoctors = uniqueUsersByName.filter(u =>
      (u.role === 'Doctor' || u.role === 'Internist' || (u.name && (u.name.includes('MD') || u.name.includes('M.D.')))) &&
      !pathologists.includes(u) && !radiologists.includes(u)
    );
    const allDoctors = [...pathologists, ...otherDoctors];

    // For Clinical equipment: strictly MedTechs only. For Radiology equipment: strictly RadTechs only.
    const opCandidates = isXray
      ? (radtechs.length ? radtechs : [{ id: 'rad1', name: 'John Kevin R. Estanislao, RXT', license: '' }])
      : (medtechs.length ? medtechs : [{ id: 'med1', name: 'Gezyne M. Lopez, RMT', license: '67820' }]);

    const valCandidates = isXray
      ? (radtechs.length ? radtechs : [{ id: 'rad2', name: 'Chief Radiologic Technologist', license: '' }])
      : (medtechs.length ? medtechs : [{ id: 'med2', name: 'Jeff Louine Jamir T. Domingo, RMT, PMSDA', license: '68285' }]);

    const p1Candidates = isXray
      ? (radiologists.length ? radiologists : (allDoctors.length ? allDoctors : [{ id: 'doc1', name: 'Alberto J. Gabriel, MD, FPCR', license: '' }]))
      : (pathologists.length ? pathologists : (allDoctors.length ? allDoctors : [{ id: 'path1', name: 'Bernadette R. Espiritu, M.D.', license: '75547' }]));

    const p2Candidates = isXray
      ? (radiologists.length ? radiologists : allDoctors)
      : (allDoctors.length ? allDoctors : [{ id: 'path1', name: 'Bernadette R. Espiritu, M.D.', license: '75547' }]);

    // 1. Populate Operator
    opCandidates.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u.id;
      opt.dataset.name = u.name;
      opt.dataset.license = u.license || '';
      opt.textContent = `${u.name}${u.license ? ' (PRC: ' + u.license + ')' : ''}`;
      opSelect.appendChild(opt);
    });

    // 2. Populate Validator
    valCandidates.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u.id;
      opt.dataset.name = u.name;
      opt.dataset.license = u.license || '';
      opt.textContent = `${u.name}${u.license ? ' (PRC: ' + u.license + ')' : ''}`;
      valSelect.appendChild(opt);
    });

    // 3. Populate Pathologist 1
    p1Candidates.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u.id;
      opt.dataset.name = u.name;
      opt.dataset.license = u.license || '';
      opt.textContent = `${u.name}${u.license ? ' (PRC: ' + u.license + ')' : ''}`;
      p1Select.appendChild(opt);
    });

    // 4. Populate Pathologist 2
    p2Candidates.forEach(u => {
      const opt = document.createElement('option');
      opt.value = u.id;
      opt.dataset.name = u.name;
      opt.dataset.license = u.license || '';
      opt.textContent = `${u.name}${u.license ? ' (PRC: ' + u.license + ')' : ''}`;
      p2Select.appendChild(opt);
    });

    // Set Default Selections:
    if (!isXray) {
      const opDef = opCandidates.find(u => u.name && (u.name.includes('Lopez') || u.name.includes('Gezyne M.'))) || opCandidates[0];
      if (opDef) opSelect.value = opDef.id;

      const valDef = valCandidates.find(u => u.name && u.name.includes('Domingo')) || valCandidates[1] || valCandidates[0];
      if (valDef) valSelect.value = valDef.id;

      const p1Def = p1Candidates.find(u => u.name && u.name.includes('Espiritu')) || p1Candidates[0];
      if (p1Def) p1Select.value = p1Def.id;
    } else {
      if (opCandidates[0]) opSelect.value = opCandidates[0].id;
      if (valCandidates.length > 1) valSelect.value = valCandidates[1].id;
      else if (valCandidates[0]) valSelect.value = valCandidates[0].id;
      if (p1Candidates[0]) p1Select.value = p1Candidates[0].id;
    }

    onOperatorSelectChange();
    onValidatorSelectChange();
    onPathologistSelectChange();
    onPathologist2SelectChange();
  }

  function onOperatorSelectChange() {
    const sel = document.getElementById('lj_operatorSelect');
    const opt = sel ? sel.options[sel.selectedIndex] : null;
    const lic = opt ? (opt.dataset.license || 'None') : 'None';
    const preview = document.getElementById('lj_op_lic_preview');
    if (preview) preview.textContent = 'PRC License: ' + lic;
  }

  function onValidatorSelectChange() {
    const sel = document.getElementById('lj_validatorSelect');
    const opt = sel ? sel.options[sel.selectedIndex] : null;
    const lic = opt ? (opt.dataset.license || 'None') : 'None';
    const preview = document.getElementById('lj_val_lic_preview');
    if (preview) preview.textContent = 'PRC License: ' + lic;
  }

  function onPathologistSelectChange() {
    const sel = document.getElementById('lj_pathologistSelect');
    const opt = sel ? sel.options[sel.selectedIndex] : null;
    const lic = opt ? (opt.dataset.license || 'None') : 'None';
    const preview = document.getElementById('lj_p1_lic_preview');
    if (preview) preview.textContent = 'PRC License: ' + lic;
  }

  function onPathologist2SelectChange() {
    const sel = document.getElementById('lj_pathologist2Select');
    const opt = sel ? sel.options[sel.selectedIndex] : null;
    const lic = opt ? (opt.dataset.license || 'None') : 'None';
    const preview = document.getElementById('lj_p2_lic_preview');
    if (preview) preview.textContent = 'PRC License: ' + lic;
  }

  function togglePathologist2Modal(enabled) {
    const container = document.getElementById('lj_p2_fields');
    const badge = document.getElementById('lj_p2_badge');
    if (!container) return;
    if (enabled) {
      container.style.opacity = '1';
      container.style.pointerEvents = 'auto';
      if (badge) {
        badge.textContent = 'Active (2 Pathologists)';
        badge.style.color = '#0284c7';
      }
      const sel = document.getElementById('lj_pathologist2Select');
      if (sel && (sel.selectedIndex <= 0 || !sel.value)) {
        if (sel.options.length > 1) {
          sel.selectedIndex = 1;
          onPathologist2SelectChange();
        }
      }
    } else {
      container.style.opacity = '0.5';
      container.style.pointerEvents = 'none';
      if (badge) {
        badge.textContent = '(Optional)';
        badge.style.color = '#64748b';
      }
    }
  }

  function getLabTestingEquipment() {
    return (allEquipment || []).filter(eq => {
      const cat = (eq.category || '').toLowerCase();
      const dept = (eq.department || '').toLowerCase();
      const name = (eq.name || '').toLowerCase();
      const isXray = cat.includes('x-ray') || dept.includes('radiolog') || name.includes('x-ray');
      const isCabinet = cat.includes('biosafety') || name.includes('biosafety') || cat.includes('autoclave') || name.includes('autoclave');
      return !isXray && !isCabinet;
    });
  }

  // ==========================================
  // HIGH-DPI LEVEY-JENNINGS CANVAS ENGINE
  // ==========================================
  function setupLjCanvas() {
    const canvas = document.getElementById('ljCanvas');
    if (!canvas) return null;
    const container = canvas.parentElement || document.getElementById('lj_canvasContainer');
    if (!container) return null;

    // Use container width, falling back gracefully if container is hidden during initial load
    const displayWidth = container.clientWidth > 50 ? container.clientWidth : (window.innerWidth ? Math.min(window.innerWidth - 300, 1400) : 900);
    const displayHeight = 380;
    const dpr = Math.max(window.devicePixelRatio || 1, 1);

    canvas.width = Math.round(displayWidth * dpr);
    canvas.height = Math.round(displayHeight * dpr);
    canvas.style.width = displayWidth + 'px';
    canvas.style.height = displayHeight + 'px';

    const ctx = canvas.getContext('2d');
    if (ctx.resetTransform) {
      ctx.resetTransform();
    } else {
      ctx.setTransform(1, 0, 0, 1, 0, 0);
    }
    ctx.scale(dpr, dpr);

    return { canvas, ctx, W: displayWidth, H: displayHeight, dpr };
  }

  let ljResizeTimer = null;
  function handleLjResize() {
    clearTimeout(ljResizeTimer);
    ljResizeTimer = setTimeout(() => {
      const secQc = document.getElementById('sectionQc');
      if (currentLjData && (!secQc || secQc.style.display !== 'none')) {
        renderLeveyJenningsCanvas(currentLjData);
      }
    }, 60);
  }

  function populateAnalyzerDropdowns() {
    const ljSelect = document.getElementById('lj_analyzerSelect');
    const neqasSelect = document.getElementById('neqas_eqId');
    const quickSelect = document.getElementById('quick_eqId');
    if (!ljSelect) return;

    // 1. Top Selector: ONLY show machines that have recorded QC run data (entryCount > 0)
    const prevLjVal = ljSelect.value;
    ljSelect.innerHTML = '';
    const machinesWithData = (allEquipment || []).filter(eq => (qcEntryCounts[eq.id] || 0) > 0);

    if (machinesWithData.length === 0) {
      const opt = document.createElement('option');
      opt.value = '';
      opt.textContent = '-- No analyzers with LJ data recorded yet --';
      ljSelect.appendChild(opt);
    } else {
      machinesWithData.forEach(eq => {
        const opt = document.createElement('option');
        opt.value = eq.id;
        opt.textContent = `${eq.equipmentCode} - ${eq.name} (${qcEntryCounts[eq.id]} runs)`;
        ljSelect.appendChild(opt);
      });
      if (prevLjVal && machinesWithData.some(e => e.id === prevLjVal)) {
        ljSelect.value = prevLjVal;
      } else {
        ljSelect.value = machinesWithData[0].id;
      }
    }

    // 2. NEQAS selector: all equipment
    if (neqasSelect) {
      neqasSelect.innerHTML = '';
      allEquipment.forEach(eq => {
        const opt = document.createElement('option');
        opt.value = eq.id;
        opt.textContent = `${eq.equipmentCode} - ${eq.name}`;
        neqasSelect.appendChild(opt);
      });
    }

    // 3. Bottom quick QC entry: all laboratory analytical equipment
    if (quickSelect) {
      const prevQuickVal = quickSelect.value;
      quickSelect.innerHTML = '';
      const labEq = getLabTestingEquipment();
      labEq.forEach(eq => {
        const opt = document.createElement('option');
        opt.value = eq.id;
        opt.textContent = `${eq.equipmentCode} - ${eq.name}`;
        quickSelect.appendChild(opt);
      });
      if (prevQuickVal && labEq.some(e => e.id === prevQuickVal)) {
        quickSelect.value = prevQuickVal;
      } else if (machinesWithData.length > 0) {
        quickSelect.value = machinesWithData[0].id;
      } else if (labEq.length > 0) {
        quickSelect.value = labEq[0].id;
      }
    }

    if (machinesWithData.length > 0) {
      onLjAnalyzerChange();
    } else {
      if (quickSelect && quickSelect.value) {
        onQuickEquipmentChange();
      }
      // Clear canvas and table gracefully if no machine has data yet
      const env = setupLjCanvas();
      if (env) {
        const { ctx, W, H } = env;
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = '#94a3b8';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('No QC run data recorded yet. Record your first standard reading below.', W / 2, H / 2);
      }
      const tb = document.getElementById('lj_tableBody');
      if (tb) {
        tb.innerHTML = '<tr><td colspan="10" style="text-align: center; color: #64748b; padding: 24px;"><i class="fa fa-info-circle" style="color: #0284c7; margin-right: 6px;"></i> No control run measurements recorded yet. Enter a reading in the form below.</td></tr>';
      }
      const runCountBadge = document.getElementById('lj_tableRunCount');
      if (runCountBadge) runCountBadge.textContent = '0 Runs';
    }
  }

  function applyFilters() {
    const q = (document.getElementById('searchInput').value || '').toLowerCase();
    const dept = document.getElementById('departmentFilter').value;
    const status = document.getElementById('statusFilter').value;

    const rows = document.querySelectorAll('.eq-row');
    rows.forEach(row => {
      const matchesSearch = !q || row.dataset.code.includes(q) || row.dataset.name.includes(q) || row.dataset.serial.includes(q) || row.dataset.brand.includes(q);
      const matchesDept = !dept || row.dataset.dept === dept;
      const matchesStatus = !status || row.dataset.status === status;

      row.style.display = (matchesSearch && matchesDept && matchesStatus) ? '' : 'none';
    });
  }

  function filterByStatus(st) {
    document.getElementById('statusFilter').value = st;
    applyFilters();
  }

  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }

  function openCreateModal() {
    document.getElementById('modalEqTitle').textContent = 'Register Laboratory Equipment';
    document.getElementById('formEquipment').reset();
    document.getElementById('eq_id').value = '';
    document.getElementById('eq_code').value = 'EQ-' + Math.floor(1000 + Math.random() * 9000);
    document.getElementById('eq_category').value = 'Clinical Chemistry Analyzer';
    document.getElementById('eq_customCategoryGroup').style.display = 'none';
    document.getElementById('eq_customCategory').value = '';
    document.getElementById('eq_customCategory').required = false;
    document.getElementById('eq_calCycle').value = '365';
    document.getElementById('eq_pmCycle').value = '180';
    handleCategoryChange();
    document.getElementById('modalEquipment').style.display = 'block';
  }

  function handleCategoryChange() {
    const catSelect = document.getElementById('eq_category');
    const customGroup = document.getElementById('eq_customCategoryGroup');
    const customInput = document.getElementById('eq_customCategory');

    if (catSelect.value === 'OTHER') {
      customGroup.style.display = 'block';
      customInput.required = true;
      customInput.focus();
    } else {
      customGroup.style.display = 'none';
      customInput.required = false;
      customInput.value = '';
    }

    const effectiveCat = catSelect.value === 'OTHER' ? (customInput.value || '') : catSelect.value;
    const isXray = effectiveCat.toLowerCase().includes('x-ray') || effectiveCat.toLowerCase().includes('radiolog');
    document.getElementById('xraySpecificFields').style.display = isXray ? 'block' : 'none';
    if (isXray && document.getElementById('eq_department').value === 'General Laboratory') {
      document.getElementById('eq_department').value = 'Radiology / X-Ray';
    }
  }

  async function openEditModal(id) {
    try {
      const res = await fetch(`/equipment/${id}`);
      const json = await res.json();
      if (!json.success) return alert(json.error || 'Failed to load details.');
      const eq = json.equipment;

      document.getElementById('modalEqTitle').textContent = `Edit Equipment (${eq.equipmentCode})`;
      document.getElementById('eq_id').value = eq.id;
      document.getElementById('eq_code').value = eq.equipmentCode;
      document.getElementById('eq_name').value = eq.name;

      const standardCategories = [
        'Clinical Chemistry Analyzer',
        'Hematology Analyzer',
        'Diagnostic X-Ray Unit (Stationary)',
        'Diagnostic X-Ray Unit (Mobile/Portable)',
        'Ultrasound / 2D Echo Unit',
        'Coagulation Analyzer',
        'Electrolyte Analyzer',
        'Centrifuge',
        'Biosafety Cabinet / Laminar Flow',
        'Laboratory Refrigerator / Freezer',
        'Autoclave / Sterilizer',
        'General Equipment'
      ];

      if (standardCategories.includes(eq.category)) {
        document.getElementById('eq_category').value = eq.category;
        document.getElementById('eq_customCategoryGroup').style.display = 'none';
        document.getElementById('eq_customCategory').value = '';
        document.getElementById('eq_customCategory').required = false;
      } else {
        document.getElementById('eq_category').value = 'OTHER';
        document.getElementById('eq_customCategoryGroup').style.display = 'block';
        document.getElementById('eq_customCategory').value = eq.category || '';
        document.getElementById('eq_customCategory').required = true;
      }

      document.getElementById('eq_department').value = eq.department;
      document.getElementById('eq_manufacturer').value = eq.manufacturer || '';
      document.getElementById('eq_modelNumber').value = eq.modelNumber || '';
      document.getElementById('eq_serialNumber').value = eq.serialNumber || '';
      document.getElementById('eq_location').value = eq.location || '';
      document.getElementById('eq_calCycle').value = eq.calibrationCycleDays || 365;
      document.getElementById('eq_pmCycle').value = eq.pmCycleDays || 180;
      document.getElementById('eq_lastCalDate').value = eq.lastCalibrationDate ? eq.lastCalibrationDate.split('T')[0] : '';
      document.getElementById('eq_lastPmDate').value = eq.lastPmDate ? eq.lastPmDate.split('T')[0] : '';
      document.getElementById('eq_notes').value = eq.notes || '';

      const rad = eq.radiationSafetyDetails || {};
      document.getElementById('xray_fdaReg').value = rad.fdaCdrrhrRegNumber || '';
      document.getElementById('xray_rso').value = rad.radiationSafetyOfficer || '';
      document.getElementById('xray_tube').value = rad.tubeModel || '';
      document.getElementById('xray_ratings').value = rad.maxKvp ? `${rad.maxKvp} kVp / ${rad.maxMa || ''} mA` : '';

      handleCategoryChange();
      document.getElementById('modalEquipment').style.display = 'block';
    } catch (e) {
      alert('Error fetching equipment: ' + e.message);
    }
  }

  async function saveEquipment(e) {
    e.preventDefault();
    const id = document.getElementById('eq_id').value;
    const isEdit = !!id;

    let category = document.getElementById('eq_category').value;
    if (category === 'OTHER') {
      const custom = (document.getElementById('eq_customCategory').value || '').trim();
      if (!custom) {
        alert('Please specify the custom equipment category.');
        document.getElementById('eq_customCategory').focus();
        return;
      }
      category = custom;
    }

    const payload = {
      equipmentCode: document.getElementById('eq_code').value,
