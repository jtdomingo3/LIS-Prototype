  async function preloadAllBloodChemAnalytes() {
    const eqSelect = document.getElementById('add_analyte_eqId');
    const eqId = eqSelect ? eqSelect.value : (document.getElementById('quick_eqId')?.value || document.getElementById('lj_analyzerSelect')?.value);
    if (!eqId) {
      alert('Please select a target equipment/analyzer first.');
      return;
    }

    const eqObj = (allEquipment || []).find(e => e.id === eqId);
    const eqName = eqObj ? eqObj.name : 'selected analyzer';

    const confirmed = confirm(`Pre-add all 21 official Blood Chemistry analytes (from the test entry form) to ${eqName}?\n\nThis includes:\n- Blood Sugar (FBS, RBS, 1st & 2nd Hour OGTT, HbA1c)\n- Lipid Profile (Cholesterol, TG, HDL, LDL, VLDL)\n- Renal Function (BUN, Creatinine, Urea, Uric Acid)\n- Liver & Proteins (SGPT, SGOT, Albumin)\n- Electrolytes (Sodium, Potassium, Chloride, Calcium)\n\nExisting recorded QC runs and custom control targets will be preserved.`);
    if (!confirmed) return;

    // Immediately close modal popup so user does not wait with popup open
    closeModal('modalAddAnalyte');

    try {
      const payload = {
        controlName: document.getElementById('add_analyte_ctrlName')?.value.trim() || 'Bio-Rad Lyphochek Assayed Chemistry Control Level 1 (Normal)',
        lotNumber: document.getElementById('add_analyte_lotNumber')?.value.trim() || `LOT-BR-${new Date().getFullYear()}-N1`,
        level: document.getElementById('add_analyte_level')?.value || 'Level 1 (Normal)'
      };

      let data = null;
      try {
        const res = await fetch(`/equipment/${eqId}/qc/analytes/preload-blood-chemistry`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (res.ok) {
          data = await res.json();
        }
      } catch (err) {
        data = null;
      }

      // If backend endpoint not found or failed, fall back to registering presets sequentially
      if (!data || !data.success) {
        const bloodChemKeys = [
          'fbs', 'rbs', 'firstHour', 'secondHour', 'hba1c',
          'chol', 'tg', 'hdl', 'ldl', 'vldl',
          'bun', 'crea', 'urea', 'uric',
          'alt', 'ast', 'alb',
          'sodium', 'potassium', 'chloride', 'calcium'
        ];
        for (const key of bloodChemKeys) {
          const p = analytePresets[key];
          if (p) {
            await fetch(`/equipment/${eqId}/qc/analytes`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify({
                controlName: payload.controlName,
                lotNumber: payload.lotNumber,
                level: payload.level,
                analyteCode: p.code,
                analyteName: p.name,
                unit: p.unit,
                targetMean: p.mean,
                targetSd: p.sd,
                teaPercent: p.tea,
                analyte: {
                  analyteCode: p.code,
                  analyteName: p.name,
                  unit: p.unit,
                  targetMean: p.mean,
                  targetSd: p.sd,
                  teaPercent: p.tea
                }
              })
            });
          }
        }
        data = { success: true, analytesCount: bloodChemKeys.length };
      }

      // Synchronize selectors to this equipment
      const ljSelect = document.getElementById('lj_analyzerSelect');
      if (ljSelect) ljSelect.value = eqId;
      const quickEq = document.getElementById('quick_eqId');
      if (quickEq) quickEq.value = eqId;

      await onLjAnalyzerChange();

      alert(`Success! Pre-added all 21 official Blood Chemistry analytes to ${eqName}.\nAll parameters are now immediately selectable for Levey-Jennings monitoring.`);
    } catch (err) {
      alert('Notice: ' + err.message);
      await onLjAnalyzerChange();
    }
  }

  async function saveNewAnalyte(e) {
    e.preventDefault();
    const eqId = document.getElementById('add_analyte_eqId').value;
    if (!eqId) {
      alert('Please select a target equipment/analyzer.');
      return;
    }

    const analyteCode = document.getElementById('add_analyte_code').value.trim().toLowerCase();
    const analyteName = document.getElementById('add_analyte_name').value.trim();
    const unit = document.getElementById('add_analyte_unit').value.trim();
    const targetMean = parseFloat(document.getElementById('add_analyte_mean').value);
    const targetSd = parseFloat(document.getElementById('add_analyte_sd').value);
    const teaPercent = parseFloat(document.getElementById('add_analyte_tea').value) || 10.0;

    if (!analyteCode || !analyteName || isNaN(targetMean) || isNaN(targetSd) || targetSd <= 0) {
      alert('Please fill out all required fields with valid numeric Mean and SD (> 0).');
      return;
    }

    const payload = {
      controlName: document.getElementById('add_analyte_ctrlName').value.trim() || 'Quality Control Material',
      lotNumber: document.getElementById('add_analyte_lotNumber').value.trim() || `LOT-${new Date().getFullYear()}-01`,
      level: document.getElementById('add_analyte_level').value,
      expirationDate: document.getElementById('add_analyte_expDate').value || null,
      analyteCode,
      analyteName,
      unit,
      targetMean,
      targetSd,
      teaPercent,
      analyte: {
        analyteCode,
        analyteName,
        unit,
        targetMean,
        targetSd,
        teaPercent
      }
    };

    // CRITICAL: Close modal popup immediately so user is never left with an open modal thinking it didn't save
    closeModal('modalAddAnalyte');
    document.getElementById('formAddAnalyte').reset();

    try {
      const res = await fetch(`/equipment/${eqId}/qc/analytes`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      // Switch quick entry and top chart to this equipment
      const ljSelect = document.getElementById('lj_analyzerSelect');
      if (ljSelect) ljSelect.value = eqId;
      const quickEq = document.getElementById('quick_eqId');
      if (quickEq) quickEq.value = eqId;

      await onLjAnalyzerChange();

      const quickAnalyte = document.getElementById('quick_analyteCode');
      if (quickAnalyte) quickAnalyte.value = analyteCode;
      const topAnalyte = document.getElementById('lj_analyteSelect');
      if (topAnalyte) topAnalyte.value = analyteCode;

      loadLjChart();

      const displayName = formatAnalyteDisplay(analyteName, analyteCode);
      if (data && data.success) {
        alert(`Analyte "${displayName}" saved and activated successfully! You can now record QC readings.`);
      } else if (data && data.error) {
        // If already added or exists, still confirm activation
        alert(`Analyte "${displayName}" is configured and active.`);
      }
    } catch (err) {
      console.error('Error saving analyte:', err);
      await onLjAnalyzerChange();
    }
  }

  async function onLjAnalyzerChange() {
    const eqId = document.getElementById('lj_analyzerSelect').value;
    if (!eqId) return;

    // Two-way synchronization: keep quick entry machine selector matched
    const quickEq = document.getElementById('quick_eqId');
    if (quickEq && quickEq.value !== eqId) {
      quickEq.value = eqId;
    }

    populateSignatoryDropdowns();

    // Fetch controls for this equipment
    const res = await fetch(`/equipment/${eqId}/qc/controls`);
    const data = await res.json();
    const analyteSelect = document.getElementById('lj_analyteSelect');
    const quickAnalyteSelect = document.getElementById('quick_analyteCode');
    analyteSelect.innerHTML = '';
    if (quickAnalyteSelect) quickAnalyteSelect.innerHTML = '';

    const controls = data.controls || [];
    currentEqControls = controls;
    const allAnalytes = [];
    controls.forEach(ctrl => {
      (ctrl.analytes || []).forEach(a => {
        if (!allAnalytes.some(x => x.analyteCode === a.analyteCode)) {
          allAnalytes.push(a);
        }
      });
    });

    if (allAnalytes.length === 0) {
      analyteSelect.innerHTML = '<option value="">-- No Analytes Configured --</option>';
      if (quickAnalyteSelect) {
        quickAnalyteSelect.innerHTML = '<option value="">-- No Analytes Configured (Click + Add Analyte) --</option>';
      }
      const env = setupLjCanvas();
      if (env) {
        const { ctx, W, H } = env;
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = '#94a3b8';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('No analytes configured for this analyzer. Click + Add Analyte below to configure one.', W / 2, H / 2);
      }
      renderLjTable({ points: [] });
      return;
    }

    // Populate analytes in both top and bottom selectors without double labels
    allAnalytes.forEach(a => {
      const opt = document.createElement('option');
      opt.value = a.analyteCode;
      opt.textContent = formatAnalyteDisplay(a.analyteName, a.analyteCode);
      analyteSelect.appendChild(opt);

      if (quickAnalyteSelect) {
        const qOpt = opt.cloneNode(true);
        quickAnalyteSelect.appendChild(qOpt);
      }
    });

    if (quickAnalyteSelect && analyteSelect.value) {
      quickAnalyteSelect.value = analyteSelect.value;
    }

    loadLjChart();
  }

  function onTopAnalyteChange() {
    const analyteCode = document.getElementById('lj_analyteSelect').value;
    const quickAnalyte = document.getElementById('quick_analyteCode');
    if (quickAnalyte) {
      quickAnalyte.value = analyteCode;
    }
    loadLjChart();
  }

  async function onQuickEquipmentChange() {
    const eqId = document.getElementById('quick_eqId').value;
    if (!eqId) return;

    // If this machine has recorded QC runs, select it in the top analyzer dropdown and load its chart
    const ljSelect = document.getElementById('lj_analyzerSelect');
    if (ljSelect && (qcEntryCounts[eqId] || 0) > 0) {
      ljSelect.value = eqId;
      return onLjAnalyzerChange();
    }

    // If this equipment has NO recorded QC data yet, fetch its configured controls for the quick entry dropdown
    try {
      const res = await fetch(`/equipment/${eqId}/qc/controls`);
      const data = await res.json();
      const quickAnalyteSelect = document.getElementById('quick_analyteCode');
      if (!quickAnalyteSelect) return;
      quickAnalyteSelect.innerHTML = '';

      const controls = data.controls || [];
      const allAnalytes = [];
      controls.forEach(ctrl => {
        (ctrl.analytes || []).forEach(a => {
          if (!allAnalytes.some(x => x.analyteCode === a.analyteCode)) {
            allAnalytes.push(a);
          }
        });
      });

      if (allAnalytes.length === 0) {
        quickAnalyteSelect.innerHTML = '<option value="">-- No analytes yet (Click + Add Analyte) --</option>';
      } else {
        allAnalytes.forEach(a => {
          const opt = document.createElement('option');
          opt.value = a.analyteCode;
          opt.textContent = formatAnalyteDisplay(a.analyteName, a.analyteCode);
          quickAnalyteSelect.appendChild(opt);
        });
      }
    } catch (err) {
      console.error('Error fetching controls for equipment:', err);
    }
  }

  function onQuickAnalyteChange() {
    const analyteCode = document.getElementById('quick_analyteCode').value;
    const eqId = document.getElementById('quick_eqId').value;
    const topEq = document.getElementById('lj_analyzerSelect')?.value;
    const topAnalyteSelect = document.getElementById('lj_analyteSelect');

    if (topEq === eqId && topAnalyteSelect && Array.from(topAnalyteSelect.options).some(o => o.value === analyteCode)) {
      topAnalyteSelect.value = analyteCode;
      loadLjChart();
    }
  }

  function setLjDatePreset(preset) {
    const startInput = document.getElementById('lj_startDate');
    const endInput = document.getElementById('lj_endDate');
    if (!startInput || !endInput) return;

    const today = new Date();
    const todayStr = today.toISOString().split('T')[0];

    if (preset === 'month') {
      const y = today.getFullYear();
      const m = String(today.getMonth() + 1).padStart(2, '0');
      startInput.value = `${y}-${m}-01`;
      const lastDay = new Date(y, today.getMonth() + 1, 0).toISOString().split('T')[0];
      endInput.value = lastDay;
    } else if (preset === '30days') {
      const past = new Date(today.getTime() - (30 * 24 * 60 * 60 * 1000));
      startInput.value = past.toISOString().split('T')[0];
      endInput.value = todayStr;
    } else if (preset === 'all') {
      startInput.value = '';
      endInput.value = '';
    }
    loadLjChart();
  }

  async function loadLjChart() {
    const eqId = document.getElementById('lj_analyzerSelect').value;
    const analyteCode = document.getElementById('lj_analyteSelect').value;
    if (!eqId || !analyteCode) return;

    const startDate = document.getElementById('lj_startDate')?.value || '';
    const endDate = document.getElementById('lj_endDate')?.value || '';

    let url = `/equipment/${eqId}/qc/levey-jennings?analyteCode=${encodeURIComponent(analyteCode)}`;
    const matchedCtrl = (currentEqControls || []).find(c => (c.level || '').includes('1') && (c.analytes || []).some(a => a.analyteCode === analyteCode))
                     || (currentEqControls || []).find(c => (c.analytes || []).some(a => a.analyteCode === analyteCode));
    if (matchedCtrl && matchedCtrl.id) {
      url += `&controlId=${encodeURIComponent(matchedCtrl.id)}`;
    }
    if (startDate) url += `&startDate=${encodeURIComponent(startDate)}`;
    if (endDate) url += `&endDate=${encodeURIComponent(endDate)}`;

    const res = await fetch(url);
    const json = await res.json();
    if (!json.success) return;

    currentLjData = json.data;
    renderLeveyJenningsCanvas(json.data);
    renderLjTable(json.data);
  }

  function renderLeveyJenningsCanvas(data) {
    const env = setupLjCanvas();
    if (!env) return;
    const { ctx, W, H } = env;

    ctx.clearRect(0, 0, W, H);

    // Update Header Text
    document.getElementById('lj_chartTitle').textContent = `${data.analyteName} (${data.unit}) - ${data.controlName} [${data.lotNumber}]`;

    let subText = `Assigned Mean: ${data.targetMean} ${data.unit} | Target SD: ${data.targetSd} | TEa: ${data.teaPercent}%`;
    if (data.filterRange && (data.filterRange.startDate || data.filterRange.endDate)) {
      subText += ` | Filtered Period: ${data.filterRange.startDate || 'Start'} to ${data.filterRange.endDate || 'Present'}`;
    }
    document.getElementById('lj_chartSubtitle').textContent = subText;
    document.getElementById('lj_runCount').textContent = `Total Runs: ${data.points ? data.points.length : 0}`;

    // Statistics Pill
    const st = data.statistics || {};
    const pills = document.getElementById('lj_statsPills');
    pills.innerHTML = `
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">Mean: ${st.observedMean !== undefined && st.observedMean !== null ? st.observedMean : '—'}</span>
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">SD: ${st.observedSd !== undefined && st.observedSd !== null ? st.observedSd : '—'}</span>
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">%CV: ${st.cvPercent || 0}%</span>
      <span class="badge ${st.inControl ? 'badge-operational' : 'badge-overdue'}">${st.inControl ? '✓ IN CONTROL' : '⚠️ OUT OF CONTROL'}</span>
    `;

    // Coordinates mapping with generous padding for high-DPI full-screen displays
    const padL = 95;
    const padR = 35;
    const padT = 30;
    const padB = 45;
    const graphW = W - padL - padR;
    const graphH = H - padT - padB;

    const mean = Number(data.targetMean) || 100;
    const sd = Number(data.targetSd) || 5;

    // Expand bounds if outliers exist so no points are clipped
    let maxAbsSd = 3.6;
    (data.points || []).forEach(p => {
      if (p.measuredValue !== undefined && p.measuredValue !== null && !isNaN(p.measuredValue) && sd > 0) {
        const dist = Math.abs(p.measuredValue - mean) / sd;
        if (dist > maxAbsSd) maxAbsSd = Math.min(dist + 0.5, 6.0);
      }
    });

    const minVal = mean - (maxAbsSd * sd);
    const maxVal = mean + (maxAbsSd * sd);

    function getY(val) {
      const normalized = (val - minVal) / (maxVal - minVal);
      return (H - padB) - (normalized * graphH);
    }

    // Reference Line Helper
    function drawRefLine(val, label, color, dash = [], isMean = false) {
      const y = getY(val);
      ctx.save();
      ctx.strokeStyle = color;
      ctx.lineWidth = isMean ? 2.0 : 1.2;
      ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(padL, y);
      ctx.lineTo(W - padR, y);
      ctx.stroke();

      ctx.setLineDash([]);
      ctx.fillStyle = color;
      ctx.font = isMean ? 'bold 11px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif' : '600 10px monospace';
      ctx.textAlign = 'right';
      ctx.textBaseline = 'middle';
      ctx.fillText(label, padL - 10, y);
      ctx.restore();
    }

    // Draw clean background
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(padL, padT, graphW, graphH);

    // Subtle green tone for in-control +-1SD zone
    const yP1 = getY(mean + 1 * sd);
    const yM1 = getY(mean - 1 * sd);
    ctx.fillStyle = 'rgba(240, 253, 244, 0.7)';
    ctx.fillRect(padL, yP1, graphW, yM1 - yP1);

    // Draw reference SD lines
    drawRefLine(mean + 3 * sd, '+3SD (' + (mean + 3 * sd).toFixed(1) + ')', '#ef4444', [5, 4]);
    drawRefLine(mean + 2 * sd, '+2SD (' + (mean + 2 * sd).toFixed(1) + ')', '#f59e0b', [5, 4]);
    drawRefLine(mean + 1 * sd, '+1SD (' + (mean + 1 * sd).toFixed(1) + ')', '#94a3b8', [3, 3]);
    drawRefLine(mean, 'MEAN (' + mean.toFixed(1) + ')', '#10b981', [], true);
    drawRefLine(mean - 1 * sd, '-1SD (' + (mean - 1 * sd).toFixed(1) + ')', '#94a3b8', [3, 3]);
    drawRefLine(mean - 2 * sd, '-2SD (' + (mean - 2 * sd).toFixed(1) + ')', '#f59e0b', [5, 4]);
    drawRefLine(mean - 3 * sd, '-3SD (' + (mean - 3 * sd).toFixed(1) + ')', '#ef4444', [5, 4]);

    // Graph bounding box
    ctx.strokeStyle = '#cbd5e1';
    ctx.lineWidth = 1;
    ctx.strokeRect(padL, padT, graphW, graphH);

    // Plot points
    const points = data.points || [];
    if (points.length === 0) {
      ctx.fillStyle = '#64748b';
      ctx.font = '14px sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('No control runs recorded for the selected period. Enter a reading below.', W / 2, H / 2);
      return;
    }

    const stepX = points.length > 1 ? graphW / (points.length - 1) : graphW / 2;

    // Draw connecting line with crisp joints
    ctx.save();
    ctx.beginPath();
    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 2.2;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    points.forEach((p, i) => {
      const x = points.length === 1 ? padL + graphW / 2 : padL + (i * stepX);
      const y = getY(p.measuredValue);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();
    ctx.restore();

    // Draw dots and violation badges
    points.forEach((p, i) => {
      const x = points.length === 1 ? padL + graphW / 2 : padL + (i * stepX);
      const y = getY(p.measuredValue);

      let dotColor = '#0284c7';
      let radius = 5;
      if (p.status === 'REJECTED') {
        dotColor = '#ef4444';
        radius = 5.5;
      } else if (p.status === 'WARNING') {
        dotColor = '#f59e0b';
        radius = 5;
      }

      ctx.save();
      ctx.beginPath();
      ctx.fillStyle = dotColor;
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 2;
      ctx.stroke();
      ctx.restore();

      // X-axis day label (smart thinning when many points are plotted to prevent collision)
      const step = points.length > 35 ? Math.ceil(points.length / 20) : (points.length > 20 ? 2 : 1);
      if (i === 0 || i === points.length - 1 || (i % step === 0)) {
        const d = new Date(p.runDate);
        ctx.save();
        ctx.fillStyle = '#64748b';
        ctx.font = '600 10px sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText(`${d.getDate()}/${d.getMonth()+1}`, x, H - padB + 10);
        ctx.restore();
      }

      // Violation label flag if rejected or warning
      if (p.rulesViolated && p.rulesViolated.length > 0) {
        const ruleText = p.rulesViolated.join(',');
        ctx.save();
        ctx.font = 'bold 9px sans-serif';
        const txtW = ctx.measureText(ruleText).width;
        const bW = txtW + 8;
        const bH = 15;
        const bX = x - bW / 2;
        const bY = y - 22;

        ctx.fillStyle = p.status === 'REJECTED' ? '#fee2e2' : '#fef3c7';
        ctx.strokeStyle = p.status === 'REJECTED' ? '#ef4444' : '#f59e0b';
        ctx.lineWidth = 1;
        ctx.beginPath();
        if (ctx.roundRect) {
          ctx.roundRect(bX, bY, bW, bH, 3);
        } else {
          ctx.rect(bX, bY, bW, bH);
        }
        ctx.fill();
        ctx.stroke();

        ctx.fillStyle = p.status === 'REJECTED' ? '#b91c1c' : '#b45309';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(ruleText, x, bY + bH / 2);
        ctx.restore();
      }
    });
  }

  function renderLjTable(data) {
    const tableBody = document.getElementById('lj_tableBody');
    const runCountBadge = document.getElementById('lj_tableRunCount');
    if (!tableBody) return;

    const sourceData = data || currentLjData;
    if (!sourceData || !sourceData.points) {
      tableBody.innerHTML = '<tr><td colspan="10" style="text-align: center; color: #64748b; padding: 20px;">No QC run data loaded.</td></tr>';
      if (runCountBadge) runCountBadge.textContent = '0 Runs';
      return;
    }

    let pts = [...(sourceData.points || [])];
    const statusFilter = document.getElementById('lj_statusFilter')?.value || '';
    if (statusFilter) {
      pts = pts.filter(p => p.status === statusFilter);
    }

    const sortOrder = document.getElementById('lj_sortOrder')?.value || 'date_desc';
    if (sortOrder === 'date_desc') {
      pts.sort((a, b) => new Date(b.runDate) - new Date(a.runDate));
    } else if (sortOrder === 'date_asc') {
      pts.sort((a, b) => new Date(a.runDate) - new Date(b.runDate));
    } else if (sortOrder === 'zscore_desc') {
      pts.sort((a, b) => Math.abs(b.zScore || 0) - Math.abs(a.zScore || 0));
    } else if (sortOrder === 'violations_first') {
      const statusWeight = { 'REJECTED': 3, 'WARNING': 2, 'ACCEPTED': 1 };
      pts.sort((a, b) => {
        const diff = (statusWeight[b.status] || 0) - (statusWeight[a.status] || 0);
        if (diff !== 0) return diff;
        return new Date(b.runDate) - new Date(a.runDate);
      });
    }

    if (runCountBadge) {
      runCountBadge.textContent = `${pts.length} Run${pts.length === 1 ? '' : 's'}`;
    }

    if (pts.length === 0) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="10" style="text-align: center; color: #64748b; padding: 24px;">
            <i class="fa fa-info-circle" style="color: #0284c7; margin-right: 6px;"></i>
            No control runs match the selected date range and filter criteria.
          </td>
        </tr>
      `;
      return;
    }

    const rowsHtml = pts.map((p, idx) => {
      const d = p.runDate ? new Date(p.runDate) : null;
      const dateStr = d ? d.toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) : '—';

      // Z-Score badge
      let zBadge = '<span style="color:#94a3b8;">—</span>';
      if (p.zScore !== null && p.zScore !== undefined && !isNaN(p.zScore)) {
        const z = Number(p.zScore);
        const absZ = Math.abs(z);
        const sign = z > 0 ? '+' : '';
        const text = `${sign}${z.toFixed(2)} SD`;
        if (absZ > 3.0) {
          zBadge = `<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:700;">${text}</span>`;
        } else if (absZ > 2.0) {
          zBadge = `<span class="badge" style="background:#fef3c7; color:#b45309; font-weight:700;">${text}</span>`;
        } else if (absZ > 1.0) {
          zBadge = `<span class="badge" style="background:#e0f2fe; color:#0369a1;">${text}</span>`;
        } else {
          zBadge = `<span class="badge" style="background:#dcfce7; color:#15803d;">${text}</span>`;
        }
      }

      // Status badge
      let statusBadge = '<span class="badge badge-operational">✓ Accepted</span>';
      if (p.status === 'WARNING') {
        statusBadge = '<span class="badge badge-maintenance">⚠️ Warning (1:2s)</span>';
      } else if (p.status === 'REJECTED') {
        statusBadge = '<span class="badge badge-overdue">❌ Rejected</span>';
      }

      // Violations
      let violationsHtml = '<span style="color:#94a3b8; font-size: 0.85em;">None</span>';
      if (p.rulesViolated && Array.isArray(p.rulesViolated) && p.rulesViolated.length > 0) {
        violationsHtml = p.rulesViolated.map(r => `<span class="badge" style="background:#fee2e2; color:#b91c1c; font-weight:700; font-size:0.78em;">${escapeHtml(r)}</span>`).join(' ');
      }

      // Action column
      let actionHtml = '';
      if (typeof canEditEquipment !== 'undefined' && canEditEquipment) {
        actionHtml = `
          <td style="text-align: right;">
            <button type="button" class="button btn-small btn-secondary" onclick="deleteQcEntryRecord('${p.id}')" style="color:#dc2626; border-color:#fca5a5; padding: 2px 8px; font-size: 0.78em;" title="Delete this QC run record">
              <i class="fa fa-trash"></i>
            </button>
          </td>
        `;
      }

      return `
        <tr>
          <td style="font-weight: 600; color: #64748b;">${idx + 1}</td>
          <td><strong style="color: #1e293b;">${dateStr}</strong></td>
          <td><strong style="color: #0f172a; font-size: 1.05em;">${p.measuredValue}</strong> <span style="font-size: 0.85em; color: #64748b;">${escapeHtml(sourceData.unit || '')}</span></td>
          <td style="color: #475569; font-size: 0.9em;">Mean: ${sourceData.targetMean} (&plusmn;${sourceData.targetSd})</td>
          <td>${zBadge}</td>
          <td>${statusBadge}</td>
          <td>${violationsHtml}</td>
          <td style="font-family: monospace; font-size: 0.85em; color: #334155;">${escapeHtml(p.reagentLotNumber || sourceData.lotNumber || '—')}</td>
          <td style="font-size: 0.85em; color: #475569;">${p.notes ? escapeHtml(p.notes) : '<span style="color:#94a3b8;">—</span>'}</td>
          ${actionHtml}
        </tr>
      `;
    }).join('');

    tableBody.innerHTML = rowsHtml;
  }

  async function deleteQcEntryRecord(entryId) {
    if (!entryId) return;
    if (!confirm('Are you sure you want to delete this QC run measurement? This action will permanently remove the record and re-evaluate Westgard statistics.')) {
      return;
    }

    try {
      const res = await fetch(`/equipment/qc/entries/${entryId}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      });
      const data = await res.json();
      if (data.success) {
        loadLjChart();
      } else {
        alert(data.error || 'Failed to delete QC entry record.');
      }
    } catch (err) {
      alert('Error deleting QC entry: ' + err.message);
    }
  }

  async function deleteLastQcEntry() {
    const eqId = document.getElementById('quick_eqId').value || document.getElementById('lj_analyzerSelect').value;
    const analyteCode = document.getElementById('quick_analyteCode').value || document.getElementById('lj_analyteSelect').value;
    if (!eqId || !analyteCode) {
      alert('Please select an analyzer and analyte first.');
      return;
    }

    if (!confirm(`Drop / delete the most recent QC run reading for "${analyteCode.toUpperCase()}"?`)) {
      return;
    }

    try {
      // 1. Try dedicated endpoint
      let res = await fetch(`/equipment/${eqId}/qc/entries/last?analyteCode=${encodeURIComponent(analyteCode)}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      });
      let data = await res.json().catch(() => null);

      // 2. Fallback to deleting the last point ID from currentLjData
      if (!data || !data.success) {
        if (currentLjData && Array.isArray(currentLjData.points) && currentLjData.points.length > 0) {
          const lastPoint = currentLjData.points[currentLjData.points.length - 1];
          if (lastPoint && lastPoint.id) {
            res = await fetch(`/equipment/qc/entries/${lastPoint.id}`, {
              method: 'DELETE',
              headers: { 'Accept': 'application/json' }
            });
            data = await res.json().catch(() => null);
          }
        }
      }

      if (data && data.success) {
        loadLjChart();
        const box = document.getElementById('qc_alertBox');
        if (box) {
          box.style.display = 'block';
          box.style.background = '#fef2f2';
          box.style.color = '#991b1b';
          box.innerHTML = `<strong><i class="fa fa-trash"></i> Dropped:</strong> Previous QC entry removed successfully.`;
        }
      } else {
        alert((data && data.error) || 'No previous entry found to drop.');
      }
    } catch (err) {
      alert('Error dropping previous entry: ' + err.message);
    }
  }

  async function emptyAnalyteEntries() {
    const eqId = document.getElementById('lj_analyzerSelect').value || document.getElementById('quick_eqId').value;
    const analyteCode = document.getElementById('lj_analyteSelect').value || document.getElementById('quick_analyteCode').value;
    if (!eqId || !analyteCode) {
      alert('Please select an analyzer and analyte first.');
      return;
    }

    const confirmed = confirm(`Are you sure you want to EMPTY / DELETE ALL recorded QC runs for "${analyteCode.toUpperCase()}" on this analyzer?\n\nThis will reset the Levey-Jennings chart and run log for testing. This action cannot be undone.`);
    if (!confirmed) return;

    try {
      // 1. Try bulk delete endpoint
      let res = await fetch(`/equipment/${eqId}/qc/entries?analyteCode=${encodeURIComponent(analyteCode)}`, {
        method: 'DELETE',
        headers: { 'Accept': 'application/json' }
      });
      let data = await res.json().catch(() => null);

      // 2. Fallback to deleting each point in currentLjData sequentially if bulk route not yet available
      if (!data || !data.success) {
        if (currentLjData && Array.isArray(currentLjData.points) && currentLjData.points.length > 0) {
          for (const pt of currentLjData.points) {
            if (pt.id) {
              await fetch(`/equipment/qc/entries/${pt.id}`, {
                method: 'DELETE',
                headers: { 'Accept': 'application/json' }
              });
            }
          }
          data = { success: true };
        }
      }

      if (data && data.success) {
        loadLjChart();
        alert(`All QC runs for "${analyteCode.toUpperCase()}" have been emptied successfully.`);
      } else {
        alert((data && data.error) || 'Failed to empty QC runs.');
      }
    } catch (err) {
      alert('Error emptying QC runs: ' + err.message);
    }
  }

  async function submitQuickQc(e) {
    e.preventDefault();
    const eqId = document.getElementById('quick_eqId').value || document.getElementById('lj_analyzerSelect').value;
    const analyteCode = document.getElementById('quick_analyteCode').value || document.getElementById('lj_analyteSelect').value;
    const val = parseFloat(document.getElementById('qc_value').value);
    const date = document.getElementById('qc_date').value;
    const lot = document.getElementById('qc_lot').value;
    const notes = document.getElementById('qc_notes').value;

    if (!eqId || !analyteCode || isNaN(val)) {
      alert('Please select analyzer, analyte, and enter a valid measured value.');
      return;
    }

    try {
      // Find control id matching analyteCode if available
      const resCtrls = await fetch(`/equipment/${eqId}/qc/controls`);
      const dataCtrls = await resCtrls.json();
      const ctrl = (dataCtrls.controls || []).find(c => (c.analytes || []).some(a => a.analyteCode === analyteCode)) || (dataCtrls.controls || [])[0];

      const res = await fetch(`/equipment/${eqId}/qc/entries`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          controlId: ctrl ? ctrl.id : undefined,
          analyteCode,
          measuredValue: val,
          runDate: date,
          reagentLotNumber: lot,
          notes
        })
      });

      const data = await res.json();
      const box = document.getElementById('qc_alertBox');
      box.style.display = 'block';

      if (data.success) {
        const ev = data.evaluation;
        if (ev.status === 'ACCEPTED') {
          box.style.background = '#dcfce7';
          box.style.color = '#15803d';
          box.innerHTML = `<strong>✓ Accepted:</strong> Reading ${val} recorded (Z-score: ${ev.zScore}). Within &plusmn;2SD.`;
        } else if (ev.status === 'WARNING') {
          box.style.background = '#fef3c7';
          box.style.color = '#b45309';
          box.innerHTML = `<strong>⚠️ Warning (${ev.rulesViolated.join(', ')}):</strong> ${ev.explanation}`;
        } else {
          box.style.background = '#fee2e2';
          box.style.color = '#b91c1c';
          box.innerHTML = `<strong>❌ REJECTED (${ev.rulesViolated.join(', ')}):</strong> ${ev.explanation} <br><em>Action Required: Check reagent, recalibrate, or run fresh control.</em>`;
        }
        document.getElementById('qc_value').value = '';

        // Increment run count and refresh top dropdown so new machine appears immediately
        qcEntryCounts[eqId] = (qcEntryCounts[eqId] || 0) + 1;
        populateAnalyzerDropdowns();

        const topEq = document.getElementById('lj_analyzerSelect');
        if (topEq) topEq.value = eqId;
        const topAnalyte = document.getElementById('lj_analyteSelect');
        if (topAnalyte) topAnalyte.value = analyteCode;

        loadLjChart();
      } else {
        box.style.background = '#fee2e2';
        box.style.color = '#b91c1c';
        box.textContent = data.error || 'Failed to record entry.';
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }

  function printLjReport() {
    const eqId = document.getElementById('lj_analyzerSelect').value;
    const analyteCode = document.getElementById('lj_analyteSelect').value;
    if (!eqId) {
      alert('Please select an equipment analyzer first.');
      return;
    }
    const params = new URLSearchParams();
    if (analyteCode) params.set('analyteCode', analyteCode);

    const startDate = document.getElementById('lj_startDate')?.value;
    const endDate = document.getElementById('lj_endDate')?.value;
    if (startDate) params.set('startDate', startDate);
    if (endDate) params.set('endDate', endDate);

    const opSel = document.getElementById('lj_operatorSelect');
    const valSel = document.getElementById('lj_validatorSelect');
    const p1Sel = document.getElementById('lj_pathologistSelect');
    const p2Sel = document.getElementById('lj_pathologist2Select');

    const opOpt = opSel ? opSel.options[opSel.selectedIndex] : null;
    const valOpt = valSel ? valSel.options[valSel.selectedIndex] : null;
    const p1Opt = p1Sel ? p1Sel.options[p1Sel.selectedIndex] : null;
    const p2Opt = p2Sel ? p2Sel.options[p2Sel.selectedIndex] : null;

    if (opOpt && opOpt.dataset.name) {
      params.set('operatorName', opOpt.dataset.name);
      if (opOpt.dataset.license) params.set('operatorLicense', opOpt.dataset.license);
    }
    if (valOpt && valOpt.dataset.name) {
      params.set('validatorName', valOpt.dataset.name);
      if (valOpt.dataset.license) params.set('validatorLicense', valOpt.dataset.license);
    }
    if (p1Opt && p1Opt.dataset.name) {
      params.set('pathologistName', p1Opt.dataset.name);
      if (p1Opt.dataset.license) params.set('pathologistLicense', p1Opt.dataset.license);
    }

    const hasP2 = document.getElementById('lj_enablePathologist2')?.checked;
    if (hasP2 && p2Opt && p2Opt.dataset.name) {
      params.set('hasPathologist2', '1');
      params.set('pathologist2Name', p2Opt.dataset.name);
      if (p2Opt.dataset.license) params.set('pathologist2License', p2Opt.dataset.license);
    }

    const url = `/equipment/${eqId}/qc/print?${params.toString()}`;
    window.open(url, '_blank');
  }

