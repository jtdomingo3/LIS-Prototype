  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatAnalyteDisplay(name, code) {
    if (!name) return (code || '').toUpperCase();
    const trimmed = String(name).trim();
    const upperCode = (code || '').trim().toUpperCase();

    // If the name already contains parentheses with an acronym/formula, e.g. "(ALB)", "(BUN)", "(FBS)", "(HbA1c)", "(HDL-C)", "(OGTT)", "(Na+)", "(K+)", "(Cl-)", "(Ca2+)", "(WBC)"
    if (trimmed.includes('(') && trimmed.includes(')')) {
      return trimmed;
    }

    // If the name already contains the code with a slash or boundary, e.g. "SGPT / ALT" or "SGOT / AST"
    if (upperCode && (trimmed.toUpperCase().includes('/ ' + upperCode) || trimmed.toUpperCase().includes(upperCode + ' /'))) {
      return trimmed;
    }

    // If the code is an internal code longer than 5 chars (like "firsthour", "secondhour"), don't append it
    if (upperCode.length > 5) {
      return trimmed;
    }

    // Otherwise append the uppercase standard code: e.g. "Total Cholesterol (CHOL)", "Creatinine (CREA)", "Triglycerides (TG)", "Blood Urea (UREA)"
    return upperCode ? `${trimmed} (${upperCode})` : trimmed;
  }

