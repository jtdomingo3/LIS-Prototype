          <div class="form-group">
            <label>Model Number</label>
            <input type="text" id="eq_modelNumber" placeholder="e.g. BS-240, MobileDaRt MX7">
          </div>
          <div class="form-group">
            <label>Serial Number *</label>
            <input type="text" id="eq_serialNumber" required placeholder="e.g. SN-88319024">
          </div>
          <div class="form-group">
