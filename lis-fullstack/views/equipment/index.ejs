              <option value="FAIL">FAIL (Out of Tolerance - Label Out of Service)</option>
            </select>
          </div>
        </div>

        <!-- X-Ray Specific Performance Readings -->
        <div id="logXraySection" style="display: none; margin-top: 16px; padding: 14px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;">
          <h4 style="margin: 0 0 10px; color: #92400e;">X-Ray Physics Measurements (DOH / AAPM Standards)</h4>
          <div class="form-grid">
            <div class="form-group">
              <label>kVp Accuracy (% Error, limit ±5%)</label>
              <input type="number" step="0.1" id="log_kvpErr" placeholder="e.g. -0.8%">
            </div>
            <div class="form-group">
              <label>Exposure Linearity Col (limit &le;0.10)</label>
              <input type="number" step="0.01" id="log_col" placeholder="e.g. 0.04">
            </div>
            <div class="form-group">
              <label>Half-Value Layer HVL (mm Al)</label>
              <input type="number" step="0.1" id="log_hvl" placeholder="e.g. 2.8">
