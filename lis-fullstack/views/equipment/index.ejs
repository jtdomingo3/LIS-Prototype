  async function loadNeqasTable() {
    try {
      const res = await fetch('/equipment/neqas/all');
      const json = await res.json();
      allNeqasRecords = json.records || [];

      // Update KPI metrics
      const total = allNeqasRecords.length;
      const evaluated = allNeqasRecords.filter(r => r.nrlEvaluation && r.nrlEvaluation.sdi !== null && r.nrlEvaluation.sdi !== undefined);
      const acceptable = allNeqasRecords.filter(r => r.isAcceptable || (r.nrlEvaluation && r.nrlEvaluation.evaluationGrade === 'ACCEPTABLE')).length;
      const questionable = allNeqasRecords.filter(r => r.status === 'EVALUATED_QUESTIONABLE' || (r.nrlEvaluation && r.nrlEvaluation.evaluationGrade === 'QUESTIONABLE')).length;
      const unsatisfactory = allNeqasRecords.filter(r => r.isUnsatisfactory || (r.nrlEvaluation && r.nrlEvaluation.evaluationGrade === 'UNSATISFACTORY')).length;

      const accRate = evaluated.length > 0 ? Math.round((acceptable / evaluated.length) * 100) + '%' : '100%';

      const kpiTot = document.getElementById('neqasKpiTotal');
      const kpiAcc = document.getElementById('neqasKpiAcceptable');
      const kpiQue = document.getElementById('neqasKpiQuestionable');
      const kpiUns = document.getElementById('neqasKpiUnsatisfactory');

      if (kpiTot) kpiTot.textContent = total;
      if (kpiAcc) kpiAcc.textContent = accRate;
      if (kpiQue) kpiQue.textContent = questionable;
      if (kpiUns) kpiUns.textContent = unsatisfactory;

      applyNeqasFilters();
    } catch (err) {
      console.error('Error loading NEQAS records:', err);
    }
  }

  function applyNeqasFilters() {
    const q = (document.getElementById('neqasSearchInput')?.value || '').toLowerCase();
    const nrlFilter = document.getElementById('neqasNrlFilter')?.value || '';
    const gradeFilter = document.getElementById('neqasGradeFilter')?.value || '';

    let filtered = allNeqasRecords;
    if (q) {
      filtered = filtered.filter(r =>
        (r.sampleId || '').toLowerCase().includes(q) ||
        (r.analyteName || '').toLowerCase().includes(q) ||
        (r.nrlName || '').toLowerCase().includes(q)
      );
    }
    if (nrlFilter) {
      filtered = filtered.filter(r => (r.nrlName || '').toLowerCase().includes(nrlFilter.toLowerCase()));
    }
    if (gradeFilter) {
      if (gradeFilter === 'PENDING') {
        filtered = filtered.filter(r => !r.nrlEvaluation || r.nrlEvaluation.sdi === null || r.nrlEvaluation.sdi === undefined);
      } else {
        filtered = filtered.filter(r => {
          const g = (r.nrlEvaluation && r.nrlEvaluation.evaluationGrade) || r.status || '';
          return g.toUpperCase().includes(gradeFilter);
        });
      }
    }

    renderNeqasSectionTable(filtered);
  }

  function filterNeqasByNrl(nrlKeyword) {
    switchSection('neqas');
    const nrlSel = document.getElementById('neqasNrlFilter');
    if (nrlSel) nrlSel.value = nrlKeyword;
    applyNeqasFilters();
  }

  function renderNeqasSectionTable(records) {
    const tbody = document.getElementById('neqasSectionTableBody');
    if (!tbody) return;
    tbody.innerHTML = '';

    if (!records || records.length === 0) {
      tbody.innerHTML = '<tr><td colspan="9" style="text-align:center; padding:24px; color:#64748b;"><i class="fa fa-info-circle"></i> No NEQAS proficiency records found. Click <strong>"+ Log Survey Submission"</strong> to add an EQA survey.</td></tr>';
      return;
    }

    records.forEach(r => {
      const tr = document.createElement('tr');
      const evalData = r.nrlEvaluation || {};
      const sdi = evalData.sdi !== null && evalData.sdi !== undefined ? evalData.sdi : null;
      const grade = evalData.evaluationGrade || r.status || 'PENDING';

      let gradeBadge = '<span class="badge" style="background:#fef3c7; color:#b45309; border:1px solid #fbbf24;">⏳ Pending Peer Eval</span>';
      if (grade === 'ACCEPTABLE') {
        gradeBadge = '<span class="badge-operational">✓ ACCEPTABLE</span>';
      } else if (grade === 'QUESTIONABLE' || grade === 'EVALUATED_QUESTIONABLE') {
        gradeBadge = '<span class="badge-duesoon">⚠️ QUESTIONABLE</span>';
      } else if (grade === 'UNSATISFACTORY' || grade === 'ACTION_REQUIRED') {
        gradeBadge = '<span class="badge-overdue">❌ ACTION REQUIRED</span>';
      }

      let sdiDisplay = '<span style="color:#64748b;">—</span>';
      if (sdi !== null) {
        const abs = Math.abs(sdi);
        const sdiColor = abs <= 2 ? '#16a34a' : (abs < 3 ? '#d97706' : '#dc2626');
        const sdiBg = abs <= 2 ? '#dcfce7' : (abs < 3 ? '#fef3c7' : '#fee2e2');
        sdiDisplay = `<span style="font-family:monospace; font-weight:700; background:${sdiBg}; color:${sdiColor}; padding:2px 6px; border-radius:4px;">${sdi > 0 ? '+' : ''}${sdi}</span>`;
      }

      let nrlShort = r.nrlName || 'NRL';
      if (nrlShort.includes('Lung Center')) nrlShort = 'LCP (Clinical Chemistry)';
      else if (nrlShort.includes('Kidney')) nrlShort = 'NKTI (Hematology)';
      else if (nrlShort.includes('Tropical')) nrlShort = 'RITM (Microbiology)';
      else if (nrlShort.includes('San Lazaro') || nrlShort.includes('SACCL')) nrlShort = 'SACCL (Serology)';

      tr.innerHTML = `
        <td><span style="font-weight:600; color:#0f172a;">${r.cycleYear || '2026'}</span> <span style="font-size:0.8em; color:#64748b;">(${r.eventNumber || 'Event 1'})</span></td>
        <td><span class="badge" style="background:#f1f5f9; color:#334155; font-size:0.8em;">${nrlShort}</span></td>
        <td><span style="font-family:monospace; font-weight:700; color:#0284c7; background:#e0f2fe; padding:2px 6px; border-radius:4px;">${r.sampleId}</span></td>
        <td><strong>${r.analyteName || r.analyteCode}</strong></td>
        <td><span style="font-weight:700; color:#0f172a;">${r.reportedValue}</span> <span style="font-size:0.8em; color:#64748b;">${r.unit || 'mg/dL'}</span></td>
        <td>${evalData.peerMean ? `${evalData.peerMean} &plusmn; ${evalData.peerSd} ${r.unit || ''}` : '<span style="color:#94a3b8;">Pending Release</span>'}</td>
        <td style="text-align:center;">${sdiDisplay}</td>
        <td>${gradeBadge}</td>
        <td style="text-align:right; white-space:nowrap;">
          <a href="/equipment/neqas/${r.id}/print" target="_blank" class="button btn-small btn-primary" style="background:#10b981; border-color:#059669; text-decoration:none; display:inline-flex; align-items:center; gap:4px; font-weight:600;" title="Print Official NEQAS Performance Certificate">
            <i class="fa fa-print"></i> 🖨️ Print Certificate
          </a>
          <button type="button" class="button btn-small btn-secondary" onclick="openNeqasEditModal('${r.id}')" title="Enter / Update NRL Peer Mean & SD" style="margin-left:4px;">
            <i class="fa fa-pen"></i> Peer Result
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }

  async function submitNeqas(e) {
    e.preventDefault();
    const recordId = document.getElementById('neqas_recordId').value;
    const eqId = document.getElementById('neqas_eqId').value;
    const payload = {
      cycleYear: document.getElementById('neqas_year').value,
      nrlName: document.getElementById('neqas_nrl').value,
      sampleId: document.getElementById('neqas_sampleId').value,
      analyteCode: document.getElementById('neqas_analyte').value,
      analyteName: document.getElementById('neqas_analyte').value,
      reportedValue: parseFloat(document.getElementById('neqas_reported').value),
      peerMean: parseFloat(document.getElementById('neqas_peerMean').value) || null,
      peerSd: parseFloat(document.getElementById('neqas_peerSd').value) || null
    };

    try {
      let url = `/equipment/${eqId}/neqas`;
      let method = 'POST';
      if (recordId) {
        url = `/equipment/neqas/${recordId}`;
        method = 'PUT';
      }

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        closeModal('modalNeqas');
        document.getElementById('formNeqas').reset();
        await loadNeqasTable();
        alert('NEQAS proficiency record saved successfully!');
      } else {
        alert(data.error || 'Failed to save NEQAS entry.');
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }

  // ==========================================
  // X-RAY & ALERTS MODALS
  // ==========================================
  async function openXrayModal() {
    const res = await fetch('/equipment/xray/compliance');
    const data = await res.json();
    alert(`Radiation Safety & X-Ray Compliance:\nTotal Units: ${data.totalXrayUnits}\nStandard: ${data.standard}\n\nAll diagnostic X-ray units are registered with FDA CDRRHR and monitored for exposure linearity (Col <= 0.10) and radiation leakage limits.`);
  }

  async function openAlertsModal() {
    const res = await fetch('/equipment/alerts/upcoming');
    const data = await res.json();
    let msg = `Equipment Deadlines Alert Summary:\nTotal Pending Alerts: ${data.totalAlerts}\n\n`;
    if (data.calibrationAlerts.length > 0) {
      msg += '--- Calibration Alerts ---\n';
      data.calibrationAlerts.forEach(a => {
        msg += `• [${a.equipmentCode}] ${a.name}: ${a.isOverdue ? 'OVERDUE by ' + Math.abs(a.daysUntilCalibration) + 'd' : 'Due in ' + a.daysUntilCalibration + 'd'} (${new Date(a.nextCalibrationDate).toLocaleDateString()})\n`;
      });
    } else {
      msg += '✓ All calibrations are up-to-date.\n';
    }
    alert(msg);
  }
</script>
