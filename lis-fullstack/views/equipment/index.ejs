  function autoDeriveAnalyteCode() {
    const name = document.getElementById('add_analyte_name').value.trim();
    const codeInput = document.getElementById('add_analyte_code');
    if (!codeInput) return;

    const match = name.match(/\(([A-Za-z0-9\+\-]+)\)/);
    if (match && match[1]) {
      codeInput.value = match[1].toLowerCase();
    } else if (!codeInput.value || codeInput.dataset.autoderived === '1') {
      const parts = name.split(/\s+/);
      if (parts.length === 1) {
        codeInput.value = parts[0].substring(0, 4).toLowerCase();
      } else {
        codeInput.value = parts.map(p => p.charAt(0)).join('').substring(0, 4).toLowerCase();
      }
      codeInput.dataset.autoderived = '1';
    }
  }

