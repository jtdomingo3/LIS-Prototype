<!-- MODAL 1: REGISTER / EDIT EQUIPMENT                      -->
<!-- ======================================================== -->
<div id="modalEquipment" class="eq-modal">
  <div class="eq-modal-content">
    <div class="eq-modal-header">
      <h3 id="modalEqTitle" style="margin: 0; font-size: 1.15em;">Register Laboratory Equipment</h3>
      <button type="button" onclick="closeModal('modalEquipment')" style="background:none; border:none; font-size:1.4em; cursor:pointer;">&times;</button>
    </div>
    <form id="formEquipment" onsubmit="saveEquipment(event)">
      <input type="hidden" id="eq_id">
      <div class="eq-modal-body">
        <div class="form-grid">
          <div class="form-group">
            <label>Asset Code / Tag *</label>
            <input type="text" id="eq_code" required placeholder="e.g. EQ-CHEM-001, EQ-XRAY-001">
          </div>
          <div class="form-group">
            <label>Equipment Name *</label>
            <input type="text" id="eq_name" required placeholder="e.g. Mindray BS-240 Clinical Chemistry Analyzer">
          </div>
          <div class="form-group">
            <label>Category *</label>
            <select id="eq_category" required onchange="handleCategoryChange()">
              <option value="Clinical Chemistry Analyzer">Clinical Chemistry Analyzer</option>
              <option value="Hematology Analyzer">Hematology Analyzer</option>
              <option value="Diagnostic X-Ray Unit (Stationary)">Diagnostic X-Ray Unit (Stationary)</option>
              <option value="Diagnostic X-Ray Unit (Mobile/Portable)">Diagnostic X-Ray Unit (Mobile/Portable)</option>
              <option value="Ultrasound / 2D Echo Unit">Ultrasound / 2D Echo Unit</option>
              <option value="Coagulation Analyzer">Coagulation Analyzer</option>
              <option value="Electrolyte Analyzer">Electrolyte Analyzer</option>
              <option value="Centrifuge">Centrifuge</option>
              <option value="Biosafety Cabinet / Laminar Flow">Biosafety Cabinet / Laminar Flow</option>
              <option value="Laboratory Refrigerator / Freezer">Laboratory Refrigerator / Freezer</option>
              <option value="Autoclave / Sterilizer">Autoclave / Sterilizer</option>
              <option value="General Equipment">General Equipment</option>
              <option value="OTHER">Other / Not Listed (Specify Below)</option>
            </select>
          </div>
          <div class="form-group" id="eq_customCategoryGroup" style="display: none;">
            <label>Specify Equipment Category *</label>
            <input type="text" id="eq_customCategory" placeholder="e.g. Urine Analyzer, Water Bath, Microplate Washer">
          </div>
          <div class="form-group">
            <label>Department / Section *</label>
            <select id="eq_department" required>
              <option value="Clinical Chemistry">Clinical Chemistry</option>
              <option value="Hematology">Hematology</option>
              <option value="Clinical Microscopy">Clinical Microscopy</option>
              <option value="Radiology / X-Ray">Radiology / X-Ray</option>
              <option value="Cardiology">Cardiology</option>
              <option value="Microbiology">Microbiology</option>
              <option value="General Laboratory">General Laboratory</option>
            </select>
          </div>
          <div class="form-group">
            <label>Manufacturer / Brand</label>
            <input type="text" id="eq_manufacturer" placeholder="e.g. Mindray, Sysmex, Shimadzu">
          </div>
          <div class="form-group">
            <label>Model Number</label>
            <input type="text" id="eq_modelNumber" placeholder="e.g. BS-240, MobileDaRt MX7">
          </div>
          <div class="form-group">
            <label>Serial Number *</label>
            <input type="text" id="eq_serialNumber" required placeholder="e.g. SN-88319024">
          </div>
          <div class="form-group">
            <label>Location / Room</label>
            <input type="text" id="eq_location" placeholder="e.g. Main Chemistry Bench A, X-Ray Room 1">
          </div>
          <div class="form-group">
            <label>Calibration Cycle (Days)</label>
            <input type="number" id="eq_calCycle" value="365" placeholder="Default 365 (Annual)">
          </div>
          <div class="form-group">
            <label>Last Calibration Date</label>
            <input type="date" id="eq_lastCalDate">
          </div>
          <div class="form-group">
            <label>PM Cycle (Days)</label>
            <input type="number" id="eq_pmCycle" value="180" placeholder="Default 180 (Semi-annual)">
          </div>
          <div class="form-group">
            <label>Last PM Date</label>
            <input type="date" id="eq_lastPmDate">
          </div>
        </div>

        <!-- Diagnostic X-Ray Specific Radiation Safety Fields (DOH AO 2020-0035 / FDA CDRRHR) -->
        <div id="xraySpecificFields" style="display: none; margin-top: 20px; padding: 16px; background: #fffbeb; border: 1px solid #fde68a; border-radius: 8px;">
          <h4 style="margin: 0 0 12px; color: #92400e; display: flex; align-items: center; gap: 8px;">
            <i class="fa fa-radiation"></i> Diagnostic X-Ray Radiation Safety Details (FDA CDRRHR)
          </h4>
          <div class="form-grid">
            <div class="form-group">
              <label>FDA CDRRHR Registration / Permit #</label>
              <input type="text" id="xray_fdaReg" placeholder="e.g. FDA-CDRRHR-XR-2026-0419">
            </div>
            <div class="form-group">
              <label>Radiation Safety Officer (RSO)</label>
              <input type="text" id="xray_rso" placeholder="e.g. Engr. J. Santos, RSO">
            </div>
            <div class="form-group">
              <label>X-Ray Tube Model & Serial #</label>
              <input type="text" id="xray_tube" placeholder="e.g. Varian Rad-14 / TB-884102">
            </div>
            <div class="form-group">
              <label>Max kVp / Max mA Rating</label>
              <input type="text" id="xray_ratings" placeholder="e.g. 150 kVp / 500 mA">
            </div>
          </div>
        </div>

        <div class="form-group" style="margin-top: 16px;">
          <label>Operating Notes & Restrictions</label>
          <textarea id="eq_notes" rows="2" placeholder="Traceability references, authorized operators, special requirements..."></textarea>
        </div>
      </div>
      <div class="eq-modal-footer">
        <button type="button" class="button btn-secondary" onclick="closeModal('modalEquipment')">Cancel</button>
        <button type="submit" class="button btn-primary">Save Equipment</button>
      </div>
    </form>
  </div>
</div>

