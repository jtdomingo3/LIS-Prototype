      <div class="eq-modal-footer">
        <button type="button" class="button btn-secondary" onclick="closeModal('modalLog')">Cancel</button>
        <button type="submit" class="button btn-primary">Save & Recalculate Next Due Date</button>
      </div>
    </form>
  </div>
</div>

