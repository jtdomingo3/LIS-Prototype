            <label>Service Date *</label>
            <input type="date" id="log_date" required>
          </div>
          <div class="form-group">
            <label>Service Provider Type *</label>
            <select id="log_providerType" required>
              <option value="Accredited Metrology Body / Calibration Service">Accredited Metrology Body / Calibration Service</option>
              <option value="Manufacturer Engineer">Manufacturer / Authorized Engineer</option>
              <option value="DOH / FDA Certified Physicist">DOH / FDA Certified Physicist</option>
              <option value="Internal Staff">Internal Biomedical Staff</option>
