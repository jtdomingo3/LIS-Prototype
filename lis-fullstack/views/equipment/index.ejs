          </div>
          <div class="form-group">
            <label>Service Company / Organization</label>
            <input type="text" id="log_providerName" placeholder="e.g. Standard Precision Metrology Corp.">
          </div>
          <div class="form-group">
            <label>Technician / Engineer Name</label>
            <input type="text" id="log_techName" placeholder="e.g. Engr. Robert D. Cruz">
