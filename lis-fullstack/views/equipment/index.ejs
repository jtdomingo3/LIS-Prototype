  function switchSection(sectionId, preselectEqId) {
    const tabs = ['equipment', 'qc', 'neqas'];
    tabs.forEach(t => {
      const btn = document.getElementById('tabBtn_' + t);
      const sec = document.getElementById('section' + t.charAt(0).toUpperCase() + t.slice(1));
      if (btn) {
        if (t === sectionId) btn.classList.add('active');
        else btn.classList.remove('active');
      }
      if (sec) {
        sec.style.display = (t === sectionId) ? 'block' : 'none';
      }
    });

    if (sectionId === 'qc') {
      if (preselectEqId) {
        const ljSelect = document.getElementById('lj_analyzerSelect');
        if (ljSelect) ljSelect.value = preselectEqId;
      }
      onLjAnalyzerChange();
      requestAnimationFrame(() => {
