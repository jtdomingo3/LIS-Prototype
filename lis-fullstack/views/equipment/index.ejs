  function renderLeveyJenningsCanvas(data) {
    const canvas = document.getElementById('ljCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    const W = canvas.width;
    const H = canvas.height;

    ctx.clearRect(0, 0, W, H);

    // Update Header Text
    document.getElementById('lj_chartTitle').textContent = `${data.analyteName} (${data.unit}) - ${data.controlName} [${data.lotNumber}]`;
    document.getElementById('lj_chartSubtitle').textContent = `Assigned Mean: ${data.targetMean} ${data.unit} | Target SD: ${data.targetSd} | TEa: ${data.teaPercent}%`;
    document.getElementById('lj_runCount').textContent = `Total Runs: ${data.points.length}`;

    // Statistics Pill
    const st = data.statistics;
    const pills = document.getElementById('lj_statsPills');
    pills.innerHTML = `
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">Mean: ${st.observedMean || '—'}</span>
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">SD: ${st.observedSd || '—'}</span>
      <span class="badge" style="background:#e0f2fe; color:#0369a1;">%CV: ${st.cvPercent || 0}%</span>
      <span class="badge ${st.inControl ? 'badge-operational' : 'badge-overdue'}">${st.inControl ? '✓ IN CONTROL' : '⚠️ OUT OF CONTROL'}</span>
    `;

    // Coordinates mapping
    const padL = 70;
    const padR = 30;
    const padT = 30;
    const padB = 40;
    const graphW = W - padL - padR;
    const graphH = H - padT - padB;

    const mean = data.targetMean;
    const sd = data.targetSd;
    const minVal = mean - (3.5 * sd);
    const maxVal = mean + (3.5 * sd);

    function getY(val) {
      const normalized = (val - minVal) / (maxVal - minVal);
      return (H - padB) - (normalized * graphH);
    }

    // Reference Line Helper
    function drawRefLine(val, label, color, dash = []) {
      const y = getY(val);
      ctx.save();
      ctx.strokeStyle = color;
      ctx.lineWidth = 1.2;
      ctx.setLineDash(dash);
      ctx.beginPath();
      ctx.moveTo(padL, y);
      ctx.lineTo(W - padR, y);
      ctx.stroke();

      ctx.setLineDash([]);
      ctx.fillStyle = color;
      ctx.font = '10px monospace';
      ctx.textAlign = 'right';
      ctx.fillText(label, padL - 8, y + 3);
      ctx.restore();
    }

    // Draw grid background
    ctx.fillStyle = '#fafafa';
    ctx.fillRect(padL, padT, graphW, graphH);

    // Draw reference SD lines
    drawRefLine(mean + 3 * sd, '+3SD (' + (mean + 3 * sd).toFixed(1) + ')', '#dc2626', [4, 4]);
    drawRefLine(mean + 2 * sd, '+2SD (' + (mean + 2 * sd).toFixed(1) + ')', '#d97706', [4, 4]);
    drawRefLine(mean + 1 * sd, '+1SD (' + (mean + 1 * sd).toFixed(1) + ')', '#94a3b8', [2, 2]);
    drawRefLine(mean, 'MEAN (' + mean.toFixed(1) + ')', '#16a34a', []);
    drawRefLine(mean - 1 * sd, '-1SD (' + (mean - 1 * sd).toFixed(1) + ')', '#94a3b8', [2, 2]);
    drawRefLine(mean - 2 * sd, '-2SD (' + (mean - 2 * sd).toFixed(1) + ')', '#d97706', [4, 4]);
    drawRefLine(mean - 3 * sd, '-3SD (' + (mean - 3 * sd).toFixed(1) + ')', '#dc2626', [4, 4]);

    // Graph bounding box
    ctx.strokeStyle = '#cbd5e1';
    ctx.strokeRect(padL, padT, graphW, graphH);

    // Plot points
    const points = data.points || [];
    if (points.length === 0) {
      ctx.fillStyle = '#94a3b8';
      ctx.font = '14px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('No control runs recorded for this month. Enter a reading below.', W / 2, H / 2);
      return;
    }

    const stepX = points.length > 1 ? graphW / (points.length - 1) : graphW / 2;

    // Draw connecting line
    ctx.beginPath();
    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 1.8;
    points.forEach((p, i) => {
      const x = points.length === 1 ? padL + graphW / 2 : padL + (i * stepX);
      const y = getY(p.measuredValue);
      if (i === 0) ctx.moveTo(x, y);
      else ctx.lineTo(x, y);
    });
    ctx.stroke();

    // Draw dots and violation badges
    points.forEach((p, i) => {
      const x = points.length === 1 ? padL + graphW / 2 : padL + (i * stepX);
      const y = getY(p.measuredValue);

      let dotColor = '#0284c7';
      if (p.status === 'REJECTED') dotColor = '#dc2626';
      else if (p.status === 'WARNING') dotColor = '#d97706';

      ctx.beginPath();
      ctx.fillStyle = dotColor;
      ctx.arc(x, y, 5, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#fff';
      ctx.lineWidth = 1.5;
      ctx.stroke();

      // X-axis day label (smart thinning when many points are plotted to prevent collision)
      const step = pts.length > 40 ? Math.ceil(pts.length / 20) : (pts.length > 20 ? 2 : 1);
      if (i === 0 || i === pts.length - 1 || (i % step === 0)) {
        const d = new Date(p.runDate);
        ctx.fillStyle = '#64748b';
        ctx.font = '10px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText(`${d.getDate()}/${d.getMonth()+1}`, x, H - padB + 16);
      }

      // Violation label flag if rejected
      if (p.status === 'REJECTED' && p.rulesViolated && p.rulesViolated.length > 0) {
        ctx.fillStyle = '#dc2626';
        ctx.font = 'bold 9px sans-serif';
        ctx.fillText(p.rulesViolated.join(','), x, y - 9);
      }
    });
  }

  async function submitQuickQc(e) {
    e.preventDefault();
    const eqId = document.getElementById('lj_analyzerSelect').value;
    const analyteCode = document.getElementById('lj_analyteSelect').value;
    const val = parseFloat(document.getElementById('qc_value').value);
    const date = document.getElementById('qc_date').value;
    const lot = document.getElementById('qc_lot').value;
    const notes = document.getElementById('qc_notes').value;

    if (!currentLjData) return;

    try {
      // Find control id
      const resCtrls = await fetch(`/equipment/${eqId}/qc/controls`);
      const dataCtrls = await resCtrls.json();
      const ctrl = (dataCtrls.controls || [])[0];

      const res = await fetch(`/equipment/${eqId}/qc/entries`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          controlId: ctrl.id,
          analyteCode,
          measuredValue: val,
          runDate: date,
          reagentLotNumber: lot,
          notes
        })
      });

      const data = await res.json();
      const box = document.getElementById('qc_alertBox');
      box.style.display = 'block';

      if (data.success) {
        const ev = data.evaluation;
        if (ev.status === 'ACCEPTED') {
          box.style.background = '#dcfce7';
          box.style.color = '#15803d';
          box.innerHTML = `<strong>✓ Accepted:</strong> Reading ${val} recorded (Z-score: ${ev.zScore}). Within &plusmn;2SD.`;
        } else if (ev.status === 'WARNING') {
          box.style.background = '#fef3c7';
          box.style.color = '#b45309';
          box.innerHTML = `<strong>⚠️ Warning (${ev.rulesViolated.join(', ')}):</strong> ${ev.explanation}`;
        } else {
          box.style.background = '#fee2e2';
          box.style.color = '#b91c1c';
          box.innerHTML = `<strong>❌ REJECTED (${ev.rulesViolated.join(', ')}):</strong> ${ev.explanation} <br><em>Action Required: Check reagent, recalibrate, or run fresh control.</em>`;
        }
        document.getElementById('qc_value').value = '';
        loadLjChart();
      } else {
        box.style.background = '#fee2e2';
        box.style.color = '#b91c1c';
        box.textContent = data.error || 'Failed to record entry.';
      }
    } catch (err) {
      alert('Error: ' + err.message);
    }
  }

