<div class="card">
    <h3>Add New Patient</h3>
    <form action="/patients" method="POST">
        <div class="form-group">
            <label>First Name *</label>
            <input type="text" name="firstName" value="<%= patient.firstName || '' %>" placeholder="Enter first name" required>
        </div>
        <div class="form-group">
            <label>Last Name *</label>
            <input type="text" name="lastName" value="<%= patient.lastName || '' %>" placeholder="Enter last name" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Date of Birth</label>
                <input id="dobInput" type="date" name="dateOfBirth" value="<%= patient.dateOfBirth ? new Date(patient.dateOfBirth).toISOString().split('T')[0] : '' %>">
            </div>
            <div class="form-group">
                <label>Age</label>
                <input id="ageInput" type="number" name="ageManual" value="<%= patient.ageManual || '' %>" placeholder="Enter age if DOB unknown">
                <small class="muted">Age is auto-calculated when DOB is set. Clear DOB to enter age manually.</small>
            </div>
            <div class="form-group">
                <label>Gender *</label>
                <select name="gender" required>
                    <option value="">Select Gender</option>
                    <option value="Male" <%= patient.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= patient.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= patient.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" name="phone" value="<%= patient.phone || '' %>" placeholder="+1 (555) 000-0000">
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= patient.email || '' %>" placeholder="patient@example.com">
            </div>
        </div>
        <div class="form-group">
            <label>Physician</label>
            <input type="text" name="physician" value="<%= patient.physician || '' %>" placeholder="Referring physician or doctor's name">
        </div>
        <div class="form-group">
            <label>Address</label>
            <textarea name="address" placeholder="Street address, city, state, zip"><%= patient.address || '' %></textarea>
        </div>

        <div class="card" style="margin-top:12px;">
          <h4>Route patient to reception areas</h4>
          <p>Select which areas this patient needs to go to (after Payment Area). Payment is automatic.</p>
                    <style>
                        .checkbox-columns { column-gap: 20px; column-fill: auto; }
                        /* Always use 4 columns on tablet/desktop for compact layout */
                        @media (min-width: 768px) { .checkbox-columns { column-count: 4; } }
                        /* Use 2 columns on small devices */
                        @media (min-width: 480px) and (max-width: 767px) { .checkbox-columns { column-count: 2; } }
                        /* Single column on very small devices */
                        @media (max-width: 479px) { .checkbox-columns { column-count: 1; } }
                        .checkbox-columns label { display: block; margin-bottom: 6px; break-inside: avoid; }
                    </style>
                    <div class="checkbox-columns">
                        <% const TEST_OPTIONS = [
                            { label: 'Blood Chemistry Albumin', value: 'blood-chemistry-albumin' },
                            { label: 'Blood Chemistry Blood Sugar', value: 'blood-chemistry-blood-sugar' },
                            { label: 'Blood Chemistry BUN Crea', value: 'blood-chemistry-bun-crea' },
                            { label: 'Blood Chemistry Electrolytes', value: 'blood-chemistry-electrolytes' },
                            { label: 'Blood Chemistry HbA1c', value: 'blood-chemistry-hba1c' },
                            { label: 'Blood Chemistry Lipid Profile', value: 'blood-chemistry-lipid-profile' },
                            { label: 'Blood Chemistry SGPT SGOT', value: 'blood-chemistry-sgpt-sgot' },
                            { label: 'Blood Typing', value: 'blood-typing' },
                            { label: 'CT BT', value: 'ct-bt' },
                            { label: 'Dengue Duo', value: 'dengue-duo' },
                            { label: 'Drugtest', value: 'drugtest' },
                            { label: 'ECG', value: 'ecg' },
                            { label: 'Echocardiography 2D', value: 'echocardiography-2d' },
                            { label: 'ESR', value: 'esr' },
                            { label: 'Fecal Occult Blood', value: 'fecal-occult-blood' },
                            { label: 'Fecalysis', value: 'fecalysis' },
                            { label: 'Hematology (CBC)', value: 'hematology' },
                            { label: 'Pregnancy Test', value: 'pregnancy-test' },
                            { label: 'PT APTT', value: 'pt-aptt' },
                            { label: 'Serology (HBsAg)', value: 'serology' },
                            { label: 'Thyroid Panel', value: 'thyroid-panel' },
                            { label: 'Ultrasound 1st Trimester Obstetrics', value: 'ultrasound-1st-trimester-obstetrics' },
                            { label: 'Ultrasound ABD KUBP HBT', value: 'ultrasound-abd-kubp-hbt' },
                            { label: 'Ultrasound Biophysical', value: 'ultrasound-biophysical' },
                            { label: 'Ultrasound Pelvic', value: 'ultrasound-pelvic' },
                            { label: 'Ultrasound Transvaginal', value: 'ultrasound-transvaginal' },
                            { label: 'Urinalysis', value: 'urinalysis' },
                            { label: 'X-Ray', value: 'xray' }
                        ]; %>
                        <% TEST_OPTIONS.forEach(opt => { %>
                            <label>
                                <input type="checkbox" class="test-checkbox" name="requiredAreas" value="<%= opt.value %>" <%= (patient.requiredAreas && patient.requiredAreas.includes(opt.value)) ? 'checked' : '' %> >
                                <span style="margin-left:8px;"><%= opt.label %></span>
                                <input type="number" step="0.01" min="0" name="price-<%= opt.value %>" class="test-price" placeholder="Price" style="width:86px; margin-left:8px; display:none;">
                            </label>
                        <% }) %>
                    </div>

                    <div style="margin-top:10px; display:flex; gap:16px; align-items:center;">
                        <div>
                            <label style="font-weight:600;">Clinical Lab Total:</label>
                            <input type="text" id="clinicalTotal" name="clinicalTotal" value="0.00" readonly style="width:120px; margin-left:8px;">
                        </div>
                        <div>
                            <label style="font-weight:600;">X-Ray Lab Total:</label>
                            <input type="text" id="xrayTotal" name="xrayTotal" value="0.00" readonly style="width:120px; margin-left:8px;">
                        </div>
                        <div>
                            <label style="font-weight:600;">Estimated Total:</label>
                            <input type="text" id="estimatedTotal" name="estimatedTotal" value="0.00" readonly style="width:120px; margin-left:8px;">
                        </div>
                    </div>
        </div>

        <div class="form-row">
            <a href="/patients" class="button btn-secondary">Back to Patients</a>
            <button type="submit" class="button btn-primary">Save Patient</button>
        </div>
    </form>
</div>
<script>
    (function(){
        const dob = document.getElementById('dobInput');
        const age = document.getElementById('ageInput');

        function computeAgeFromDob(d) {
            if (!d) return '';
            const b = new Date(d);
            if (isNaN(b.getTime())) return '';
            const today = new Date();
            let a = today.getFullYear() - b.getFullYear();
            const m = today.getMonth() - b.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < b.getDate())) a--;
            return a;
        }

        function onDobChange() {
            const val = dob.value;
            if (val) {
                const calc = computeAgeFromDob(val);
                age.value = calc;
                age.setAttribute('readonly', 'readonly');
            } else {
                // allow manual age entry when DOB is cleared
                age.removeAttribute('readonly');
                // keep existing manual value if present
            }
        }

        // initialize state
        if (dob && age) {
            onDobChange();
            dob.addEventListener('change', onDobChange);
        }
        // Price toggle + total calculation
        function toNumber(v) { const n = parseFloat(v); return isNaN(n) ? 0 : n; }
        const checkboxes = document.querySelectorAll('.test-checkbox');
        const estimatedEl = document.getElementById('estimatedTotal');
        const clinicalEl = document.getElementById('clinicalTotal');
        const xrayEl = document.getElementById('xrayTotal');
        function recomputeTotal() {
            let total = 0;
            let clinical = 0;
            let xray = 0;
            checkboxes.forEach(cb => {
                if (!cb.checked) return;
                const name = 'price-' + cb.value;
                const ip = document.querySelector('input[name="' + name + '"]');
                const price = ip ? toNumber(ip.value) : 0;
                total += price;
                if (cb.value === 'xray') xray += price; else clinical += price;
            });
            estimatedEl.value = total.toFixed(2);
            clinicalEl.value = clinical.toFixed(2);
            xrayEl.value = xray.toFixed(2);
        }

        checkboxes.forEach(cb => {
            const val = cb.value;
            const priceInput = document.querySelector('input[name="price-' + val + '"]');
            function updateInputs() {
                if (priceInput) priceInput.style.display = cb.checked ? 'inline-block' : 'none';
                recomputeTotal();
            }
            cb.addEventListener('change', updateInputs);
            if (priceInput) priceInput.addEventListener('input', recomputeTotal);
            // initialize visibility
            updateInputs();
        });
    })();
</script>