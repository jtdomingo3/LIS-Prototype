<div class="card">
    <h3>Add New Patient</h3>
    <form action="/patients" method="POST">
        <div class="form-group">
            <label>First Name *</label>
            <input type="text" name="firstName" value="<%= patient.firstName || '' %>" placeholder="Enter first name" required>
        </div>
        <div class="form-group">
            <label>Last Name *</label>
            <input type="text" name="lastName" value="<%= patient.lastName || '' %>" placeholder="Enter last name" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Date of Birth</label>
                <input id="dobInput" type="date" name="dateOfBirth" value="<%= patient.dateOfBirth ? new Date(patient.dateOfBirth).toISOString().split('T')[0] : '' %>">
            </div>
            <div class="form-group">
                <label>Age</label>
                <input id="ageInput" type="number" name="ageManual" value="<%= patient.ageManual || '' %>" placeholder="Enter age if DOB unknown">
                <small class="muted">Age is auto-calculated when DOB is set. Clear DOB to enter age manually.</small>
            </div>
            <div class="form-group">
                <label>Gender *</label>
                <select name="gender" required>
                    <option value="">Select Gender</option>
                    <option value="Male" <%= patient.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= patient.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= patient.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
        </div>
            <script>
                document.addEventListener('DOMContentLoaded', function(){
                    // Toggle amount and remark input visibility + enabled state based on checkboxes
                    document.querySelectorAll('.test-checkbox').forEach(cb => {
                        const key = cb.getAttribute('data-key');
                        const amt = document.querySelector('input[name="amount_' + key + '"]');
                        const remark = document.querySelector('input[name="remark_' + key + '"]');

                        function updateAmount() {
                            if (!amt) return;
                            if (cb.checked) {
                                amt.disabled = false;
                                amt.style.display = '';
                            } else {
                                amt.disabled = true;
                                amt.style.display = 'none';
                            }
                        }

                        function updateRemark() {
                            if (!remark) return;
                            if (cb.checked) {
                                remark.disabled = false;
                                remark.style.display = '';
                            } else {
                                remark.disabled = true;
                                remark.style.display = 'none';
                            }
                        }

                        cb.addEventListener('change', function(){ updateAmount(); updateRemark(); });

                        // init
                        updateAmount();
                        updateRemark();
                    });
                });
            </script>
        <div class="form-row">
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" name="phone" value="<%= patient.phone || '' %>" placeholder="+1 (555) 000-0000">
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= patient.email || '' %>" placeholder="patient@example.com">
            </div>
        </div>
        <div class="form-group">
            <label>Physician</label>
            <input type="text" name="physician" value="<%= patient.physician || '' %>" placeholder="Referring physician or doctor's name">
        </div>
        <div class="form-group">
            <label>Address</label>
            <textarea name="address" placeholder="Street address, city, state, zip"><%= patient.address || '' %></textarea>
        </div>

                <div class="card" style="margin-top:12px;">
                    <h4>Select Requested Tests</h4>
                    <p>Choose the tests/services to request for this patient. The system will map selected tests to reception areas automatically.</p>
                    <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:8px; margin-top:8px;">
                        <% (templates || []).forEach(t => {
                                 const rawKey = String(t.testType || t.name || '').trim();
                                 const slug = rawKey.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
                        %>
                            <label style="display:flex; align-items:center; gap:8px; padding:6px; border-radius:6px; background:#fff; border:1px solid #eee; flex-direction:column; align-items:stretch;">
                                <div style="display:flex; align-items:center; gap:8px;">
                                    <input type="checkbox" class="test-checkbox" data-key="<%= slug %>" name="selectedTests" value="<%= rawKey %>" <%= (patient.requestedTests && patient.requestedTests.find(r => (r && (r.key||r) === rawKey || r === rawKey))) ? 'checked' : '' %> >
                                    <span style="font-size:0.95em; flex:1;"><%= t.name || t.testType %></span>
                                    <input type="number" step="0.01" min="0" name="amount_<%= slug %>" class="test-amount" placeholder="Amount" style="width:120px;" value="<%= (patient.requestedTests && (patient.requestedTests.find(r => (r && (r.key||r) === rawKey) || r === rawKey) || {}).amount) || '' %>">
                                </div>
                                <div style="display:flex; gap:8px; align-items:center; margin-top:6px;">
                                    <input type="text" name="remark_<%= slug %>" class="test-remark" placeholder="Remarks" style="flex:1; width:100%;" value="<%= (patient.requestedTests && (patient.requestedTests.find(r => (r && (r.key||r) === rawKey) || r === rawKey) || {}).remark) || '' %>">
                                </div>
                            </label>
                        <% }) %>
                    </div>

                    <div style="margin-top:12px;">
                        <h5>Doctor's Check-up</h5>
                        <% const DOCS = ["Doctor's Check-up - Dr. Lorenzo","Doctor's Check-up - Dr. Arcilla"]; %>
                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:6px;">
                            <% DOCS.forEach(d => { %>
                                <label style="display:inline-flex; align-items:center; gap:6px;">
                                    <input type="checkbox" name="requiredAreas" value="<%= d %>" <%= (patient.requiredAreas && patient.requiredAreas.includes(d)) ? 'checked' : '' %> >
                                    <%= d %>
                                </label>
                            <% }) %>
                        </div>
                    </div>
                </div>

        <div class="form-row">
            <a href="/patients" class="button btn-secondary">Back to Patients</a>
            <button type="submit" class="button btn-primary">Save Patient</button>
        </div>
    </form>
</div>
<script>
    (function(){
        const dob = document.getElementById('dobInput');
        const age = document.getElementById('ageInput');

        function computeAgeFromDob(d) {
            if (!d) return '';
            const b = new Date(d);
            if (isNaN(b.getTime())) return '';
            const today = new Date();
            let a = today.getFullYear() - b.getFullYear();
            const m = today.getMonth() - b.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < b.getDate())) a--;
            return a;
        }

        function onDobChange() {
            const val = dob.value;
            if (val) {
                const calc = computeAgeFromDob(val);
                age.value = calc;
                age.setAttribute('readonly', 'readonly');
            } else {
                // allow manual age entry when DOB is cleared
                age.removeAttribute('readonly');
                // keep existing manual value if present
            }
        }

        // initialize state
        if (dob && age) {
            onDobChange();
            dob.addEventListener('change', onDobChange);
        }
    })();
</script>