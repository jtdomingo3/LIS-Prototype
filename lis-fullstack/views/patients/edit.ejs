<div class="card">
    <h3>Edit Patient</h3>
    <form action="/patients/<%= patient.id %>?_method=PUT" method="POST">
        <div class="form-group">
            <label>First Name *</label>
            <input type="text" name="firstName" value="<%= patient.firstName %>" placeholder="Enter first name" required>
        </div>
        <div class="form-group">
            <label>Last Name *</label>
            <input type="text" name="lastName" value="<%= patient.lastName %>" placeholder="Enter last name" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Date of Birth</label>
                <input id="dobInput" type="date" name="dateOfBirth" value="<%= patient.dateOfBirth ? new Date(patient.dateOfBirth).toISOString().split('T')[0] : '' %>">
            </div>
            <div class="form-group">
                <label>Age</label>
                <input id="ageInput" type="number" name="ageManual" value="<%= patient.ageManual || patient.age || '' %>" placeholder="Enter age if DOB unknown">
                <small class="muted">Age is auto-calculated when DOB is set. Clear DOB to enter age manually.</small>
            </div>
            <div class="form-group">
                <label>Gender *</label>
                <select name="gender" required>
                    <option value="">Select Gender</option>
                    <option value="Male" <%= patient.gender === 'Male' ? 'selected' : '' %>>Male</option>
                    <option value="Female" <%= patient.gender === 'Female' ? 'selected' : '' %>>Female</option>
                    <option value="Other" <%= patient.gender === 'Other' ? 'selected' : '' %>>Other</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Phone Number</label>
                <input type="text" name="phone" value="<%= patient.phone || '' %>" placeholder="+1 (555) 000-0000">
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="<%= patient.email || '' %>" placeholder="patient@example.com">
            </div>
        </div>
                <div class="form-group">
                        <label>Physician</label>
                        <input type="text" name="physician" value="<%= patient.physician || '' %>" placeholder="Referring physician or doctor's name">
                </div>
                <div class="form-group">
                        <label>Address</label>
                        <textarea name="address" placeholder="Street address, city, state, zip"><%= patient.address || '' %></textarea>
                </div>

                <div class="card" style="margin-top:12px;">
                    <h4>Route patient to reception areas</h4>
                    <p>Select which areas this patient needs to go to (after Payment Area). Payment is automatic.</p>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <% const TEST_OPTIONS = [
                          { label: 'Blood Chemistry Albumin', value: 'blood-chemistry-albumin' },
                          { label: 'Blood Chemistry Blood Sugar', value: 'blood-chemistry-blood-sugar' },
                          { label: 'Blood Chemistry BUN Crea', value: 'blood-chemistry-bun-crea' },
                          { label: 'Blood Chemistry Electrolytes', value: 'blood-chemistry-electrolytes' },
                          { label: 'Blood Chemistry HbA1c', value: 'blood-chemistry-hba1c' },
                          { label: 'Blood Chemistry Lipid Profile', value: 'blood-chemistry-lipid-profile' },
                          { label: 'Blood Chemistry SGPT SGOT', value: 'blood-chemistry-sgpt-sgot' },
                          { label: 'Blood Typing', value: 'blood-typing' },
                          { label: 'CT BT', value: 'ct-bt' },
                          { label: 'Dengue Duo', value: 'dengue-duo' },
                          { label: 'Drugtest', value: 'drugtest' },
                          { label: 'ECG', value: 'ecg' },
                          { label: 'Echocardiography 2D', value: 'echocardiography-2d' },
                          { label: 'ESR', value: 'esr' },
                          { label: 'Fecal Occult Blood', value: 'fecal-occult-blood' },
                          { label: 'Fecalysis', value: 'fecalysis' },
                          { label: 'Hematology (CBC)', value: 'hematology' },
                          { label: 'Pregnancy Test', value: 'pregnancy-test' },
                          { label: 'PT APTT', value: 'pt-aptt' },
                          { label: 'Serology (HBsAg)', value: 'serology' },
                          { label: 'Thyroid Panel', value: 'thyroid-panel' },
                          { label: 'Ultrasound 1st Trimester Obstetrics', value: 'ultrasound-1st-trimester-obstetrics' },
                          { label: 'Ultrasound ABD KUBP HBT', value: 'ultrasound-abd-kubp-hbt' },
                          { label: 'Ultrasound Biophysical', value: 'ultrasound-biophysical' },
                          { label: 'Ultrasound Pelvic', value: 'ultrasound-pelvic' },
                          { label: 'Ultrasound Transvaginal', value: 'ultrasound-transvaginal' },
                          { label: 'Urinalysis', value: 'urinalysis' },
                          { label: 'X-Ray', value: 'xray' }
                        ]; %>
                        <% TEST_OPTIONS.forEach(opt => { %>
                            <label style="display:inline-flex; align-items:center; gap:6px;">
                                <input type="checkbox" name="requiredAreas" value="<%= opt.value %>" <%= (patient.requiredAreas && patient.requiredAreas.includes(opt.value)) ? 'checked' : '' %> >
                                <%= opt.label %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                                <div class="form-row">
                                                <a href="/patients/<%= patient.id %>" class="button btn-secondary">Cancel</a>
                                                <button type="submit" class="button btn-primary">Update Patient</button>
                                </div>
        </form>
</div>

<script>
    (function(){
        const dob = document.getElementById('dobInput');
        const age = document.getElementById('ageInput');

        function computeAgeFromDob(d) {
            if (!d) return '';
            const b = new Date(d);
            if (isNaN(b.getTime())) return '';
            const today = new Date();
            let a = today.getFullYear() - b.getFullYear();
            const m = today.getMonth() - b.getMonth();
            if (m < 0 || (m === 0 && today.getDate() < b.getDate())) a--;
            return a;
        }

        function onDobChange() {
            const val = dob.value;
            if (val) {
                const calc = computeAgeFromDob(val);
                age.value = calc;
                age.setAttribute('readonly', 'readonly');
            } else {
                age.removeAttribute('readonly');
            }
        }

        if (dob && age) {
            onDobChange();
            dob.addEventListener('change', onDobChange);
        }
    })();
</script>
        </form>
</div>