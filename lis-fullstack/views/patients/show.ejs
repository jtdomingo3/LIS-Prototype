<div class="card">
    <h3>Patient Details</h3>
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px; margin-bottom: 30px;">
        <div>
            <h4 style="color: var(--secondary-green); margin-bottom: 15px;">Patient Information</h4>
            <p><strong>Patient ID:</strong> <%= patient.patientId %></p>
            <p><strong>Name:</strong> <%= patient.firstName %> <%= patient.lastName %></p>
            <p><strong>Date of Birth:</strong> <%= new Date(patient.dateOfBirth).toLocaleDateString() %></p>
            <p><strong>Age:</strong> <%= patient.age %> years</p>
            <p><strong>Gender:</strong> <%= patient.gender %></p>
            <p><strong>Phone:</strong> <%= patient.phone || 'N/A' %></p>
            <p><strong>Email:</strong> <%= patient.email || 'N/A' %></p>
            <p><strong>Address:</strong> <%= patient.address || 'N/A' %></p>
            <p><strong>Physician:</strong> <%= patient.physician || 'N/A' %></p>
        </div>
        <div>
            <h4 style="color: var(--secondary-green); margin-bottom: 15px;">Test History</h4>
            <p><strong>Total Tests:</strong> <%= tests.length %></p>
            <p><strong>Completed:</strong> <%= tests.filter(t => t.status === 'Completed').length %></p>
            <p><strong>Pending:</strong> <%= tests.filter(t => t.status === 'Pending').length %></p>
            <p><strong>In Progress:</strong> <%= tests.filter(t => t.status === 'In Progress').length %></p>
        </div>
    </div>

    <div class="action-buttons">
        <a href="/patients/<%= patient.id %>/edit" class="button btn-orange">Edit Patient</a>
        <a href="/tests/new?patient=<%= patient.id %>" class="button btn-primary">Create New Test</a>
        <a href="/patients" class="button btn-secondary">Back to Patients</a>
    </div>
</div>

<% if (tests && tests.length > 0) { %>
<div class="card">
    <h3>Test History</h3>
    <table>
        <thead>
            <tr>
                <th>Test ID</th>
                <th>Test Type</th>
                <th>Date</th>
                <th>Status</th>
                <th>Requested By</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% tests.forEach(test => { %>
            <tr>
                <td><strong><%= test.testId %></strong></td>
                <td><%= test.testType %></td>
                <td><%= new Date(test.testDate).toLocaleDateString() %></td>
                <td>
                    <span class="badge <%= test.status === 'Completed' ? 'badge-success' : test.status === 'In Progress' ? 'badge-warning' : 'badge-info' %>">
                        <%= test.status %>
                    </span>
                </td>
                <td><%= test.requestedBy ? test.requestedBy.name : 'Unknown' %></td>
                <td>
                    <a href="/tests/<%= test.id %>" class="button btn-small btn-primary">View</a>
                    <% if (test.status === 'Completed') { %>
                    <a href="/reports/preview/<%= test.id %>" class="button btn-small btn-orange">Report</a>
                    <% } %>
                </td>
            </tr>
            <% }); %>
        </tbody>
    </table>
</div>
<% } %>