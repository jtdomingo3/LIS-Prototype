<div style="display: flex; align-items: center; justify-content: center; min-height: 80vh; padding: 24px;">
  <div style="max-width: 520px; width: 100%; background: #ffffff; border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04); padding: 40px 32px; text-align: center;">
    <div style="width: 72px; height: 72px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 20px; color: #0284c7;">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
    </div>
    <div style="font-size: 0.85em; font-weight: 700; color: #0284c7; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px;">Error 404</div>
    <h1 style="font-size: 1.75em; font-weight: 800; color: #0f172a; margin: 0 0 12px; letter-spacing: -0.02em;">Page Not Found</h1>
    <p style="font-size: 0.95em; color: #64748b; line-height: 1.6; margin: 0 0 28px;">
      The clinical record, test page, or module you requested could not be located or may have been moved.
    </p>
    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/dashboard" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: #0284c7; color: #ffffff; font-weight: 600; font-size: 0.9em; border-radius: 8px; text-decoration: none; transition: background 0.15s ease, transform 0.1s ease;" onmouseover="this.style.background='#0369a1'" onmouseout="this.style.background='#0284c7'">
        <i class="fas fa-chart-line"></i> Dashboard
      </a>
      <a href="/reception" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: #f8fafc; color: #334155; font-weight: 600; font-size: 0.9em; border-radius: 8px; border: 1px solid #cbd5e1; text-decoration: none; transition: background 0.15s ease;" onmouseover="this.style.background='#f1f5f9'" onmouseout="this.style.background='#f8fafc'">
        <i class="fas fa-users"></i> Reception
      </a>
      <button onclick="history.back()" style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; background: transparent; color: #64748b; font-weight: 600; font-size: 0.9em; border-radius: 8px; border: 1px solid transparent; cursor: pointer; transition: color 0.15s ease;" onmouseover="this.style.color='#0f172a'" onmouseout="this.style.color='#64748b'">
        <i class="fas fa-arrow-left"></i> Go Back
      </button>
    </div>
  </div>
</div>