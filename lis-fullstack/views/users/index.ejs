<div class="card" style="padding:24px 28px; border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.03); background:#ffffff; border:1px solid #e2e8f0;">
  <!-- Toolbar (Single Clean Line) -->
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:20px; padding-bottom:16px; border-bottom:1px solid #f1f5f9; width:100%;">
    <div>
      <a href="/users/new" class="button btn-primary" style="display:inline-flex; align-items:center; gap:8px; font-weight:700; padding:0 18px; height:42px; flex-shrink:0; white-space:nowrap; border-radius:10px; box-shadow:0 2px 8px rgba(16,185,129,0.25);">
        <i class="fas fa-user-plus"></i>
        <span>Add Staff Account</span>
      </a>
    </div>

    <div style="display:flex; gap:10px; align-items:center; flex:1; justify-content:flex-end; max-width:440px;">
      <div style="position:relative; width:100%;">
        <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.88rem; pointer-events:none;"></i>
        <input type="text" id="userSearchInput" placeholder="Filter staff by name, email, or role..." onkeyup="filterUsers()" style="width:100%; height:42px; padding:0 14px 0 38px; font-size:0.88rem; box-sizing:border-box; border-radius:10px; border:1px solid #cbd5e1; background:#f8fafc; margin:0; transition:all 0.2s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#0284c7'; this.style.boxShadow='0 0 0 3px rgba(2,132,199,0.1)';" onblur="this.style.background='#f8fafc'; this.style.borderColor='#cbd5e1'; this.style.boxShadow='none';" />
      </div>
    </div>
  </div>

  <!-- User Table -->
  <div class="table-responsive" style="overflow-x:auto; border:1px solid #e2e8f0; border-radius:12px;">
    <table id="usersTable" style="width:100%; border-collapse:collapse; margin-bottom:0; font-size:0.88rem;">
      <thead>
        <tr style="background:#f8fafc; border-bottom:2px solid #e2e8f0; text-align:left;">
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; min-width:220px;">Staff Member</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; min-width:200px;">Email Address</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; white-space:nowrap;">Role & Scope</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; white-space:nowrap;">Status</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; text-align:right; white-space:nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (users && users.length) { %>
          <% users.forEach(u => { 
            const initials = ((u.name || u.email || 'US').split(' ').map(n => n[0]).join('').slice(0, 2)).toUpperCase();
            const roleStr = String(u.role || 'Staff');
            let roleBadgeStyle = 'background:#f1f5f9; color:#475569; border:1px solid #cbd5e1;';
            const rLower = roleStr.toLowerCase();
            if (rLower.includes('admin') || rLower.includes('manager') || rLower.includes('owner')) {
              roleBadgeStyle = 'background:#f5f3ff; color:#5b21b6; border:1px solid #ddd6fe;';
            } else if (rLower.includes('doctor') || rLower.includes('patholog') || rLower.includes('cardio') || rLower.includes('radio') || rLower.includes('sonolog') || rLower.includes('internist') || rLower.includes('pulmonolog') || rLower.includes('gynecolog') || rLower.includes('pediatric') || rLower.includes('neurolog') || rLower.includes('surgeon') || rLower.includes('physician')) {
              roleBadgeStyle = 'background:#e0f2fe; color:#0369a1; border:1px solid #bae6fd;';
            } else if (rLower.includes('tech') || rLower.includes('med')) {
              roleBadgeStyle = 'background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0;';
            } else if (rLower.includes('reception')) {
              roleBadgeStyle = 'background:#fffbe6; color:#92400e; border:1px solid #fde68a;';
            }

            const isInactive = String(u.status || '').toLowerCase() === 'inactive';
          %>
            <tr class="user-row" style="border-bottom:1px solid #f1f5f9; transition:background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#ffffff'">
              <td style="padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:12px;">
                  <span style="display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color:#ffffff; font-weight:700; font-size:0.82rem; flex-shrink:0; box-shadow:0 2px 6px rgba(2,132,199,0.25);"><%= initials %></span>
                  <div>
                    <strong class="user-name" style="color:#0f172a; display:block; font-size:0.92rem;"><%= u.name %></strong>
                    <% if (u.licenseNumber) { %>
                      <span style="font-size:0.75rem; color:#64748b; font-family:var(--font-mono, monospace);">PRC: <%= u.licenseNumber %></span>
                    <% } %>
                  </div>
                </div>
              </td>
              <td style="padding:14px 16px;">
                <span class="user-email" style="font-family:var(--font-mono, monospace); color:#334155; font-size:0.86rem;"><%= u.email %></span>
              </td>
              <td style="padding:14px 16px; white-space:nowrap;">
                <span class="user-role" style="display:inline-flex; align-items:center; gap:6px; padding:4px 12px; border-radius:20px; font-size:0.78rem; font-weight:700; <%= roleBadgeStyle %>">
                  <%= roleStr %>
                </span>
              </td>
              <td style="padding:14px 16px; white-space:nowrap;">
                <% if (isInactive) { %>
                  <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:700; background:#f1f5f9; color:#94a3b8; border:1px solid #cbd5e1;">
                    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#94a3b8;"></span>
                    <span>Inactive</span>
                  </span>
                <% } else { %>
                  <span style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:20px; font-size:0.75rem; font-weight:700; background:#ecfdf5; color:#065f46; border:1px solid #a7f3d0;">
                    <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#10b981;"></span>
                    <span>Active</span>
                  </span>
                <% } %>
              </td>
              <td style="padding:14px 16px; text-align:right; white-space:nowrap;">
                <a href="/users/<%= u.id %>" class="button btn-secondary btn-small" style="padding:6px 12px; font-size:0.8rem; border-radius:8px; display:inline-flex; align-items:center; gap:4px;" title="View Profile">
                  <i class="fas fa-eye" style="color:#64748b;"></i>
                  <span>View</span>
                </a>
                <a href="/users/<%= u.id %>/edit" class="button btn-primary btn-small" style="padding:6px 12px; font-size:0.8rem; font-weight:700; border-radius:8px; display:inline-flex; align-items:center; gap:4px;" title="Edit Account">
                  <i class="fas fa-pen"></i>
                  <span>Edit</span>
                </a>
                <form action="/users/<%= u.id %>?_method=DELETE" method="POST" style="display:inline-block; margin:0;" onsubmit="return confirm('⚠️ Are you sure you want to permanently delete user <%= u.name %> (<%= u.email %>)? This action cannot be undone.');">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="button btn-danger btn-small" style="padding:6px 10px; font-size:0.8rem; margin-left:4px; border-radius:8px;" title="Delete user">
                    <i class="fas fa-trash-alt"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="5" style="text-align:center; color:#94a3b8; padding:54px 20px;">
              <div style="width:64px; height:64px; border-radius:18px; background:#f0f9ff; color:#0284c7; display:inline-flex; align-items:center; justify-content:center; font-size:1.8rem; margin-bottom:14px; box-shadow:0 4px 12px rgba(2,132,199,0.1);">
                <i class="fas fa-users-gear"></i>
              </div>
              <strong style="font-size:1.15rem; color:#0f172a; display:block; margin-bottom:4px;">No Staff Accounts Found</strong>
              <p style="font-size:0.88rem; color:#64748b; margin:0 0 16px 0;">Create a user account to grant access to clinical and diagnostic laboratory modules.</p>
              <a href="/users/new" class="button btn-primary" style="display:inline-flex; align-items:center; gap:8px; font-weight:700; padding:8px 18px; border-radius:8px;">
                <i class="fas fa-user-plus"></i>
                <span>Add Staff Account</span>
              </a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function filterUsers() {
  const input = document.getElementById('userSearchInput');
  const filter = input.value.toLowerCase().trim();
  const rows = document.querySelectorAll('.user-row');

  rows.forEach(row => {
    const name = row.querySelector('.user-name') ? row.querySelector('.user-name').textContent.toLowerCase() : '';
    const email = row.querySelector('.user-email') ? row.querySelector('.user-email').textContent.toLowerCase() : '';
    const role = row.querySelector('.user-role') ? row.querySelector('.user-role').textContent.toLowerCase() : '';
    if (name.includes(filter) || email.includes(filter) || role.includes(filter)) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}
</script>
