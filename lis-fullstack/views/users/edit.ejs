<div class="card">
  <h3>Edit User</h3>

  <form action="/users/<%= user.id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= user.name || '' %>" required>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= user.email || '' %>" required>
    </div>

    <div class="form-group">
      <label>New Password (leave blank to keep current)</label>
      <input type="password" name="password">
    </div>

    <div class="form-group">
      <label>Confirm Password</label>
      <input type="password" name="confirmPassword">
    </div>

    <div class="form-group">
      <label>Role</label>
      <select name="role" id="roleSelect">
        <option value="Receptionist" <%= user.role === 'Receptionist' ? 'selected' : '' %>>Receptionist</option>
        <option value="Technician" <%= user.role === 'Technician' ? 'selected' : '' %>>Technician</option>
        <option value="Doctor" <%= user.role === 'Doctor' ? 'selected' : '' %>>Doctor</option>
        <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin</option>
        <option value="Medical Technologist" <%= user.role === 'Medical Technologist' ? 'selected' : '' %>>Medical Technologist</option>
        <option value="Radiologist" <%= user.role === 'Radiologist' ? 'selected' : '' %>>Radiologist</option>
        <option value="Nurse" <%= user.role === 'Nurse' ? 'selected' : '' %>>Nurse</option>
        <option value="Sonographer" <%= user.role === 'Sonographer' ? 'selected' : '' %>>Sonographer</option>
        <option value="System IT" <%= user.role === 'System IT' ? 'selected' : '' %>>System IT</option>
        <option value="Other" <%= ['Receptionist','Technician','Doctor','Admin','Medical Technologist','Radiologist','Nurse','Sonographer','System IT'].includes(user.role) ? '' : 'selected' %>>Other (specify below)</option>
      </select>
      <input type="text" name="customRole" id="customRole" placeholder="Enter custom role" style="display:none;margin-top:8px;" value="<%= ['Receptionist','Technician','Doctor','Admin','Medical Technologist','Radiologist','Nurse','Sonographer','System IT'].includes(user.role) ? '' : user.role %>">
    </div>

    <div class="form-group">
      <label>License Number (optional)</label>
      <input type="text" name="licenseNumber" value="<%= user.licenseNumber || '' %>">
    </div>

    <div class="form-group">
      <label>Status</label>
      <select name="status">
        <option value="Active" <%= user.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= user.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <fieldset style="margin-top:12px;border:1px solid #ddd;padding:12px;border-radius:6px;">
      <legend>Feature Access</legend>
      <label><input type="checkbox" name="perm_dashboard" <%= user.permissions && user.permissions.dashboard ? 'checked' : '' %> > Dashboard</label><br>
      <label><input type="checkbox" name="perm_patients" <%= user.permissions && user.permissions.patients ? 'checked' : '' %> > Patients</label><br>
      <label><input type="checkbox" name="perm_reception" <%= user.permissions && user.permissions.reception ? 'checked' : '' %> > Reception</label><br>
      <label><input type="checkbox" name="perm_tests" <%= user.permissions && user.permissions.tests ? 'checked' : '' %> > Tests & Results</label><br>
      <label><input type="checkbox" name="perm_reports" <%= user.permissions && user.permissions.reports ? 'checked' : '' %> > Reports</label><br>
      <label><input type="checkbox" name="perm_worksheet" <%= user.permissions && user.permissions.worksheet ? 'checked' : '' %> > Worksheet</label><br>
      <label><input type="checkbox" name="perm_templates" <%= user.permissions && user.permissions.templates ? 'checked' : '' %> > Templates</label><br>
      <label><input type="checkbox" name="perm_users" <%= user.permissions && user.permissions.users ? 'checked' : '' %> > Users (access to Users management)</label><br>
      <label><input type="checkbox" name="perm_delete" <%= user.permissions && user.permissions.delete ? 'checked' : '' %> > Allow Delete actions</label>
    </fieldset>

    <button class="button btn-primary">Update User</button>
    <a href="/users" class="button btn-secondary">Cancel</a>
  </form>
</div>

<script>
  (function(){
    const roleSelect = document.getElementById('roleSelect');
    const custom = document.getElementById('customRole');
    function toggle(){
      if(roleSelect && custom){
        custom.style.display = roleSelect.value === 'Other' ? 'block' : 'none';
      }
    }
    if(roleSelect){ roleSelect.addEventListener('change', toggle); toggle(); }
  })();
</script>
