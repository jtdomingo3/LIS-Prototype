<style>
  .user-form-layout {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    box-sizing: border-box;
  }
  .user-form-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 20px;
    align-items: stretch;
  }
  @media (max-width: 992px) {
    .user-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="card user-form-layout" style="padding: 24px 28px; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0;">
  
  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; margin-bottom: 18px; border-bottom: 1px solid #f1f5f9; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: #ecfdf5; color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 1.2em;">
        <i class="fa fa-user-plus"></i>
      </div>
      <div>
        <h2 style="margin: 0; font-size: 1.3em; font-weight: 700; color: #0f172a;">Add New User</h2>
        <div style="font-size: 0.8em; color: #64748b; margin-top: 2px;">Create a new staff account and configure access privileges</div>
      </div>
    </div>
    <a href="/users" class="button btn-secondary" style="height: 36px; padding: 0 16px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.85em;">
      <i class="fa fa-arrow-left"></i> Back to Users
    </a>
  </div>

  <form action="/users" method="POST" enctype="multipart/form-data">
    <div class="user-form-grid">
      
      <!-- Left Column: Account Details -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; display: flex; flex-direction: column; gap: 12px;">
        <div style="font-weight: 700; font-size: 0.92em; color: #0f172a; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
          <i class="fa fa-id-badge" style="color: #3b82f6;"></i> Account Credentials
        </div>

        <div>
          <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Full Name <span style="color: #ef4444;">*</span></label>
          <input type="text" name="name" value="<%= user.name || '' %>" placeholder="e.g. Maria Santos, RMT" required style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.9em; font-weight: 500; box-sizing: border-box;" />
        </div>

        <div>
          <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Email Address <span style="color: #ef4444;">*</span></label>
          <input type="email" name="email" value="<%= user.email || '' %>" placeholder="e.g. maria@gezyne.com" required style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.9em; font-weight: 500; box-sizing: border-box;" />
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div>
            <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Password <span style="color: #ef4444;">*</span></label>
            <input type="password" name="password" required style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.9em; box-sizing: border-box;" />
          </div>
          <div>
            <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Confirm Password <span style="color: #ef4444;">*</span></label>
            <input type="password" name="confirmPassword" required style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.9em; box-sizing: border-box;" />
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 10px;">
          <div>
            <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Role <span style="color: #ef4444;">*</span></label>
            <select name="role" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 4px 8px; font-size: 0.88em; background: #fff;">
              <option value="Receptionist" <%= user.role === 'Receptionist' ? 'selected' : '' %>>Receptionist</option>
              <option value="Technician" <%= user.role === 'Technician' ? 'selected' : '' %>>Technician</option>
              <option value="Medical Technologist" <%= user.role === 'Medical Technologist' ? 'selected' : '' %>>Medical Technologist</option>
              <option value="X-Ray Technologist" <%= user.role === 'X-Ray Technologist' ? 'selected' : '' %>>X-Ray Technologist</option>
              <option value="Doctor" <%= user.role === 'Doctor' ? 'selected' : '' %>>Doctor</option>
              <option value="Internist" <%= user.role === 'Internist' ? 'selected' : '' %>>Internist</option>
              <option value="Pathologist" <%= user.role === 'Pathologist' ? 'selected' : '' %>>Pathologist</option>
              <option value="Radiologist" <%= user.role === 'Radiologist' ? 'selected' : '' %>>Radiologist</option>
              <option value="Encoder" <%= user.role === 'Encoder' ? 'selected' : '' %>>Encoder</option>
              <option value="Drugtest Analyst" <%= user.role === 'Drugtest Analyst' ? 'selected' : '' %>>Drugtest Analyst</option>
              <option value="Sonographer" <%= user.role === 'Sonographer' ? 'selected' : '' %>>Sonographer</option>
              <option value="Manager" <%= user.role === 'Manager' ? 'selected' : '' %>>Manager</option>
              <option value="Owner" <%= user.role === 'Owner' ? 'selected' : '' %>>Owner</option>
              <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
          <div>
            <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">Status</label>
            <select name="status" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 4px 8px; font-size: 0.88em; background: #fff;">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
        </div>

        <div>
          <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">PRC / Professional License Number</label>
          <input type="text" name="licenseNumber" value="<%= user.licenseNumber || '' %>" placeholder="e.g. 0089123" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.9em; font-weight: 500; box-sizing: border-box;" />
        </div>

        <div>
          <label style="display: block; font-weight: 600; font-size: 0.85em; color: #334155; margin-bottom: 4px;">
            <i class="fa fa-signature" style="color: #10b981;"></i> Digital Signature (PNG)
          </label>
          <input type="file" name="signature" accept="image/png,image/*" style="width: 100%; font-size: 0.85em; color: #475569; box-sizing: border-box;" />
          <small style="font-size: 0.72em; color: #64748b; margin-top: 4px; display: block;">Upload a clean PNG image of handwritten signature.</small>
        </div>
      </div>

      <!-- Right Column: User Permissions & Access Control -->
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; display: flex; flex-direction: column;">
        <div style="font-weight: 700; font-size: 0.92em; color: #0f172a; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
          <span style="display: flex; align-items: center; gap: 8px;">
            <i class="fa fa-user-shield" style="color: #10b981;"></i> Module Permissions & Access Control
          </span>
          <span style="font-size: 0.75em; color: #64748b; font-weight: 500;">Select modules</span>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 10px; flex: 1; align-content: start;">
          <% 
            const permList = [
              { key: 'dashboard', label: 'Dashboard', desc: 'Analytics & Financials' },
              { key: 'reception', label: 'Reception', desc: 'Patient Intake & Queue' },
              { key: 'patients', label: 'Patients', desc: 'Demographics & Records' },
              { key: 'tests', label: 'Tests', desc: 'Worklist & Results Entry' },
              { key: 'reports', label: 'Reports', desc: 'Sign-off & Printouts' },
              { key: 'signatures', label: 'Signature', desc: 'Sign-offs & Queue' },
              { key: 'worksheet', label: 'Worksheet', desc: 'Batch Bench Sheet' },
              { key: 'inventory', label: 'Inventory', desc: 'Reagents & Supplies' },
              { key: 'templates', label: 'Report Templates', desc: 'Template Config', highlight: true },
              { key: 'users', label: 'Users', desc: 'Staff Management' },
              { key: 'delete', label: 'Delete Records', desc: 'Deletion Authority', highlight: true }
            ];
          %>
          <% permList.forEach(p => { %>
            <label style="display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 8px; background: <%= p.highlight ? '#fef2f2' : '#ffffff' %>; border: 1px solid <%= p.highlight ? '#fca5a5' : '#e2e8f0' %>; cursor: pointer; transition: all 0.15s ease;" onmouseover="this.style.borderColor='<%= p.highlight ? '#ef4444' : '#10b981' %>'" onmouseout="this.style.borderColor='<%= p.highlight ? '#fca5a5' : '#e2e8f0' %>'">
              <input type="checkbox" name="permissions[<%= p.key %>]" value="1" <%= user.permissions && (user.permissions[p.key] || (p.key === 'signatures' && user.permissions.signature)) ? 'checked' : '' %> style="accent-color: #10b981; width: 16px; height: 16px; cursor: pointer; flex-shrink: 0;" />
              <div style="min-width: 0; flex: 1;">
                <div style="font-weight: 700; font-size: 0.84em; color: <%= p.highlight ? '#b91c1c' : '#0f172a' %>; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= p.label %></div>
                <div style="font-size: 0.7em; color: <%= p.highlight ? '#991b1b' : '#64748b' %>; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= p.desc %></div>
              </div>
            </label>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- Actions Footer -->
    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 18px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
      <a href="/users" class="button btn-secondary" style="height: 40px; padding: 0 20px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">Cancel</a>
      <button type="submit" class="button btn-primary" style="height: 40px; padding: 0 28px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fa fa-check"></i> Create User
      </button>
    </div>
  </form>

</div>
