<!-- Modal: Primary Diagnosis Required Alert -->
<div id="validationAlertModal" style="display: none; position: fixed; inset: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); z-index: 99999; align-items: center; justify-content: center; padding: 16px; box-sizing: border-box;">
  <div style="background: #ffffff; width: 100%; max-width: 440px; border-radius: 18px; padding: 26px 28px; box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.35); border: 1px solid #fed7aa; text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #ffedd5; border: 2px solid #fed7aa; color: #ea580c; display: flex; align-items: center; justify-content: center; font-size: 24px; margin: 0 auto 14px;">
      <i class="fa fa-stethoscope"></i>
    </div>
    <h3 id="valModalTitle" style="margin: 0 0 8px; font-size: 1.2rem; font-weight: 700; color: #0f172a;">Primary Diagnosis Required</h3>
    <p id="valModalMsg" style="margin: 0 0 20px; font-size: 0.88rem; color: #475569; line-height: 1.55;">
      Please enter a <strong>Primary Diagnosis</strong> in the Assessment section before marking this clinical consultation as completed.
    </p>
    <button type="button" id="btnCloseValidationModal" class="button btn-orange" style="width: 100%; height: 42px; font-weight: 600; border-radius: 10px;">
      Go to Assessment
    </button>
  </div>
</div>

<script>
  // Global previous visits data for modal display
  const previousVisitsData = <%- JSON.stringify(previousConsultations) %>;
  const doctorLicensesData = <%- JSON.stringify(typeof doctorLicenses !== 'undefined' ? doctorLicenses : {}) %>;

  // Auto-populate PRC license on doctor selection
  const docSelect = document.getElementById('doctorNameSelect');
  if (docSelect) {
    docSelect.addEventListener('change', function() {
      const licInput = document.querySelector('input[name="doctorLicenseNumber"]');
      if (licInput && doctorLicensesData[this.value]) {
        licInput.value = doctorLicensesData[this.value];
      }
      triggerAutoSave();
    });
  }

  // Multipanel Tab Switcher
  function switchConsultTab(tabId, btn) {
    document.querySelectorAll('.consult-tab-page').forEach(page => page.style.display = 'none');
    const target = document.getElementById(tabId);
    if (target) target.style.display = 'block';

    document.querySelectorAll('.consult-tab-btn').forEach(b => b.classList.remove('active'));
    if (btn) {
      btn.classList.add('active');
    }
  }

  function recalcBmiUI() {
    const w = parseFloat(document.getElementById('vitalWeight').value);
    const h = parseFloat(document.getElementById('vitalHeight').value);
    const bmiDisp = document.getElementById('bmiDisplay');
    const bmiBadge = document.getElementById('bmiBadge');
    if (!bmiDisp || !bmiBadge) return;

    if (!w || !h || w <= 0 || h <= 0) {
      bmiDisp.textContent = '—';
      bmiBadge.textContent = 'Normal';
      bmiBadge.style.background = '#f1f5f9';
      bmiBadge.style.color = '#475569';
      return;
    }

    const hM = h / 100.0;
    const bmi = +(w / (hM * hM)).toFixed(1);
    bmiDisp.textContent = bmi;

    let cat = 'Normal', bg = '#dcfce7', color = '#15803d';
    if (bmi < 18.5) { cat = 'Underweight'; bg = '#fef3c7'; color = '#b45309'; }
    else if (bmi < 25.0) { cat = 'Normal'; bg = '#dcfce7'; color = '#15803d'; }
    else if (bmi < 30.0) { cat = 'Overweight'; bg = '#ffedd5'; color = '#c2410c'; }
    else { cat = 'Obese'; bg = '#fee2e2'; color = '#b91c1c'; }

    bmiBadge.textContent = cat;
    bmiBadge.style.background = bg;
    bmiBadge.style.color = color;
  }

  // DOH PhilPEN Calculations & UI Helpers
  function recalcPackYearsUI() {
    const spd = parseFloat(document.getElementById('smokingSticksInput')?.value) || 0;
    const yrs = parseFloat(document.getElementById('smokingYearsInput')?.value) || 0;
    const packYears = +((spd / 20) * yrs).toFixed(1);
    const disp = document.getElementById('packYearsDisplay');
    const inp = document.getElementById('smokingPackYearsInput');
    const badge = document.getElementById('packYearsRiskBadge');
    if (inp) inp.value = packYears;
    if (disp) disp.textContent = packYears.toFixed(1) + ' Pack-Years';
    if (badge) {
      if (packYears >= 20) {
        badge.style.display = 'inline-block';
        badge.textContent = 'High CVD/COPD Risk (≥20 PY)';
        badge.style.background = '#fee2e2';
        badge.style.color = '#b91c1c';
      } else if (packYears >= 10) {
        badge.style.display = 'inline-block';
        badge.textContent = 'Moderate Risk (≥10 PY)';
        badge.style.background = '#fef3c7';
        badge.style.color = '#92400e';
      } else {
        badge.style.display = 'none';
      }
    }
  }

  function recalcAlcoholRiskUI() {
    const drinks = parseFloat(document.getElementById('alcoholDrinksInput')?.value) || 0;
    const badge = document.getElementById('alcoholBingeBadge');
    const bingeInp = document.getElementById('alcoholBingeInput');
    const gender = '<%= patientGender %>';
    const threshold = (gender === 'female' || gender === 'f') ? 4 : 5;
    const isBinge = drinks >= threshold;
    if (bingeInp) bingeInp.value = isBinge ? 'Yes' : 'No';
    if (badge) {
      if (isBinge) {
        badge.style.display = 'inline-flex';
        badge.innerHTML = `<i class="fa fa-exclamation-triangle" style="margin-right:4px;"></i> Binge Risk (≥${threshold} drinks/session)`;
      } else {
        badge.style.display = 'none';
      }
    }
  }

  function recalcWaistRiskUI() {
    const waist = parseFloat(document.getElementById('vitalWaist')?.value) || 0;
    const badge = document.getElementById('waistRiskBadge');
    const gender = '<%= patientGender %>';
    // Asian WHO / DOH PhilPEN Cutoffs: Men >= 90 cm, Women >= 80 cm
    const threshold = (gender === 'female' || gender === 'f') ? 80 : 90;
    if (badge) {
      if (waist >= threshold) {
        badge.style.display = 'inline-block';
        badge.textContent = `High CVD Risk (≥${threshold}cm)`;
        badge.style.background = '#fee2e2';
        badge.style.color = '#b91c1c';
      } else if (waist > 0) {
        badge.style.display = 'inline-block';
        badge.textContent = `Normal (<${threshold}cm)`;
        badge.style.background = '#d1fae5';
        badge.style.color = '#065f46';
      } else {
        badge.style.display = 'none';
      }
    }
  }

  function toggleNcdPill(btn, name) {
    btn.classList.toggle('selected');
    const icon = btn.querySelector('i');
    if (icon) {
      if (btn.classList.contains('selected')) {
        icon.className = 'fa fa-check-circle';
      } else {
        icon.className = 'fa fa-circle-o';
      }
    }
    syncNcdInputs();
    triggerAutoSave();
  }

  function syncNcdInputs() {
    const container = document.getElementById('familyHistoryDiseasesInputs');
    if (!container) return;
    container.innerHTML = '';
    document.querySelectorAll('.ncd-pill.selected').forEach(b => {
      const inp = document.createElement('input');
      inp.type = 'hidden';
      inp.name = 'familyHistoryDiseases[]';
      inp.value = b.getAttribute('data-ncd') || b.textContent.trim();
      container.appendChild(inp);
    });
  }

  function quickFillRos() {
    const el = document.getElementById('reviewOfSystemsInput');
    if (!el) return;
    el.value = "General: No fever, unintentional weight loss, or fatigue.\nHEENT: No blurring of vision, headache, or dizziness.\nRespiratory: No cough, hemoptysis, or dyspnea.\nCardiovascular: No chest pain, orthopnea, or palpitations.\nGastrointestinal: No abdominal pain, nausea, vomiting, or change in bowel habits.\nGenitourinary: No dysuria, frequency, or flank pain.\nMusculoskeletal: No joint swelling, stiffness, or muscle pain.\nNeurologic: No numbness, motor weakness, or focal deficits.\nSkin: No rashes, lesions, or jaundice.";
    triggerAutoSave();
  }

  function quickFillPe() {
    const el = document.getElementById('peFindingsInput');
    if (!el) return;
    el.value = "General: Conscious, coherent, ambulatory, not in acute cardiopulmonary distress.\nHEENT: Normocephalic, anicteric sclera, pink palpebral conjunctiva, supple neck, no cervical lymphadenopathy.\nChest & Lungs: Symmetrical chest expansion, vesicular breath sounds, no rales or wheezes.\nCardiovascular: Normal rate, regular rhythm, normal S1 and S2, no murmurs or thrills.\nAbdomen: Soft, non-tender, non-distended, normoactive bowel sounds, no palpable organomegaly.\nExtremities: Full and equal peripheral pulses, no cyanosis, no clubbing, no pedal edema.\nNeurologic: Awake, alert, oriented x 3, GCS 15, no gross focal motor or sensory deficit.";
    triggerAutoSave();
  }

  function addCustomLabOrder() {
    const inp = document.getElementById('customLabInput');
    if (!inp) return;
    const val = inp.value.trim();
    if (!val) return;
    
    const container = document.getElementById('customLabTagsContainer');
    if (container) {
      const existing = Array.from(container.querySelectorAll('.custom-lab-tag-val')).map(el => el.value.toLowerCase());
      if (!existing.includes(val.toLowerCase())) {
        const tag = document.createElement('span');
        tag.className = 'custom-lab-tag';
        tag.innerHTML = `
          <span>${val}</span>
          <input type="hidden" class="custom-lab-tag-val" value="${val}">
          <button type="button" onclick="removeCustomLabTag(this)" style="background: none; border: none; color: #0284c7; cursor: pointer; font-size: 1.1em; line-height: 1; padding: 0 2px;">&times;</button>
        `;
        container.appendChild(tag);
      }
    }
    inp.value = '';
    triggerAutoSave();
  }

  function removeCustomLabTag(btn) {
    const tag = btn.closest('.custom-lab-tag');
    if (tag) tag.remove();
    triggerAutoSave();
  }

  function addDifferentialRow() {
    const container = document.getElementById('differentialContainer');
    if (!container) return;
    const div = document.createElement('div');
    div.className = 'diff-item-row';
    div.style.cssText = 'display: flex; gap: 6px; align-items: center;';
    div.innerHTML = `
      <input type="text" name="differential_items[]" placeholder="Enter differential diagnosis..." class="form-input auto-save-input" style="flex: 1; height: 34px; font-size: 0.86em; border-radius: 6px;">
      <button type="button" class="button btn-small" onclick="removeRow(this)" style="height: 32px; padding: 0 8px; background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; border-radius: 6px;">
        <i class="fa fa-times"></i>
      </button>
    `;
    container.appendChild(div);
    const input = div.querySelector('input');
    attachAutoSave(input);
    input.focus();
  }

  function addRxRow() {
    const tbody = document.getElementById('rxTableBody');
    if (!tbody) return;
    const tr = document.createElement('tr');
    tr.className = 'rx-row';
    tr.style.cssText = 'border-bottom: 1px solid #f1f5f9;';
    tr.innerHTML = `
      <td style="padding: 4px 6px;">
        <input type="text" name="rx_drug[]" placeholder="Drug name & dosage form" class="form-input auto-save-input" style="width: 100%;">
      </td>
      <td style="padding: 4px 6px;">
        <input type="text" name="rx_dosage[]" placeholder="1 cap" class="form-input auto-save-input" style="width: 100%;">
      </td>
      <td style="padding: 4px 6px;">
        <select name="rx_route[]" class="form-input auto-save-input" style="width: 100%;">
          <option value="Oral" selected>Oral (PO)</option>
          <option value="Topical">Topical</option>
          <option value="Inhalation">Inhalation</option>
          <option value="Sublingual">Sublingual</option>
          <option value="IV">IV</option>
          <option value="IM">IM</option>
        </select>
      </td>
      <td style="padding: 4px 6px;">
        <input type="text" name="rx_frequency[]" placeholder="e.g. TID" class="form-input auto-save-input" style="width: 100%;">
      </td>
      <td style="padding: 4px 6px;">
        <input type="text" name="rx_duration[]" placeholder="7 days" class="form-input auto-save-input" style="width: 100%;">
      </td>
      <td style="padding: 4px 6px;">
        <input type="text" name="rx_instructions[]" placeholder="#21 after meals" class="form-input auto-save-input" style="width: 100%;">
      </td>
      <td style="padding: 4px 6px; text-align: center;">
        <button type="button" class="button btn-small" onclick="removeRow(this)" style="height: 28px; padding: 0 6px; background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; border-radius: 6px;">
          <i class="fa fa-trash"></i>
        </button>
      </td>
    `;
    tbody.appendChild(tr);
    tr.querySelectorAll('.auto-save-input').forEach(attachAutoSave);
  }

  function removeRow(btn) {
    const row = btn.closest('.diff-item-row') || btn.closest('.rx-row');
    if (row) {
      row.remove();
      triggerAutoSave();
    }
  }

  function viewPriorVisitModal(idx) {
    const item = previousVisitsData[idx];
    if (!item) return;
    const modal = document.getElementById('priorVisitModal');
    const title = document.getElementById('modalTitle');
    const body = document.getElementById('modalBody');
    if (!modal || !title || !body) return;

    title.textContent = `Consultation — ${item.consultationDate ? new Date(item.consultationDate).toLocaleDateString() : 'Encounter'}`;
    const v = item.vitalSigns || {};
    const diffs = Array.isArray(item.differentialDiagnosis) ? item.differentialDiagnosis : [];
    const rxs = Array.isArray(item.prescriptions) ? item.prescriptions : [];

    body.innerHTML = `
      <div style="background: #f8fafc; padding: 12px; border-radius: 8px; margin-bottom: 12px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
        <div><strong>Doctor:</strong> ${item.doctorName || 'N/A'} (PRC: ${item.doctorLicenseNumber || '—'})</div>
        <div><strong>Visit Type:</strong> ${item.visitType || 'Visit'}</div>
        <div><strong>Status:</strong> <span style="color:#16a34a; font-weight:700;">${item.status || 'Completed'}</span></div>
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #0f172a;">Chief Complaint:</strong>
        <div style="padding: 4px 0;">${item.chiefComplaint || 'None recorded'}</div>
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #0f172a;">History of Present Illness:</strong>
        <div style="padding: 4px 0;">${item.historyOfPresentIllness || 'None recorded'}</div>
      </div>

      <div style="background: #f0fdfa; border: 1px solid #ccfbf1; border-radius: 8px; padding: 10px; margin-bottom: 12px;">
        <strong style="color: #0f766e; display: block; margin-bottom: 4px;">Vital Signs Recorded:</strong>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 6px; font-size: 0.9em;">
          <div>BP: <strong>${v.bloodPressureSystolic || '—'}/${v.bloodPressureDiastolic || '—'}</strong></div>
          <div>HR: <strong>${v.pulseRate || '—'} bpm</strong></div>
          <div>RR: <strong>${v.respiratoryRate || '—'} cpm</strong></div>
          <div>Temp: <strong>${v.temperature || '—'} °C</strong></div>
          <div>SpO2: <strong>${v.oxygenSaturation || '—'} %</strong></div>
          <div>BMI: <strong>${v.bmi || '—'} (${v.bmiCategory || '—'})</strong></div>
          <div>Pain: <strong>${v.painScale !== undefined && v.painScale !== '' ? v.painScale + '/10' : 'None'}</strong></div>
          <div>Sugar: <strong>${v.bloodGlucose || '—'} mg/dL</strong></div>
        </div>
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #0f172a;">Physical Examination:</strong>
        <div style="padding: 4px 0;">${item.physicalExamFindings || 'None recorded'}</div>
      </div>

      <div style="margin-bottom: 10px;">
        <strong style="color: #0f172a;">Primary Diagnosis:</strong>
        <div style="padding: 4px 0; font-weight: 700; color: #0d9488;">${item.primaryDiagnosis || 'None recorded'}</div>
      </div>

      ${diffs.length ? `
        <div style="margin-bottom: 10px;">
          <strong style="color: #0f172a;">Differential Diagnoses:</strong>
          <ul style="margin: 4px 0 0 20px; padding: 0;">
            ${diffs.map(d => `<li>${d}</li>`).join('')}
          </ul>
        </div>
      ` : ''}

      ${item.suspectedPathology ? `
        <div style="margin-bottom: 10px;">
          <strong style="color: #0f172a;">Suspected Pathology:</strong>
          <div>${item.suspectedPathology}</div>
        </div>
      ` : ''}

      ${rxs.length ? `
        <div style="margin-bottom: 10px;">
          <strong style="color: #0f172a;">Prescriptions Given:</strong>
          <table style="width: 100%; border-collapse: collapse; margin-top: 6px; font-size: 0.9em;">
            <tr style="background: #f1f5f9; text-align: left;"><th style="padding:4px 6px;">Drug</th><th style="padding:4px 6px;">Sig</th></tr>
            ${rxs.map(r => `<tr><td style="padding:4px 6px; border-bottom:1px solid #f1f5f9;"><strong>${r.drug}</strong> ${r.dosage || ''}</td><td style="padding:4px 6px; border-bottom:1px solid #f1f5f9;">${r.frequency || ''} ${r.duration ? 'x ' + r.duration : ''} ${r.instructions ? '(' + r.instructions + ')' : ''}</td></tr>`).join('')}
          </table>
        </div>
      ` : ''}

      ${item.treatmentPlan ? `
        <div style="margin-bottom: 10px;">
          <strong style="color: #0f172a;">Treatment Plan:</strong>
          <div>${item.treatmentPlan}</div>
        </div>
      ` : ''}
    `;

    modal.style.display = 'flex';
  }

  function closePriorVisitModal() {
    const modal = document.getElementById('priorVisitModal');
    if (modal) modal.style.display = 'none';
  }

  // Auto-Save Mechanics
  let autoSaveTimeout = null;

  function buildFormDataObject() {
    const form = document.getElementById('consultationForm');
    const fd = new FormData(form);
    const obj = {};
    fd.forEach((val, key) => {
      if (key.endsWith('[]')) {
        const cleanKey = key.slice(0, -2);
        obj[cleanKey] = obj[cleanKey] || [];
        obj[cleanKey].push(val);
      } else {
        obj[key] = val;
      }
    });

    // Assemble dynamic prescriptions
    const drugs = obj.rx_drug || [];
    const dosages = obj.rx_dosage || [];
    const routes = obj.rx_route || [];
    const freqs = obj.rx_frequency || [];
    const durations = obj.rx_duration || [];
    const insts = obj.rx_instructions || [];
    const rxList = [];
    for (let i = 0; i < drugs.length; i++) {
      if (drugs[i] && drugs[i].trim()) {
        rxList.push({
          drug: drugs[i].trim(),
          dosage: (dosages[i] || '').trim(),
          route: routes[i] || 'Oral',
          frequency: (freqs[i] || '').trim(),
          duration: (durations[i] || '').trim(),
          instructions: (insts[i] || '').trim()
        });
      }
    }
    obj.prescriptions = JSON.stringify(rxList);

    // Assemble dynamic lab orders (checked catalog items + custom typed procedures)
    const checkedLabs = Array.from(document.querySelectorAll('input[name="labOrders"]:checked')).map(el => el.value);
    const customBadges = Array.from(document.querySelectorAll('.custom-lab-tag-val')).map(el => el.value || el.textContent.trim());
    const allLabOrders = Array.from(new Set([...checkedLabs, ...customBadges])).filter(Boolean);
    obj.labRequestTests = JSON.stringify(allLabOrders.map(t => ({ testType: t })));

    // Assemble selected NCD pills
    const ncds = Array.from(document.querySelectorAll('.ncd-pill.selected')).map(b => b.getAttribute('data-ncd') || b.textContent.trim());
    obj.familyHistoryDiseases = ncds;

    return obj;
  }

  async function triggerAutoSave() {
    const indicator = document.getElementById('saveIndicator');
    if (indicator) {
      indicator.innerHTML = '<i class="fa fa-spinner fa-spin" style="color: #0284c7;"></i> Saving...';
    }

    try {
      const data = buildFormDataObject();
      const res = await fetch('/consultations/<%= test.id %>', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify(data)
      });
      const json = await res.json();
      if (json && json.success) {
        if (indicator) {
          const now = new Date().toLocaleTimeString();
          indicator.innerHTML = `<i class="fa fa-check-circle" style="color: #10b981;"></i> Saved at ${now}`;
        }
      } else {
        if (indicator) indicator.innerHTML = '<span style="color:#ef4444;">Save failed</span>';
      }
    } catch (e) {
      if (indicator) indicator.innerHTML = '<span style="color:#ef4444;">Offline</span>';
    }
  }

  function attachAutoSave(el) {
    if (!el) return;
    el.addEventListener('change', () => {
      clearTimeout(autoSaveTimeout);
      autoSaveTimeout = setTimeout(triggerAutoSave, 500);
    });
    el.addEventListener('blur', () => {
      clearTimeout(autoSaveTimeout);
      triggerAutoSave();
    });
  }

  document.querySelectorAll('.auto-save-input').forEach(attachAutoSave);

  document.getElementById('btnSaveDraft').addEventListener('click', (e) => {
    e.preventDefault();
    triggerAutoSave();
  });

  // Custom UI Modals for Consultation Completion & Validation
  const completeModal = document.getElementById('completeConsultationModal');
  const cancelCompleteModalBtn = document.getElementById('btnCancelCompleteModal');
  const confirmCompleteModalBtn = document.getElementById('btnConfirmCompleteModal');

  const validationModal = document.getElementById('validationAlertModal');
  const closeValidationModalBtn = document.getElementById('btnCloseValidationModal');

  function openCompleteModal() {
    if (completeModal) completeModal.style.display = 'flex';
  }

  function closeCompleteModal() {
    if (completeModal) completeModal.style.display = 'none';
  }

  function openValidationModal() {
    if (validationModal) validationModal.style.display = 'flex';
  }

  function closeValidationModal() {
    if (validationModal) validationModal.style.display = 'none';
    switchConsultTab('tab-soap', document.getElementById('tabNavSoap'));
    const diag = document.getElementById('primaryDiagnosisInput');
    if (diag) {
      setTimeout(() => {
        diag.focus();
        diag.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 100);
    }
  }

  if (cancelCompleteModalBtn) cancelCompleteModalBtn.addEventListener('click', closeCompleteModal);
  if (closeValidationModalBtn) closeValidationModalBtn.addEventListener('click', closeValidationModal);

  // Close modals on backdrop click or ESC key
  if (completeModal) {
    completeModal.addEventListener('click', function(e) {
      if (e.target === completeModal) closeCompleteModal();
    });
  }
  if (validationModal) {
    validationModal.addEventListener('click', function(e) {
      if (e.target === validationModal) closeValidationModal();
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeCompleteModal();
      closeValidationModal();
    }
  });

  // Clicking "Complete Consultation" in the top bar
  function handleCompleteClick() {
    const diag = document.getElementById('primaryDiagnosisInput');
    if (diag && !diag.value.trim()) {
      openValidationModal();
      return;
    }
    openCompleteModal();
  }

  const compBtn = document.getElementById('btnCompleteConsultation');
  if (compBtn) compBtn.addEventListener('click', handleCompleteClick);

  // Clicking "Complete Consultation" inside the custom modal
  if (confirmCompleteModalBtn) {
    confirmCompleteModalBtn.addEventListener('click', async function() {
      closeCompleteModal();

      const topCompleteBtn = document.getElementById('btnCompleteConsultation');
      if (topCompleteBtn) {
        topCompleteBtn.disabled = true;
        topCompleteBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Finalizing...';
      }

      try {
        const data = buildFormDataObject();
        const res = await fetch('/consultations/<%= test.id %>/complete', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json && json.success) {
          window.location.href = json.redirectUrl || '/reception/area/<%= encodeURIComponent(areaName || "Doctor\'s Check-up") %>';
        } else {
          const errMsg = json.message || 'Error completing consultation';
          if (typeof window.showCustomAlert === 'function') {
            window.showCustomAlert(errMsg, { title: 'Completion Error', type: 'danger', btnText: 'Dismiss' });
          } else {
            alert(errMsg);
          }
          if (topCompleteBtn) {
            topCompleteBtn.disabled = false;
            topCompleteBtn.innerHTML = '<i class="fa fa-check-circle"></i> Complete Consultation';
          }
        }
      } catch (err) {
        console.error('Complete failed', err);
        const errMsg = 'Network error while completing consultation. Please try again.';
        if (typeof window.showCustomAlert === 'function') {
          window.showCustomAlert(errMsg, { title: 'Network Error', type: 'danger', btnText: 'Dismiss' });
        } else {
          alert(errMsg);
        }
        if (topCompleteBtn) {
          topCompleteBtn.disabled = false;
          topCompleteBtn.innerHTML = '<i class="fa fa-check-circle"></i> Complete Consultation';
        }
      }
    });
  }

  // Initial calculation checks on page load
  recalcBmiUI();
  recalcPackYearsUI();
  recalcAlcoholRiskUI();
  recalcWaistRiskUI();
</script>
