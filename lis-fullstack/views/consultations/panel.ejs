<%
  const p = patient || {};
  const c = consultation || {};
  const vitals = c.vitalSigns || {};
  const isCompleted = (c.status === 'Completed');
  const patientAge = p.age || p.ageManual || '';
  const patientGender = String(p.gender || p.sex || '').toLowerCase();

  // DOH PhilPEN Data
  const smoking = (typeof c.smoking === 'object' && c.smoking !== null) ? c.smoking : {};
  const alcohol = (typeof c.alcohol === 'object' && c.alcohol !== null) ? c.alcohol : {};
  const famHistory = (typeof c.familyHistory === 'object' && c.familyHistory !== null && !Array.isArray(c.familyHistory))
    ? c.familyHistory
    : { diseases: [], notes: typeof c.familyHistory === 'string' ? c.familyHistory : '' };
  const socHistory = (typeof c.socialHistory === 'object' && c.socialHistory !== null && !Array.isArray(c.socialHistory))
    ? c.socialHistory
    : { occupation: '', physicalActivity: 'Active (≥150 mins/week)', dietaryHabits: '', notes: typeof c.socialHistory === 'string' ? c.socialHistory : '' };
  
  let rawDiffs = [];
  if (Array.isArray(c.differentialDiagnosis)) {
    rawDiffs = c.differentialDiagnosis;
  } else if (typeof c.differentialDiagnosis === 'string' && c.differentialDiagnosis.trim()) {
    try {
      const parsed = JSON.parse(c.differentialDiagnosis);
      rawDiffs = Array.isArray(parsed) ? parsed : [c.differentialDiagnosis.trim()];
    } catch (_) {
      rawDiffs = [c.differentialDiagnosis.trim()];
    }
  }
  const diffList = rawDiffs.map(item => {
    if (typeof item === 'string') {
      let s = item.trim();
      if (s.startsWith('[') && s.endsWith(']')) {
        try {
          const p = JSON.parse(s);
          if (Array.isArray(p)) return p[0] || '';
        } catch (_) {}
      }
      return s;
    }
    return item;
  }).filter(Boolean);

  const rxList = Array.isArray(c.prescriptions) ? c.prescriptions : [];
  const labOrders = Array.isArray(c.labRequestTests) ? c.labRequestTests : [];
%>

<style>
  /* Full-width container & box sizing */
  .consultation-panel {
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    padding: 0 4px 60px 4px !important;
    box-sizing: border-box !important;
  }

  /* Interactive NCD Screening Pills */
  .ncd-pill {
    padding: 4px 10px;
    border-radius: 20px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #334155;
    font-size: 0.8em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    user-select: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .ncd-pill:hover {
    background: #e2e8f0;
    border-color: #94a3b8;
  }
  .ncd-pill.selected {
    background: #0d9488;
    color: #ffffff;
    border-color: #0f766e;
    box-shadow: 0 1px 4px rgba(13,148,136,0.3);
  }

  /* Diagnostic Orders Styling */
  .diag-cat-title {
    font-size: 0.76em;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #0369a1;
    margin: 8px 0 4px 0;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .diag-item-lbl {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8em;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    padding: 4px 8px;
    border-radius: 6px;
    margin: 0;
    transition: background 0.15s ease, border-color 0.15s ease;
    user-select: none;
  }
  .diag-item-lbl:hover {
    background: #f1f5f9;
    border-color: #94a3b8;
  }
  .diag-item-lbl input[type="checkbox"]:checked + span {
    color: #0f766e;
    font-weight: 700;
  }
  .custom-lab-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #e0f2fe;
    color: #0369a1;
    border: 1px solid #bae6fd;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.82em;
    font-weight: 600;
  }
  .consultation-panel * {
    box-sizing: border-box;
  }

  /* Scoped styling to override global layout.ejs padding: 12px 16px */
