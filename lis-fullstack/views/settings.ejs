<div class="page active">
  <div class="card">
    <h3>Settings</h3>
    <p class="mb-20">Temporarily disable sections of the sidebar. Changes are temporary and in-memory.</p>

    <form method="POST" action="/settings">
      <div class="checkbox-group">
        <label class="checkbox-item"><input type="checkbox" name="tests" <%= featureFlags && featureFlags.tests ? 'checked' : '' %>/> Tests & Results</label>
        <label class="checkbox-item"><input type="checkbox" name="reports" <%= featureFlags && featureFlags.reports ? 'checked' : '' %>/> Reports</label>
        <label class="checkbox-item"><input type="checkbox" name="templates" <%= featureFlags && featureFlags.templates ? 'checked' : '' %>/> Templates</label>
        <label class="checkbox-item"><input type="checkbox" name="users" <%= featureFlags && featureFlags.users ? 'checked' : '' %>/> Users</label>
      </div>

      <hr/>
      <h4>Data Backup</h4>
      <div class="field">
        <label>Enable Auto Backup</label>
        <input type="checkbox" name="autoBackup" <%= (backupConfig && backupConfig.enabled) ? 'checked' : '' %> />
      </div>
      <div class="field">
        <label>Frequency</label>
        <select name="backupFrequency">
          <option value="daily" <%= (backupConfig && backupConfig.frequency === 'daily') ? 'selected' : '' %>>Daily</option>
          <option value="weekly" <%= (backupConfig && backupConfig.frequency === 'weekly') ? 'selected' : '' %>>Weekly</option>
          <option value="monthly" <%= (backupConfig && backupConfig.frequency === 'monthly') ? 'selected' : '' %>>Monthly</option>
        </select>
      </div>
      <div class="field">
        <label>Backup Folder</label>
        <input type="text" name="backupPath" placeholder="e.g. C:\\Users\\You\\Documents\\LIS\\backup" value="<%= (backupConfig && backupConfig.path) || '' %>" />
        <p class="note">Default: My Documents\LIS\backup</p>
      </div>

      <div class="mt-20">
        <button type="submit" class="button btn-primary">Save</button>
        <a href="/dashboard" class="button btn-secondary">Cancel</a>
      </div>
    </form>
    <hr/>
    <h4>Manual Backup / Restore</h4>
    <form method="POST" action="/settings/backup" style="display:inline-block;margin-right:12px;">
      <input type="hidden" name="backupPath" value="<%= (backupConfig && backupConfig.path) || '' %>" />
      <button type="submit" class="button btn-primary">Create Backup Now</button>
    </form>

    <form method="POST" action="/settings/restore" enctype="multipart/form-data" style="display:inline-block;">
      <input type="file" name="backupFile" accept=".json" required />
      <button type="submit" class="button btn-danger">Restore from File</button>
    </form>

    <form method="POST" action="/settings/clear" onsubmit="return confirm('Are you sure? This will remove non-admin data after creating a backup.');" style="display:inline-block;margin-left:12px;">
      <button type="submit" class="button btn-warning">Clear All Non-Admin Data</button>
    </form>
  </div>
</div>
