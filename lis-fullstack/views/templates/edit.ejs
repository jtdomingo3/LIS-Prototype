<div class="card">
  <h3>Edit Template</h3>

  <form action="/templates/<%= template.id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label>Template Name</label>
      <input type="text" name="name" value="<%= template.name || '' %>" required>
    </div>

    <div class="form-group">
      <label>Test Type</label>
      <input type="text" name="testType" value="<%= template.testType || '' %>" required>
    </div>

    <div class="form-group">
      <label>Fields (JSON array or one field per line)</label>
      <textarea name="fields" rows="6"><%= template.fields && Array.isArray(template.fields) ? JSON.stringify(template.fields, null, 2) : (template.fields || '') %></textarea>
    </div>

    <div class="form-group">
      <label>Footer Notes</label>
      <textarea name="footerNotes"><%= template.footerNotes || '' %></textarea>
    </div>

    <button class="button btn-primary">Save Changes</button>
  </form>
</div>
