<%
  const visibleTemplates = (templates || []).filter(t => {
    const name = (t.name || '').toLowerCase();
    if (name === 'full letter' || name === 'half letter') return false;
    const compact = name.replace(/[-\s]/g, '');
    if (/^[0-9a-f]{20,}$/.test(compact)) return false;
    return true;
  });
%>

<div class="card" style="padding:24px 28px; border-radius:16px; box-shadow:0 4px 18px rgba(0,0,0,0.03);">
  <!-- Toolbar -->
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:22px; padding-bottom:18px; border-bottom:1px solid #f1f5f9;">
    <div>
      <a href="/templates/new" class="button btn-primary no-guard" style="display:inline-flex; align-items:center; gap:8px; font-weight:600; padding:10px 20px;">
        <i class="fa fa-plus-circle"></i> Create New Template
      </a>
    </div>

    <div style="display:flex; gap:10px; align-items:center; flex:1; justify-content:flex-end; max-width:460px;">
      <div style="position:relative; width:100%;">
        <span style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.95em;">🔍</span>
        <input type="text" id="templateSearchInput" placeholder="Filter templates by name or test type..." onkeyup="filterTemplates()" style="width:100%; height:42px; padding-left:36px; padding-right:12px; font-size:14px; box-sizing:border-box; border-radius:10px; border:1px solid #cbd5e1; background:#fff;" />
      </div>
    </div>
  </div>

  <!-- Templates Table -->
  <div style="overflow-x:auto;">
    <table id="templatesTable" style="width:100%; border-collapse:collapse;">
      <thead>
        <tr style="border-bottom:2px solid #e2e8f0; text-align:left;">
          <th style="padding:12px 14px; font-size:0.85em; text-transform:uppercase; color:#64748b;">Template Name</th>
          <th style="padding:12px 14px; font-size:0.85em; text-transform:uppercase; color:#64748b;">Diagnostic Department / Type</th>
          <th style="padding:12px 14px; font-size:0.85em; text-transform:uppercase; color:#64748b;">Field Parameters</th>
          <th style="padding:12px 14px; font-size:0.85em; text-transform:uppercase; color:#64748b; text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (visibleTemplates && visibleTemplates.length) { %>
          <% visibleTemplates.forEach(t => { %>
            <tr class="template-row" style="border-bottom:1px solid #f1f5f9; transition:background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
              <td style="padding:14px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <strong class="template-name" style="color:#0f172a; font-size:1em;"><%= t.name %></strong>
                  <% if (t.isStatic) { %>
                    <span style="display:inline-block; background:rgba(59,130,246,0.1); color:#1e40af; font-size:0.75em; font-weight:700; padding:2px 8px; border-radius:10px;">Static</span>
                  <% } else { %>
                    <span style="display:inline-block; background:rgba(16,185,129,0.1); color:#065f46; font-size:0.75em; font-weight:700; padding:2px 8px; border-radius:10px;">Dynamic</span>
                  <% } %>
                </div>
              </td>
              <td style="padding:14px;">
                <span class="template-type" style="font-weight:600; color:#475569; background:#f1f5f9; padding:4px 10px; border-radius:8px; font-size:0.88em;">
                  <%= t.testType || 'General' %>
                </span>
              </td>
              <td style="padding:14px;">
                <% if (t.fields && Array.isArray(t.fields) && t.fields.length) { %>
                  <span style="display:inline-block; background:rgba(16,185,129,0.1); color:#065f46; font-size:0.82em; font-weight:700; padding:4px 10px; border-radius:10px;">
                    <%= t.fields.length %> parameters
                  </span>
                <% } else { %>
                  <span style="color:#94a3b8; font-size:0.9em;">—</span>
                <% } %>
              </td>
              <td style="padding:14px; text-align:right; white-space:nowrap;">
                <a href="/templates/<%= t.id %>" class="button btn-success btn-small" style="padding:6px 12px; font-size:0.82em; font-weight:600;">
                  <i class="fa fa-eye"></i> View
                </a>
                <a href="/templates/<%= t.id %>/edit" class="button btn-orange btn-small" style="padding:6px 12px; font-size:0.82em;">
                  <i class="fa fa-edit"></i> Edit
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align:center; color:#94a3b8; padding:48px 16px;">
              <span style="font-size:2.4em; display:block; margin-bottom:8px;">📄</span>
              <strong style="font-size:1.1em; color:#475569; display:block;">No Templates Found</strong>
              <span style="font-size:0.9em;">Create a report template to standardize laboratory result printouts.</span>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function filterTemplates() {
  const input = document.getElementById('templateSearchInput');
  const filter = input.value.toLowerCase().trim();
  const rows = document.querySelectorAll('.template-row');

  rows.forEach(row => {
    const name = row.querySelector('.template-name') ? row.querySelector('.template-name').textContent.toLowerCase() : '';
    const type = row.querySelector('.template-type') ? row.querySelector('.template-type').textContent.toLowerCase() : '';
    if (name.includes(filter) || type.includes(filter)) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}
</script>
