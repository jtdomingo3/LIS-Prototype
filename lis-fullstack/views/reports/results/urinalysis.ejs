
<style>
  @page { size: Letter; margin: 0.25in; }
  body { margin:0; padding:0; box-sizing:border-box; }
  *, *:before, *:after { box-sizing:inherit; }
  .report-page{ position:relative; width:100%; max-width:calc(8.5in - 0.5in); margin:0 auto; padding:6px; font-family: 'Times New Roman', Times, serif; color:#000; font-size:12px }
  .header{ display:flex; align-items:flex-start; gap:8px }
  .logo{ width:60px; height:auto; margin-right:6px }
  .lab-title{ text-align:center; flex:1; min-width:0 }
  .lab-title h1{ margin:0; font-size:18px; color:#009957; letter-spacing:1px }
  .lab-sub{ font-size:9px; margin-top:3px; color:#009957 }
  .patient-box{ margin-top:6px; width:100%; border-collapse:collapse; font-size:11px }
  .patient-box td{ padding:3px 5px; border:1px solid #000; box-sizing:border-box }
  .section-title{ text-align:center; margin:8px 0; font-size:13px; font-weight:bold }
  .results-frame{ width:100%; border:1px solid #000; border-collapse:collapse; margin-top:6px; box-sizing:border-box }
  .results-frame th, .results-frame td{ border:1px solid #000; padding:4px; vertical-align:middle; font-size:11px }
  .test-col{ width:50%; font-size:12px; font-weight:400; padding-left:8px; text-align:left }
  .results-frame th.test-col { text-align:center }
  .result-col{ width:50%; font-size:12px; text-align:center; text-transform:uppercase; font-weight:700 }
  .section-label{ text-align:left; display:block; font-weight:700 }
  .label-right{ text-align:left; display:block }
  .note{ margin-top:8px; border:none; padding:0 4px; font-size:11px }
  .note-text{ color:#c00 }
  .signatures{ display:flex; justify-content:space-between; margin-top:24px }
  .sig{ text-align:center; width:32% }
  .watermark{ position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:52%; opacity:0.06; pointer-events:none; z-index:0 }
  .report-container{ position:relative; z-index:1 }
</style>

<%- include('./_highlight') %>

<div class="report-page">
  <div class="report-container">
    <div class="header">
      <div>
        <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
      </div>
      <div class="lab-title">
        <h1>GEZYNE CLINICAL LABORATORY</h1>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
        <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub">Lic. No. 03-435-15CL-20</div>
      </div>	
      <div style="min-width:180px; font-size:12px; text-align:right">
        <table style="border-collapse:collapse; width:100%; font-size:12px">
          <tr><td style="border:1px solid #000; padding:4px">Date:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleDateString() : new Date().toLocaleDateString() %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Requested:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Released:</td><td style="border:1px solid #000; padding:4px"><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></td></tr>
        </table>
      </div>
    </div>

    <table class="patient-box">
      <tr>
        <td style="width:20%">Patient's Reference No. :</td>
        <td style="width:30%"><strong><%= test && test.testId ? test.testId : '' %></strong></td>
        <td style="width:15%">DOB:</td>
        <td style="width:15%"><strong><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></strong></td>
        <td style="width:10%">Sex:</td>
        <td style="width:10%"><strong><%= test && test.patient && test.patient.sex ? test.patient.sex : '' %></strong></td>
      </tr>
      <tr>
        <td>Name:</td>
        <td colspan="3"><strong><%= test && test.patient ? (test.patient.lastName + ', ' + test.patient.firstName) : '' %></strong></td>
        <td>Age:</td>
        <td><strong><%= test && test.patient && test.patient.dateOfBirth ? Math.max(0, new Date().getFullYear() - new Date(test.patient.dateOfBirth).getFullYear()) : (test && test.patient && test.patient.ageManual ? test.patient.ageManual : '') %></strong></td>
      </tr>
      <tr>
        <td>Physician:</td>
        <td colspan="5"><strong><%= (test && test.patient && (test.patient.physician || test.patient.physicianName)) ? (test.patient.physician || test.patient.physicianName) : '' %></strong></td>
      </tr>
    </table>

    <div class="section-title">URINALYSIS</div>

    <table class="results-frame">
      <tr>
        <td style="width:50%; vertical-align:top;">
          <table style="width:100%; border-collapse:collapse;">
            <tr>
              <th style="text-align:left; padding:6px; border:1px solid #000;">PHYSICAL / CHEMICAL ANALYSIS</th>
              <th style="text-align:center; padding:6px; border:1px solid #000; width:20%">Results</th>
              <th style="text-align:center; padding:6px; border:1px solid #000; width:20%">Reference Interval</th>
            </tr>
            <tr>
              <td class="label">Color</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.color) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">Transparency</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.appearance) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">pH</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.ph) %></td>
              <td style="text-align:center">5.0 - 7.0</td>
            </tr>
            <tr>
              <td class="label">Sp. Gravity</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.specificGravity) %></td>
              <td style="text-align:center">1.005 - 1.025</td>
            </tr>
            <tr>
              <td class="label">Glucose</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.glucose) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <tr>
              <td class="label">Protein</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.protein) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <tr>
              <td class="label">Leukocyte</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.leukocyte) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <tr>
              <td class="label">Nitrite</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.nitrite) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <tr>
              <td class="label">Urobilinogen</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.urobilinogen) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <tr>
              <td class="label">Blood</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.blood) %></td>
              <td style="text-align:center">Negative</td>
            </tr>
            <!-- Ketones and Bilirubin moved to Microscopic Analysis column -->
          </table>
        </td>
        <td style="width:50%; vertical-align:top;">
          <table style="width:100%; border-collapse:collapse;">
            <tr>
              <th style="text-align:left; padding:6px; border:1px solid #000">MICROSCOPIC ANALYSIS</th>
              <th style="text-align:center; padding:6px; border:1px solid #000; width:20%">Results</th>
              <th style="text-align:center; padding:6px; border:1px solid #000; width:20%">Reference Interval</th>
            </tr>
            <tr>
              <td class="label">WBC</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.wbc) %></td>
              <td style="text-align:center">0-3 / hpf</td>
            </tr>
            <tr>
              <td class="label">RBC</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.rbc) %></td>
              <td style="text-align:center">0-5 / hpf</td>
            </tr>
            <tr>
              <td class="label">Epithelial Cells</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.epithelial) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">Mucus Threads</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.mucus) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">Amorphous Crystals</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.amorphous) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">Bacteria</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.bacteria) %></td>
              <td style="text-align:center"></td>
            </tr>
            <tr>
              <td class="label">Others</td>
              <td style="text-align:center"><%- hl(test && test.results && test.results.others) %></td>
              <td style="text-align:center"></td>
            </tr>
          </table>
        </td>
      </tr>
    </table>

    <div class="note"><strong>NOTE:</strong> <span class="note-text"><%= test && test.results && test.results.note ? test.results.note : '' %></span></div>

    <div class="signatures">
      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700"><strong><%= (test && test.results && test.results.performedByName) || (test && test.performedBy && test.performedBy.name) || '' %></strong></div>
        <div style="font-size:11px"><% if (test && test.results && test.results.performedByLicense) { %><strong>Lic. No. <%= test.results.performedByLicense %></strong><% } %></div>
        <div>Medical Technologist</div>
      </div>

      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700"><strong><%= (test && test.results && test.results.validatedByName) || '' %></strong></div>
        <div style="font-size:11px"><% if (test && test.results && test.results.validatedByLicense) { %><strong>Lic. No. <%= test.results.validatedByLicense %></strong><% } %></div>
        <div>Validated by</div>
      </div>

      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700"><strong><%= (test && test.results && test.results.requestedByName) || (test && test.requestedBy && test.requestedBy.name) || '' %></strong></div>
        <div style="font-size:11px"><% if (test && test.results && test.results.requestedByLicense) { %><strong>Lic. No. <%= test.results.requestedByLicense %></strong><% } %></div>
        <div>Pathologist</div>
      </div>
    </div>
  </div>

  <img class="watermark" src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" alt="" />
</div>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 300);</script>
<% } %>
