<style>
  @page { size: Letter; margin: 0.25in; }
  body { margin:0; padding:0; box-sizing:border-box; }
  *, *:before, *:after { box-sizing:inherit; }
  /* Limit content width to printable area: Letter width minus page margins (0.25in each side) */
  .report-page{ position:relative; width:100%; max-width:calc(8.5in - 0.5in); margin:0 auto; padding:8px; font-family: 'Times New Roman', Times, serif; color:#000 }
  .header{ display:flex; align-items:flex-start; gap:12px }
  .logo{ width:72px; height:auto; margin-right:8px }
  .lab-title{ text-align:center; flex:1; min-width:0 }
  .lab-title h1{ margin:0; font-size:26px; color:#009957; letter-spacing:1px }
  .lab-sub{ font-size:10px; margin-top:4px; color:#009957 }
  .patient-box{ margin-top:8px; width:100%; border-collapse:collapse; font-size:12px }
  .patient-box td{ padding:4px 6px; border:1px solid #000; box-sizing:border-box }
  .section-title{ text-align:center; margin:12px 0; font-size:22px; font-weight:bold; text-decoration:underline }
  .results-frame{ width:100%; border:2px solid #000; border-collapse:collapse; margin-top:6px; box-sizing:border-box }
  .results-frame td{ padding:0; vertical-align:top }
  .inner-table{ width:100%; border-collapse:collapse; box-sizing:border-box }
  .inner-table td, .inner-table th{ padding:4px 6px; border-bottom:1px dotted #999; font-size:12px }
  .inner-table th{ font-weight:700; font-size:12px }
  .inner-table td strong{ display:inline-block; width:35%; text-align:center }
  .inner-table td .norm-block{ display:inline-block; width:65%; float:right; text-align:right }
  .inner-table td .norm-block div{ white-space:nowrap }
  .two-col{ display:flex }
  .col{ width:50%; padding:6px; box-sizing:border-box }
  .normal-small{ font-size:11px; color:#333 }
  .signatures{ display:flex; justify-content:space-between; margin-top:24px }
  .sig{ text-align:center; width:32% }
  .sig-line{ width:70%; margin:0 auto 6px; border-top:1px solid #000; height:0 }
  .sig .name{ padding-top:0; margin-bottom:6px; font-weight:700 }
  .watermark{ position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:52%; opacity:0.06; pointer-events:none; z-index:0 }
  .report-container{ position:relative; z-index:1 }
</style>

<div class="report-page">
  <div class="report-container">
    <div class="header">
      <div>
        <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
      </div>
      <div class="lab-title">
        <h1>GEZYNE CLINICAL LABORATORY</h1>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
        <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub">Lic. No. 03-435-15CL-20</div>
      </div>						
      <div style="min-width:180px; font-size:12px; text-align:right">
        <table style="border-collapse:collapse; width:100%; font-size:12px">
          <tr><td style="border:1px solid #000; padding:4px">Date:</td><td style="border:1px solid #000; padding:4px"><%= new Date().toLocaleDateString() %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Requested:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Released:</td><td style="border:1px solid #000; padding:4px"><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></td></tr>
        </table>
      </div>
    </div>

    <table class="patient-box">
      <tr>
        <td style="width:20%"><strong>Patient's Reference No. :</strong></td>
        <td style="width:30%"><%= test && test.testId ? test.testId : '' %></td>
        <td style="width:15%"><strong>DOB:</strong></td>
        <td style="width:15%"><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></td>
        <td style="width:10%"><strong>Sex:</strong></td>
        <td style="width:10%"><%= test && test.patient && test.patient.sex ? test.patient.sex : '' %></td>
      </tr>
      <tr>
        <td><strong>Name:</strong></td>
        <td colspan="3"><%= test && test.patient ? (test.patient.lastName + ', ' + test.patient.firstName) : '' %></td>
        <td><strong>Age:</strong></td>
        <td><%= test && test.patient && test.patient.dateOfBirth ? Math.max(0, new Date().getFullYear() - new Date(test.patient.dateOfBirth).getFullYear()) : (test && test.patient && test.patient.ageManual ? test.patient.ageManual : '') %></td>
      </tr>
      <tr>
        <td><strong>Physician:</strong></td>
        <td colspan="5"><%= (test && test.patient && (test.patient.physician || test.patient.physicianName)) ? (test.patient.physician || test.patient.physicianName) : '' %></td>
      </tr>
    </table>

    <div class="section-title">HEMATOLOGY</div>

    <table class="results-frame">
      <tr>
        <td>
          <div class="two-col">
            <div class="col">
              <table class="inner-table">
                <tr><th style="width:60%">Result</th><th style="width:40%">Normal</th></tr>
                <tr><td>RBC ct. (x 10^6/µL)</td><td class="normal-small"> <strong><%= test && test.results && test.results.rbc ? test.results.rbc : '' %></strong> <span class="norm-block"><div>3.8-5.8</div></span></td></tr>
                <tr>
                  <td>Hemoglobin (g/dL)</td>
                  <td class="normal-small">
                    <% var _sex = String((test && test.patient && test.patient.sex) || '').toLowerCase(); %>
                    <div style="display:flex; flex-direction:column;">
                      <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="width:35%; text-align:center;"><strong><% if (_sex === 'male') { %><%= (test && test.results && test.results.hemoglobin) ? test.results.hemoglobin : '' %><% } else { %>&nbsp;<% } %></strong></div>
                        <div style="width:65%; text-align:right; white-space:nowrap">Male&nbsp;&nbsp;130-160</div>
                      </div>
                      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
                        <div style="width:35%; text-align:center;"><strong><% if (_sex === 'female') { %><%= (test && test.results && test.results.hemoglobin) ? test.results.hemoglobin : '' %><% } else { %>&nbsp;<% } %></strong></div>
                        <div style="width:65%; text-align:right; white-space:nowrap">Female&nbsp;&nbsp;120-140</div>
                      </div>
                    </div>
                  </td>
                </tr>
                <tr>
                  <td>Hematocrit (%)</td>
                  <td class="normal-small">
                    <% var _sex = String((test && test.patient && test.patient.sex) || '').toLowerCase(); %>
                    <div style="display:flex; flex-direction:column;">
                      <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div style="width:35%; text-align:center; font-weight:700;"><% if (_sex === 'male') { %><%= (test && test.results && test.results.hematocrit) ? test.results.hematocrit : '' %><% } else { %>&nbsp;<% } %></div>
                        <div style="width:65%; text-align:right; white-space:nowrap">Male&nbsp;&nbsp;0.38-0.49</div>
                      </div>
                      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:4px;">
                        <div style="width:35%; text-align:center; font-weight:700;"><% if (_sex === 'female') { %><%= (test && test.results && test.results.hematocrit) ? test.results.hematocrit : '' %><% } else { %>&nbsp;<% } %></div>
                        <div style="width:65%; text-align:right; white-space:nowrap">Female&nbsp;&nbsp;0.36-0.44</div>
                      </div>
                    </div>
                  </td>
                </tr>
                <tr><td>MCV (µm^3)</td><td class="normal-small"> <strong><%= test && test.results && test.results.mcv ? test.results.mcv : '' %></strong> <span class="norm-block"><div>83.0-98.0</div></span></td></tr>
                <tr><td>MCH (pg)</td><td class="normal-small"> <strong><%= test && test.results && test.results.mch ? test.results.mch : '' %></strong> <span class="norm-block"><div>27.0-32.2</div></span></td></tr>
                <tr><td>MCHC (g/dL)</td><td class="normal-small"> <strong><%= test && test.results && test.results.mchc ? test.results.mchc : '' %></strong> <span class="norm-block"><div>31.8-33.7</div></span></td></tr>
              </table>
            </div>

            <div class="col">
              <table class="inner-table">
                <tr><th style="width:60%">Result</th><th style="width:40%">Normal</th></tr>
                <tr><td>WBC ct.(x10^9/L)</td><td class="normal-small"> <strong><%= test && test.results && test.results.wbc ? test.results.wbc : '' %></strong> &nbsp;&nbsp; <span style="float:right">5.0-10.0</span></td></tr>
                <tr><td>Neutrophils (%)</td><td class="normal-small"> <strong><%= test && test.results && test.results.neutrophils ? test.results.neutrophils : '' %></strong> &nbsp;&nbsp; <span style="float:right">43.0-76.0</span></td></tr>
                <tr><td>Lymphocyte (%)</td><td class="normal-small"> <strong><%= test && test.results && test.results.lymphocyte ? test.results.lymphocyte : '' %></strong> &nbsp;&nbsp; <span style="float:right">17.0-48.0</span></td></tr>
                <tr><td>Monocyte (%)</td><td class="normal-small"> <strong><%= test && test.results && test.results.monocyte ? test.results.monocyte : '' %></strong> &nbsp;&nbsp; <span style="float:right">0-10.0</span></td></tr>
                <tr><td>Eosinophils (%)</td><td class="normal-small"> <strong><%= test && test.results && test.results.eosinophils ? test.results.eosinophils : '' %></strong> &nbsp;&nbsp; <span style="float:right">0.5-5.0</span></td></tr>
                <tr><td>Basophils (%)</td><td class="normal-small"> <strong><%= test && test.results && test.results.basophils ? test.results.basophils : '' %></strong> &nbsp;&nbsp; <span style="float:right">0-1</span></td></tr>
                <tr><td>Platelet ct.(x10^9/L)</td><td class="normal-small"> <strong><%= test && test.results && test.results.platelets ? test.results.platelets : '' %></strong> &nbsp;&nbsp; <span style="float:right">150-350</span></td></tr>
              </table>
            </div>
          </div>
        </td>
      </tr>
    </table>

    <div class="signatures">
      <div class="sig">
          <div class="sig-line"></div>
          <div class="name"><strong><%= (test && test.results && test.results.performedByName) || (test && test.performedBy && test.performedBy.name) || '' %></strong></div>
          <div class="normal-small"><% if (test && test.results && test.results.performedByLicense) { %><strong>Lic. No. <%= test.results.performedByLicense %></strong><% } %></div>
          <div>Medical Technologist</div>
        </div>

      <div class="sig">
        <div class="sig-line"></div>
        <div class="name"><strong><%= (test && test.results && test.results.validatedByName) || '' %></strong></div>
        <div class="normal-small"><% if (test && test.results && test.results.validatedByLicense) { %><strong>Lic. No. <%= test.results.validatedByLicense %></strong><% } %></div>
        <div>Validated By</div>
      </div>

      <div class="sig">
        <div class="sig-line"></div>
        <div class="name"><strong><%= (test && test.results && test.results.requestedByName) || (test && test.requestedBy && test.requestedBy.name) || '' %></strong></div>
        <div class="normal-small"><% if (test && test.results && test.results.requestedByLicense) { %><strong>Lic. No. <%= test.results.requestedByLicense %></strong><% } %></div>
        <div>Pathologist</div>
      </div>
    </div>
  </div>

  <img class="watermark" src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" alt="" />
</div>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 300);</script>
<% } %>
