<style>
  @page { size: Letter; margin: 0.25in; }
  body { margin:0; padding:0; box-sizing:border-box; }
  *, *:before, *:after { box-sizing:inherit; }
  .report-page{ position:relative; width:100%; max-width:calc(8.5in - 0.5in); margin:0 auto; padding:8px; font-family: 'Times New Roman', Times, serif; color:#000 }
  .header{ display:flex; align-items:flex-start; gap:12px }
  .logo{ width:72px; height:auto; margin-right:8px }
  .lab-title{ text-align:center; flex:1; min-width:0 }
  .lab-title h1{ margin:0; font-size:22px; color:#009957; letter-spacing:1px }
  .lab-sub{ font-size:10px; margin-top:4px; color:#009957 }
  .patient-box{ margin-top:8px; width:100%; border-collapse:collapse; font-size:12px }
  .patient-box td{ padding:4px 6px; border:1px solid #000; box-sizing:border-box }
  .section-title{ text-align:center; margin:2px 0 0; font-size:20px; font-weight:bold }
  .results-frame{ width:100%; border:2px solid #000; border-collapse:collapse; margin-top:0; box-sizing:border-box; padding-top:6px }
  .results-frame td{ padding:0; vertical-align:middle }
  .specimen-cell{ width:50%; padding:18px; font-size:28px; font-weight:700; text-align:center; border-right:1px solid #000 }
  .result-cell{ width:50%; padding:18px; font-size:56px; font-weight:900; text-align:center }
  .signatures{ display:flex; justify-content:space-between; margin-top:48px }
  .sig{ text-align:center; width:32%; position:relative; min-height:80px }
  .signature-overlay{ position:absolute; left:50%; transform-origin:center; pointer-events:none; max-width:60%; z-index:2 }
  .watermark{ position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:52%; opacity:0.06; pointer-events:none; z-index:0 }
  .report-container{ position:relative; z-index:1 }
</style>

<%- include('./_highlight') %>

<div class="report-page">
  <div class="report-container">
    <div class="header">
      <div>
        <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
      </div>
      <div class="lab-title">
        <h1>GEZYNE X-RAY DEPARTMENT</h1>
        <div class="lab-sub"><strong>DOH ACCREDITED</strong></div>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
        <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub">Lic. No. 03-435-15CL-2</div>
      </div>						
      <div style="min-width:180px; font-size:12px; text-align:right">
        <table style="border-collapse:collapse; width:100%; font-size:12px">
          <tr><td style="border:1px solid #000; padding:4px">Date:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleDateString() : new Date().toLocaleDateString() %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Requested:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Released:</td><td style="border:1px solid #000; padding:4px"><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></td></tr>
        </table>
      </div>
    </div>

    <table class="patient-box">
      <tr>
        <td style="width:20%">Case No.:</td>
        <td style="width:30%"><strong><%= test && test.caseNumber ? test.caseNumber : (test && test.results && test.results.caseNumber ? test.results.caseNumber : '') %></strong></td>
        <td style="width:15%">DOB:</td>
        <td style="width:15%"><strong><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></strong></td>
        <td style="width:10%">Sex:</td>
        <td style="width:10%"><strong><%= test && test.patient && test.patient.sex ? test.patient.sex : '' %></strong></td>
      </tr>
      <tr>
        <td>Name:</td>
        <td colspan="3"><strong><%= test && test.patient ? (test.patient.lastName + ', ' + test.patient.firstName) : '' %></strong></td>
        <td>Age:</td>
        <td><strong><%= test && test.patient ? (test.patient.age !== null && test.patient.age !== undefined && test.patient.age !== '' ? test.patient.age : (test.patient.ageManual || '')) : '' %></strong></td>
      </tr>
      <tr>
        <td>Examination:</td>
        <td colspan="5"><strong><%= (test && (test.examination || (test.results && test.results.examination) || test.examinationName)) %></strong></td>
      </tr>
      <tr>
        <td>Physician:</td>
        <td colspan="5"><strong><%= (test && test.patient && (test.patient.physician || test.patient.physicianName)) ? (test.patient.physician || test.patient.physicianName) : '' %></strong></td>
      </tr>
    </table>

    <div class="section-title">X-Ray Result</div>

    <div class="results-frame" style="border:none; padding:12px; line-height:1.4; padding-left:5.5em; padding-right:3.5em;font-size:<%= (test && test.results && test.results.paragraphs_font_size) ? test.results.paragraphs_font_size : '16px' %>; font-family:<%= (test && test.results && test.results.paragraphs_font_family) ? ('"' + test.results.paragraphs_font_family + '"') : "'Times New Roman'" %>">
      <% 
        var raw = (test && test.results && (test.results.paragraphs || test.results.result)) ? (test.results.paragraphs || test.results.result) : '';
        var htmlOut = raw;
        if (raw && !/<\/?[a-z][\s\S]*>/i.test(raw)) {
          // convert double newlines to paragraphs, single newline to <br>
          var parts = raw.split(/\r?\n\r?\n/).map(function(p){ return p.trim(); }).filter(Boolean);
          if (parts.length) {
            htmlOut = parts.map(function(p){ return '<p>' + p.replace(/\r?\n/g, '<br>') + '</p>'; }).join('\n');
          } else {
            htmlOut = raw.replace(/\r?\n/g, '<br>');
          }
        }
      %>
      <%- htmlOut %>
    </div>

    <%
      function findSigFor(displayName){
        if (!displayName) return null;
        var sigs = (test && test.results && test.results.signatures) ? test.results.signatures : {};
        for(var k in sigs){ if(sigs[k] && sigs[k].name === displayName) return sigs[k]; }
        return null;
      }
    %>

    <div class="signatures">
      <div class="sig">
        <div style="border-top:1px solid #000; height:0; margin-bottom:8px"></div>
        <% var _performedName = (test && test.results && test.results.performedByName) || (test && test.performedBy && test.performedBy.name) || '' %>
        <div style="font-weight:700"><strong><%= _performedName %></strong></div>
        <% var _performedSig = findSigFor(_performedName); %>
        <% if (_performedSig && _performedSig.filename) { %>
          <% var p = _performedSig.placement || { x:0, y:-56, scale:1.25 }; if(p && (typeof p.scale==='undefined' || p.scale===1)) p.scale=1.25; %>
          <img src="/assets/signature/<%= _performedSig.filename %>" class="signature-overlay" style="top:<%= p.y %>px; transform:translateX(-50%) scale(<%= p.scale %>); max-height:96px;" alt="signature" />
        <% } %>
        <div style="font-size:11px"><% if (test && test.results && test.results.performedByLicense) { %><strong>Lic. No. <%= test.results.performedByLicense %></strong><% } %></div>
        <div>X-Ray Technician</div>
      </div>

      <div class="sig">
        <div style="border-top:1px solid #000; height:0; margin-bottom:8px"></div>
        <% var _requestedName = (test && test.results && test.results.requestedByName) || (test && test.requestedBy && test.requestedBy.name) || 'Dr. Omar Baraga, DPBR' %>
        <div style="font-weight:700"><strong><%= _requestedName %></strong></div>
        <% var _requestedSig = findSigFor(_requestedName); %>
        <% if (_requestedSig && _requestedSig.filename) { %>
          <% var p2 = _requestedSig.placement || { x:0, y:-56, scale:1.25 }; if(p2 && (typeof p2.scale==='undefined' || p2.scale===1)) p2.scale=1.25; %>
          <img src="/assets/signature/<%= _requestedSig.filename %>" class="signature-overlay" style="top:<%= p2.y %>px; transform:translateX(-50%) scale(<%= p2.scale %>); max-height:96px;" alt="signature" />
        <% } else if (_requestedName === 'Dr. Omar Baraga, DPBR') { %>
          <% var p2 = { x:0, y:-56, scale:1.25 }; %>
          <img src="/assets/signature/DrBragaSignature.png" class="signature-overlay" style="top:<%= p2.y %>px; transform:translateX(-50%) scale(<%= p2.scale %>); max-height:140px;" alt="Dr. Omar Baraga signature" />
        <% } %>
        <div style="font-size:11px"><% if (test && test.results && test.results.requestedByLicense) { %><strong>Lic. No. <%= test.results.requestedByLicense %></strong><% } %></div>
        <div>Radiologist</div>
      </div>
    </div>
  </div>

  <img class="watermark" src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" alt="" />
</div>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 300);</script>
<% } %>
