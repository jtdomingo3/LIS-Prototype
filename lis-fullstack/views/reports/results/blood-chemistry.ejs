<style>
  @page { size: Letter; margin: 0.25in; }

  body { margin:0; padding:0; box-sizing:border-box; }
  *, *:before, *:after { box-sizing:inherit; }
  .report-page{ position:relative; width:100%; max-width:calc(8.5in - 0.5in); margin:0 auto; padding:8px; font-family: 'Times New Roman', Times, serif; color:#000 }
  .header{ display:flex; align-items:flex-start; gap:12px }
  .logo{ width:72px; height:auto; margin-right:8px }
  .lab-title{ text-align:center; flex:1; min-width:0 }
  .lab-title h1{ margin:0; font-size:22px; color:#009957; letter-spacing:1px }
  .lab-sub{ font-size:10px; margin-top:4px; color:#009957 }
  .patient-box{ margin-top:8px; width:100%; border-collapse:collapse; font-size:12px }
  .patient-box td{ padding:4px 6px; border:1px solid #000; box-sizing:border-box }
  .section-title{ text-align:center; margin:11px 0; font-size:16px; font-weight:bold }
  .results-frame{ width:100%; border:2px solid #000; border-collapse:collapse; margin-top:6px; box-sizing:border-box }
  .results-frame td{ padding:6px; vertical-align:middle; border-bottom:1px solid #000 }
  .results-frame th{ padding:8px; text-align:left; border-bottom:2px solid #000; font-weight:700 }
  .blood-results th{ padding:4px 8px; font-size:10px; font-weight:700 }
  .blood-results td{ padding:4px 8px; font-size:10px }
  .results-frame th, .results-frame td { border-right:1px solid #000 }
  .results-frame th:last-child, .results-frame td:last-child { border-right:none }
  .flag { display:inline-block; min-width:18px; margin-left:6px; color:#d00; font-weight:700 }
  .results-frame .center{ text-align:center }
  .signatures{ display:flex; justify-content:space-between; margin-top:24px }
  .sig{ position:relative; text-align:center; width:32%; min-height:90px }
  .signature-overlay{ position:absolute; pointer-events:none; left:50%; transform-origin:center; }
  .watermark{ position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:52%; opacity:0.06; pointer-events:none; z-index:0 }
  .report-container{ position:relative; z-index:1 }
  .normal-small{ font-size:11px; color:#333 }
</style>
<%- include('./_highlight') %>
<div class="report-page">
  <div class="report-container">
    <div class="header">
      <div>
        <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
      </div>
      <div class="lab-title">
        <h1>GEZYNE CLINICAL LABORATORY</h1>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
        <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub">Lic. No. 03-435-15CL-20</div>
      </div>	
      <div style="min-width:180px; font-size:12px; text-align:right">
        <table style="border-collapse:collapse; width:100%; font-size:12px">
          <tr><td style="border:1px solid #000; padding:4px">Date:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleDateString() : new Date().toLocaleDateString() %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Requested:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Released:</td><td style="border:1px solid #000; padding:4px"><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></td></tr>
        </table>
      </div>
    </div>

    <table class="patient-box">
      <tr>
        <td style="width:20%">Patient's Reference No. :</td>
        <td style="width:30%"><strong><%= test && test.testId ? test.testId : '' %></strong></td>
        <td style="width:15%">DOB:</td>
        <td style="width:15%"><strong><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></strong></td>
        <td style="width:10%">Sex:</td>
        <td style="width:10%"><strong><%= test && test.patient && test.patient.sex ? test.patient.sex : '' %></strong></td>
      </tr>
      <tr>
        <td>Name:</td>
        <td colspan="3"><strong><%= test && test.patient ? (test.patient.lastName + ', ' + test.patient.firstName) : '' %></strong></td>
        <td>Age:</td>
        <td><strong><%= test && test.patient && test.patient.dateOfBirth ? Math.max(0, new Date().getFullYear() - new Date(test.patient.dateOfBirth).getFullYear()) : (test && test.patient && test.patient.ageManual ? test.patient.ageManual : '') %></strong></td>
      </tr>
      <tr>
        <td>Physician:</td>
        <td colspan="5"><strong><%= (test && test.patient && (test.patient.physician || test.patient.physicianName)) ? (test.patient.physician || test.patient.physicianName) : '' %></strong></td>
      </tr>
    </table>

    <div class="section-title">BLOOD CHEMISTRY</div>

    <% function flagValue(val, min, max) {
         if (val === undefined || val === null || String(val).trim() === '') return '';
         const n = parseFloat(String(val).replace(/[^0-9.+-eE]/g, ''));
         if (isNaN(n)) return '';
         if (typeof min === 'number' && !isNaN(min) && n < min) return 'L';
         if (typeof max === 'number' && !isNaN(max) && n > max) return 'H';
         return '';
       }
    %>
    <div class="results-columns" style="display:flex; gap:10px;">
      <table class="results-frame blood-results" style="width:50%;">
        <tr>
          <th style="width:45%">TEST</th>
          <th style="width:20%">RESULT</th>
          <th style="width:15%">UNIT</th>
          <th style="width:20%">REFERENCE</th>
        </tr>
        <tr>
          <td>FBS</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.fbs ? test.results.fbs : '' %><span class="flag"><%= flagValue(test && test.results && test.results.fbs,70,110) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">70.00 - 110.00</td>
        </tr>
        <tr>
          <td>RBS</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.rbs ? test.results.rbs : '' %><span class="flag"><%= flagValue(test && test.results && test.results.rbs,80,130) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">80.00 - 130.00</td>
        </tr>
        <tr>
          <td>1st Hour</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.firstHour ? test.results.firstHour : '' %><span class="flag"><%= flagValue(test && test.results && test.results.firstHour,90,140) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">90.00 - 140.00</td>
        </tr>
        <tr>
          <td>2nd Hour</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.secondHour ? test.results.secondHour : '' %><span class="flag"><%= flagValue(test && test.results && test.results.secondHour,80,120) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">80.00 - 120.00</td>
        </tr>
        <tr>
          <td>Cholesterol</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.cholesterol ? test.results.cholesterol : '' %><span class="flag"><%= flagValue(test && test.results && test.results.cholesterol,0,200) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">0.00 - 200.00</td>
        </tr>
        <tr>
          <td>Triglyceride</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.tg ? test.results.tg : '' %><span class="flag"><%= flagValue(test && test.results && test.results.tg,60,150) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">60.00 - 150.00</td>
        </tr>
        <tr>
          <td>HDL-C</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.hdl ? test.results.hdl : '' %><span class="flag"><%= flagValue(test && test.results && test.results.hdl,35,80) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">35.00 - 80.00</td>
        </tr>
        <tr>
          <td>LDL</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.ldl ? test.results.ldl : '' %><span class="flag"><%= flagValue(test && test.results && test.results.ldl,66,178) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">66.00 - 178.00</td>
        </tr>
        <tr>
          <td>VLDL</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.vldl ? test.results.vldl : '' %><span class="flag"><%= flagValue(test && test.results && test.results.vldl,0,30) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">0.00 - 30.00</td>
        </tr>
        <tr>
          <td>Uric Acid</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.uricAcid ? test.results.uricAcid : '' %><span class="flag"><%= flagValue(test && test.results && test.results.uricAcid,2.4,5.7) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">2.40 - 5.70</td>
        </tr>
      </table>

      <table class="results-frame blood-results" style="width:50%;">
        <tr>
          <th style="width:45%">TEST</th>
          <th style="width:20%">RESULT</th>
          <th style="width:15%">UNIT</th>
          <th style="width:20%">REFERENCE</th>
        </tr>
        <tr>
          <td>Creatinine</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.creatinine ? test.results.creatinine : '' %><span class="flag"><%= flagValue(test && test.results && test.results.creatinine,0.5,1.0) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">0.50 - 1.00</td>
        </tr>
        <tr>
          <td>BUN</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.bun ? test.results.bun : '' %><span class="flag"><%= flagValue(test && test.results && test.results.bun,4.67,23.36) %></span></td>
          <td class="center">mg/dL</td>
          <td class="center">4.67 - 23.36</td>
        </tr>
        <tr>
          <td>SGPT (ALT)</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.sgpt ? test.results.sgpt : '' %><span class="flag"><%= flagValue(test && test.results && test.results.sgpt,0,32) %></span></td>
          <td class="center">U/L</td>
          <td class="center">0.00 - 32.00</td>
        </tr>
        <tr>
          <td>SGOT (AST)</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.sgot ? test.results.sgot : '' %><span class="flag"><%= flagValue(test && test.results && test.results.sgot,0,31) %></span></td>
          <td class="center">U/L</td>
          <td class="center">0.00 - 31.00</td>
        </tr>
        <tr>
          <td>Sodium</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.sodium ? test.results.sodium : '' %><span class="flag"><%= flagValue(test && test.results && test.results.sodium,136,148) %></span></td>
          <td class="center">mmol/L</td>
          <td class="center">136.00 - 148.00</td>
        </tr>
        <tr>
          <td>Potassium</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.potassium ? test.results.potassium : '' %><span class="flag"><%= flagValue(test && test.results && test.results.potassium,3.5,5.1) %></span></td>
          <td class="center">mmol/L</td>
          <td class="center">3.50 - 5.10</td>
        </tr>
        <tr>
          <td>Chloride</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.chloride ? test.results.chloride : '' %><span class="flag"><%= flagValue(test && test.results && test.results.chloride,98,107) %></span></td>
          <td class="center">mmol/L</td>
          <td class="center">98.00 - 107.00</td>
        </tr>
        <tr>
          <td>HbA1c</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.hba1c ? test.results.hba1c : '' %><span class="flag"><%= flagValue(test && test.results && test.results.hba1c,4,6.5) %></span></td>
          <td class="center">%</td>
          <td class="center">4.00 - 6.50</td>
        </tr>
        <tr>
          <td>ALB</td>
          <td class="center" style="font-weight:700"><%= test && test.results && test.results.alb ? test.results.alb : '' %><span class="flag"><%= flagValue(test && test.results && test.results.alb,3,6) %></span></td>
          <td class="center">g/L</td>
          <td class="center">3.00 - 6.00</td>
        </tr>
      </table>
    </div>

    <% function findSigFor(displayName){
         if (!displayName) return null;
         const sigs = (test && test.results && test.results.signatures) ? test.results.signatures : {};
         for (const k in sigs){
           const s = sigs[k];
           if (s && s.name && String(s.name).trim() === String(displayName).trim()) return s;
         }
         return null;
       }
    %>
    <div class="signatures">
      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700">
          <strong><%= (test && test.results && test.results.performedByName) || (test && test.performedBy && test.performedBy.name) || '' %></strong>
        </div>
        <% const _performedName = (test && test.results && test.results.performedByName) || (test && test.performedBy && test.performedBy.name) || '';
           const _performedSig = findSigFor(_performedName);
        %>
        <% if (_performedSig && _performedSig.filename) { %>
          <% const p = _performedSig.placement || { x:0, y:-56, scale:1 }; %>
          <img src="/assets/signature/<%= _performedSig.filename %>" class="signature-overlay" style="left:50%; top:<%= p.y %>px; transform:translateX(-50%) scale(<%= p.scale %>); max-height:96px;" alt="signature" />
        <% } %>
        <div class="normal-small"><% if (test && test.results && test.results.performedByLicense) { %><strong>Lic. No. <%= test.results.performedByLicense %></strong><% } %></div>
        <div>Medical Technologist</div>
      </div>

      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700"><strong><%= (test && test.results && test.results.validatedByName) || '' %></strong></div>
        <% const _validatedName = (test && test.results && test.results.validatedByName) || '';
           const _validatedSig = findSigFor(_validatedName);
        %>
        <% if (_validatedSig && _validatedSig.filename) { %>
          <% const p = _validatedSig.placement || { x:0, y:-56, scale:1 }; %>
          <img src="/assets/signature/<%= _validatedSig.filename %>" class="signature-overlay" style="left:50%; top:<%= p.y %>px; transform:translateX(-50%) scale(<%= p.scale %>); max-height:96px;" alt="signature" />
        <% } %>
        <div class="normal-small"><% if (test && test.results && test.results.validatedByLicense) { %><strong>Lic. No. <%= test.results.validatedByLicense %></strong><% } %></div>
        <div>Validated By</div>
      </div>

      <div class="sig">
        <div style="border-top:1px solid #000; height:10px; margin-bottom:6px"></div>
        <div style="font-weight:700"><strong><%= (test && test.results && test.results.requestedByName) || (test && test.requestedBy && test.requestedBy.name) || '' %></strong></div>
        <% const _requestedName = (test && test.results && test.results.requestedByName) || (test && test.requestedBy && test.requestedBy.name) || '';
           const _requestedSig = findSigFor(_requestedName);
        %>
        <% if (_requestedSig && _requestedSig.filename) { %>
          <% const p = _requestedSig.placement || { x:0, y:-56, scale:1 }; %>
          <img src="/assets/signature/<%= _requestedSig.filename %>" class="signature-overlay" style="left:50%; top:<%= p.y %>px; transform:translateX(-50%) scale(<%= p.scale %>); max-height:96px;" alt="signature" />
        <% } %>
        <div class="normal-small"><% if (test && test.results && test.results.requestedByLicense) { %><strong>Lic. No. <%= test.results.requestedByLicense %></strong><% } %></div>
        <div>Pathologist</div>
      </div>
    </div>
  </div>

  <img class="watermark" src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" alt="" />
</div>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 300);</script>
<% } %>
