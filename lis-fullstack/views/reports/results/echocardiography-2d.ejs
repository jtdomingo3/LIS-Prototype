      <!-- Row 1: Maximum Velocity -->
      <tr>
        <td class="dop-label">Maximum Velocity (m/sec)</td>
        <td style="width:10%; text-align:center; font-weight:bold;">
          <%
            let mitE = (r.dop_max_vel_mitral_e || '').trim();
            let mitA = (r.dop_max_vel_mitral_a || '').trim();
            if (mitE && !mitE.toLowerCase().startsWith('e:')) mitE = 'E: ' + mitE;
            if (mitA && !mitA.toLowerCase().startsWith('a:')) mitA = 'A: ' + mitA;
          %>
          <%= mitE %><% if (mitA) { %><br><%= mitA %><% } %>
        </td>
        <td style="width:10%; text-align:left; font-size:8px;">
          <%= r.dop_max_vel_mitral_norm_e || 'E:' %><br><%= r.dop_max_vel_mitral_norm_a || 'A:' %>
        </td>
        <td style="width:10%; text-align:center; font-weight:bold;">
          <%= r.dop_max_vel_aortic_1 || '' %><% if (r.dop_max_vel_aortic_2) { %><br><%= r.dop_max_vel_aortic_2 %><% } %>
        </td>
        <td style="width:10%; text-align:left; font-size:8px;">
          <%= r.dop_max_vel_aortic_sub_1 || 'V1 (LVOT)' %><br><%= r.dop_max_vel_aortic_sub_2 || 'V2 (AV) 1 – 1.7' %>
        </td>
        <td style="width:10%; text-align:center; font-weight:bold;">
          <%= r.dop_max_vel_tricuspid_1 || '' %><% if (r.dop_max_vel_tricuspid_2) { %><br><%= r.dop_max_vel_tricuspid_2 %><% } %>
        </td>
        <td style="width:10%; text-align:center; font-size:8px;">
          <%= r.dop_max_vel_tricuspid_norm || '0.3 – 0.7' %>
        </td>
        <td style="width:10%; text-align:center; font-weight:bold;">
          <%= r.dop_max_vel_pulmonic_1 || '' %><% if (r.dop_max_vel_pulmonic_2) { %><br><%= r.dop_max_vel_pulmonic_2 %><% } %>
        </td>
        <td style="width:10%; text-align:left; font-size:8px;">
          <%= r.dop_max_vel_pulmonic_sub_1 || 'V1 (RVOT)' %><br><%= r.dop_max_vel_pulmonic_sub_2 || 'V2 (PV) 0.6 – 0.9' %>
        </td>
      </tr>

      <!-- Row 2: E/A Ratio -->
      <tr>
        <td class="dop-label">E/ A Ratio</td>
        <td style="text-align:center; font-weight:bold;"><%= r.dop_ea_ratio_mitral || '' %></td>
        <td style="text-align:center; font-size:8px;"><%= r.dop_ea_ratio_mitral_norm || '0.9 – 1.5' %></td>
        <td></td><td></td><td></td><td></td><td></td><td></td>
      </tr>

      <!-- Row 3: Peak Gradient -->
      <tr>
        <td class="dop-label">Peak Gradient (mm / Hg)</td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_peak_grad_mitral || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_peak_grad_aortic || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_peak_grad_tricuspid || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_peak_grad_pulmonic || '' %></td>
      </tr>

      <!-- Row 4: Max Peak Gradient -->
      <tr>
        <td class="dop-label">Max Peak Gradient(mm/Hg)</td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_max_peak_grad_mitral || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_max_peak_grad_aortic || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_max_peak_grad_tricuspid || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_max_peak_grad_pulmonic || '' %></td>
      </tr>

      <!-- Row 5: MV Annular TDI -->
      <tr>
        <td class="dop-label">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <span>MV Annular TDI</span>
            <span style="font-weight:normal; font-size:8px; text-align:right; line-height:1.35;">Lateral<br>Media</span>
          </div>
        </td>
        <td colspan="2" style="font-size:8px; line-height:1.35; text-align:left; padding-left:8px; font-weight:bold;">
          <%
            let latE = r.dop_tdi_lat_e || '';
            let latA = r.dop_tdi_lat_a || '';
            let medE = r.dop_tdi_med_e || '';
            let medA = r.dop_tdi_med_a || '';
            if (latE && !latE.toLowerCase().startsWith('e')) latE = "E': " + latE;
            if (latA && !latA.toLowerCase().startsWith('a')) latA = "A': " + latA;
            if (medE && !medE.toLowerCase().startsWith('e')) medE = "E': " + medE;
            if (medA && !medA.toLowerCase().startsWith('a')) medA = "A': " + medA;
            let latStr = [latE, latA].filter(Boolean).join('  ');
            let medStr = [medE, medA].filter(Boolean).join('  ');
          %>
          <%= latStr %><% if (latStr && medStr) { %><br><% } %><%= medStr %>
        </td>
        <td colspan="2"></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
      </tr>

      <!-- Row 6: Deceleration Time -->
      <tr>
        <td class="dop-label">Deceleration Time (m/sec)</td>
        <td style="text-align:center; font-weight:bold;"><%= r.dop_decel_time || '' %></td>
        <td style="text-align:center; font-size:8px;"><%= r.dop_decel_time_norm || '160 – 240' %></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
      </tr>

      <!-- Row 7: IVRT -->
      <tr>
        <td class="dop-label">IVRT (m/sec)</td>
        <td style="text-align:center; font-weight:bold;"><%= r.dop_ivrt || '' %></td>
        <td style="text-align:center; font-size:8px;"><%= r.dop_ivrt_norm || '60 - 90' %></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
      </tr>

      <!-- Row 8: Ar Duration -->
      <tr>
        <td class="dop-label">Ar Duration(ms)</td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_ar_duration || '' %></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
        <td colspan="2"></td>
      </tr>

      <!-- Row 9: Pulmonic Vein -->
      <tr>
        <td class="dop-label" style="font-size:8px; line-height:1.2;">
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <span>Pulmonic Vein</span>
            <span style="font-weight:normal; font-size:8px; text-align:right; line-height:1.35;">
              Diastoles<br>Systole<br>Sys / Dias
            </span>
          </div>
        </td>
        <!-- MITRAL (Left: Value, Right: Blank Reference) -->
        <td style="font-size:8px; line-height:1.35; text-align:center; font-weight:bold;">
          <%= r.dop_pv_diastoles || '' %><br>
          <%= r.dop_pv_systole || '' %><br>
          <%= r.dop_pv_sys_dias || '' %>
        </td>
        <td></td>

        <!-- AORTIC (Left: Blank Value, Right: Reference/Label PASP) -->
        <td></td>
        <td style="font-size:8px; text-align:left; line-height:1.35; white-space:nowrap;">PASP by TRJ<br>Total PASP</td>

        <!-- TRICUSPID (Left: Value for PASP, Right: Reference/Label PAT) -->
        <td style="text-align:center; font-weight:bold; font-size:8px; line-height:1.35;"><%= r.dop_pasp_trj || '' %><br><%= r.dop_total_pasp || '' %></td>
        <td style="font-size:8px; text-align:center;">PAT</td>

        <!-- PULMONIC (Left: Value for PAT, Right: Reference/Label >=) -->
        <td style="text-align:center; font-weight:bold; font-size:8px;"><%= r.dop_pat || '' %></td>
        <td style="font-size:8px; text-align:center; font-weight:bold;">&ge;<% if (r.dop_pat_norm) { %> <%= r.dop_pat_norm %><% } %></td>
      </tr>

      <!-- Row 10: Severity of Regurgitation -->
      <tr>
        <td class="dop-label">Severity of Regurgitation</td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_regurg_mitral || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_regurg_aortic || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_regurg_tricuspid || '' %></td>
        <td colspan="2" style="text-align:center; font-weight:bold;"><%= r.dop_regurg_pulmonic || '' %></td>
      </tr>
    </tbody>
  </table>

  <!-- Footer Note -->
  <div class="echo-footer-note">
    *results are based on echocardiographic findings only and should be correlated clinically and with other diagnostic tests and
  </div>

</div>
<% } %>

<!-- Page Break if both forms are printed or viewed -->
<% if (showInfo && showReading) { %>
  <div class="page-break"></div>
<% } %>

<!-- ==================================================================== -->
<!-- FORM 2: ECHOCARDIOGRAPHY READING / INTERPRETATION SHEET (Image 2)    -->
<!-- Fits strictly on 1 Letter Page                                       -->
<!-- ==================================================================== -->
<% if (showReading) { %>
<div class="echo-page echo-reading-sheet">

  <!-- Uniform System Header -->
  <div class="header">
    <div>
      <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
    </div>
    <div class="lab-title">
      <h1>GEZYNE CLINICAL LABORATORY</h1>
      <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
      <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
      <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
      <div class="lab-sub">Lic. No. 03-435-15CL-20</div>
    </div>	
    <div class="header-datetime">
      <table>
        <tr><td>Date:</td><td><strong><%= test && test.testDate ? (new Date(test.testDate)).toLocaleDateString() : new Date().toLocaleDateString() %></strong></td></tr>
        <tr><td>Time Requested:</td><td><strong><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></strong></td></tr>
        <tr><td>Time Released:</td><td><strong><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></strong></td></tr>
      </table>
    </div>
  </div>

  <!-- Uniform System Patient Box -->
  <table class="patient-box">
    <tr>
      <td style="width: 18%;">Patient's Reference No. :</td>
      <td style="width: 27%;"><strong><%= test && test.testId ? test.testId : '' %></strong></td>
      <td style="width: 9%;">DOB:</td>
      <td style="width: 16%;"><strong><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></strong></td>
      <td style="width: 10%;">Sex:</td>
      <td style="width: 20%;"><strong><%= patientSex %></strong></td>
    </tr>
    <tr>
      <td>Name:</td>
      <td colspan="3"><strong><%= patientName %></strong></td>
      <td>Age:</td>
      <td><strong><%= patientAge %></strong></td>
    </tr>
    <tr>
      <td>Physician:</td>
      <td colspan="3"><strong><%= physician %></strong></td>
      <td>Contact:</td>
      <td style="white-space: nowrap; overflow: visible; font-size: 10.5px;"><strong><%= contact %></strong></td>
    </tr>
    <tr>
      <td>Indication for study:</td>
      <td colspan="3"><strong><%= indication %></strong></td>
      <td>Weight:</td>
      <td><strong><%= weightStr %></strong></td>
    </tr>
    <tr>
      <td>Height:</td>
      <td><strong><%= heightStr %></strong></td>
      <td>HR:</td>
      <td><strong><%= hrStr %></strong></td>
      <td>BSA:</td>
      <td><strong><%= bsaStr %></strong></td>
    </tr>
  </table>

  <!-- Clinical Reading & Interpretation Section -->
  <div class="echo-reading-block">
    
    <!-- 1. Interpretation -->
    <div class="echo-reading-heading">Interpretation</div>
    <div class="echo-reading-content" style="min-height: 85px;">
      <%
        var rawInterp = (r.paragraphs || r.findings || r.result || '').toString().trim();
      %><%- rawInterp ? rawInterp.replace(/\r?\n/g, '<br>') : '' %>
    </div>

    <!-- 2. Color flow and Spectral Doppler -->
    <div class="echo-reading-heading">Color flow and Spectral Doppler</div>
    <div class="echo-reading-content" style="min-height: 60px;">
      <%
        var rawCF = (r.color_flow || r.color_flow_study || '').toString().trim();
      %><%- rawCF ? rawCF.replace(/\r?\n/g, '<br>') : '' %>
    </div>

    <!-- 3. CONCLUSION -->
    <div class="echo-reading-heading">CONLUSION:</div>
    <div class="echo-reading-content" style="min-height: 60px;">
      <%
        var rawConc = (r.conclusion || r.impression || r.conclusion_text || '').toString().trim();
      %><%- rawConc ? rawConc.replace(/\r?\n/g, '<br>') : '' %>
    </div>

  </div>

  <!-- Signatory Block (Right-aligned, matching Image 2) -->
  <div class="echo-signatory-wrap">
    <div class="echo-signatory-box">
      <% if (sig && sig.filename) { %>
        <img src="/assets/signature/<%= sig.filename %>" class="echo-signature-overlay" alt="Signature" />
      <% } %>
      <div style="font-weight: bold; font-size: 13px; color: #000; margin-bottom: 2px;">
        <% if (doctorName) { %>
          <%= doctorName %>
        <% } else { %>
          <span style="display:inline-block; width:220px; border-bottom:1px solid #000; height:18px;"></span>
        <% } %>
      </div>
      <div style="font-size: 11.5px; color: #111;"><%= doctorDesignation || 'Cardiologist' %></div>
      <% if (doctorLicense) { %>
        <div style="font-size: 10px; color: #333; margin-top: 1px;">Lic. No. <%= doctorLicense %></div>
      <% } %>
    </div>
  </div>

</div>
<% } %>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 350);</script>
<% } %>
