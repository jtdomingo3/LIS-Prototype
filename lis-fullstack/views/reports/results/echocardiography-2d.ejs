<style>
  @page {
    size: Letter portrait;
    margin: 0.22in 0.35in 0.2in 0.35in;
  }
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    color: #000;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  *, *:before, *:after { box-sizing: inherit; }


  /* Echo Page layout - strictly fits Letter page */
  .echo-page {
    position: relative;
    width: 100%;
    max-width: 7.95in;
    margin: 0 auto;
    padding: 4px 6px;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
    color: #000;
    background: #fff;
    box-sizing: border-box;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  /* Uniform System Header */
  .header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 5px;
  }
  .logo {
    width: 68px;
    height: auto;
    margin-right: 4px;
    flex-shrink: 0;
  }
  .lab-title {
    text-align: center;
    flex: 1;
    min-width: 0;
  }
  .lab-title h1 {
    margin: 0;
    font-size: 21px;
    color: #009957;
    letter-spacing: 0.8px;
    font-weight: 900;
    line-height: 1.15;
  }
  .lab-sub {
    font-size: 9.5px;
    margin-top: 2px;
    color: #009957;
    line-height: 1.25;
    font-weight: 600;
  }
  .header-datetime {
    min-width: 175px;
    font-size: 10.5px;
    text-align: right;
  }
  .header-datetime table {
    border-collapse: collapse;
    width: 100%;
    font-size: 10.5px;
  }
  .header-datetime td {
    border: 1px solid #000;
    padding: 2px 4px;
    text-align: left;
    box-sizing: border-box;
  }

  /* Uniform System Patient Box */
  .patient-box {
    margin-top: 5px;
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    table-layout: fixed;
    border: 1.5px solid #000;
    margin-bottom: 7px;
  }
  .patient-box td {
    border: 1px solid #000;
    padding: 3.5px 6px;
    vertical-align: middle;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-sizing: border-box;
  }

  /* Sheet Titles */
  .echo-sheet-title {
    text-align: center;
    font-weight: 800;
    font-size: 13.5px;
    letter-spacing: 0.8px;
    margin: 7px 0 7px 0;
  }

  /* 3-Column M-Mode Measurements Container */
  .echo-three-col-container {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    width: 100%;
    margin-bottom: 8px;
  }
  .echo-col-table {
    width: 32.8%;
    border-collapse: collapse;
    border: 1.5px solid #000;
    font-size: 9.8px;
    line-height: 1.25;
    table-layout: fixed;
  }
  .echo-col-table th, .echo-col-table td {
    border: 1px solid #000;
    padding: 3.2px 4px;
    vertical-align: middle;
    box-sizing: border-box;
  }
  .echo-col-table th.table-header {
    text-align: center;
    font-size: 10.5px;
    font-weight: bold;
    background: #ffffff;
    padding: 4.5px 3px;
  }
  .echo-col-table td.col-param {
    font-weight: 600;
    color: #000;
    width: 44%;
    white-space: nowrap;
  }
  .echo-col-table td.col-val {
    text-align: center;
    font-weight: bold;
    width: 18%;
    color: #000;
  }
  .echo-col-table td.col-norm {
    font-size: 8.8px;
    color: #111;
    width: 38%;
    line-height: 1.15;
  }

  /* Doppler Study Section */
  .echo-doppler-subtitle {
    text-align: left;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.8px;
    margin: 8px 0 5px 0;
    color: #111;
  }
  .echo-doppler-table {
    width: 100%;
    border-collapse: collapse;
    border: 1.5px solid #000;
    font-size: 9.2px;
    line-height: 1.25;
    table-layout: fixed;
  }
  .echo-doppler-table th, .echo-doppler-table td {
    border: 1px solid #000;
    padding: 3.2px 4px;
    vertical-align: middle;
    box-sizing: border-box;
  }
  .echo-doppler-table th {
    text-align: center;
    font-weight: bold;
    font-size: 10px;
    background: #ffffff;
    padding: 4.5px 3px;
  }
  .echo-doppler-table td.dop-label {
    font-weight: 600;
    width: 20%;
  }

  /* Footer Note */
  .echo-footer-note {
    text-align: center;
    font-style: italic;
    font-size: 9px;
    font-weight: bold;
    margin-top: 9px;
    color: #000;
  }

  /* Sheet 2: Reading / Interpretation Styling */
  .echo-reading-block {
    margin-top: 14px;
    font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
  }
  .echo-reading-heading {
    font-weight: bold;
    font-size: 12.5px;
    color: #000;
    margin-bottom: 4px;
  }
  .echo-reading-content {
    font-size: 11px;
    line-height: 1.48;
    color: #000;
    margin-bottom: 12px;
    white-space: pre-wrap;
    text-align: justify;
  }

  /* Signatory Block */
  .echo-signatory-wrap {
    display: flex;
    justify-content: flex-end;
    margin-top: 40px;
    padding-right: 25px;
  }
  .echo-signatory-box {
    text-align: center;
    min-width: 240px;
    position: relative;
  }
  .echo-signature-overlay {
    position: absolute;
    left: 50%;
    top: -46px;
    transform: translateX(-50%);
    pointer-events: none;
    max-height: 76px;
    z-index: 2;
  }

  /* Print Media Rules */
  @media print {
    .no-print {
      display: none !important;
    }
    .page-break {
      page-break-after: always !important;
      break-after: page !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      border: none !important;
      display: block !important;
    }
    .echo-page {
      padding: 0 !important;
      max-width: 100% !important;
      height: 10.5in !important;
      max-height: 10.5in !important;
      overflow: hidden !important;
      page-break-inside: avoid !important;
      break-inside: avoid !important;
    }
  }
</style>

<%- include('./_highlight') %>

<%
  // Extract parameters and helpers
  const querySheet = (typeof sheet !== 'undefined' && sheet) ? String(sheet).toLowerCase() : (typeof req !== 'undefined' && req && req.query && req.query.sheet ? String(req.query.sheet).toLowerCase() : 'all');
  const showInfo = querySheet === 'all' || querySheet === 'info' || querySheet === 'information' || querySheet === '1';
  const showReading = querySheet === 'all' || querySheet === 'reading' || querySheet === 'interpretation' || querySheet === '2';

  const r = (test && test.results) ? Object.assign({}, test.results.echo_info || {}, test.results) : {};
  const p = (test && test.patient) ? test.patient : {};

  // Patient Header Data
  let patientName = '';
  if (p.lastName) {
    patientName = (p.lastName + ', ' + (p.firstName || '') + (p.middleName ? ' ' + p.middleName[0] + '.' : '')).toUpperCase();
  } else if (p.name) {
    patientName = String(p.name).toUpperCase();
  } else if (test && test.patientName) {
    patientName = String(test.patientName).toUpperCase();
  }

  let patientAddress = p.address || p.homeAddress || p.addressLine || '';
  let patientAge = (p.age !== null && p.age !== undefined && p.age !== '') ? (p.age + ' y/o') : (p.ageManual ? (p.ageManual + ' y/o') : '');
  let patientSex = p.sex || '';
  let physician = p.physician || p.physicianName || r.requestingPhysician || '';
  let indication = r.indication || r.indication_for_study || '';
  let contact = p.contactNumber || p.phone || p.contact || r.contact || '';
  let testDateStr = test && test.testDate ? (new Date(test.testDate)).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' }) : (new Date()).toLocaleDateString('en-US', { month: '2-digit', day: '2-digit', year: 'numeric' });

  // Biometrics
  let weightStr = r.weight ? (r.weight + (String(r.weight).toLowerCase().includes('kg') ? '' : ' kg')) : '';
  let heightStr = r.height ? (r.height + (String(r.height).toLowerCase().includes('cm') ? '' : ' cm')) : '';
  let bsaStr = r.bsa ? (r.bsa + (String(r.bsa).includes('m') ? '' : 'm²')) : '';
  let hrStr = r.hr ? (String(r.hr).toLowerCase().includes('bpm') ? r.hr : (r.hr + ' bpm')) : '';

  // Signature matching helper
  function findSigFor(displayName){
    if (!displayName) return null;
    var sigs = (test && test.results && test.results.signatures) ? test.results.signatures : {};
    for (var k in sigs) {
      if (sigs[k] && sigs[k].name === displayName) return sigs[k];
    }
    return null;
  }
  const doctorName = r.doctorName || r.pathName || r.performedByName || (test && test.performedBy && test.performedBy.name) || '';
  const doctorLicense = r.doctorLicense || r.pathLicense || '';
  const doctorDesignation = r.doctorDesignation || 'Cardiologist';
  const sig = findSigFor(doctorName);
%>


