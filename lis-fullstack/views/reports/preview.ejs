<div class="card">
  <h3>Report Preview</h3>

<% if (!test) { %>
  <p style="padding:20px; color:#888;">No completed test results yet.</p>
<% } else { %>
  <!-- Navigation & Filters -->
  <div style="display:flex; gap:8px; align-items:center; margin-bottom:12px;">
    <div>
      <% // Always render as anchors so client-side can update hrefs reliably %>
      <a id="prevBtn" class="button btn-secondary<%= (typeof prevId === 'undefined' || !prevId) ? ' disabled' : '' %>" <%= (typeof prevId !== 'undefined' && prevId) ? ('href="/reports/preview/' + prevId + (typeof filterQuery !== 'undefined' ? filterQuery : '') + '"') : '' %>>← Previous</a>
      <a id="nextBtn" class="button btn-secondary<%= (typeof nextId === 'undefined' || !nextId) ? ' disabled' : '' %>" <%= (typeof nextId !== 'undefined' && nextId) ? ('href="/reports/preview/' + nextId + (typeof filterQuery !== 'undefined' ? filterQuery : '') + '"') : '' %>>Next →</a>
    </div>

    <div style="flex:1; display:flex; gap:8px; align-items:center;">
      <div style="display:flex; flex-direction:column; gap:4px; flex:2; min-width:300px;">
        <input id="patientSearch" type="text" placeholder="Type to search patients by name..." autocomplete="off" style="padding:8px; font-size:14px; border-radius:8px; border:1px solid #d0d7de;">
        <select id="filterPatient" style="width:100%; padding:8px;">
          <option value="">-- All Patients --</option>
          <% if (testsForNav && testsForNav.length) {
              const patients = Array.from(new Set(testsForNav.map(t => t.patientName || '').filter(Boolean))).sort((a,b) => a.localeCompare(b)); 
             %>
            <% patients.forEach(function(pn) { %>
              <option value="<%= pn %>"><%= pn %></option>
            <% }) %>
          <% } %>
        </select>
      </div>
      <!-- Test type dropdown (based on templates/testType) -->
        <div style="display:flex; gap:8px; align-items:flex-start;">
          <div style="display:flex; flex-direction:column; gap:8px;">
            <% let testTypes = []; if (testsForNav && testsForNav.length) { testTypes = Array.from(new Set(testsForNav.map(t => t.testType || t.template || '').filter(Boolean))); } %>
            <div id="filterTestType" style="position:relative;">
              <button type="button" id="filterTestTypeToggle" class="button" style="white-space:nowrap;">All Test Types ▾</button>
              <div id="filterTestTypeList" style="display:none; position:absolute; right:0; background:#fff; border:1px solid #ccc; padding:8px; z-index:1000; max-height:220px; overflow:auto; min-width:220px;">
                <label style="display:block; margin-bottom:6px;"><input type="checkbox" id="filterTestTypeSelectAll"> <strong>Select all</strong></label>
                <% testTypes.forEach(function(tp) { %>
                  <label style="display:block; white-space:nowrap; margin:4px 0;"><input type="checkbox" class="filterTestTypeCheckbox" value="<%= tp %>"> <%= tp %></label>
                <% }) %>
              </div>
            </div>
          </div>
          <input id="filterDate" type="date" style="width:130px; padding:8px;">
          <button class="button" id="clearFilters">Clear Filters</button>
          <button class="button btn-primary" id="printFiltered">Print Filtered</button>
        </div>
      </div>
  </div>

  <!-- Filtered results (checkbox list populated when filters change) -->
  <div style="margin-bottom:12px;">
    <div id="filteredContainer" style="width:100%; padding:8px; border:1px solid #e0e0e0; border-radius:6px; max-height:130px; overflow:auto; background:#fff;">
      <label style="display:block; margin-bottom:8px;"><input type="checkbox" id="filteredSelectAll"> <strong>Select all visible</strong></label>
      <div id="filteredList" style="display:block;">
        <!-- items injected here: each item contains a checkbox and a one-line label -->
      </div>
    </div>
    <div style="margin-top:6px; text-align:right;">
      <span id="filteredPager" style="margin-left:12px; font-weight:600;"></span>
    </div>
  </div>

  <div style="margin-bottom:12px; text-align:right;">
    <a id="downloadPdf" href="/reports/pdf/<%= test.id %>" class="button btn-primary">Download PDF</a>
    <a id="printLink" href="/reports/result/<%= test.id %>?embedded=1&print=1" target="_blank" class="button btn-orange">Print</a>
  </div>

  <div class="card">
    <h4>Patient Information</h4>
    <% if (test.patient) { %>
      <p><strong>Name:</strong> <span id="patientName"><%= test.patient.firstName %> <%= test.patient.lastName %></span></p>
      <p><strong>Patient ID:</strong> <span id="patientPatientId"><%= test.patient.patientId %></span></p>
    <% } else { %>
      <p><strong>Name:</strong> <span id="patientName"><%= test.patientName || '' %></span></p>
      <p><strong>Patient ID:</strong> <span id="patientPatientId"><%= (test.patient && test.patient.patientId) || '' %></span></p>
    <% } %>
    <h4>Test Information</h4>
    <p><strong>Test ID:</strong> <span id="displayTestId"><%= test.testId %></span></p>
    <p><strong>Test Type:</strong> <span id="displayTestType"><%= test.testType %></span></p>
    <p><strong>Date:</strong> <span id="displayTestDate"><%= test.testDate ? new Date(test.testDate).toLocaleDateString() : '' %></span></p>
    <h4>Results</h4>
    <% if (true) { %>
      <div style="width:100%;height:820px;border:1px solid #e6e6e6;">
            <!-- Load result template via iframe src so it uses the same routing/layout logic and asset paths
                 (avoids srcdoc issues with relative URLs and duplicated/global CSS that distort preview) -->
            <iframe id="resultFrame" src="/reports/result/<%= test.id %>?embedded=1" style="width:100%;height:100%;border:0;margin:0;padding:0;" title="Result Template" sandbox="allow-same-origin allow-scripts"></iframe>
      </div>
    <% } else { %>
      <pre style="white-space:pre-wrap;"><%= test.results || 'No results recorded.' %></pre>
    <% } %>
  </div>

  <!-- moved download/print controls to top filters area -->
</div>

<script>
  // embed testsForNav for client filtering
  window.testsForNav = <%- JSON.stringify(testsForNav || []) %>;
  // embed current test id
  window.currentTestId = '<%= test.id %>';

  (function(){
    // Patient search -> filter patient select options
    (function(){
      const searchInput = document.getElementById('patientSearch');
      const selectEl = document.getElementById('filterPatient');
      if (!searchInput || !selectEl) return;

      function filterPatientOptions() {
        const q = String(searchInput.value || '').toLowerCase().trim();
        let visibleCount = 0;
        for (let i = 0; i < selectEl.options.length; i++) {
          const opt = selectEl.options[i];
          if (!opt.value) { opt.hidden = false; visibleCount++; continue; }
          const txt = (opt.text || '').toLowerCase();
          const match = q === '' || txt.indexOf(q) !== -1;
          opt.hidden = !match;
          if (match) visibleCount++;
        }
        if (q !== '' && visibleCount > 1) selectEl.size = Math.min(8, visibleCount);
        else selectEl.size = 1;

        if (q !== '' && visibleCount === 1) {
          for (let i = 0; i < selectEl.options.length; i++) {
            const opt = selectEl.options[i];
            if (!opt.hidden && opt.value) {
              selectEl.value = opt.value;
              selectEl.dispatchEvent(new Event('change'));
              break;
            }
          }
        }
      }

      searchInput.addEventListener('input', filterPatientOptions);
      selectEl.addEventListener('change', function(){ selectEl.size = 1; });
    })();

    const tests = window.testsForNav || [];
    const patientInput = document.getElementById('filterPatient');
    const testTypeToggle = document.getElementById('filterTestTypeToggle');
    const testTypeList = document.getElementById('filterTestTypeList');
    const dateFilter = document.getElementById('filterDate');
    const clearBtn = document.getElementById('clearFilters');
    const printBtn = document.getElementById('printFiltered');

    function getSelectedTestTypes(){
      const boxes = Array.from(document.querySelectorAll('.filterTestTypeCheckbox'));
      if (!boxes || !boxes.length) return [];
      return boxes.filter(b => b.checked).map(b => b.value).filter(Boolean);
    }

    function getQueryString() {
      const params = new URLSearchParams();
      if (patientInput.value) params.set('filterPatient', patientInput.value);
      const selTypes = getSelectedTestTypes();
      if (selTypes.length) params.set('filterTestType', selTypes.join(','));
      if (dateFilter.value) params.set('filterDate', dateFilter.value);
      const s = params.toString();
      return s ? ('?' + s) : '';
    }

    function applyParamsToNavLinks(){
      const qs = getQueryString();
      Array.from(document.querySelectorAll('a[href^="/reports/preview/"]')).forEach(a => {
        const base = a.href.split('?')[0];
        a.href = base + qs;
      });
    }

    function readParamsToInputs(){
        const p = new URLSearchParams(window.location.search);
        const fp = p.get('filterPatient');
        const ft = p.get('filterTestType');
        const fd = p.get('filterDate');
        if (fp) patientInput.value = fp;
        if (ft) {
          const arr = ft.split(',');
          Array.from(document.querySelectorAll('.filterTestTypeCheckbox')).forEach(cb => {
            cb.checked = arr.indexOf(cb.value) !== -1;
          });
        }
        if (fd) dateFilter.value = fd;
        try { if (typeof updateSelectAllState === 'function') updateSelectAllState(); } catch(e) {}
    }

    function matchesFilters(t){
      const p = (patientInput.value || '').toLowerCase();
      const selTypes = getSelectedTestTypes().map(s => (s || '').toLowerCase());
      const fd = (dateFilter.value || '');
      if (p && ((t.patientName || '').toLowerCase() !== p)) return false;
      if (selTypes.length && selTypes.indexOf(((t.testType||'').toLowerCase()) ) === -1) return false;
      if (fd && (t.testDate ? new Date(t.testDate).toISOString().slice(0,10) !== fd : true)) return false;
      return true;
    }

    function getFilteredIds(){
      return tests.filter(matchesFilters).map(t=>t.id);
    }

    // initialize from URL
    readParamsToInputs();
    applyParamsToNavLinks();
    const filteredPager = document.getElementById('filteredPager');
    let debounceTimer = null;

    function updatePager(){
      const anyFilter = !!(patientInput.value || getSelectedTestTypes().length || dateFilter.value);
      const ids = anyFilter ? getFilteredIds() : tests.map(t => t.id);
      const total = ids.length || 0;
      const cur = window.currentTestId;
      const idx = ids.indexOf(cur);
      if (!filteredPager) return;
      if (total === 0) {
        filteredPager.textContent = '';
      } else {
        filteredPager.textContent = (idx === -1 ? '0' : (idx + 1)) + ' / ' + total + (anyFilter ? ' (filtered)' : '');
      }
    }

    // populate filtered list
    const filteredList = document.getElementById('filteredList');
    const filteredSelectAll = document.getElementById('filteredSelectAll');

    function populateFilteredList(){
      if (!filteredList) return;
      while (filteredList.firstChild) filteredList.removeChild(filteredList.firstChild);
      const filtered = tests.filter(matchesFilters);
      filtered.forEach(t => {
        const date = t.testDate ? new Date(t.testDate).toLocaleDateString() : '';
        const id = t.id;
        const labelText = (t.testId || '') + ' - ' + (t.patientName || 'Unknown') + ' - ' + (t.testType || '') + (date ? (' ('+date+')') : '');

        const row = document.createElement('div');
        row.style.display = 'flex';
        row.style.alignItems = 'center';
        row.style.padding = '6px 8px';
        row.style.borderBottom = '1px solid #f0f0f0';

        const cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'filteredItemCheckbox';
        cb.setAttribute('data-id', id);
        cb.style.marginRight = '8px';

        const label = document.createElement('span');
        label.textContent = labelText;
        label.style.flex = '1';
        label.style.cursor = 'pointer';
        label.style.whiteSpace = 'nowrap';
        label.style.overflow = 'hidden';
        label.style.textOverflow = 'ellipsis';

        label.addEventListener('click', function(){
          // open in the main preview area (update iframe below)
          renderTestInPlace(id, getQueryString());
        });

        row.appendChild(cb);
        row.appendChild(label);
        filteredList.appendChild(row);
      });
      if (filteredSelectAll) filteredSelectAll.checked = false;
    }

    // wire filters to update
    function onFilterChange(){
      populateFilteredList();
      setUrlParams();
      applyParamsToNavLinks();
      updatePager();
      if (debounceTimer) clearTimeout(debounceTimer);
      const ids = getFilteredIds();
      if (!ids || !ids.length) return;
      if (ids.indexOf(window.currentTestId) === -1) {
        debounceTimer = setTimeout(() => {
          const qs = getQueryString();
          renderTestInPlace(ids[0], qs);
        }, 400);
      }
    }

    [patientInput].forEach(el => el.addEventListener('input', onFilterChange));
    [patientInput, dateFilter].forEach(el => el.addEventListener('change', onFilterChange));

    function updateSelectAllState(){
      const boxes = Array.from(document.querySelectorAll('.filterTestTypeCheckbox'));
      const selAll = document.getElementById('filterTestTypeSelectAll');
      if (!selAll) return;
      selAll.checked = boxes.length > 0 && boxes.every(b => b.checked);
    }

    Array.from(document.querySelectorAll('.filterTestTypeCheckbox')).forEach(cb => cb.addEventListener('change', function(){
      updateSelectAllState();
      onFilterChange();
    }));

    const selectAllBox = document.getElementById('filterTestTypeSelectAll');
    if (selectAllBox) {
      selectAllBox.addEventListener('change', function(){
        const checked = selectAllBox.checked;
        Array.from(document.querySelectorAll('.filterTestTypeCheckbox')).forEach(cb => cb.checked = checked);
        onFilterChange();
      });
    }

    if (testTypeToggle && testTypeList) {
      testTypeToggle.addEventListener('click', function(e){
        e.stopPropagation();
        const showing = testTypeList.style.display === 'block';
        testTypeList.style.display = showing ? 'none' : 'block';
        testTypeToggle.textContent = showing ? 'All Test Types ▾' : 'All Test Types ▴';
      });
      document.addEventListener('click', function(evt){
        if (!testTypeList.contains(evt.target) && !testTypeToggle.contains(evt.target)) {
          testTypeList.style.display = 'none';
          testTypeToggle.textContent = 'All Test Types ▾';
        }
      });
    }

    clearBtn.addEventListener('click', function(){
      if (debounceTimer) { clearTimeout(debounceTimer); debounceTimer = null; }
      patientInput.value = '';
      var psBox = document.getElementById('patientSearch'); if (psBox) { psBox.value = ''; }
      for (var i = 0; i < patientInput.options.length; i++) patientInput.options[i].hidden = false;
      patientInput.size = 1;
      Array.from(document.querySelectorAll('.filterTestTypeCheckbox')).forEach(cb => cb.checked = false);
      try { const sa = document.getElementById('filterTestTypeSelectAll'); if (sa) sa.checked = false; } catch(e) {}
      dateFilter.value = '';
      const fl = document.getElementById('filteredList'); if (fl) while (fl.firstChild) fl.removeChild(fl.firstChild);
      try { const fsa = document.getElementById('filteredSelectAll'); if (fsa) fsa.checked = false; } catch(e) {}
      history.replaceState(null, '', window.location.pathname);
      applyParamsToNavLinks();
      populateFilteredList();
      updatePager();
    });

    printBtn.addEventListener('click', function(){
      const checked = Array.from(document.querySelectorAll('.filteredItemCheckbox')).filter(cb => cb.checked).map(cb => cb.getAttribute('data-id'));
      let ids = checked.filter(Boolean);
      if (!ids.length) {
        const allFiltered = getFilteredIds();
        if (!allFiltered || !allFiltered.length) { alert('No tests match the current filter'); return; }
        if (!confirm('No tests selected. Print all filtered results?')) return;
        ids = allFiltered;
      }
      const url = '/reports/print-multiple?ids=' + encodeURIComponent(ids.join(','));
      window.open(url, '_blank');
    });

    if (filteredSelectAll) {
      filteredSelectAll.addEventListener('change', function(){
        const checked = filteredSelectAll.checked;
        Array.from(document.querySelectorAll('.filteredItemCheckbox')).forEach(cb => cb.checked = checked);
      });
    }

    // clicking an item updates the main preview iframe (no floating overlay)

    function setUrlParams(){ const qs = getQueryString(); const newUrl = window.location.pathname + qs; history.replaceState(null, '', newUrl); }

    // render a test preview in-place (without full page reload)
    const resultFrame = document.getElementById('resultFrame');
    const elPatientName = document.getElementById('patientName');
    const elPatientPatientId = document.getElementById('patientPatientId');
    const elDisplayTestId = document.getElementById('displayTestId');
    const elDisplayTestType = document.getElementById('displayTestType');
    const elDisplayTestDate = document.getElementById('displayTestDate');
    const downloadPdf = document.getElementById('downloadPdf');
    const printLink = document.getElementById('printLink');

    function renderTestInPlace(id, qs) {
      qs = qs || '';
      const t = tests.find(x => String(x.id) === String(id));
      if (!t) { window.location.href = '/reports/preview/' + id + qs; return; }
      if (resultFrame) resultFrame.src = '/reports/result/' + id + '?embedded=1' + (qs ? ('&' + qs.replace(/^\?/, '')) : '');
      if (elPatientName) elPatientName.textContent = t.patientName || '';
      if (elPatientPatientId) elPatientPatientId.textContent = t.patientId || '';
      if (elDisplayTestId) elDisplayTestId.textContent = t.testId || '';
      if (elDisplayTestType) elDisplayTestType.textContent = t.testType || '';
      if (elDisplayTestDate) elDisplayTestDate.textContent = t.testDate ? new Date(t.testDate).toLocaleDateString() : '';
      if (downloadPdf) downloadPdf.href = '/reports/pdf/' + id;
      if (printLink) printLink.href = '/reports/result/' + id + '?embedded=1&print=1';
      const newPath = '/reports/preview/' + id + qs; try { history.replaceState(null, '', newPath); } catch (e) {}
      window.currentTestId = id; applyParamsToNavLinks(); updatePager();
      const anyFilter = !!(patientInput.value || getSelectedTestTypes().length || dateFilter.value);
      const ids = anyFilter ? getFilteredIds() : tests.map(tt => tt.id);
      const idx = ids.indexOf(id);
      if (prevBtn && prevBtn.tagName === 'A') { if (idx > 0) prevBtn.href = '/reports/preview/' + ids[idx-1] + getQueryString(); else prevBtn.removeAttribute('href'); }
      if (nextBtn && nextBtn.tagName === 'A') { if (idx !== -1 && idx < ids.length - 1) nextBtn.href = '/reports/preview/' + ids[idx+1] + getQueryString(); else nextBtn.removeAttribute('href'); }
    }

    // Prev/Next navigation
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    function navigateWithinFiltered(direction){
      const ids = getFilteredIds(); if (!ids || !ids.length) return false; const cur = window.currentTestId; let idx = ids.indexOf(cur); let targetIndex;
      if (idx === -1) targetIndex = (direction === 'prev') ? (ids.length - 1) : 0; else targetIndex = (direction === 'prev') ? (idx - 1) : (idx + 1);
      if (targetIndex < 0 || targetIndex >= ids.length) return false; const targetId = ids[targetIndex]; const qs = getQueryString(); renderTestInPlace(targetId, qs); return true;
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', function(e){ e.preventDefault(); const handled = navigateWithinFiltered('prev'); if (!handled) { const href = prevBtn.getAttribute && prevBtn.getAttribute('href'); if (href) window.location.href = href; } });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function(e){ e.preventDefault(); const handled = navigateWithinFiltered('next'); if (!handled) { const href = nextBtn.getAttribute && nextBtn.getAttribute('href'); if (href) window.location.href = href; } });
    }

    // initial populate if filters present
    if (patientInput.value || getSelectedTestTypes().length || dateFilter.value) populateFilteredList();
    updatePager();

  })();
</script>
<% } /* end if test */ %>
