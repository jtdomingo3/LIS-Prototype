<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Print Report</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 30px; }
    h1 { color: #10b981; }
    .section { margin-bottom: 20px; }
  </style>
  <script>
    window.onload = function() { window.print(); };
  </script>
</head>
<body>
  <h1>Laboratory Test Report</h1>
  <div class="section">
    <h3>Patient</h3>
    <% if (test.patient) { %>
      <p><strong>Name:</strong> <%= test.patient.firstName %> <%= test.patient.lastName %></p>
      <p><strong>Patient ID:</strong> <%= test.patient.patientId %></p>
    <% } %>
  </div>
  <div class="section">
    <h3>Test</h3>
    <p><strong>Test ID:</strong> <%= test.testId %></p>
    <p><strong>Type:</strong> <%= test.testType %></p>
    <p><strong>Date:</strong> <%= test.testDate ? new Date(test.testDate).toLocaleDateString() : '' %></p>
  </div>
  <div class="section">
    <h3>Results</h3>
    <pre style="white-space:pre-wrap;"><%= test.results || 'No results' %></pre>
  </div>
</body>
</html>
