<script>
(function() {
  function applyTheme(theme) {
    const isDark = (theme === 'dark');
    if (isDark) {
      document.documentElement.setAttribute('data-theme', 'dark');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }

    window.__toggleTheme = function(e) {
      if (e && e.preventDefault) {
        e.preventDefault();
        e.stopPropagation();
      }
      const currentIsDark = document.documentElement.getAttribute('data-theme') === 'dark';
      const nextTheme = currentIsDark ? 'light' : 'dark';
      try {
        localStorage.setItem('gezyne_theme', nextTheme);
      } catch(err) {}
      applyTheme(nextTheme);
    };

    const icons = document.querySelectorAll('.theme-toggle-icon, #themeToggleIcon, #loginThemeToggleIcon');
    icons.forEach(function(icon) {
      if (isDark) {
        icon.className = 'fas fa-sun theme-toggle-icon';
        icon.style.color = '#f59e0b';
      } else {
        icon.className = 'fas fa-moon theme-toggle-icon';
        icon.style.color = '#64748b';
      }
    });

    const buttons = document.querySelectorAll('#themeToggleBtn, #loginThemeToggleBtn, .theme-toggle-trigger');
    buttons.forEach(function(btn) {
      btn.disabled = false;
      delete btn.dataset.__loading;
      btn.title = isDark ? 'Night Shift Active — Click to switch to Day Mode' : 'Switch to 24/7 Night Duty Mode';
    });

    // Chart.js dark mode synchronizer
    try {
      if (window.Chart && window.Chart.defaults) {
        window.Chart.defaults.color = isDark ? '#94a3b8' : '#64748b';
        window.Chart.defaults.borderColor = isDark ? '#1f293d' : '#f1f5f9';
      }
    } catch(e) {}
  }

  // Synchronous initial apply to eliminate flashes
  const savedTheme = localStorage.getItem('gezyne_theme') || 'light';
  applyTheme(savedTheme);

  document.addEventListener('DOMContentLoaded', function() {
    const activeTheme = localStorage.getItem('gezyne_theme') || 'light';
    applyTheme(activeTheme);

    document.querySelectorAll('#themeToggleBtn, #loginThemeToggleBtn, .theme-toggle-trigger').forEach(function(btn) {
      btn.disabled = false;
      delete btn.dataset.__loading;
      btn.addEventListener('click', window.__toggleTheme);
    });
  });
})();
</script>
