<div class="card" style="padding: 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0; margin-bottom: 28px;">
  
  <!-- Header Title Block -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <div>
      <h3 style="margin: 0 0 6px 0; font-size: 1.5em; color: #0f172a; font-weight: 700; letter-spacing: -0.3px; display: flex; align-items: center; gap: 10px;">
        <i class="fa fa-archive" style="color: #d97706;"></i>
        <span>Stashed Results (Pending Patient Pickup)</span>
      </h3>
      <p style="margin: 0; color: #64748b; font-size: 0.95em;">Results held while patients are away. Releasing from this page will mark test results as released without ringing kiosk audio alerts.</p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center;">
      <a href="/reception" class="button btn-secondary" style="padding: 10px 18px; border-radius: 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fa fa-arrow-left"></i>
        <span>Back to Reception</span>
      </a>
    </div>
  </div>

  <!-- Messages & Flash Alerts -->
  <% const success = (typeof flash !== 'undefined' && flash && flash.success_msg) ? flash.success_msg : (typeof success_msg !== 'undefined' ? success_msg : null); %>
  <% const error = (typeof flash !== 'undefined' && flash && flash.error_msg) ? flash.error_msg : (typeof error_msg !== 'undefined' ? error_msg : null); %>
  <% if (success && success.length > 0) { %>
    <div style="padding: 12px 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; margin-bottom: 20px; color: #15803d; font-weight: 600; display: flex; align-items: center; gap: 10px;">
      <i class="fa fa-check-circle" style="font-size: 1.1em;"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div style="padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; margin-bottom: 20px; color: #b91c1c; font-weight: 600; display: flex; align-items: center; gap: 10px;">
      <i class="fa fa-exclamation-triangle" style="font-size: 1.1em;"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Search Filter Input -->
  <% if (typeof stashedList !== 'undefined' && Array.isArray(stashedList) && stashedList.length > 0) { %>
    <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
      <div style="position: relative; width: 100%; max-width: 380px;">
        <i class="fa fa-search" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
        <input type="text" id="stashedSearch" placeholder="Search patient name or code..." onkeyup="filterStashedTable()" style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 10px; font-size: 0.9em; outline: none;">
      </div>
      <div style="font-weight: 700; color: #92400e; background: #fef3c7; padding: 6px 16px; border-radius: 20px; font-size: 0.9em;">
        <%= stashedList.length %> Total Patient(s) Stashed
      </div>
    </div>
  <% } %>

  <!-- Table of Stashed Results -->
  <% if (typeof stashedList === 'undefined' || !Array.isArray(stashedList) || stashedList.length === 0) { %>
    <div style="padding: 40px 20px; background: #fafaf9; border: 2px dashed #e7e5e4; border-radius: 14px; text-align: center; color: #78716c; margin-top: 10px;">
      <i class="fa fa-archive" style="font-size: 2.5em; color: #d6d3d1; margin-bottom: 12px; display: block;"></i>
      <h4 style="margin: 0 0 6px 0; color: #44403c; font-size: 1.1em;">No Stashed Results</h4>
      <p style="margin: 0; font-size: 0.9em;">There are currently no patient results held in stash. All completed results appear in the active Releasing queue.</p>
    </div>
  <% } else { %>
    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
      <table id="stashedTable" style="width: 100%; border-collapse: collapse; background: #ffffff;">
        <thead>
          <tr style="background: #f8fafc; color: #475569; font-size: 0.82em; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e2e8f0; text-align: left;">
            <th style="padding: 14px 16px;">Patient Name</th>
            <th style="padding: 14px 16px;">Patient Code</th>
            <th style="padding: 14px 16px;">Available Results</th>
            <th style="padding: 14px 16px;">Stashed Date/Time</th>
            <th style="padding: 14px 16px; text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% stashedList.forEach(item => { %>
            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#ffffff'">
              <td style="padding: 14px 16px; font-weight: 700; color: #0f172a;" class="patient-name-cell">
                <%= item.patient ? (item.patient.firstName + ' ' + item.patient.lastName) : 'Unknown' %>
              </td>
              <td style="padding: 14px 16px; color: #475569; font-weight: 600; font-size: 0.9em;" class="patient-code-cell">
                <%= item.patient && item.patient.patientCode ? String(item.patient.patientCode).slice(-5) : '—' %>
              </td>
              <td style="padding: 14px 16px; color: #d97706; font-weight: 600; font-size: 0.9em;">
                <ul style="margin: 0; padding-left: 14px;">
                  <% (item.testNames || []).forEach(name => { %>
                    <li><%= name %></li>
                  <% }) %>
                </ul>
              </td>
              <td style="padding: 14px 16px; color: #64748b; font-size: 0.85em;">
                <%= item.stashedAt ? (new Date(item.stashedAt)).toLocaleString() : '—' %>
              </td>
              <td style="padding: 14px 16px; text-align: right;">
                <form action="/reception/release-stashed" method="POST" style="margin: 0; display: inline-block;">
                  <input type="hidden" name="patientId" value="<%= item.patient ? item.patient.id : '' %>">
                  <input type="hidden" name="testIds" value="<%= (item.testIds || []).join(',') %>">
                  <input type="hidden" name="redirectUrl" value="/reception/stashed">
                  <button type="submit" class="button btn-success btn-small" style="padding: 8px 16px; font-weight: 700; border-radius: 8px; font-size: 0.85em; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 6px rgba(16, 185, 129, 0.2);">
                    <i class="fa fa-paper-plane"></i>
                    <span>Release Result</span>
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<script>
  function filterStashedTable() {
    const input = document.getElementById('stashedSearch');
    const filter = input ? input.value.toLowerCase().trim() : '';
    const table = document.getElementById('stashedTable');
    if (!table) return;
    const trs = table.getElementsByTagName('tr');
    for (let i = 1; i < trs.length; i++) {
      const tr = trs[i];
      const nameTd = tr.querySelector('.patient-name-cell');
      const codeTd = tr.querySelector('.patient-code-cell');
      const txt = ((nameTd ? nameTd.textContent : '') + ' ' + (codeTd ? codeTd.textContent : '')).toLowerCase();
      if (txt.indexOf(filter) !== -1) {
        tr.style.display = '';
      } else {
        tr.style.display = 'none';
      }
    }
  }
</script>
