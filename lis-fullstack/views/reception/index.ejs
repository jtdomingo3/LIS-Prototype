<%
  // Compute total patients currently waiting across all reception areas
  let totalWaiting = 0;
  if (Array.isArray(areas)) {
    areas.forEach(a => { totalWaiting += (Number(a.count) || 0); });
  }
%>

<div class="card reception-card" style="padding: 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0; margin-bottom: 28px; position: relative;">
  
  <!-- Header Title Block -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid #f1f5f9;">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px;">
        <div style="width: 38px; height: 38px; border-radius: 10px; background: #ecfdf5; color: #059669; display: flex; align-items: center; justify-content: center; font-size: 1.15rem; box-shadow: 0 2px 6px rgba(16,185,129,0.15);">
          <i class="fas fa-door-open"></i>
        </div>
        <h3 style="margin: 0; font-size: 1.45rem; color: #0f172a; font-weight: 800; letter-spacing: -0.02em;">
          Reception & Department Areas
        </h3>
        <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 20px; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; background: <%= totalWaiting > 0 ? '#ecfdf5' : '#f8fafc' %>; color: <%= totalWaiting > 0 ? '#065f46' : '#64748b' %>; border: 1px solid <%= totalWaiting > 0 ? '#a7f3d0' : '#e2e8f0' %>;">
          <span style="display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: <%= totalWaiting > 0 ? '#10b981' : '#94a3b8' %>;"></span>
          <span><%= totalWaiting %> In Flow</span>
        </span>
      </div>
      <p style="margin: 0; color: #64748b; font-size: 0.92rem;">Real-time clinical flow, department station routing, and patient queue load balancing.</p>
    </div>

    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
      <a href="/reception/stashed" class="button no-guard" data-no-guard="1" style="background: #f59e0b; color: #ffffff; border: none; padding: 10px 18px; border-radius: 10px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.25); text-decoration: none;">
        <i class="fas fa-box-archive"></i>
        <span>Stashed Results (<%= (typeof stashedCount !== 'undefined' ? stashedCount : (typeof stashedList !== 'undefined' && Array.isArray(stashedList) ? stashedList.length : 0)) %>)</span>
      </a>
      <a href="/kiosk" target="_blank" rel="noopener" class="button btn-secondary no-guard" data-no-guard="1" style="padding: 10px 18px; border-radius: 10px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.04); text-decoration: none;">
        <i class="fas fa-desktop" style="color: #059669;"></i>
        <span>Kiosk Queue Display</span>
      </a>
    </div>
  </div>

  <!-- Area Cards Grid (5 Columns x 2 Rows) -->
  <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; margin-bottom: 28px;">
    <% 
      const roomLabelMap = (function(){
        try {
          const d1 = (typeof DOCTOR_1_NAME !== 'undefined' && DOCTOR_1_NAME) ? `Doctor's Check-up - ${DOCTOR_1_NAME}` : "Doctor's Check-up - Dr. Lorenzo";
          const d2 = (typeof DOCTOR_2_NAME !== 'undefined' && DOCTOR_2_NAME) ? `Doctor's Check-up - ${DOCTOR_2_NAME}` : "Doctor's Check-up - Dr. Arcilla";
          const out = {};
          out[d1] = `Doctor's Check-up — ${DOCTOR_1_NAME || 'Dr. Lorenzo'}`;
          out[d2] = `Doctor's Check-up — ${DOCTOR_2_NAME || 'Dr. Arcilla'}`;
          return out;
        } catch (e) { return {}; }
      })();

      // Curated Theme per area (icon, color, bg, border)
      const themeMap = {
        'Payment Area': { icon: 'fa-cash-register', color: '#059669', bg: 'linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%)', border: '#a7f3d0' },
        'Extraction Area': { icon: 'fa-vial', color: '#d97706', bg: 'linear-gradient(135deg, #ffffff 0%, #fffbe6 100%)', border: '#fef08a' },
        'Drug Test': { icon: 'fa-capsules', color: '#7c3aed', bg: 'linear-gradient(135deg, #ffffff 0%, #faf5ff 100%)', border: '#e9d5ff' },
        'Ultrasound': { icon: 'fa-wave-square', color: '#0284c7', bg: 'linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)', border: '#bae6fd' },
        '2D Echo': { icon: 'fa-heart-pulse', color: '#e11d48', bg: 'linear-gradient(135deg, #ffffff 0%, #fff1f2 100%)', border: '#fecdd3' },
        'X-ray': { icon: 'fa-x-ray', color: '#ea580c', bg: 'linear-gradient(135deg, #ffffff 0%, #fff7ed 100%)', border: '#ffedd5' },
        'ECG': { icon: 'fa-file-waveform', color: '#0891b2', bg: 'linear-gradient(135deg, #ffffff 0%, #ecfeff 100%)', border: '#cffaff' },
        'Releasing of Result': { icon: 'fa-paper-plane', color: '#4f46e5', bg: 'linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%)', border: '#ddd6fe' }
      };

      (areas.slice ? areas.slice(0,10) : areas).forEach(area => { 
        const displayName = roomLabelMap[area.name] || String(area.name).replace(/\s*-\s*[AB]$/i, "");
        const isDoc = String(area.name).toLowerCase().includes('doctor');
        const theme = themeMap[area.name] || (isDoc ? { icon: 'fa-user-md', color: '#0d9488', bg: 'linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%)', border: '#99f6e4' } : { icon: 'fa-hospital-user', color: '#10b981', bg: '#ffffff', border: '#e2e8f0' });
        const hasQueue = (Number(area.count) || 0) > 0;
    %>
      <div style="background: <%= theme.bg %>; border: 1px solid <%= theme.border %>; border-radius: 16px; padding: 22px; box-shadow: 0 4px 14px rgba(0,0,0,0.03); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1); min-height: 170px;" class="reception-area-tile" onmouseover="this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(0,0,0,0.06)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 4px 14px rgba(0,0,0,0.03)';">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; gap: 8px;">
            <h4 style="margin: 0; font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 700; color: <%= theme.color %>; line-height: 1.35;"><%= displayName %></h4>
            <div style="width: 36px; height: 36px; border-radius: 10px; background: #ffffff; color: <%= theme.color %>; display: flex; align-items: center; justify-content: center; font-size: 1.05rem; box-shadow: 0 2px 6px rgba(0,0,0,0.04); flex-shrink: 0;">
              <i class="fas <%= theme.icon %>"></i>
            </div>
          </div>
          
          <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 14px;">
            <div style="font-size: 2.5rem; font-weight: 800; color: <%= theme.color %>; line-height: 1; letter-spacing: -0.03em; font-family: var(--font-mono, monospace);">
              <%= area.count %>
            </div>
            <span style="font-size: 0.72rem; font-weight: 600; color: <%= hasQueue ? theme.color : '#94a3b8' %>; text-transform: uppercase; letter-spacing: 0.04em;">
              <%= hasQueue ? 'Waiting' : 'Clear' %>
            </span>
          </div>
        </div>

        <div>
          <a href="/reception/area/<%= encodeURIComponent(area.name) %>" class="button btn-primary btn-small" style="width: 100%; padding: 8px 12px; font-weight: 700; border-radius: 8px; text-align: center; justify-content: center; font-size: 0.82rem; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
            <span>View Queue</span>
            <i class="fas fa-arrow-right" style="font-size: 0.75rem;"></i>
          </a>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Admin Special Action Card -->
  <% 
    const u = (typeof sessionUser !== 'undefined' && sessionUser) ? sessionUser : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null));
    const isAdmin = u && u.role === 'Admin';
  %>

  <% if (isAdmin) { %>
    <div style="margin-bottom: 24px; padding: 20px 24px; background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%); border: 1px solid #fecaca; border-radius: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.05);">
      <div>
        <h4 style="margin: 0 0 4px 0; color: #991b1b; font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <i class="fas fa-shield-alt" style="color: #dc2626;"></i>
          <span>Admin Authorization: Reset Reception Queues</span>
        </h4>
        <p style="margin: 0; color: #7f1d1d; font-size: 0.85rem; line-height: 1.4;">
          Resets all active queue counts across department areas to <strong>0</strong> for a fresh clinical shift.<br>
          <span style="color: #64748b; font-weight: 500;">Note: All patient records, test history, and encoded results will remain completely safe and intact.</span>
        </p>
      </div>
      <form action="/reception/clear-queues" method="POST"
            data-confirm-title="Clear Reception Queue"
            data-confirm-button="Yes, Clear Queues"
            data-confirm="⚠️ ADMIN CONFIRMATION REQUIRED\n\nAre you sure you want to clear all active reception queues?\n\n• All queue counts (Payment Area, Releasing of Result, Extraction, etc.) will reset to 0.\n• Patient profiles and encoded test results will NOT be lost.\n\nClick Yes to proceed.">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <button type="submit" class="button btn-danger no-guard" data-no-guard="1" style="background: #dc2626; color: white; border: none; padding: 10px 20px; font-weight: 700; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25); transition: transform 0.2s;">
          <i class="fas fa-broom"></i>
          <span>Clear Active Queues</span>
        </button>
      </form>
    </div>
  <% } %>

  <!-- Kiosk Advertisement Configuration Box -->
  <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px;">
    <form action="/reception/advert" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <label for="adText" style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 8px; color: #334155; font-size: 0.92rem;">
        <i class="fas fa-bullhorn" style="color: #0284c7;"></i>
        <span>Kiosk Public Announcement Marquee</span>
      </label>
      <textarea id="adText" name="ad" rows="3" placeholder="Enter announcement text to display on the patient kiosk waiting room TV..." style="width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 14px; font-size: 0.88rem; font-family: inherit; resize: vertical; outline: none; margin-bottom: 12px; background: #ffffff;"><%= (typeof ad !== 'undefined' && ad) ? ad : '' %></textarea>
      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <button type="submit" class="button btn-primary btn-small" style="padding: 8px 16px; border-radius: 8px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
          <i class="fas fa-save"></i>
          <span>Save Marquee</span>
        </button>
        <a href="/reception/assigned?kiosk=1" target="_blank" rel="noopener" class="button btn-secondary btn-small" style="padding: 8px 16px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
          <i class="fas fa-desktop" style="color: #0284c7;"></i>
          <span>Preview Waiting Display</span>
        </a>
      </div>
    </form>
  </div>
</div>