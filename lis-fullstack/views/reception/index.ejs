<div class="card reception-card">
  <h3>Reception - Areas</h3>
  <p>Quick overview of reception areas and current queue counts.</p>

  <style>
    .reception-card { 
      position:relative; 
      padding:32px; 
      border-radius:16px; 
      box-shadow: 0 4px 24px rgba(0,0,0,0.04); 
      background: var(--text-white);
      border: 1px solid var(--border-gray);
      margin-bottom: 28px;
    }
    .reception-card:before { 
      content:""; 
      position:absolute; 
      left:0; 
      top:0; 
      bottom:0; 
      width:6px; 
      border-radius:16px 0 0 16px; 
      background: linear-gradient(180deg, var(--secondary-green) 0%, var(--secondary-green-dark) 100%); 
    }
    .reception-card > h3, .reception-card > p { margin-left: 8px; }
    .reception-card > h3 { font-size: 1.5em; color: var(--primary-black); margin-bottom: 6px; letter-spacing: -0.3px; }
    .reception-card > p { color: var(--text-gray); margin-bottom: 24px; }
    
    .area-grid-container { 
      display:grid; 
      grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); 
      gap:20px; 
      margin-top:16px; 
    }
    
    .area-tile { 
      box-sizing:border-box; 
      position:relative; 
      padding:24px 20px 24px 24px; 
      background: var(--text-white); 
      border-radius:16px; 
      border: 1px solid var(--border-gray); 
      box-shadow: 0 4px 16px rgba(0,0,0,0.02); 
      min-height:140px; 
      display: flex;
      flex-direction: column;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
    }
    .area-tile:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0,0,0,0.06);
      border-color: #cbd5e1;
    }
    .area-tile .accent { 
      position:absolute; 
      left:0; 
      top:0; 
      bottom:0; 
      width:6px; 
      background:linear-gradient(180deg, var(--secondary-green), var(--secondary-green-dark)); 
    }
    .area-tile h4 { 
      margin:0 0 12px 0; 
      font-size:0.9em; 
      color: var(--text-gray);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
    }
    .area-tile .count { 
      font-size:2.4em; 
      font-weight:700; 
      margin: 0; 
      color: var(--primary-black);
      line-height: 1.1;
      letter-spacing: -1px;
    }
    .area-tile .actions { 
      margin-top: auto; 
      padding-top: 16px;
    }
    .area-tile .actions .button {
      width: 100%;
    }
  </style>

  <div class="area-grid-container">
    <% 
      const roomLabelMap = (function(){
        try {
          const d1 = (typeof DOCTOR_1_NAME !== 'undefined' && DOCTOR_1_NAME) ? `Doctor's Check-up - ${DOCTOR_1_NAME}` : "Doctor's Check-up - Dr. Lorenzo";
          const d2 = (typeof DOCTOR_2_NAME !== 'undefined' && DOCTOR_2_NAME) ? `Doctor's Check-up - ${DOCTOR_2_NAME}` : "Doctor's Check-up - Dr. Arcilla";
          const out = {};
          out[d1] = `Doctor's Check-up — ${DOCTOR_1_NAME || 'Dr. Lorenzo'}`;
          out[d2] = `Doctor's Check-up — ${DOCTOR_2_NAME || 'Dr. Arcilla'}`;
          return out;
        } catch (e) { return {}; }
      })();
      (areas.slice ? areas.slice(0,10) : areas).forEach(area => { 
        const displayName = roomLabelMap[area.name] || String(area.name).replace(/\s*-\s*[AB]$/i, "");
    %>
      <div class="area-tile">
        <span class="accent"></span>
        <h4><%= displayName %></h4>
        <div class="count"><%= area.count %></div>
        <div class="actions">
          <a href="/reception/area/<%= encodeURIComponent(area.name) %>" class="button btn-primary btn-small">View Queue</a>
        </div>
      </div>
    <% }) %>
  </div>

  <div style="margin-top:14px;">
    <a href="/reception/assigned?kiosk=1" target="_blank" rel="noopener" class="button btn-secondary">Open Patient Queue Display (new tab)</a>
  </div>

  <div style="margin-top:14px; max-width:900px;">
    <% const success = (typeof flash !== 'undefined' && flash && flash.success_msg) ? flash.success_msg : (typeof success_msg !== 'undefined' ? success_msg : null); %>
    <% const error = (typeof flash !== 'undefined' && flash && flash.error_msg) ? flash.error_msg : (typeof error_msg !== 'undefined' ? error_msg : null); %>
    <% if (success && success.length > 0) { %>
      <div style="padding:8px; background:#ecffef; border:1px solid #d1f7d6; border-radius:8px; margin-bottom:8px; color:#064e2a;"><%= success %></div>
    <% } %>
    <% if (error && error.length > 0) { %>
      <div style="padding:8px; background:#fff0f0; border:1px solid #ffd6d6; border-radius:8px; margin-bottom:8px; color:#7a0b0b;"><%= error %></div>
    <% } %>

    <form action="/reception/advert" method="POST">
      <label for="adText" style="display:block; font-weight:700; margin-bottom:6px;">Kiosk Advertisement (marquee text shown on kiosk)</label>
      <textarea id="adText" name="ad" rows="3"><%= (typeof ad !== 'undefined' && ad) ? ad : '' %></textarea>
      <div style="margin-top:8px;">
        <button type="submit" class="button btn-primary btn-small">Save Advertisement</button>
        <a href="/reception/assigned?kiosk=1" target="_blank" rel="noopener" class="button btn-secondary btn-small">Open Kiosk</a>
      </div>
    </form>
  </div>
</div>