<div class="card reception-card" style="padding: 28px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0; margin-bottom: 28px; position: relative;">
  
  <!-- Header Title Block -->
  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid #f1f5f9;">
    <div>
      <h3 style="margin: 0 0 6px 0; font-size: 1.5em; color: #0f172a; font-weight: 700; letter-spacing: -0.3px; display: flex; align-items: center; gap: 10px;">
        <i class="fa fa-door-open" style="color: #10b981;"></i>
        <span>Reception - Department Areas</span>
      </h3>
      <p style="margin: 0; color: #64748b; font-size: 0.95em;">Real-time overview of active reception queues and patient area flow.</p>
    </div>
    <div>
      <a href="/reception/assigned?kiosk=1" target="_blank" rel="noopener" class="button btn-secondary" style="padding: 10px 18px; border-radius: 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(0,0,0,0.04);">
        <i class="fa fa-desktop" style="color: #2563eb;"></i>
        <span>Open Kiosk Queue Display</span>
      </a>
    </div>
  </div>

  <!-- Area Cards Grid (5 Columns x 2 Rows) -->
  <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 28px;">
    <% 
      const roomLabelMap = (function(){
        try {
          const d1 = (typeof DOCTOR_1_NAME !== 'undefined' && DOCTOR_1_NAME) ? `Doctor's Check-up - ${DOCTOR_1_NAME}` : "Doctor's Check-up - Dr. Lorenzo";
          const d2 = (typeof DOCTOR_2_NAME !== 'undefined' && DOCTOR_2_NAME) ? `Doctor's Check-up - ${DOCTOR_2_NAME}` : "Doctor's Check-up - Dr. Arcilla";
          const out = {};
          out[d1] = `Doctor's Check-up — ${DOCTOR_1_NAME || 'Dr. Lorenzo'}`;
          out[d2] = `Doctor's Check-up — ${DOCTOR_2_NAME || 'Dr. Arcilla'}`;
          return out;
        } catch (e) { return {}; }
      })();

      // Curated Theme per area (icon, bg, border, accent, button)
      const themeMap = {
        'Payment Area': { icon: 'fa-cash-register', color: '#059669', bg: 'linear-gradient(135deg, #ffffff 0%, #f0fdf4 100%)', border: '#a7f3d0' },
        'Extraction Area': { icon: 'fa-vial', color: '#d97706', bg: 'linear-gradient(135deg, #ffffff 0%, #fffbe6 100%)', border: '#fef08a' },
        'Drug Test': { icon: 'fa-capsules', color: '#7c3aed', bg: 'linear-gradient(135deg, #ffffff 0%, #faf5ff 100%)', border: '#e9d5ff' },
        'Ultrasound': { icon: 'fa-wave-square', color: '#0284c7', bg: 'linear-gradient(135deg, #ffffff 0%, #f0f9ff 100%)', border: '#bae6fd' },
        '2D Echo': { icon: 'fa-heartbeat', color: '#e11d48', bg: 'linear-gradient(135deg, #ffffff 0%, #fff1f2 100%)', border: '#fecdd3' },
        'X-ray': { icon: 'fa-x-ray', color: '#ea580c', bg: 'linear-gradient(135deg, #ffffff 0%, #fff7ed 100%)', border: '#ffedd5' },
        'ECG': { icon: 'fa-file-medical-alt', color: '#0891b2', bg: 'linear-gradient(135deg, #ffffff 0%, #ecfeff 100%)', border: '#cffaff' },
        'Releasing of Result': { icon: 'fa-paper-plane', color: '#4f46e5', bg: 'linear-gradient(135deg, #ffffff 0%, #f5f3ff 100%)', border: '#ddd6fe' }
      };

      (areas.slice ? areas.slice(0,10) : areas).forEach(area => { 
        const displayName = roomLabelMap[area.name] || String(area.name).replace(/\s*-\s*[AB]$/i, "");
        const isDoc = String(area.name).toLowerCase().includes('doctor');
        const theme = themeMap[area.name] || (isDoc ? { icon: 'fa-user-md', color: '#0d9488', bg: 'linear-gradient(135deg, #ffffff 0%, #f0fdfa 100%)', border: '#99f6e4' } : { icon: 'fa-hospital-user', color: '#10b981', bg: '#ffffff', border: '#e2e8f0' });
    %>
      <div style="background: <%= theme.bg %>; border: 1px solid <%= theme.border %>; border-radius: 16px; padding: 22px; box-shadow: 0 4px 14px rgba(0,0,0,0.03); display: flex; flex-direction: column; justify-content: space-between; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); min-height: 160px;" class="reception-area-tile">
        
        <div>
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
            <h4 style="margin: 0; font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; color: <%= theme.color %>; line-height: 1.3;"><%= displayName %></h4>
            <div style="width: 36px; height: 36px; border-radius: 10px; background: #ffffff; color: <%= theme.color %>; display: flex; align-items: center; justify-content: center; font-size: 1.1em; box-shadow: 0 2px 6px rgba(0,0,0,0.04); flex-shrink: 0;">
              <i class="fa <%= theme.icon %>"></i>
            </div>
          </div>
          <div style="font-size: 2.5em; font-weight: 800; color: <%= theme.color %>; line-height: 1; letter-spacing: -1px; margin-bottom: 16px;">
            <%= area.count %>
          </div>
        </div>

        <div>
          <a href="/reception/area/<%= encodeURIComponent(area.name) %>" class="button btn-primary btn-small" style="width: 100%; padding: 8px 12px; font-weight: 600; border-radius: 8px; text-align: center; justify-content: center; font-size: 0.85em;">
            View Queue
          </a>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Messages & Flash Alerts -->
  <% const success = (typeof flash !== 'undefined' && flash && flash.success_msg) ? flash.success_msg : (typeof success_msg !== 'undefined' ? success_msg : null); %>
  <% const error = (typeof flash !== 'undefined' && flash && flash.error_msg) ? flash.error_msg : (typeof error_msg !== 'undefined' ? error_msg : null); %>
  <% if (success && success.length > 0) { %>
    <div style="padding: 12px 16px; background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 10px; margin-bottom: 20px; color: #15803d; font-weight: 600; display: flex; align-items: center; gap: 10px;">
      <i class="fa fa-check-circle" style="font-size: 1.1em;"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (error && error.length > 0) { %>
    <div style="padding: 12px 16px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 10px; margin-bottom: 20px; color: #b91c1c; font-weight: 600; display: flex; align-items: center; gap: 10px;">
      <i class="fa fa-exclamation-triangle" style="font-size: 1.1em;"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Admin Special Action Card -->
  <% 
    const u = (typeof sessionUser !== 'undefined' && sessionUser) ? sessionUser : ((typeof currentUser !== 'undefined' && currentUser) ? currentUser : ((typeof user !== 'undefined' && user) ? user : null));
    const isAdmin = u && u.role === 'Admin';
  %>

  <% if (isAdmin) { %>
    <div style="margin-bottom: 24px; padding: 20px 24px; background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%); border: 1px solid #fecaca; border-radius: 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 4px 14px rgba(220, 38, 38, 0.05);">
      <div>
        <h4 style="margin: 0 0 4px 0; color: #991b1b; font-size: 1.05em; font-weight: 700; display: flex; align-items: center; gap: 8px;">
          <i class="fa fa-user-shield" style="color: #dc2626;"></i>
          <span>Admin Only: Reset Reception Queues</span>
        </h4>
        <p style="margin: 0; color: #7f1d1d; font-size: 0.88em; line-height: 1.4;">
          Resets all active queue counts (Payment Area, Releasing of Result, Extraction, etc.) to <strong>0</strong> for a fresh start.<br>
          <span style="color: #64748b; font-weight: 500;">Note: All patient records, test history, and encoded results will remain completely safe and intact.</span>
        </p>
      </div>
      <form action="/reception/clear-queues" method="POST"
            data-confirm-title="Clear Reception Queue"
            data-confirm-button="Yes, Clear Queues"
            data-confirm="⚠️ ADMIN CONFIRMATION REQUIRED\n\nAre you sure you want to clear all active reception queues?\n\n• All queue counts (Payment Area, Releasing of Result, Extraction, etc.) will reset to 0.\n• Patient profiles and encoded test results will NOT be lost.\n\nClick Yes to proceed.">
        <button type="submit" class="button btn-danger no-guard" data-no-guard="1" style="background: #dc2626; color: white; border: none; padding: 10px 20px; font-weight: 700; border-radius: 10px; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25); transition: transform 0.2s;">
          <i class="fa fa-broom"></i>
          <span>Clear Reception Queue</span>
        </button>
      </form>
    </div>
  <% } %>

  <!-- Kiosk Advertisement Configuration Box -->
  <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; padding: 20px;">
    <form action="/reception/advert" method="POST">
      <label for="adText" style="display: flex; align-items: center; gap: 8px; font-weight: 700; margin-bottom: 8px; color: #334155; font-size: 0.95em;">
        <i class="fa fa-bullhorn" style="color: #2563eb;"></i>
        <span>Kiosk Advertisement (marquee text shown on kiosk display)</span>
      </label>
      <textarea id="adText" name="ad" rows="3" placeholder="Enter marquee text to display on the kiosk..." style="width: 100%; border: 1px solid #cbd5e1; border-radius: 10px; padding: 10px 14px; font-size: 0.9em; font-family: inherit; resize: vertical; outline: none; margin-bottom: 12px;"><%= (typeof ad !== 'undefined' && ad) ? ad : '' %></textarea>
      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <button type="submit" class="button btn-primary btn-small" style="padding: 8px 16px; border-radius: 8px; font-weight: 600;">Save Advertisement</button>
        <a href="/reception/assigned?kiosk=1" target="_blank" rel="noopener" class="button btn-secondary btn-small" style="padding: 8px 16px; border-radius: 8px; font-weight: 600;">Open Kiosk Display</a>
      </div>
    </form>
  </div>
</div>