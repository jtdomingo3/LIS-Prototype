<div class="card">
  <h3><%= areaName %> - Queue</h3>
  <p>Manage patients assigned to this area. Use the tabs to switch between the queue and specimen assignments.</p>

  <div style="margin-top:12px; display:flex; gap:8px;">
    <button id="tabQueue" class="button btn-small btn-primary">Queue</button>
    <button id="tabSpecimens" class="button btn-small">Specimens</button>
  </div>

  <div id="queuePane" style="margin-top:12px;">
    <!-- Create & assign removed: new patients are auto-created and assigned to Payment Area on encoding -->
    <% if (areaName === 'Payment Area') { %>
      <% if (!groups || groups.length === 0) { %>
        <p class="text-center">No patients waiting for payment.</p>
      <% } else { %>
        <table style="width:100%; margin-top:12px;">
          <thead>
            <tr>
              <th>Patient</th>
              <th>Tests</th>
              <th>Total</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% groups.forEach(p => { %>
              <tr>
                <td>
                  <strong><%= p.patient.firstName %> <%= p.patient.lastName %></strong>
                  <% if (p.patient.patientCode) { %>
                    <div style="font-size:0.85em; color:var(--text-gray);">Code: <%= p.patient.patientCode %></div>
                  <% } %>
                </td>
                <td>
                  <ul style="margin:0; padding-left:18px;">
                    <% p.tests.forEach(t => { %>
                      <li><%= t.testType %> (<%= t.testId %>)</li>
                    <% }) %>
                  </ul>
                </td>
                <td style="white-space:nowrap;">
                  <div>PHP <%= (p.total || 0).toFixed(2) %></div>
                  <div style="font-size:0.85em; color:var(--text-gray);">Clinical: <%= (p.clinical || 0).toFixed(2) %></div>
                  <div style="font-size:0.85em; color:var(--text-gray);">X‑Ray: <%= (p.xray || 0).toFixed(2) %></div>
                </td>
                <td>
                    <!-- Editable lab totals (allow adjusting clinical/xray amounts) and single Mark Complete action -->
                    <div style="margin-bottom:6px; display:flex; gap:12px; align-items:center;">
                      <% if (p.clinical && Number(p.clinical) > 0) { %>
                        <div>
                          <label style="font-size:0.85em;">Clinical:</label>
                          <input type="number" step="0.01" min="0" name="clinicalAmount" class="clinical-amount" value="<%= (p.clinical || 0).toFixed(2) %>" style="width:110px; margin-left:6px;">
                        </div>
                      <% } %>
                      <% if (p.xray && Number(p.xray) > 0) { %>
                        <div>
                          <label style="font-size:0.85em;">X‑Ray:</label>
                          <input type="number" step="0.01" min="0" name="xrayAmount" class="xray-amount" value="<%= (p.xray || 0).toFixed(2) %>" style="width:110px; margin-left:6px;">
                        </div>
                      <% } %>
                      <div>
                        <label style="font-size:0.85em;">Estimated Total:</label>
                        <input type="number" step="0.01" min="0" name="amount" class="payment-amount" value="<%= (p.total || 0).toFixed(2) %>" style="width:110px; margin-left:6px;">
                      </div>
                    </div>
                    <form action="/reception/complete-payment" method="POST" class="complete-payment-form" style="display:inline-block; margin-right:6px;">
                      <input type="hidden" name="patientId" value="<%= p.patient.id %>">
                      <input type="hidden" name="lab" value="">
                      <input type="number" name="amount" class="payment-amount" step="0.01" min="0.01" value="<%= (p.total || 0).toFixed(2) %>" style="width:110px; margin-right:6px;" required>
                      <button type="submit" class="button btn-success btn-small payment-submit" title="Mark complete" onclick="return paymentSubmitFallback(this)">Mark Complete</button>
                    </form>
                    <form action="/reception/delete-patient" method="POST" class="delete-patient-form" style="display:inline-block; margin-left:6px;" onsubmit="return confirm('Delete all Payment Area items for this patient?');">
                      <input type="hidden" name="patientId" value="<%= p.patient.id %>">
                      <button type="submit" class="button btn-danger btn-small">Delete</button>
                    </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } else if (typeof groups !== 'undefined' && groups && groups.length) { %>
      <% /* Grouped view for areas like Extraction or X-ray where multiple tests per patient should be shown */ %>
      <table style="width:100%; margin-top:12px;">
        <thead>
          <tr>
            <th>Patient</th>
            <th>Tests</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(g => { %>
            <tr>
              <td>
                <strong><%= g.patient.firstName %> <%= g.patient.lastName %></strong>
                <% if (g.patient.patientCode) { %>
                  <div style="font-size:0.85em; color:var(--text-gray);">Code: <%= g.patient.patientCode %></div>
                <% } %>
              </td>
              <td>
                <ul style="margin:0; padding-left:18px;">
                  <% g.tests.forEach(t => { %>
                    <li style="font-size:0.9em; margin-bottom:2px;"><strong><%= t.testId %></strong> — <%= t.testType %></li>
                  <% }) %>
                </ul>
              </td>
              <td>
                <!-- Mark Complete All for entire patient row -->
                <form action="/reception/complete-all" method="POST" class="complete-all-form" style="display:inline-block; margin-right:12px;">
                  <input type="hidden" name="patientId" value="<%= g.patient.id %>">
                  <input type="hidden" name="area" value="<%= areaName %>">
                  <button type="submit" class="button btn-success btn-small" title="Mark all <%= g.tests.length %> test(s) complete">
                    <%= areaName === 'Releasing of Result' ? 'Release All' : 'Mark Complete All' %> (<%= g.tests.length %>)
                  </button>
                </form>
                <!-- Delete all tests for this patient in this area -->
                <form action="/reception/delete-patient-area" method="POST" class="delete-patient-area-form" style="display:inline-block;" onsubmit="return confirm('Delete all <%= g.tests.length %> test(s) for this patient from <%= areaName %>?');">
                  <input type="hidden" name="patientId" value="<%= g.patient.id %>">
                  <input type="hidden" name="area" value="<%= areaName %>">
                  <button type="submit" class="button btn-danger btn-small" title="Delete all tests">Delete All</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <% if (!tests || tests.length === 0) { %>
        <p class="text-center">No tests currently assigned to this area.</p>
      <% } else { %>
        <table style="width:100%; margin-top:12px;">
          <thead>
            <tr>
              <th>Test ID</th>
              <th>Patient</th>
              <th>Test Type</th>
              <th>Date</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% tests.forEach(test => { %>
              <tr>
                <td><%= test.testId %></td>
                <td>
                  <% if (test.patient) { %>
                    <strong><%= test.patient.firstName %> <%= test.patient.lastName %></strong>
                    <% if (test.patient.patientCode) { %>
                      <div style="font-size:0.85em; color:var(--text-gray);">Code: <%= test.patient.patientCode %></div>
                    <% } else { %>
                      <div style="font-size:0.85em; color:var(--danger);">(Not encoded)</div>
                    <% } %>
                  <% } else { %>
                    Unknown
                  <% } %>
                </td>
                <td><%= test.testType %></td>
                <td><%= test.testDate ? new Date(test.testDate).toLocaleString() : 'N/A' %></td>
                <td>
                  <% if (areaName !== 'Payment Area') { %>
                  <form action="/reception/assign" method="POST" style="display:inline-block; margin-right:6px;">
                    <input type="hidden" name="testId" value="<%= test.id %>">
                    <select name="area" required style="margin-right:6px;">
                      <% 
                        // map specific area values to nicer display labels if needed
                        const optionLabelMap = {};
                      %>
                      <% areas.forEach(a => { %>
                        <% const displayLabel = optionLabelMap[a] || String(a).replace(/\s*-\s*[AB]$/i, ''); %>
                        <option value="<%= a %>" <%= a === areaName ? 'selected' : '' %>><%= displayLabel %></option>
                      <% }) %>
                    </select>
                    <input type="text" name="specimen" placeholder="Specimen # (optional)" style="margin-right:6px;" <%= test.patientEncoded ? '' : 'disabled' %>>
                    <button class="button btn-primary btn-small" <%= test.patientEncoded ? '' : 'disabled' %>>Assign</button>
                    <% if (!test.patientEncoded) { %>
                      <div style="font-size:0.8em;color:var(--danger);margin-top:6px;">Patient must be encoded (have a patient code) before assignment. <a href="/patients/<%= test.patient ? test.patient.id : '' %>/edit">Encode now</a></div>
                    <% } %>
                  </form>
                  <a href="/tests/<%= test.id %>" class="button btn-secondary btn-small">View</a>
                  <!-- Mark complete -->
                  <form action="/reception/complete" method="POST" class="complete-form" style="display:inline-block; margin-left:6px;">
                    <input type="hidden" name="testId" value="<%= test.id %>">
                    <input type="hidden" name="area" value="<%= areaName %>">
                    <button type="submit" class="button btn-success btn-small" title="Mark complete"><%= areaName === 'Releasing of Result' ? 'Mark Released' : 'Mark Complete' %></button>
                  </form>
                  <% } %>
                  <!-- Delete from queue -->
                  <form action="/reception/delete" method="POST" class="delete-form" style="display:inline-block; margin-left:6px;" onsubmit="return confirm('Delete this test from the queue?');">
                    <input type="hidden" name="testId" value="<%= test.id %>">
                    <input type="hidden" name="area" value="<%= areaName %>">
                    <button type="submit" class="button btn-danger btn-small" title="Delete">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    <% } %>
  </div>

  <div id="specimensPane" style="margin-top:12px; display:none;">
    <% if (!specimens || specimens.length === 0) { %>
      <p class="text-center">No specimens assigned for this area yet.</p>
    <% } else { %>
      <table style="width:100%; margin-top:12px;">
        <thead>
          <tr>
            <th>Test ID</th>
            <th>Specimen #</th>
            <th>Patient</th>
          </tr>
        </thead>
        <tbody>
          <% specimens.forEach(s => { %>
            <tr>
              <td><%= s.testId %></td>
              <td><%= s.specimen %></td>
              <td><%= s.patient ? s.patient.firstName + ' ' + s.patient.lastName : 'Unknown' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div style="margin-top:14px;">
    <a href="/reception" class="button btn-secondary">Back to Areas</a>
  </div>

  <script>
    (function(){
      const tabQueue = document.getElementById('tabQueue');
      const tabSpecimens = document.getElementById('tabSpecimens');
      const queuePane = document.getElementById('queuePane');
      const specimensPane = document.getElementById('specimensPane');
      tabQueue.addEventListener('click', () => { queuePane.style.display='block'; specimensPane.style.display='none'; tabQueue.classList.add('btn-primary'); tabSpecimens.classList.remove('btn-primary'); });
      tabSpecimens.addEventListener('click', () => { queuePane.style.display='none'; specimensPane.style.display='block'; tabSpecimens.classList.add('btn-primary'); tabQueue.classList.remove('btn-primary'); });
    })();

    // AJAX handlers for complete/delete to avoid navigation and keep on same area page
    (function(){
      console.debug('[DEBUG] reception area script init');
      try {
        document.addEventListener('DOMContentLoaded', () => {
          console.debug('[DEBUG] DOMContentLoaded, .complete-form count=', document.querySelectorAll('.complete-form').length);
        });
        // also log immediately in case script runs after DOM is ready
        console.debug('[DEBUG] immediate .complete-form count=', document.querySelectorAll('.complete-form').length);
      } catch (e) {
        console.warn('[DEBUG] failed to attach debug listeners', e);
      }
      function serializeForm(form) {
        const data = new URLSearchParams();
        for (const el of form.elements) {
          if (!el.name) continue;
          if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) continue;
          data.append(el.name, el.value);
        }
        return data;
      }

      // Fallback submit helper for Payment Area button clicks.
      // Validates the amount, logs debugging info, and triggers a programmatic submit
      // which will be intercepted by the AJAX submit handler above.
      function paymentSubmitFallback(btn) {
        try {
          const form = btn && btn.closest ? btn.closest('form') : null;
          if (!form) return true;
          const amtInput = form.querySelector('.payment-amount');
          if (amtInput) {
            const raw = amtInput.value;
            const parsed = parseFloat(String(raw).replace(/[,\s]/g, ''));
            const htmlValid = typeof amtInput.checkValidity === 'function' ? amtInput.checkValidity() : true;
            const valid = htmlValid && Number.isFinite(parsed) && parsed > 0;
            console.debug('[DEBUG] paymentSubmitFallback', { raw, parsed, htmlValid, valid });
            if (!valid) {
              alert('Please enter a valid positive amount before marking complete.');
              return false;
            }
          }
          // Trigger form submission programmatically so the AJAX handler runs.
          if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
          // Prevent default click action (we already submitted programmatically)
          return false;
        } catch (e) {
          console.error('paymentSubmitFallback error', e);
          return true;
        }
      }

      // Enable/disable Payment Area submit buttons based on amount input
      // Make this robust across browsers/locales and add debug logging for troubleshooting
      document.querySelectorAll('.payment-amount').forEach(input => {
        const form = input.closest('form');
        const btn = form ? form.querySelector('.payment-submit') : null;
        function parseAmount(v) {
          if (v === null || v === undefined) return NaN;
          // strip common thousands separators, trim whitespace
          try { return parseFloat(String(v).replace(/[,\s]/g, '')); } catch (e) { return NaN; }
        }
        function update() {
          const raw = input.value;
          const amt = parseAmount(raw);
          // Use HTML5 validity when available as a stronger signal
          let htmlValid = true;
          try { htmlValid = typeof input.checkValidity === 'function' ? input.checkValidity() : true; } catch (e) { htmlValid = true; }
          const valid = htmlValid && Number.isFinite(amt) && amt > 0;
          if (btn) {
            btn.disabled = !valid;
          }
          // helpful debug output when troubleshooting why button remains disabled
          console.debug('[DEBUG] payment-amount update', { raw, parsed: amt, htmlValid, buttonDisabled: btn ? btn.disabled : null });
        }
        ['input','change','blur'].forEach(ev => input.addEventListener(ev, update));
        // initialize after a short timeout in case the DOM or value was set programmatically
        setTimeout(update, 0);
      });

      // handle complete (AJAX) — use URLSearchParams and mimic the working delete flow
      document.querySelectorAll('.complete-form').forEach(form => {
        // normal submit interception
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          console.debug('[DEBUG] complete-form submit triggered for form action=', form.action);
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;

          // use URLSearchParams directly (fetch will set Content-Type correctly)
          let bodyParams = null;
          try { bodyParams = serializeForm(form); } catch (serr) { console.warn('serializeForm failed', serr); bodyParams = new URLSearchParams(); }
          console.debug('[DEBUG] body to send=', bodyParams.toString());

          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
              },
              body: bodyParams
            });
            console.debug('[DEBUG] fetch completed, status=', resp.status);
          } catch (err) {
            if (btn) btn.disabled = false;
            console.error('Network error completing test', err);
            alert('Network error marking complete');
            return;
          }

          if (btn) btn.disabled = false;
          let json = null;
          try { json = await resp.json(); } catch (e) { /* ignore parse errors */ }
          console.debug('[DEBUG] parsed json response=', json);
          if (!resp.ok) {
            const msg = (json && json.message) ? json.message : 'Error marking complete';
            alert(msg);
            return;
          }
          // remove the row from the table so next patient shows up
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            const main = document.querySelector('.main-content') || document.body;
            main.insertBefore(note, main.firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) { }
          }
        });

        // safety: prevent silent failures if browser validation/disabled state blocks click
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.addEventListener('click', (ev) => {
            // if button is disabled when clicked, stop native behavior to avoid confusion
            if (submitBtn.disabled) {
              ev.preventDefault();
              ev.stopImmediatePropagation();
            }
          });
        }
      });

      // handle aggregated payment forms (AJAX)
      document.querySelectorAll('.complete-payment-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          let bodyParams = null;
          try { bodyParams = serializeForm(form); } catch (serr) { bodyParams = new URLSearchParams(); }
          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
              body: bodyParams
            });
          } catch (err) {
            if (btn) btn.disabled = false;
            alert('Network error recording payment');
            return;
          }
          if (btn) btn.disabled = false;
          const json = await resp.json().catch(() => null);
          if (!resp.ok) {
            alert((json && json.message) ? json.message : 'Error recording payment');
            return;
          }
          // Decide whether to remove the patient row: only remove when no Payment Area tests remain
          const row = form.closest('tr');
          const remaining = json && typeof json.remaining === 'number' ? json.remaining : 0;
          const labTotals = json && json.labTotals ? json.labTotals : null;
          if (row) {
            if (remaining === 0) {
              row.remove();
            } else {
              // update displayed values if present: clinical/xray/total inputs
              try {
                if (labTotals) {
                  const clin = row.querySelector('.clinical-amount');
                  const xray = row.querySelector('.xray-amount');
                  const totals = row.querySelectorAll('.payment-amount');
                  if (clin && typeof labTotals.clinical !== 'undefined') clin.value = Number(labTotals.clinical || 0).toFixed(2);
                  if (xray && typeof labTotals.xray !== 'undefined') xray.value = Number(labTotals.xray || 0).toFixed(2);
                  totals.forEach(t => { t.value = Number((labTotals.clinical || 0) + (labTotals.xray || 0)).toFixed(2); });
                }
              } catch (e) { /* ignore UI update errors */ }
            }
          }
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            const main = document.querySelector('.main-content') || document.body;
            main.insertBefore(note, main.firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) {}
          }
        });
      });

      // Sync clinical/xray inputs to the main payment amount input when present
      document.querySelectorAll('tr').forEach(row => {
        const clinicalInput = row.querySelector('.clinical-amount');
        const xrayInput = row.querySelector('.xray-amount');
        const totalInput = row.querySelector('.payment-amount');
        if (!totalInput) return;
        function updateTotal() {
          const c = clinicalInput ? parseFloat(String(clinicalInput.value).replace(/[ ,]/g, '')) || 0 : 0;
          const x = xrayInput ? parseFloat(String(xrayInput.value).replace(/[ ,]/g, '')) || 0 : 0;
          totalInput.value = (c + x).toFixed(2);
          // also update any other payment-amount inputs within same row/forms
          row.querySelectorAll('.payment-amount').forEach(inp => { if (inp !== totalInput) inp.value = totalInput.value; });
        }
        if (clinicalInput) clinicalInput.addEventListener('input', updateTotal);
        if (xrayInput) xrayInput.addEventListener('input', updateTotal);
      });

      // handle delete
      document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!confirm('Delete this test from the queue?')) return;
          const btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          const resp = await fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: serializeForm(form)
          }).catch(err => ({ ok: false, error: err }));
          btn.disabled = false;
          if (!resp || !resp.ok) {
            alert('Error deleting test');
            return;
          }
          const json = await resp.json().catch(() => null);
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            document.querySelector('.main-content').insertBefore(note, document.querySelector('.main-content').firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try {
              // notify other tabs via localStorage so kiosk/assigned views refresh immediately
              localStorage.setItem('reception:updated', String(Date.now()));
            } catch (e) { }
          }
        });
      });

      // handle delete-patient (group row) forms
      document.querySelectorAll('.delete-patient-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!confirm('Delete all Payment Area items for this patient?')) return;
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
              body: serializeForm(form)
            });
          } catch (err) {
            if (btn) btn.disabled = false;
            alert('Network error deleting patient items');
            return;
          }
          if (btn) btn.disabled = false;
          const json = await resp.json().catch(() => null);
          if (!resp.ok) {
            alert((json && json.message) ? json.message : 'Error deleting patient items');
            return;
          }
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            document.querySelector('.main-content').insertBefore(note, document.querySelector('.main-content').firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) {}
          }
        });
      });

      // handle complete-all-form (grouped area: complete all tests for patient in this area)
      document.querySelectorAll('.complete-all-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
              body: serializeForm(form)
            });
          } catch (err) {
            if (btn) btn.disabled = false;
            alert('Network error completing tests');
            return;
          }
          if (btn) btn.disabled = false;
          const json = await resp.json().catch(() => null);
          if (!resp.ok) {
            alert((json && json.message) ? json.message : 'Error completing tests');
            return;
          }
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            document.querySelector('.main-content').insertBefore(note, document.querySelector('.main-content').firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) {}
          }
        });
      });

      // handle delete-patient-area-form (grouped area: delete all tests for patient in this area)
      document.querySelectorAll('.delete-patient-area-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!confirm('Delete all tests for this patient in this area?')) return;
          const btn = form.querySelector('button[type="submit"]');
          if (btn) btn.disabled = true;
          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
              body: serializeForm(form)
            });
          } catch (err) {
            if (btn) btn.disabled = false;
            alert('Network error deleting tests');
            return;
          }
          if (btn) btn.disabled = false;
          const json = await resp.json().catch(() => null);
          if (!resp.ok) {
            alert((json && json.message) ? json.message : 'Error deleting tests');
            return;
          }
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            document.querySelector('.main-content').insertBefore(note, document.querySelector('.main-content').firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) {}
          }
        });
      });
    })();
  </script>

</div>
