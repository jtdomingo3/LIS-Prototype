<div class="card">
  <h3><%= areaName %> - Queue</h3>
  <p>Manage patients and tests currently waiting in this area.</p>

  <div id="queuePane" style="margin-top:12px;">
    <!-- Create & assign removed: new patients are auto-created and assigned to Payment Area on encoding -->
    <% if (!tests || tests.length === 0) { %>
      <p class="text-center">No tests currently assigned to this area.</p>
    <% } else { %>
      <table style="width:100%; margin-top:12px;">
        <thead>
          <tr>
            <th>Patient</th>
            <th>Tests</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% // Unified rendering: server provides aggregated rows for every area in `tests`.
             tests.forEach(row => { %>
            <tr>
              <td>
                <strong><%= row.patient ? (row.patient.firstName + ' ' + row.patient.lastName) : 'Unknown' %></strong>
                <% if (row.patient && row.patient.patientCode) { %>
                  <div style="font-size:0.85em; color:var(--text-gray);">Code: <%= String(row.patient.patientCode).slice(-5) %></div>
                <% } else { %>
                  <div style="font-size:0.85em; color:var(--danger);">(Not encoded)</div>
                <% } %>
              </td>
              <td>
                <ul style="margin:0 0 0 12px; padding:0; list-style:disc;">
                  <% if (Array.isArray(row.tests) && row.tests.length) {
                       row.tests.forEach(t => {
                         // Render a single collapsed row for Blood Chemistry tests (group variants)
                         const tt = (t.testType || '').toString().toLowerCase();
                         const isBloodChem = /blood\s*chemistry|blood-chemistry|^bc\b/i.test(tt) || (Array.isArray(t.requestedTests) && t.requestedTests.length > 1 && t.requestedTests.every(r=>/(blood|chemistry|bun|crea|sgpt|sgot|lipid|hba1c|albumin|blood[-_\s]?sugar)/i.test(String(r.key||r.label||''))));
                         if (isBloodChem) {
                           const label = (t.testType && t.testType.toString()) ? (t.testType.toString()) : 'Blood Chemistry'; %>
                            <li style="margin-bottom:4px;"><%= label.replace(/-/g,' ').replace(/\b\w/g, function(ch){return ch.toUpperCase();}) %>
                               <div style="margin-top:4px; font-size:0.85em;">
                                <% if (areaName !== 'Payment Area') { %>
                                 <form action="/reception/assign" method="POST" style="display:inline-block; margin-right:6px;">
                                   <input type="hidden" name="testId" value="<%= t.id %>">
                                   <select name="area" required style="margin-right:6px;">
                                     <% areas.forEach(a => { %>
                                       <option value="<%= a %>" <%= a === areaName ? 'selected' : '' %>><%= a %></option>
                                     <% }) %>
                                   </select>
                                   <input type="text" name="specimen" placeholder="Specimen # (optional)" style="margin-right:6px;" <%= row.patientEncoded ? '' : 'disabled' %>>
                                   <button class="button btn-primary btn-small" <%= row.patientEncoded ? '' : 'disabled' %>>Assign</button>
                                 </form>
                                <% } %>
                               </div>
                             </li>
                         <% } else {
                           // use area-specific requested list when available, otherwise fall back to whole test type
                           const areaList = Array.isArray(t._areaRequested) && t._areaRequested.length ? t._areaRequested : (Array.isArray(t.requestedTests) ? t.requestedTests : []);
                           if (areaList.length) {
                             areaList.forEach(rt => { const amt = Number(rt.amount || 0); %>
                              <li style="margin-bottom:4px;"><%= (rt.label || '').replace(/-/g,' ').replace(/\b\w/g, function(ch){return ch.toUpperCase();}) %> <span style="color:var(--text-gray);">(<%= rt.lab || 'clinical' %>)</span>
                                 <% if (rt.remarks || rt.remark) { %>
                                   <span style="font-size:0.82em; color:#0284c7; background:#f0f9ff; border:1px solid #bae6fd; padding:2px 6px; border-radius:4px; margin-left:6px; font-weight:600;"><i class="fa fa-info-circle"></i> <%= rt.remarks || rt.remark %></span>
                                 <% } %>
                                 <div style="margin-top:4px; font-size:0.85em;">
                                  <% if (areaName !== 'Payment Area') { %>
                                   <form action="/reception/assign" method="POST" style="display:inline-block; margin-right:6px;">
                                     <input type="hidden" name="testId" value="<%= t.id %>">
                                     <select name="area" required style="margin-right:6px;">
                                       <% areas.forEach(a => { %>
                                         <option value="<%= a %>" <%= a === areaName ? 'selected' : '' %>><%= a %></option>
                                       <% }) %>
                                     </select>
                                     <input type="text" name="specimen" placeholder="Specimen # (optional)" style="margin-right:6px;" <%= row.patientEncoded ? '' : 'disabled' %>>
                                     <button class="button btn-primary btn-small" <%= row.patientEncoded ? '' : 'disabled' %>>Assign</button>
                                   </form>
                                  <% } %>
                                   <!-- per-test View/Delete removed; use patient-level actions in Action column -->
                                 </div>
                               </li>
                             <% })
                           } else {
                             const singleLabel = (t.testType || 'Test').toString().replace(/-/g,' ').replace(/\b\w/g, function(ch){return ch.toUpperCase();}); %>
                             <li style="margin-bottom:4px;"><%= singleLabel %>
                               <% const singleRem = t.notes || t.remarks || ''; if (singleRem) { %>
                                 <span style="font-size:0.82em; color:#0284c7; background:#f0f9ff; border:1px solid #bae6fd; padding:2px 6px; border-radius:4px; margin-left:6px; font-weight:600;"><i class="fa fa-info-circle"></i> <%= singleRem %></span>
                               <% } %>
                               <div style="margin-top:4px; font-size:0.85em;">
                                 <% if (areaName !== 'Payment Area') { %>
                                 <form action="/reception/assign" method="POST" style="display:inline-block; margin-right:6px;">
                                   <input type="hidden" name="testId" value="<%= t.id %>">
                                   <select name="area" required style="margin-right:6px;">
                                     <% areas.forEach(a => { %>
                                       <option value="<%= a %>" <%= a === areaName ? 'selected' : '' %>><%= a %></option>
                                     <% }) %>
                                   </select>
                                   <input type="text" name="specimen" placeholder="Specimen # (optional)" style="margin-right:6px;" <%= row.patientEncoded ? '' : 'disabled' %>>
                                   <button class="button btn-primary btn-small" <%= row.patientEncoded ? '' : 'disabled' %>>Assign</button>
                                 </form>
                                 <% } %>
                                 <!-- per-test View/Delete removed; use patient-level actions in Action column -->
                               </div>
                             </li>
                           <% }
                         }
                       })
                     } else { %>
                       <li>No tests</li>
                     <% } %>
                </ul>
              </td>
              <td>
                <% if (areaName === 'Payment Area') { %>
                  <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                    <form action="/reception/complete" method="POST" class="complete-form" data-require-amount="<%= (typeof requirePaymentAmount === 'undefined' || requirePaymentAmount) ? '1' : '0' %>" style="display:flex; gap:8px; align-items:flex-end; margin:0;">
                      <input type="hidden" name="patientId" value="<%= row.patient ? row.patient.id : '' %>">
                      <input type="hidden" name="testIds" value="<%= (row.testIds || []).join(',') %>">
                      <input type="hidden" name="area" value="<%= areaName %>">
                      <input type="hidden" name="charged_to_philhealth" value="0">
                      <input type="hidden" name="charged_to_healthcard" value="0">
                      <div>
                        <label style="display:block; font-size:0.8em; margin-bottom:4px; font-weight:600; color:#64748b;">Clinical Lab Amount</label>
                        <input type="number" name="amount_clinical" class="payment-amount" step="0.01" min="0" placeholder="Clinical" style="width:130px;" value="<%= (row.clinicalTotal || 0).toFixed(2) %>">
                      </div>
                      <div>
                        <label style="display:block; font-size:0.8em; margin-bottom:4px; font-weight:600; color:#64748b;">X-ray Lab Amount</label>
                        <input type="number" name="amount_xray" class="payment-amount" step="0.01" min="0" placeholder="X-ray" style="width:130px;" value="<%= (row.xrayTotal || 0).toFixed(2) %>">
                      </div>
                      <div style="display:flex; flex-direction:column; gap:6px;">
                        <% const isAmountReq = (typeof requirePaymentAmount === 'undefined' || requirePaymentAmount); %>
                        <% const hasInitialAmount = !isAmountReq || (Number(row.clinicalTotal) > 0 || Number(row.xrayTotal) > 0); %>
                        <button type="submit" class="button btn-success btn-small payment-submit" title="Mark complete" onclick="return window.paymentSubmitFallback ? window.paymentSubmitFallback(this) : true" style="min-width:155px;<%= !hasInitialAmount ? ' opacity:0.45; cursor:not-allowed;' : '' %>" <%= !hasInitialAmount ? 'disabled' : '' %>>Mark Complete</button>
                        <% 
                          const pName = row.patient ? (row.patient.firstName + ' ' + (row.patient.middleName ? row.patient.middleName + ' ' : '') + row.patient.lastName).trim() : 'this patient';
                          const isPhilMember = Boolean(row.patient && (row.patient.philhealthConsent || row.patient.philhealthId || (row.patient.philhealth && String(row.patient.philhealth).toLowerCase() === 'yes')));
                          const pHasPhil = isPhilMember ? '1' : '0';
                          const pPhilId = (row.patient && row.patient.philhealthId) ? row.patient.philhealthId : '';

                          const isHealthCardMember = Boolean(row.patient && (row.patient.healthInsuranceConsent || row.patient.healthInsuranceProvider || row.patient.healthInsuranceId));
                          const pHasHealthCard = isHealthCardMember ? '1' : '0';
                          const pHealthCardProvider = (row.patient && row.patient.healthInsuranceProvider) ? row.patient.healthInsuranceProvider : '';
                          const pHealthCardId = (row.patient && row.patient.healthInsuranceId) ? row.patient.healthInsuranceId : '';
                        %>
                        <button type="button" class="button btn-small btn-philhealth" 
                          data-patient-name="<%= pName %>"
                          data-patient-philhealth="<%= pHasPhil %>"
                          data-philhealth-id="<%= pPhilId %>"
                          style="background:<%= isPhilMember ? '#0284c7' : '#94a3b8' %>; color:#fff; border:none; padding:6px 12px; font-size:0.82em; font-weight:600; border-radius:6px; min-width:155px;<%= !isPhilMember ? ' opacity:0.45; cursor:not-allowed;' : ' cursor:pointer;' %>" 
                          <%= !isPhilMember ? 'disabled' : '' %>
                          onclick="submitChargedToPhilhealth(this)" 
                          title="<%= isPhilMember ? 'Charge to PhilHealth (Verified Member)' : 'Disabled: Patient is not registered as a PhilHealth member' %>">
                          🩺 Charged to PhilHealth
                        </button>
                        <button type="button" class="button btn-small btn-healthcard" 
                          data-patient-name="<%= pName %>"
                          data-patient-healthcard="<%= pHasHealthCard %>"
                          data-healthcard-provider="<%= pHealthCardProvider %>"
                          data-healthcard-id="<%= pHealthCardId %>"
                          style="background:<%= isHealthCardMember ? '#6366f1' : '#94a3b8' %>; color:#fff; border:none; padding:6px 12px; font-size:0.82em; font-weight:600; border-radius:6px; min-width:155px;<%= !isHealthCardMember ? ' opacity:0.45; cursor:not-allowed;' : ' cursor:pointer;' %>" 
                          <%= !isHealthCardMember ? 'disabled' : '' %>
                          onclick="submitChargedToHealthcard(this)" 
                          title="<%= isHealthCardMember ? ('Charge to Health Card (' + pHealthCardProvider + ')') : 'Disabled: Patient is not registered with a Health Card' %>">
                          💳 Charged to Health Card
                        </button>
                      </div>
                    </form>
                    <form action="/reception/delete" method="POST" class="delete-form" style="margin:0;" onsubmit="return confirm('Delete these tests from the queue?');">
                      <input type="hidden" name="testId" value="<%= (row.testIds && row.testIds.length ? row.testIds[0] : '') %>">
                      <input type="hidden" name="area" value="<%= areaName %>">
                      <button type="submit" class="button btn-danger btn-small" title="Delete" style="min-width:155px;">Delete</button>
                    </form>
                  </div>
                <% } else { %>
                  <!-- For non-payment areas show Mark Complete, Stash (if Releasing), and Delete stacked -->
                  <div style="display:flex; flex-direction:column; gap:6px; align-items:flex-end;">
                    <form action="/reception/complete" method="POST" class="complete-form" style="margin:0;">
                      <input type="hidden" name="patientId" value="<%= row.patient ? row.patient.id : '' %>">
                      <input type="hidden" name="testIds" value="<%= (row.testIds || []).join(',') %>">
                      <input type="hidden" name="area" value="<%= areaName %>">
                      <button type="submit" class="button btn-success btn-small" title="Mark Complete" style="min-width:110px;">Mark Complete</button>
                    </form>
                    <% if (areaName === 'Releasing of Result') { %>
                      <form action="/reception/stash" method="POST" class="stash-form" style="margin:0;" data-confirm-title="Stash Patient Result" data-confirm-button="Yes, Stash Result" data-confirm="Stash results for this patient?\n\n• The patient will be moved to the Stashed Results section on Reception.\n• This queue count will decrease immediately.">
                        <input type="hidden" name="patientId" value="<%= row.patient ? row.patient.id : '' %>">
                        <input type="hidden" name="testIds" value="<%= (row.testIds || []).join(',') %>">
                        <button type="submit" class="button btn-small no-guard" data-no-guard="1" style="min-width:110px; background:#f59e0b; color:white; border:none; padding: 6px 12px; font-weight:700; border-radius:6px; cursor:pointer;" title="Stash result if patient unavailable">
                          <i class="fa fa-archive" style="margin-right:4px;"></i> Stash
                        </button>
                      </form>
                    <% } %>
                    <form action="/reception/delete" method="POST" class="delete-form" style="margin:0;" onsubmit="return confirm('Delete these tests from the queue?');">
                      <input type="hidden" name="testId" value="<%= (row.testIds && row.testIds.length ? row.testIds[0] : '') %>">
                      <input type="hidden" name="area" value="<%= areaName %>">
                      <button type="submit" class="button btn-danger btn-small" title="Delete" style="min-width:110px;">Delete</button>
                    </form>
                  </div>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div id="specimensPane" style="margin-top:12px; display:none;">
    <% if (!specimens || specimens.length === 0) { %>
      <p class="text-center">No specimens assigned for this area yet.</p>
    <% } else { %>
      <table style="width:100%; margin-top:12px;">
        <thead>
          <tr>
            <th>Test ID</th>
            <th>Specimen #</th>
            <th>Patient</th>
          </tr>
        </thead>
        <tbody>
          <% specimens.forEach(s => { %>
            <tr>
              <td><%= s.testId %></td>
              <td><%= s.specimen %></td>
              <td><%= s.patient ? s.patient.firstName + ' ' + s.patient.lastName : 'Unknown' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>

  <div style="margin-top:14px;">
    <a href="/reception" class="button btn-secondary">Back to Areas</a>
  </div>

  <script>
    (function(){
      const tabQueue = document.getElementById('tabQueue');
      const tabSpecimens = document.getElementById('tabSpecimens');
      const queuePane = document.getElementById('queuePane');
      const specimensPane = document.getElementById('specimensPane');
      if (tabQueue && queuePane) tabQueue.addEventListener('click', () => { queuePane.style.display='block'; if (specimensPane) specimensPane.style.display='none'; tabQueue.classList.add('btn-primary'); if (tabSpecimens) tabSpecimens.classList.remove('btn-primary'); });
      if (tabSpecimens && specimensPane) tabSpecimens.addEventListener('click', () => { if (queuePane) queuePane.style.display='none'; specimensPane.style.display='block'; tabSpecimens.classList.add('btn-primary'); if (tabQueue) tabQueue.classList.remove('btn-primary'); });
    })();

    // AJAX handlers for complete/delete to avoid navigation and keep on same area page
    (function(){
      console.debug('[DEBUG] reception area script init');
      try {
        document.addEventListener('DOMContentLoaded', () => {
          console.debug('[DEBUG] DOMContentLoaded, .complete-form count=', document.querySelectorAll('.complete-form').length);
        });
        // also log immediately in case script runs after DOM is ready
        console.debug('[DEBUG] immediate .complete-form count=', document.querySelectorAll('.complete-form').length);
      } catch (e) {
        console.warn('[DEBUG] failed to attach debug listeners', e);
      }
      function serializeForm(form) {
        const data = new URLSearchParams();
        for (const el of form.elements) {
          if (!el.name) continue;
          if ((el.type === 'checkbox' || el.type === 'radio') && !el.checked) continue;
          data.append(el.name, el.value);
        }
        return data;
      }

      // Fallback submit helper for Payment Area button clicks.
      // Validates that at least one lab amount (clinical or x-ray) is a positive number,
      // and triggers form submit only if validation passes.
      window.paymentSubmitFallback = function(btn) {
        try {
          const form = btn && btn.closest ? btn.closest('form') : null;
          if (!form) return true;
          const philInput = form.querySelector('input[name="charged_to_philhealth"]');
          if (philInput) philInput.value = '0';
          const cardInput = form.querySelector('input[name="charged_to_healthcard"]');
          if (cardInput) cardInput.value = '0';
          if (form.dataset && form.dataset.requireAmount === '0') return true;
          const amtInputs = Array.from(form.querySelectorAll('.payment-amount'));
          if (amtInputs.length) {
            let anyValid = false;
            for (const inp of amtInputs) {
              const raw = inp.value;
              const parsed = parseFloat(String(raw).replace(/[,\s]/g, ''));
              if (Number.isFinite(parsed) && parsed > 0) { anyValid = true; break; }
            }
            if (!anyValid) {
              alert('Please enter an amount for either Clinical Lab or X-ray Lab before marking complete.');
              return false;
            }
          }
          // Trigger form submission programmatically so the AJAX handler runs.
          if (typeof form.requestSubmit === 'function') form.requestSubmit(); else form.submit();
          return false;
        } catch (e) {
          console.error('paymentSubmitFallback error', e);
          return false;
        }
      };

      // Handler for Charged to PhilHealth button
      window.submitChargedToPhilhealth = function(btn) {
        try {
          const form = btn && btn.closest ? btn.closest('form') : null;
          if (!form) return;

          const patientName = (btn && btn.dataset && btn.dataset.patientName) ? btn.dataset.patientName : 'this patient';
          const isMember = btn && btn.dataset && btn.dataset.patientPhilhealth === '1';
          const philhealthId = (btn && btn.dataset && btn.dataset.philhealthId) ? btn.dataset.philhealthId : '';

          if (!isMember) {
            if (typeof window.showCustomAlert === 'function') {
              window.showCustomAlert(
                '<div style="font-size:0.93em; line-height:1.6; color:#334155;">' +
                  '<p style="margin:0 0 10px; font-weight:700; color:#dc2626;">Action Not Allowed</p>' +
                  '<p>Patient <strong>' + patientName + '</strong> is not registered as a PhilHealth member in the demographic records.</p>' +
                  '<p style="color:#64748b; font-size:0.88em; margin-bottom:0;">Please update the patient profile under Patients management first to enable PhilHealth billing.</p>' +
                '</div>',
                { title: 'Non-PhilHealth Member', btnText: 'Understood', type: 'danger' }
              );
            } else {
              alert('Patient ' + patientName + ' is not registered as a PhilHealth member.');
            }
            return;
          }

          const htmlMsg = '<div style="font-size:0.93em; line-height:1.6; color:#334155;">' +
                          '<p style="margin:0 0 10px; font-weight:600; color:#0f172a;">Are you sure you want to charge this patient to PhilHealth?</p>' +
                          '<div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:8px; padding:10px 14px; margin-bottom:12px;">' +
                            '<div><strong>Patient:</strong> ' + patientName + '</div>' +
                            '<div style="margin-top:4px;"><strong>PhilHealth Status:</strong> ' + 
                              '<span style="color:#059669; font-weight:700;">✓ Verified Member' + (philhealthId ? ' (ID: ' + philhealthId + ')' : '') + '</span>' +
                            '</div>' +
                          '</div>' +
                          '<div style="font-size:0.86em; color:#64748b; line-height:1.5;">' +
                            '• <strong>Amount Due:</strong> ₱0.00 (No on-site collection)<br>' +
                            '• <strong>Next Station:</strong> Advances to Extraction / Clinical Queue' +
                          '</div>' +
                        '</div>';

          const proceedCharge = function() {
            let philInput = form.querySelector('input[name="charged_to_philhealth"]');
            if (!philInput) {
              philInput = document.createElement('input');
              philInput.type = 'hidden';
              philInput.name = 'charged_to_philhealth';
              form.appendChild(philInput);
            }
            philInput.value = '1';
            let cardInput = form.querySelector('input[name="charged_to_healthcard"]');
            if (cardInput) cardInput.value = '0';
            form.dataset.requireAmount = '0';

            // Trigger submission
            if (typeof form.requestSubmit === 'function') {
              form.requestSubmit();
            } else {
              form.submit();
            }
          };

          if (typeof window.showCustomConfirm === 'function') {
            window.showCustomConfirm(htmlMsg, proceedCharge, {
              title: 'PhilHealth Billing Verification',
              btnText: 'Yes, Charge to PhilHealth',
              type: 'primary',
              icon: 'fa fa-file-medical',
              iconBg: '#e0f2fe',
              iconColor: '#0284c7'
            });
          } else {
            proceedCharge();
          }
        } catch (e) {
          console.error('submitChargedToPhilhealth error', e);
        }
      };

      // Handler for Charged to Health Card button
      window.submitChargedToHealthcard = function(btn) {
        try {
          const form = btn && btn.closest ? btn.closest('form') : null;
          if (!form) return;

          const patientName = (btn && btn.dataset && btn.dataset.patientName) ? btn.dataset.patientName : 'this patient';
          const isMember = btn && btn.dataset && btn.dataset.patientHealthcard === '1';
          const provider = (btn && btn.dataset && btn.dataset.healthcardProvider) ? btn.dataset.healthcardProvider : 'Health Card';
          const cardId = (btn && btn.dataset && btn.dataset.healthcardId) ? btn.dataset.healthcardId : '';

          if (!isMember) {
            if (typeof window.showCustomAlert === 'function') {
              window.showCustomAlert(
                '<div style="font-size:0.93em; line-height:1.6; color:#334155;">' +
                  '<p style="margin:0 0 10px; font-weight:700; color:#dc2626;">Action Not Allowed</p>' +
                  '<p>Patient <strong>' + patientName + '</strong> does not have an active Health Insurance / Health Card registered in their demographic records.</p>' +
                  '<p style="color:#64748b; font-size:0.88em; margin-bottom:0;">Please update the patient profile under Patients management first to add Health Card credentials.</p>' +
                '</div>',
                { title: 'No Health Card on File', btnText: 'Understood', type: 'danger' }
              );
            } else {
              alert('Patient ' + patientName + ' does not have a Health Card on file.');
            }
            return;
          }

          const htmlMsg = '<div style="font-size:0.93em; line-height:1.6; color:#334155;">' +
                          '<p style="margin:0 0 10px; font-weight:600; color:#0f172a;">Are you sure you want to charge this patient to their Health Card?</p>' +
                          '<div style="background:#ffffff; border:1px solid #e2e8f0; border-radius:8px; padding:10px 14px; margin-bottom:12px;">' +
                            '<div><strong>Patient:</strong> ' + patientName + '</div>' +
                            '<div style="margin-top:4px;"><strong>HMO / Provider:</strong> ' + 
                              '<span style="color:#4f46e5; font-weight:700;">' + provider + '</span>' +
                            '</div>' +
                            (cardId ? '<div style="margin-top:4px;"><strong>Card / Member #:</strong> <span style="font-weight:600; color:#0f172a;">' + cardId + '</span></div>' : '') +
                          '</div>' +
                          '<div style="font-size:0.86em; color:#64748b; line-height:1.5;">' +
                            '• <strong>Amount Due:</strong> ₱0.00 (Covered by HMO / Health Card)<br>' +
                            '• <strong>Next Station:</strong> Advances to Extraction / Clinical Queue' +
                          '</div>' +
                        '</div>';

          const proceedCharge = function() {
            let cardInput = form.querySelector('input[name="charged_to_healthcard"]');
            if (!cardInput) {
              cardInput = document.createElement('input');
              cardInput.type = 'hidden';
              cardInput.name = 'charged_to_healthcard';
              form.appendChild(cardInput);
            }
            cardInput.value = '1';
            let philInput = form.querySelector('input[name="charged_to_philhealth"]');
            if (philInput) philInput.value = '0';
            form.dataset.requireAmount = '0';

            // Trigger submission
            if (typeof form.requestSubmit === 'function') {
              form.requestSubmit();
            } else {
              form.submit();
            }
          };

          if (typeof window.showCustomConfirm === 'function') {
            window.showCustomConfirm(htmlMsg, proceedCharge, {
              title: 'Health Card Billing Verification',
              btnText: 'Yes, Charge to Health Card',
              type: 'primary',
              icon: 'fas fa-id-card-clip',
              iconBg: '#e0e7ff',
              iconColor: '#4f46e5'
            });
          } else {
            proceedCharge();
          }
        } catch (e) {
          console.error('submitChargedToHealthcard error', e);
        }
      };

      function updatePaymentFormButton(form) {
        if (!form) return;
        const btn = form.querySelector('.payment-submit');
        if (!btn) return;
        if (form.dataset && form.dataset.requireAmount === '0') {
          btn.disabled = false;
          btn.style.opacity = '1';
          btn.style.cursor = 'pointer';
          btn.style.pointerEvents = 'auto';
          btn.title = 'Mark complete';
          return;
        }
        const inputs = Array.from(form.querySelectorAll('.payment-amount'));
        if (!inputs.length) return;
        let anyValid = false;
        for (const input of inputs) {
          const raw = input.value;
          const amt = parseFloat(String(raw).replace(/[,\s]/g, ''));
          if (Number.isFinite(amt) && amt > 0) {
            anyValid = true;
            break;
          }
        }
        btn.disabled = !anyValid;
        if (!anyValid) {
          btn.style.opacity = '0.45';
          btn.style.cursor = 'not-allowed';
          btn.style.pointerEvents = 'none';
          btn.title = 'Enter Clinical Lab or X-ray Lab amount to complete';
        } else {
          btn.style.opacity = '1';
          btn.style.cursor = 'pointer';
          btn.style.pointerEvents = 'auto';
          btn.title = 'Mark complete';
        }
      }

      // Enable/disable Payment Area submit buttons based on amount inputs in the same form.
      function setupPaymentAmountValidation() {
        document.querySelectorAll('form').forEach(form => {
          const inputs = Array.from(form.querySelectorAll('.payment-amount'));
          if (!inputs.length) return;
          ['input', 'change', 'blur', 'keyup', 'paste'].forEach(ev => inputs.forEach(i => i.addEventListener(ev, () => updatePaymentFormButton(form))));
          updatePaymentFormButton(form);
        });
      }
      setupPaymentAmountValidation();

      // Delegated listener on document: guarantees updating even if elements were dynamically rendered
      ['input', 'change', 'keyup', 'paste'].forEach(evName => {
        document.addEventListener(evName, (e) => {
          if (e.target && e.target.classList && e.target.classList.contains('payment-amount')) {
            const form = e.target.closest('form');
            if (form) updatePaymentFormButton(form);
          }
        });
      });

      // handle complete (AJAX) — use URLSearchParams and mimic the working delete flow
      document.querySelectorAll('.complete-form').forEach(form => {
        // normal submit interception
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          console.debug('[DEBUG] complete-form submit triggered for form action=', form.action);
          const btn = form.querySelector('button[type="submit"]');

          // Strict Payment Area validation: require at least one positive amount if required
          const philInput = form.querySelector('input[name="charged_to_philhealth"]');
          const isChargedToPhilhealth = philInput && (philInput.value === '1' || philInput.value === 'true');
          const cardInput = form.querySelector('input[name="charged_to_healthcard"]');
          const isChargedToHealthCard = cardInput && (cardInput.value === '1' || cardInput.value === 'true');
          if (!isChargedToPhilhealth && !isChargedToHealthCard && (!form.dataset || form.dataset.requireAmount !== '0')) {
            const amtInputs = Array.from(form.querySelectorAll('.payment-amount'));
            if (amtInputs.length) {
              let anyValid = false;
              for (const input of amtInputs) {
                const val = parseFloat(String(input.value || '').replace(/[,\s]/g, ''));
                if (Number.isFinite(val) && val > 0) {
                  anyValid = true;
                  break;
                }
              }
              if (!anyValid) {
                alert('Please enter an amount for either Clinical Lab or X-ray Lab before marking complete.');
                if (btn) {
                  btn.disabled = true;
                  btn.style.opacity = '0.45';
                  btn.style.cursor = 'not-allowed';
                  btn.style.pointerEvents = 'none';
                }
                return;
              }
            }
          }

          if (btn) btn.disabled = true;

          // use URLSearchParams directly (fetch will set Content-Type correctly)
          let bodyParams = null;
          try { bodyParams = serializeForm(form); } catch (serr) { console.warn('serializeForm failed', serr); bodyParams = new URLSearchParams(); }
          console.debug('[DEBUG] body to send=', bodyParams.toString());

          let resp;
          try {
            resp = await fetch(form.action, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
              },
              body: bodyParams
            });
            console.debug('[DEBUG] fetch completed, status=', resp.status);
          } catch (err) {
            if (btn) btn.disabled = false;
            console.error('Network error completing test', err);
            alert('Network error marking complete');
            return;
          }

          if (btn) btn.disabled = false;
          let json = null;
          try { json = await resp.json(); } catch (e) { /* ignore parse errors */ }
          console.debug('[DEBUG] parsed json response=', json);
          if (!resp.ok) {
            const msg = (json && json.message) ? json.message : 'Error marking complete';
            alert(msg);
            return;
          }
          // remove the row from the table so next patient shows up
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            const main = document.querySelector('.main-content') || document.body;
            main.insertBefore(note, main.firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try { localStorage.setItem('reception:updated', String(Date.now())); } catch (e) { }
          }
        });

        // safety: prevent silent failures if browser validation/disabled state blocks click
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.addEventListener('click', (ev) => {
            // if button is disabled when clicked, stop native behavior to avoid confusion
            if (submitBtn.disabled) {
              ev.preventDefault();
              ev.stopImmediatePropagation();
            }
          });
        }
      });

      // handle delete
      document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!confirm('Delete this test from the queue?')) return;
          const btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          const resp = await fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
            body: serializeForm(form)
          }).catch(err => ({ ok: false, error: err }));
          btn.disabled = false;
          if (!resp || !resp.ok) {
            alert('Error deleting test');
            return;
          }
          const json = await resp.json().catch(() => null);
          const row = form.closest('tr');
          if (row) row.remove();
          if (json && json.message) {
            const note = document.createElement('div');
            note.className = 'alert alert-success active';
            note.textContent = json.message;
            document.querySelector('.main-content').insertBefore(note, document.querySelector('.main-content').firstChild);
            setTimeout(() => note.classList.remove('active'), 3000);
            try {
              // notify other tabs via localStorage so kiosk/assigned views refresh immediately
              localStorage.setItem('reception:updated', String(Date.now()));
            } catch (e) { }
          }
        });
      });
    })();
  </script>

</div>
