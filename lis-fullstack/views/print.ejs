<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title || 'Print' %></title>
  <style>
    /* Minimal print-safe layout */
    html,body{height:100%;margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;color:#111}
    .container{padding:18px 28px}
    @media print{
      .no-print{display:none}
    }
  </style>
</head>
<body>
  <div class="container">
    <%- body %>
  </div>
</body>
</html>