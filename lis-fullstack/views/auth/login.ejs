<div class="login-container">
    <div class="login-box">
        <h2>🔬 LIS</h2>
        <p class="login-subtitle">Laboratory Information System</p>

        <div class="alert alert-info active" style="margin-bottom: 25px;">
            <strong>Demo Credentials:</strong><br>Email: admin@lab.com<br>Password: password123
        </div>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter your email" value="admin@lab.com" required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Enter password" value="password123" required>
            </div>

            <button type="submit" class="button btn-primary" style="width: 100%; margin-bottom: 15px; padding: 14px;">
                Login to Dashboard
            </button>
        </form>

        <p style="text-align: center; color: var(--text-gray); font-size: 0.85em; margin: 0;">
            Professional Laboratory Information Management System
        </p>
    </div>
</div>