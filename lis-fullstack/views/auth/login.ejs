<div class="login-container">
    <div class="login-box">
        <div style="text-align:center; margin-bottom:12px;">
            <img src="/assets/gezyne-logo.png" alt="Gezyne Clinical Laboratory" style="width:120px; height:auto; object-fit:contain; border-radius:6px; background:white; padding:6px; box-shadow:0 3px 10px rgba(0,0,0,0.12);">
            <h2 style="margin-top:10px; color:var(--primary-black); font-weight:800; font-size:1.15rem;">Gezyne Clinical Laboratory</h2>
            <p style="margin:6px 0 0; color:var(--secondary-green-dark); font-weight:700; letter-spacing:0.6px;">Laboratory Information System (LIS)</p>
        </div>

        <form action="/login" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" placeholder="Enter your email" value="admin@lab.com" required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="Enter password" value="password123" required>
            </div>

            <button type="submit" class="button btn-primary" style="width: 100%; margin-bottom: 15px; padding: 14px;">
                Login to Dashboard
            </button>
        </form>

        <p style="text-align: center; color: var(--text-gray); font-size: 0.85em; margin: 8px 0 0;">
            Professional Laboratory Information Management System
        </p>
    </div>
</div>