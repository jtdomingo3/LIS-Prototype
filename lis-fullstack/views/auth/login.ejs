<style>
  /* Scoped Login Styling */
  .login-page-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 120px);
    padding: 20px 10px;
  }

  .login-card-container {
    display: flex;
    width: 100%;
    max-width: 1060px;
    background: #ffffff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.08), 0 4px 15px rgba(15, 23, 42, 0.03);
    border: 1px solid rgba(226, 232, 240, 0.8);
    transition: all 0.3s ease;
  }

  /* Left Side: Lab Information Showcase */
  .lab-info-panel {
    flex: 1.1;
    background: linear-gradient(135deg, #047857 0%, #064e3b 60%, #0f172a 100%);
    color: #ffffff;
    padding: 44px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .lab-info-panel::before {
    content: '';
    position: absolute;
    top: -50px;
    right: -50px;
    width: 250px;
    height: 250px;
    background: radial-gradient(circle, rgba(52, 211, 153, 0.15) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .lab-info-panel::after {
    content: '';
    position: absolute;
    bottom: -80px;
    left: -80px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.12) 0%, rgba(255,255,255,0) 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .lab-brand-header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    z-index: 1;
  }

  .lab-logo-img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 14px;
    background: #ffffff;
    padding: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
    border: 2px solid rgba(255, 255, 255, 0.2);
  }

  .lab-brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.25;
    letter-spacing: -0.2px;
  }

  .lab-category-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
    color: #a7f3d0;
    margin-top: 4px;
  }

  .lab-intro-text {
    font-size: 0.95rem;
    color: #d1fae5;
    line-height: 1.6;
    margin-bottom: 24px;
    z-index: 1;
  }

  /* Contact & Address List */
  .lab-details-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 24px;
    z-index: 1;
  }

  .lab-detail-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 0.88rem;
    color: #e2e8f0;
    line-height: 1.45;
  }

  .lab-detail-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #34d399;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .lab-detail-item a {
    color: #a7f3d0;
    text-decoration: none;
    transition: color 0.2s;
  }

  .lab-detail-item a:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Feature Badges */
  .lab-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 1;
  }

  .lab-pill {
    font-size: 0.76rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    color: #e2e8f0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .lab-pill.status-open {
    background: rgba(16, 185, 129, 0.2);
    color: #6ee7b7;
    border-color: rgba(52, 211, 153, 0.4);
  }

  /* Right Side: Login Panel */
  .login-form-panel {
    flex: 1;
    padding: 48px 44px;
    background: #ffffff;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .login-header-section {
    margin-bottom: 28px;
  }

  .login-main-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.3px;
    margin-bottom: 6px;
  }

  .login-sub-title {
    font-size: 0.88rem;
    color: #64748b;
    line-height: 1.5;
  }

  .input-group-custom {
    position: relative;
    margin-bottom: 20px;
  }

  .input-group-custom label {
    display: block;
    font-size: 0.82rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .input-field-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .input-field-wrapper i.field-icon {
    position: absolute;
    left: 14px;
    color: #94a3b8;
    font-size: 0.95rem;
    pointer-events: none;
    transition: color 0.2s;
  }

  .input-field-wrapper input {
    width: 100%;
    padding: 13px 14px 13px 42px;
    border-radius: 12px;
    border: 1.5px solid #e2e8f0;
    background: #f8fafc;
    font-size: 0.93rem;
    color: #0f172a;
    font-weight: 500;
    outline: none;
    transition: all 0.2s ease;
  }

  .input-field-wrapper input:focus {
    background: #ffffff;
    border-color: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
  }

  .input-field-wrapper input:focus + i.field-icon,
  .input-field-wrapper input:focus ~ i.field-icon {
    color: #10b981;
  }

  .toggle-pw-btn {
    position: absolute;
    right: 14px;
    background: transparent;
    border: none;
    color: #94a3b8;
    cursor: pointer;
    padding: 4px;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 0.2s;
  }

  .toggle-pw-btn:hover {
    color: #0f172a;
  }

  .login-submit-btn {
    width: 100%;
    padding: 14px 20px;
    background: linear-gradient(135deg, #059669 0%, #047857 100%);
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 4px 14px rgba(5, 150, 105, 0.3);
    transition: all 0.25s ease;
    margin-top: 8px;
    margin-bottom: 20px;
  }

  .login-submit-btn:hover {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(5, 150, 105, 0.4);
  }

  .login-submit-btn:active {
    transform: translateY(0);
  }

  .login-footer-info {
    text-align: center;
    padding-top: 16px;
    border-top: 1px solid #f1f5f9;
    font-size: 0.8rem;
    color: #94a3b8;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  /* Responsive Adjustments */
  @media (max-width: 860px) {
    .login-card-container {
      flex-direction: column;
      max-width: 480px;
    }

    .lab-info-panel {
      padding: 32px 28px;
    }

    .login-form-panel {
      padding: 36px 28px;
    }
  }
</style>

<div class="login-page-wrapper">
  <div class="login-card-container">

    <!-- Left Side: Gezyne Laboratory Details -->
    <div class="lab-info-panel">
      <div>
        <div class="lab-brand-header">
          <img src="<%= typeof inlineLogo !== 'undefined' && inlineLogo ? inlineLogo : '/assets/gezyne-logo.png' %>" alt="Gezyne Clinical Laboratory" class="lab-logo-img">
          <div>
            <h2 class="lab-brand-title">Gezyne Clinical Laboratory</h2>
            <div class="lab-category-badge">
              <i class="fas fa-microscope"></i> Medical & Clinical Laboratory
            </div>
          </div>
        </div>

        <p class="lab-intro-text">
          Dedicated to providing high-accuracy medical diagnostic testing, comprehensive clinical analysis, and real-time patient care management.
        </p>

        <!-- Lab Location & Contact Information from Facebook -->
        <div class="lab-details-list">
          <div class="lab-detail-item">
            <div class="lab-detail-icon"><i class="fas fa-map-marker-alt"></i></div>
            <div>
              <strong>Address:</strong><br>
              0330 VERGEL DE DIOS STREET, POBLACION, Plaridel, Philippines
            </div>
          </div>

          <div class="lab-detail-item">
            <div class="lab-detail-icon"><i class="fas fa-phone-alt"></i></div>
            <div>
              <strong>Contact Number:</strong><br>
              <a href="tel:09603900921">0960 390 0921</a>
            </div>
          </div>

          <div class="lab-detail-item">
            <div class="lab-detail-icon"><i class="fas fa-envelope"></i></div>
            <div>
              <strong>Email Address:</strong><br>
              <a href="mailto:laboratorygezyne@gmail.com">laboratorygezyne@gmail.com</a>
            </div>
          </div>

          <div class="lab-detail-item">
            <div class="lab-detail-icon"><i class="fab fa-facebook"></i></div>
            <div>
              <strong>Facebook Page:</strong><br>
              <a href="https://www.facebook.com/gezyneclinicallaboratory" target="_blank" rel="noopener noreferrer">
                @gezyneclinicallaboratory <i class="fas fa-external-link-alt" style="font-size: 0.75em; margin-left: 2px;"></i>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature Badges -->
      <div>
        <div class="lab-badges-row">
          <span class="lab-pill status-open"><i class="fas fa-clock"></i> Open Now</span>
          <span class="lab-pill"><i class="fas fa-chair"></i> Outdoor Seating</span>
          <span class="lab-pill"><i class="fas fa-tags"></i> Price Range: ₱₱</span>
          <span class="lab-pill"><i class="fas fa-network-wired"></i> LIS System v2.0.0</span>
        </div>
      </div>

    </div>

    <!-- Right Side: Login Panel -->
    <div class="login-form-panel">
      <div class="login-header-section">
        <h1 class="login-main-title">System Login</h1>
        <p class="login-sub-title">Enter your credentials to access the Laboratory Information System</p>
      </div>

      <form action="/login" method="POST">
        <div class="input-group-custom">
          <label for="emailInput">Email Address</label>
          <div class="input-field-wrapper">
            <i class="fas fa-envelope field-icon"></i>
            <input type="email" id="emailInput" name="email" placeholder="name@lab.com" required autofocus>
          </div>
        </div>

        <div class="input-group-custom">
          <label for="passwordInput">Password</label>
          <div class="input-field-wrapper">
            <i class="fas fa-lock field-icon"></i>
            <input type="password" id="passwordInput" name="password" placeholder="Enter your password" required>
            <button type="button" class="toggle-pw-btn" id="togglePasswordBtn" title="Show/Hide Password">
              <i class="fas fa-eye" id="togglePasswordIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="login-submit-btn">
          <i class="fas fa-sign-in-alt"></i> Login to Dashboard
        </button>
      </form>

      <div class="login-footer-info">
        <i class="fas fa-shield-alt" style="color:#10b981;"></i> Secure Laboratory Information Management System
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    // Password Visibility Toggle
    const toggleBtn = document.getElementById('togglePasswordBtn');
    const passwordInput = document.getElementById('passwordInput');
    const toggleIcon = document.getElementById('togglePasswordIcon');

    if (toggleBtn && passwordInput && toggleIcon) {
      toggleBtn.addEventListener('click', function() {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        
        if (type === 'text') {
          toggleIcon.classList.remove('fa-eye');
          toggleIcon.classList.add('fa-eye-slash');
        } else {
          toggleIcon.classList.remove('fa-eye-slash');
          toggleIcon.classList.add('fa-eye');
        }
      });
    }
  })();
</script>