<script>
// Global handler for Quick Knowledge Chips (direct inline execution & visual feedback)
window.handleQuickChipClick = function(btn) {
    if (!btn) return;
    if (window.__gezynebotSubmitting) {
        console.warn('[GezyneBot] Submission in progress, ignoring chip click');
        return;
    }
    const query = btn.getAttribute('data-query') || (btn.dataset && btn.dataset.query);
    if (!query) return;

    btn.classList.add('active-pressed');
    setTimeout(() => btn.classList.remove('active-pressed'), 350);

    const input = document.getElementById('main-chat-input');
    if (input) {
        input.value = query;
        input.style.height = 'auto';
        input.style.height = Math.min(input.scrollHeight, 140) + 'px';
        input.focus();
    }

    if (typeof window.executeMainChatSubmit === 'function') {
        window.executeMainChatSubmit(query);
    } else {
        const sendBtn = document.getElementById('btn-main-send');
        if (sendBtn) sendBtn.click();
    }
};

function initChatbot() {
    if (window.__chatbotInitialized) return;
    window.__chatbotInitialized = true;
    let activeConversationId = '<%= activeConversation ? activeConversation.id : "" %>';
    const topicsList = document.getElementById('topics-list');
    const topicSearch = document.getElementById('topic-search-input');
    const newTopicBtn = document.getElementById('btn-new-topic');
    const clearChatBtn = document.getElementById('btn-clear-chat');
    const messagesContainer = document.getElementById('main-messages-container');
    const chatInput = document.getElementById('main-chat-input');
    const sendBtn = document.getElementById('btn-main-send');
    const modelSelect = document.getElementById('ai-model-select');
    const activeTitle = document.getElementById('active-topic-title');
    const quickChips = document.querySelectorAll('.main-chip');
    const btnFetchFree = document.getElementById('btn-fetch-free-models');

    // Bot Toast Notification Helper
    function showBotToast(msg, type = 'success') {
        let toast = document.getElementById('gezyne-bot-toast');
        if (!toast) {
            toast = document.createElement('div');
            toast.id = 'gezyne-bot-toast';
            toast.style.cssText = 'position:fixed; bottom:24px; right:24px; z-index:9999; padding:12px 20px; border-radius:10px; font-weight:600; font-size:0.9em; box-shadow:0 10px 25px rgba(0,0,0,0.18); transition:all 0.3s ease; opacity:0; pointer-events:none; transform:translateY(10px); display:flex; align-items:center; gap:8px;';
            document.body.appendChild(toast);
        }
        toast.style.background = type === 'success' ? '#065f46' : (type === 'info' ? '#1e293b' : '#991b1b');
        toast.style.color = '#ffffff';
        toast.innerHTML = (type === 'success' ? '✅ ' : (type === 'info' ? 'ℹ️ ' : '⚠️ ')) + msg;
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0)';
        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(10px)';
        }, 4000);
    }

    // Dynamic Fetch of OpenRouter Free Models
    if (btnFetchFree) {
        btnFetchFree.addEventListener('click', async function() {
            const icon = document.getElementById('icon-fetch-free-models');
            const text = document.getElementById('text-fetch-free-models');
            const originalText = text ? text.textContent : 'Fetch Free';

            try {
                btnFetchFree.disabled = true;
                if (icon) icon.classList.add('fa-spin');
                if (text) text.textContent = 'Fetching...';

                const res = await fetch('/chatbot/api/models/refresh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await res.json();

                if (!data.success) {
                    throw new Error(data.error || 'Failed to fetch free models from OpenRouter');
                }

                const currentSelected = modelSelect ? modelSelect.value : '';
                const defaultGroup = document.getElementById('optgroup-default-models');
                const freeGroup = document.getElementById('optgroup-free-models');

                if (defaultGroup && Array.isArray(data.defaultModels)) {
                    defaultGroup.innerHTML = '';
                    data.defaultModels.forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.id;
                        opt.textContent = m.name;
                        defaultGroup.appendChild(opt);
                    });
                }

                if (freeGroup && Array.isArray(data.freeModels)) {
                    freeGroup.innerHTML = '';
                    freeGroup.style.display = data.freeModels.length > 0 ? '' : 'none';
                    data.freeModels.forEach(m => {
                        const opt = document.createElement('option');
                        opt.value = m.id;
                        opt.textContent = m.name;
                        freeGroup.appendChild(opt);
                    });
                }

                if (modelSelect && currentSelected) {
                    modelSelect.value = currentSelected;
                }

                showBotToast(`Loaded ${data.freeModels.length} free OpenRouter models!`, 'success');
            } catch (err) {
                console.error('[GezyneBot] Fetch free models failed:', err);
                showBotToast(err.message || 'Could not fetch free models from OpenRouter.', 'error');
            } finally {
                btnFetchFree.disabled = false;
                if (icon) icon.classList.remove('fa-spin');
                if (text) text.textContent = originalText;
            }
        });
    }

    let isSubmitting = false;

    // Bridge global submit caller
    window.executeMainChatSubmit = function(overrideText) {
        sendQuestion(overrideText);
    };

    // Format initial messages raw text to markdown safely
    try {
        document.querySelectorAll('.bubble-content[data-raw]').forEach(el => {
            const raw = el.getAttribute('data-raw');
            if (raw) {
                el.innerHTML = formatMarkdown(raw);
            }
        });
    } catch (e) {
        console.warn('[GezyneBot] Initial markdown render error:', e);
    }
    scrollToBottom();

    // Comprehensive markdown to clean HTML parser with KaTeX LaTeX math support
    function formatMarkdown(text) {
        if (!text) return '';

        const mathBlocks = [];

        // 1. Extract Display/Block Math: $$ ... $$ or \[ ... \]
        let raw = text.replace(/(\$\$|\\\[)([\s\S]+?)(\$\$|\\\])/g, (match, open, math) => {
            const placeholder = '%%%KATEX_BLOCK_' + mathBlocks.length + '%%%';
            let rendered = '';
            if (typeof katex !== 'undefined') {
                try {
                    rendered = '<div class="katex-display">' + katex.renderToString(math.trim(), { displayMode: true, throwOnError: false }) + '</div>';
                } catch (e) {
                    rendered = '<div class="katex-display katex-error">' + math + '</div>';
                }
            } else {
                rendered = '<div class="katex-display">' + math + '</div>';
            }
            mathBlocks.push({ placeholder, rendered });
            return '\n\n' + placeholder + '\n\n';
        });

        // 2. Extract Inline Math: \( ... \)
        raw = raw.replace(/\\\(([\s\S]+?)\\\)/g, (match, math) => {
            const placeholder = '%%%KATEX_INLINE_' + mathBlocks.length + '%%%';
            let rendered = '';
            if (typeof katex !== 'undefined') {
                try {
                    rendered = katex.renderToString(math.trim(), { displayMode: false, throwOnError: false });
                } catch (e) {
                    rendered = '<span class="katex-error">' + math + '</span>';
                }
            } else {
                rendered = '<span>' + math + '</span>';
            }
            mathBlocks.push({ placeholder, rendered });
            return placeholder;
        });

        // 3. Extract Inline Math: $ ... $ (excluding simple currency numbers like $50 or $100.50)
        raw = raw.replace(/(^|[^\$])\$([^\$\n\r]+?)\$(?!\$)/g, (match, prefix, math) => {
            if (/^\s*\d+([.,]\d+)?\s*$/.test(math)) return match;
            const placeholder = '%%%KATEX_INLINE_' + mathBlocks.length + '%%%';
            let rendered = '';
            if (typeof katex !== 'undefined') {
                try {
                    rendered = katex.renderToString(math.trim(), { displayMode: false, throwOnError: false });
                } catch (e) {
                    rendered = '<span class="katex-error">' + math + '</span>';
                }
            } else {
                rendered = '<span>' + math + '</span>';
            }
            mathBlocks.push({ placeholder, rendered });
            return prefix + placeholder;
        });

        let escaped = raw
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        // Inline code
        escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
        // Bold
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        // Italic
        escaped = escaped.replace(/\*(.*?)\*/g, '<em>$1</em>');

        const lines = escaped.split('\n');
        let html = '';
        let inList = null; // 'ul' or 'ol'
        let inTable = false;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const trimmed = line.trim();

            if (!trimmed) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                if (inTable) { html += '</tbody></table>'; inTable = false; }
                continue;
            }

            // Table row: | cell | cell |
            if (trimmed.startsWith('|') && trimmed.endsWith('|')) {
                const cells = trimmed.split('|').slice(1, -1).map(c => c.trim());
                // Skip separator row |---|---|
                if (cells.every(c => /^:?-+:?$/.test(c))) {
                    continue;
                }
                if (!inTable) {
                    if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                    inTable = true;
                    html += '<table class="bot-table"><thead><tr>' + cells.map(c => '<th>' + c + '</th>').join('') + '</tr></thead><tbody>';
                } else {
                    html += '<tr>' + cells.map(c => '<td>' + c + '</td>').join('') + '</tr>';
                }
                continue;
            } else if (inTable) {
                html += '</tbody></table>';
                inTable = false;
            }

            // Headings
            if (trimmed.startsWith('#### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h5>' + trimmed.substring(5) + '</h5>';
                continue;
            }
            if (trimmed.startsWith('### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h4>' + trimmed.substring(4) + '</h4>';
                continue;
            }
            if (trimmed.startsWith('## ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(3) + '</h3>';
                continue;
            }
            if (trimmed.startsWith('# ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(2) + '</h3>';
                continue;
            }

            // Blockquote
            if (trimmed.startsWith('> ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<blockquote>' + trimmed.substring(2) + '</blockquote>';
                continue;
            }

            // Horizontal rule
            if (/^(\-{3,}|\*{3,}|_{3,})$/.test(trimmed)) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<hr>';
                continue;
            }

            // Unordered list item
            if (/^[-*+]\s+/.test(trimmed)) {
                if (inList !== 'ul') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ul>';
                    inList = 'ul';
                }
                html += '<li>' + trimmed.replace(/^[-*+]\s+/, '') + '</li>';
                continue;
            }

            // Ordered list item
            if (/^\d+\.\s+/.test(trimmed)) {
                if (inList !== 'ol') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ol>';
                    inList = 'ol';
                }
                html += '<li>' + trimmed.replace(/^\d+\.\s+/, '') + '</li>';
                continue;
            }

            // Regular paragraph
            if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
            html += '<p>' + trimmed + '</p>';
        }

        if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
        if (inTable) html += '</tbody></table>';

        // Re-inject rendered LaTeX math
        mathBlocks.forEach(item => {
            html = html.split(item.placeholder).join(item.rendered);
        });

        return html;
    }

    function scrollToBottom() {
        if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    }

    // Auto-growing textarea & Enter key
    chatInput.addEventListener('input', () => {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px';
    });

    chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendQuestion();
        }
    });

    sendBtn.addEventListener('click', sendQuestion);

    // New Topic Button
    newTopicBtn.addEventListener('click', async () => {
        try {
            const res = await fetch('/chatbot/api/conversations', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: 'New Discussion',
                    model: modelSelect ? modelSelect.value : undefined
                })
            });
            const data = await res.json();
            if (data && data.success && data.conversation) {
                activeConversationId = data.conversation.id;
                localStorage.setItem('gezynebot_active_conv', activeConversationId);
                window.location.href = `/chatbot?conversationId=${encodeURIComponent(activeConversationId)}`;
            }
        } catch (e) {
            alert('Failed to start new topic: ' + e.message);
        }
    });

    // Clear Chat Button
    clearChatBtn.addEventListener('click', () => {
        messagesContainer.innerHTML = `
            <div style="text-align:center; padding:40px 20px; color:#94a3b8;">
                <p>View cleared for this session.</p>
            </div>
        `;
    });

    // Topic Selection
    document.querySelectorAll('.topic-item').forEach(item => {
        item.addEventListener('click', (e) => {
            if (e.target.closest('.btn-delete-topic')) return;
            const id = item.dataset.id;
            if (id) {
                window.location.href = `/chatbot?conversationId=${encodeURIComponent(id)}`;
            }
        });
    });

    // Delete Topic
    document.querySelectorAll('.btn-delete-topic').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            const doDelete = async () => {
                try {
                    const res = await fetch(`/chatbot/api/conversations/${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data && data.success) {
                        const item = document.querySelector(`.topic-item[data-id="${id}"]`);
                        if (item) item.remove();
                        if (activeConversationId === id) {
                            window.location.href = '/chatbot';
                        }
                    }
                } catch (err) {
                    alert('Could not delete conversation: ' + err.message);
                }
            };

            if (typeof window.showCustomConfirm === 'function') {
                window.showCustomConfirm('Are you sure you want to delete this conversation?', doDelete, {
                    title: 'Delete Conversation',
                    btnText: 'Yes, Delete'
                });
            } else if (confirm('Are you sure you want to delete this conversation?')) {
                doDelete();
            }
        });
    });

    // Topic Filter
    if (topicSearch) {
        topicSearch.addEventListener('input', () => {
            const query = (topicSearch.value || '').toLowerCase().trim();
            document.querySelectorAll('.topic-item').forEach(item => {
                const title = (item.dataset.title || '').toLowerCase();
                if (!query || title.includes(query)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        });
    }

    // Refresh RAG Status
    async function refreshRagStatus(showToast = false) {
        try {
            const res = await fetch('/chatbot/api/rag-status');
            const data = await res.json();
            const badge = document.getElementById('rag-status-badge');
            const text = document.getElementById('rag-status-text');
            const dot = badge ? badge.querySelector('.dot') : null;

            if (data && data.online) {
                if (badge) {
                    badge.className = 'status-indicator-badge rag-online';
                    badge.title = `Python RAG Microservice (ChromaDB Vector Store) is active (${data.totalChunks || 27} knowledge chunks loaded). Click to re-check.`;
                }
                if (text) text.textContent = `RAG: Online (${data.totalChunks || 27} chunks)`;
                if (dot) dot.className = 'dot dot-rag-online';
                if (showToast) {
                    if (typeof showNotification === 'function') {
                        showNotification(`RAG Vector Engine is Online! (${data.totalChunks || 27} chunks loaded)`, 'success');
                    } else {
                        alert(`RAG Vector Engine is Online!\n${data.totalChunks || 27} knowledge chunks indexed in ChromaDB.`);
                    }
                }
            } else {
                if (badge) {
                    badge.className = 'status-indicator-badge rag-offline';
                    badge.title = 'RAG Microservice is offline. GezyneBot will use static manual fallback. Click to re-check.';
                }
                if (text) text.textContent = 'RAG: Offline (Fallback)';
                if (dot) dot.className = 'dot dot-rag-offline';
                if (showToast) {
                    if (typeof showNotification === 'function') {
                        showNotification('RAG Microservice is currently offline. Using static manual fallback.', 'warning');
                    } else {
                        alert('RAG Microservice is currently offline.\nGezyneBot will use static manual fallback.');
                    }
                }
            }
        } catch (_) {}
    }
    window.refreshRagStatus = refreshRagStatus;

    // Periodically poll RAG status every 10 seconds
    setInterval(refreshRagStatus, 10000);

    // Web Search Toggle Handling (Default: OFF)
    const webSearchCheckbox = document.getElementById('toggle-web-search');
    const webSearchContainer = document.querySelector('.web-search-toggle-container');
    if (webSearchCheckbox) {
        webSearchCheckbox.checked = false;
        webSearchCheckbox.addEventListener('change', () => {
            if (webSearchContainer) {
                if (webSearchCheckbox.checked) webSearchContainer.classList.add('active');
                else webSearchContainer.classList.remove('active');
            }
        });
    }

    // Append Message to Workspace
    function appendMainMessage(role, text, metadata = {}) {
        const welcome = document.getElementById('main-welcome');
        if (welcome) welcome.remove();

        const msgDiv = document.createElement('div');
        msgDiv.className = `main-msg main-msg-${role}`;

        const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        const nameStr = role === 'user' ? '<%= sessionUser ? sessionUser.name : "You" %>' : 'GezyneBot';
        const ragPill = (role === 'bot' && metadata && metadata.ragUsed)
            ? `<span class="badge-rag-pill" title="Augmented with ${metadata.ragChunks || 4} chunks from ChromaDB Vector Store"><i class="fa fa-database"></i> RAG Verified</span>`
            : '';
        const webPill = (role === 'bot' && metadata && metadata.webSearchUsed)
            ? `<span class="badge-web-pill" title="Augmented with live web search citations"><i class="fa fa-globe"></i> Web Cited</span>`
            : '';

        let sourcesHtml = '';
        if (role === 'bot' && metadata && Array.isArray(metadata.webSources) && metadata.webSources.length > 0) {
            sourcesHtml = '<div style="margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:0.80em; color:#64748b;"><strong style="color:#475569;">Web Sources:</strong><br>';
            metadata.webSources.forEach(s => {
                const title = (s.title || 'Web Citation').slice(0, 45);
                sourcesHtml += `<a href="${s.url}" target="_blank" rel="noopener noreferrer" class="web-source-pill" title="${(s.snippet || s.title || '').replace(/"/g, '&quot;')}"><i class="fa fa-external-link-alt"></i> ${title}${s.title && s.title.length > 45 ? '...' : ''}</a>`;
            });
            sourcesHtml += '</div>';
        }

        msgDiv.innerHTML = `
            <div class="main-bubble">
                <div class="bubble-header">
                    <strong>${nameStr}</strong>
                    ${ragPill}
                    ${webPill}
                    <span class="bubble-time">${timeStr}</span>
                </div>
                <div class="bubble-content">
                    ${role === 'bot' ? formatMarkdown(text) : `<p>${text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`}
                    ${sourcesHtml}
                </div>
            </div>
        `;

        messagesContainer.appendChild(msgDiv);
        scrollToBottom();
        return msgDiv;
    }

    // Send Question (supports direct string or textarea input)
    async function sendQuestion(overrideText) {
        const question = (overrideText || (chatInput ? chatInput.value : '') || '').trim();
        if (!question) return;

        if (isSubmitting || window.__gezynebotSubmitting) {
            console.warn('[GezyneBot] Chat submission already in progress, ignoring duplicate trigger');
            return;
        }

        isSubmitting = true;
        window.__gezynebotSubmitting = true;
        if (sendBtn) sendBtn.disabled = true;
        if (chatInput) {
            chatInput.value = '';
            chatInput.style.height = 'auto';
        }

        // Add user message
        appendMainMessage('user', question);

        // Add typing indicator
        const typingDiv = document.createElement('div');
        typingDiv.className = 'main-msg main-msg-bot';
        typingDiv.innerHTML = `
            <div class="main-bubble" style="background:#ffffff; border:1px solid #e2e8f0; padding:10px 16px;">
                <span style="color:#10b981; font-weight:600; font-size:0.9em;">Thinking...</span>
            </div>
        `;
        messagesContainer.appendChild(typingDiv);
        scrollToBottom();

        const enableWebSearch = webSearchCheckbox ? !!webSearchCheckbox.checked : false;

        try {
            const res = await fetch('/chatbot/api/query', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    question,
                    conversationId: activeConversationId || null,
                    model: modelSelect ? modelSelect.value : undefined,
                    webSearch: enableWebSearch
                })
            });

            const data = await res.json();
            typingDiv.remove();

            if (data && data.success) {
                appendMainMessage('bot', data.answer, {
                    ragUsed: data.ragUsed,
                    ragChunks: data.ragChunks,
                    webSearchUsed: data.webSearchUsed,
                    webSources: data.webSources
                });
                if (data.conversationId) {
                    activeConversationId = data.conversationId;
                    localStorage.setItem('gezynebot_active_conv', activeConversationId);
                    // Update active title if was new
                    if (activeTitle && activeTitle.textContent.includes('New Discussion')) {
                        activeTitle.textContent = question.slice(0, 36) + (question.length > 36 ? '...' : '');
                    }
                }
            } else {
                appendMainMessage('bot', data.answer || data.error || 'Sorry, I encountered an error communicating with the AI service.');
            }
        } catch (err) {
            typingDiv.remove();
            appendMainMessage('bot', 'Network error: could not connect to the server.');
        } finally {
            isSubmitting = false;
            window.__gezynebotSubmitting = false;
            if (sendBtn) sendBtn.disabled = false;
            if (chatInput) chatInput.focus();
        }
    }
} // end initChatbot

// Run initialization reliably across all environments (Browser, Electron, Standalone)
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatbot);
} else {
    initChatbot();
}
</script>
