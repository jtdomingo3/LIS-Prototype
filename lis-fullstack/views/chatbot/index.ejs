<div class="chatbot-page-container">
    <!-- Left Sidebar: Saved Conversations / Topics -->
    <aside class="chatbot-sidebar card">
        <div class="chatbot-sidebar-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <span style="font-size:1.4em;">🤖</span>
                <h3 style="margin:0; font-size:1.15em; font-weight:700; color:var(--primary-black);">GezyneBot Topics</h3>
            </div>
            <button type="button" id="btn-new-topic" class="button btn-primary btn-small" style="margin-top:14px; width:100%; display:flex; align-items:center; justify-content:center; gap:8px;">
                <i class="fa fa-plus"></i> New Topic
            </button>
        </div>

        <div class="chatbot-search-wrapper">
            <input type="text" id="topic-search-input" class="chatbot-search" placeholder="Search conversations..." aria-label="Search conversations">
        </div>

        <div class="chatbot-topics-list" id="topics-list">
            <% if (!conversations || conversations.length === 0) { %>
                <div class="empty-topics" id="empty-topics-msg">
                    <p style="color:#94a3b8; font-size:0.9em; text-align:center; padding:30px 10px;">No saved topics yet.<br>Click <strong>New Topic</strong> to start a discussion.</p>
                </div>
            <% } else { %>
                <% conversations.forEach(conv => { %>
                    <div class="topic-item <%= (activeConversation && activeConversation.id === conv.id) ? 'active' : '' %>" data-id="<%= conv.id %>" data-title="<%= conv.title %>">
                        <div class="topic-info">
                            <span class="topic-title"><%= conv.title || 'Untitled Conversation' %></span>
                            <span class="topic-date"><%= new Date(conv.updated_at || conv.created_at).toLocaleDateString() %></span>
                        </div>
                        <button type="button" class="btn-delete-topic" title="Delete conversation" data-id="<%= conv.id %>">
                            <i class="fa fa-trash-alt"></i>
                        </button>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </aside>

    <!-- Main Chat Workspace -->
    <main class="chatbot-main card">
        <div class="chatbot-main-header">
            <div class="header-details">
                <h2 id="active-topic-title" style="margin:0; font-size:1.35em; font-weight:700; color:var(--primary-black);">
                    <%= activeConversation ? activeConversation.title : 'New Discussion with GezyneBot' %>
                </h2>
                <div style="display:flex; align-items:center; gap:10px; margin-top:4px; flex-wrap:wrap;">
                    <span class="status-indicator-badge">
                        <span class="dot"></span> Online Assistant
                    </span>
                    <span id="rag-status-badge" class="status-indicator-badge <%= (typeof ragStatus !== 'undefined' && ragStatus && ragStatus.online) ? 'rag-online' : 'rag-offline' %>" title="<%= (typeof ragStatus !== 'undefined' && ragStatus && ragStatus.online) ? 'Python RAG Microservice (ChromaDB Vector Store) is active (' + (ragStatus.totalChunks || 0) + ' chunks indexed)' : 'RAG Microservice is offline. GezyneBot is currently using static manual fallback.' %>" onclick="refreshRagStatus(true)" style="cursor:pointer;">
                        <span class="dot <%= (typeof ragStatus !== 'undefined' && ragStatus && ragStatus.online) ? 'dot-rag-online' : 'dot-rag-offline' %>"></span>
                        <span id="rag-status-text"><%= (typeof ragStatus !== 'undefined' && ragStatus && ragStatus.online) ? 'RAG: Online (' + (ragStatus.totalChunks || 27) + ' chunks)' : 'RAG: Offline (Fallback)' %></span>
                    </span>
                    <span style="font-size:0.82em; color:#64748b;">LIS Operational Workflows & Clinical Guidance</span>
                </div>
            </div>
            
            <div class="header-controls">
                <div class="model-select-wrapper" style="display:flex; align-items:center; gap:6px;">
                    <label for="ai-model-select" style="font-size:0.82em; font-weight:600; color:#475569;">Model:</label>
                    <select id="ai-model-select" class="form-select" style="padding:6px 10px; font-size:0.86em; border-radius:8px; border:1px solid #cbd5e1; max-width:280px;" title="Select AI Model">
                        <optgroup label="Default Models" id="optgroup-default-models">
                            <% (typeof defaultModels !== 'undefined' && defaultModels ? defaultModels : availableModels || []).forEach(m => { %>
                                <option value="<%= m.id %>" <%= (activeConversation && activeConversation.last_model === m.id) ? 'selected' : (m.id === defaultModel ? 'selected' : '') %>><%= m.name %></option>
                            <% }); %>
                        </optgroup>
                        <% if (typeof freeModels !== 'undefined' && Array.isArray(freeModels) && freeModels.length > 0) { %>
                            <optgroup label="Free Models (OpenRouter)" id="optgroup-free-models">
                                <% freeModels.forEach(m => { %>
                                    <option value="<%= m.id %>" <%= (activeConversation && activeConversation.last_model === m.id) ? 'selected' : '' %>><%= m.name %></option>
                                <% }); %>
                            </optgroup>
                        <% } else { %>
                            <optgroup label="Free Models (OpenRouter)" id="optgroup-free-models" style="display:none;"></optgroup>
                        <% } %>
                    </select>
                    <button type="button" id="btn-fetch-free-models" class="button btn-secondary btn-small" title="Fetch latest free models from OpenRouter" style="display:inline-flex; align-items:center; gap:5px; font-size:0.82em; padding:6px 10px; white-space:nowrap; border-radius:8px;">
                        <i class="fas fa-sync-alt" id="icon-fetch-free-models"></i>
                        <span id="text-fetch-free-models">Fetch Free</span>
                    </button>
                </div>
                <!-- Live Web Search Toggle (Default: OFF) -->
                <div class="web-search-toggle-container" title="Enable live internet search snippets (DuckDuckGo/Google). Off by default to focus on internal LIS procedures and preserve token limits.">
                    <label class="switch-toggle" for="toggle-web-search">
                        <input type="checkbox" id="toggle-web-search">
                        <span class="switch-slider round"></span>
                    </label>
                    <label for="toggle-web-search" class="switch-text">
                        <i class="fa fa-globe"></i>
                        <span>Web Search</span>
                    </label>
                </div>
                <button type="button" id="btn-clear-chat" class="button btn-secondary btn-small" title="Clear current message view">Clear View</button>
            </div>
        </div>

        <!-- Quick Knowledge Filter Chips (Top 6 Operational & Medical Queries) -->
        <div class="main-chips-bar">
            <span style="font-size:0.8em; font-weight:600; color:#64748b; margin-right:4px;">Quick Queries:</span>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="How do I use the Equipment &amp; QC module, track calibrations, record Levey-Jennings QC runs, and evaluate Westgard rules in Gezyne LIS?">⚙️ Equipment &amp; QC Guide</button>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="How does the NEQAS EQA module work with East Avenue Medical Center (EAMC) Drug Testing PT surveys, and how is the SDI calculated?">🏛️ NEQAS &amp; EAMC Surveys</button>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="How do I track reagent lots, open-vial stability, and stock deductions in the Inventory Management module?">📦 Reagent Inventory</button>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="What is the standard order of draw for phlebotomy blood collection tubes according to CLSI guidelines?">🧪 Tube Order of Draw</button>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="What are the patient preparation and fasting requirements for Fasting Blood Sugar (FBS) and Lipid Profile?">🩸 Fasting Guidelines</button>
            <button type="button" class="main-chip" onclick="handleQuickChipClick(this)" data-query="What are the critical/panic laboratory values for Glucose, Potassium, Hemoglobin, and Platelets, and what is the reporting protocol?">⚠️ Panic Values Protocol</button>
        </div>

        <!-- Messages Workspace -->
        <div class="chatbot-main-messages" id="main-messages-container">
            <% if (!initialMessages || initialMessages.length === 0) { %>
                <div class="main-welcome-card" id="main-welcome">
                    <div class="welcome-avatar">🤖</div>
                    <h3>Welcome to GezyneBot AI</h3>
                    <p>I am your specialized AI Assistant for Gezyne Clinical Laboratory (LIS v2.6.2). I can assist you with software operations, quality assurance, and clinical diagnostic inquiries:</p>
                    <div class="welcome-features-grid">
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I use the Clinical Consultation module, record SOAP notes, auto-calculate DOH BMI, and print the patient medical chart in Gezyne LIS?">
                            <div class="feature-icon">🩺</div>
                            <div class="feature-title">Clinical Consultation</div>
                            <div class="feature-desc">SOAP outpatient visits, PhilPEN smoking/alcohol assessment, DOH BMI classification, Rx prescribing, and medical charts.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I use the HR &amp; Payroll module to manage employees, record DTR attendance, apply for leaves, calculate SSS/PhilHealth/Pag-IBIG/tax, and generate payslips?">
                            <div class="feature-icon">👥</div>
                            <div class="feature-title">HR &amp; Payroll</div>
                            <div class="feature-desc">Employee directory, DTR attendance, Philippine statutory benefits (SSS, PhilHealth, Pag-IBIG), withholding tax, semi-monthly payroll, and printable payslips/COE.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I use the Costing &amp; P&amp;L module for cost-per-test modeling, tracking laboratory operating expenses, and analyzing revenue and profit margins?">
                            <div class="feature-icon">💰</div>
                            <div class="feature-title">Costing &amp; P&amp;L</div>
                            <div class="feature-desc">Cost-per-test unit economics, reagent mapping, gross margin analysis, laboratory operating expenses, and monthly P&amp;L income statements.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I use the LIS system for patient reception queue, multi-station routing, kiosk setup, test worksheets, and generating PDF reports?">
                            <div class="feature-icon">🏥</div>
                            <div class="feature-title">LIS Operations</div>
                            <div class="feature-desc">Queue management, multi-station routing, kiosk setup, test worksheets, analyzer direct import, and PDF reports.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I use the Equipment &amp; QC module, track calibrations, record Levey-Jennings QC runs, and evaluate Westgard rules in Gezyne LIS?">
                            <div class="feature-icon">⚙️</div>
                            <div class="feature-title">Equipment &amp; QC Guide</div>
                            <div class="feature-desc">Instrument calibrations, Levey-Jennings charts, Westgard multi-rules, and calibration/PM countdown tracking.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How does the NEQAS EQA module work with East Avenue Medical Center (EAMC) Drug Testing PT surveys, and how is the SDI calculated?">
                            <div class="feature-icon">🏛️</div>
                            <div class="feature-title">NEQAS &amp; EAMC Surveys</div>
                            <div class="feature-desc">DOH proficiency testing, EAMC Drug Testing PT surveys, SDI/Z-Score evaluation, and corrective action forms.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="How do I track reagent lots, open-vial stability, and stock deductions in the Inventory Management module?">
                            <div class="feature-icon">📦</div>
                            <div class="feature-title">Reagent Inventory</div>
                            <div class="feature-desc">Lot/batch tracking, open-vial stability, per-test automated deductions, and department low-stock alerts.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="What is the standard order of draw for phlebotomy blood collection tubes according to CLSI guidelines?">
                            <div class="feature-icon">🧪</div>
                            <div class="feature-title">Tube Order of Draw</div>
                            <div class="feature-desc">CLSI phlebotomy sequence, tube additives, color codes, mixing requirements, and sample collection criteria.</div>
                        </div>
                        <div class="feature-box feature-box-clickable" onclick="handleQuickChipClick(this)" data-query="What are the critical/panic laboratory values for Glucose, Potassium, Hemoglobin, and Platelets, and what is the reporting protocol?">
                            <div class="feature-icon">🚨</div>
                            <div class="feature-title">Panic Values &amp; Fasting</div>
                            <div class="feature-desc">Critical value thresholds, physician notification protocol, patient fasting guidelines, and normal reference ranges.</div>
                        </div>
                    </div>
                    <p style="font-size:0.85em; color:#94a3b8; margin-top:20px;">👆 Click any tile above or use the quick query chips to start a conversation.</p>
                </div>
            <% } else { %>
                <% initialMessages.forEach(msg => { %>
                    <div class="main-msg main-msg-<%= msg.role === 'user' ? 'user' : 'bot' %>">
                        <div class="main-bubble">
                            <div class="bubble-header">
                                <strong><%= msg.role === 'user' ? (sessionUser ? sessionUser.name : 'You') : 'GezyneBot' %></strong>
                                <span class="bubble-time"><%= new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                            </div>
                            <div class="bubble-content" data-raw="<%= msg.content %>"></div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>

        <!-- Input Area -->
        <div class="chatbot-main-composer">
            <textarea id="main-chat-input" rows="2" placeholder="Ask GezyneBot about LIS procedures or medical lab questions... (Press Enter to send, Shift+Enter for new line)"></textarea>
            <button type="button" id="btn-main-send" class="button btn-primary main-send-btn">
                <span>Send</span>
                <i class="fa fa-paper-plane" style="margin-left:6px;"></i>
            </button>
        </div>
    </main>
</div>

<style>
.chatbot-page-container {
    display: flex;
    gap: 20px;
    height: calc(100vh - 125px);
    height: calc(100dvh - 125px);
    overflow: hidden;
}

/* Sidebar */
.chatbot-sidebar {
    width: 320px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    padding: 18px;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--border-gray);
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    overflow: hidden;
}

.chatbot-sidebar-header {
    margin-bottom: 14px;
}

.chatbot-search-wrapper {
    margin-bottom: 12px;
}

.chatbot-search {
    width: 100%;
    padding: 8px 14px;
    font-size: 0.88em;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    outline: none;
    background: #f8fafc;
    transition: all 0.2s;
}

.chatbot-search:focus {
    background: #ffffff;
    border-color: var(--secondary-green);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
}

.chatbot-topics-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-right: 4px;
}

.topic-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.topic-item:hover {
    background: #f1f5f9;
    border-color: #cbd5e1;
    transform: translateX(2px);
}

.topic-item.active {
    background: #ecfdf5;
    border-color: #a7f3d0;
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.12);
}

.topic-info {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    gap: 2px;
}

.topic-title {
    font-size: 0.9em;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.topic-item.active .topic-title {
    color: #065f46;
}

.topic-date {
    font-size: 0.75em;
    color: #94a3b8;
}

.btn-delete-topic {
    background: transparent;
    border: none;
    color: #94a3b8;
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0;
    transition: all 0.2s;
}

.topic-item:hover .btn-delete-topic {
    opacity: 1;
}

.btn-delete-topic:hover {
    color: #ef4444;
    background: #fee2e2;
}

/* Main Workspace */
.chatbot-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0;
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--border-gray);
    box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    overflow: hidden;
}

.chatbot-main-header {
    padding: 16px 24px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #ffffff;
}

.status-indicator-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #ecfdf5;
    color: #065f46;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.78em;
    font-weight: 600;
    border: 1px solid #a7f3d0;
}

.status-indicator-badge .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
}

.status-indicator-badge.rag-online {
    background: #eff6ff;
    color: #1e40af;
    border-color: #93c5fd;
    transition: all 0.2s ease;
}

.status-indicator-badge.rag-online .dot {
    background: #2563eb;
    box-shadow: 0 0 6px rgba(37, 99, 235, 0.6);
}

.status-indicator-badge.rag-offline {
    background: #fffbeb;
    color: #92400e;
    border-color: #fde68a;
    transition: all 0.2s ease;
}

.status-indicator-badge.rag-offline .dot {
    background: #f59e0b;
}

.badge-rag-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72em;
    padding: 2px 7px;
    border-radius: 12px;
    background: #dbeafe;
    color: #1e40af;
    font-weight: 600;
    margin-left: 6px;
    border: 1px solid #bfdbfe;
    vertical-align: middle;
}

.badge-web-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.72em;
    padding: 2px 7px;
    border-radius: 12px;
    background: #ecfdf5;
    color: #065f46;
    font-weight: 600;
    margin-left: 6px;
    border: 1px solid #a7f3d0;
    vertical-align: middle;
}

.web-source-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.74em;
    padding: 3px 8px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    color: #2563eb;
    text-decoration: none;
    margin-top: 6px;
    margin-right: 6px;
    transition: all 0.15s ease;
}
.web-source-pill:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    text-decoration: underline;
}

.web-search-toggle-container {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 10px;
    background: #f8fafc;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    user-select: none;
    cursor: pointer;
    transition: all 0.2s ease;
}

.web-search-toggle-container:hover {
    background: #f1f5f9;
}

.web-search-toggle-container.active {
    background: #eff6ff;
    border-color: #93c5fd;
}

.switch-toggle {
    position: relative;
    display: inline-block;
    width: 30px;
    height: 16px;
    margin: 0;
    cursor: pointer;
}

.switch-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
}

.switch-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #cbd5e1;
    transition: .2s;
    border-radius: 16px;
}

.switch-slider:before {
    position: absolute;
    content: "";
    height: 12px;
    width: 12px;
    left: 2px;
    bottom: 2px;
    background-color: white;
    transition: .2s;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgba(0,0,0,0.2);
}

.switch-toggle input:checked + .switch-slider {
    background-color: #2563eb;
}

.switch-toggle input:checked + .switch-slider:before {
    transform: translateX(14px);
}

.switch-text {
    font-size: 0.82em;
    font-weight: 600;
    color: #475569;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    cursor: pointer;
}

.web-search-toggle-container.active .switch-text {
    color: #1d4ed8;
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 12px;
}

.main-chips-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
    overflow-x: auto;
    white-space: nowrap;
}

.main-chip {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 0.82em;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer !important;
    user-select: none;
    transition: all 0.15s ease;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
}

.main-chip:hover {
    background: #ecfdf5;
    border-color: #10b981;
    color: #065f46;
    transform: translateY(-1px);
    box-shadow: 0 2px 5px rgba(16,185,129,0.15);
}

.main-chip:active,
.main-chip.active-pressed {
    transform: scale(0.96) !important;
    background: #d1fae5 !important;
    border-color: #059669 !important;
    color: #064e3b !important;
}

/* Messages */
.chatbot-main-messages {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.main-welcome-card {
    margin: auto;
    max-width: 780px;
    text-align: center;
    padding: 36px 32px;
    background: #ffffff;
    border-radius: 20px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
}

.welcome-avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #ecfdf5;
    color: #10b981;
    font-size: 2em;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px auto;
    border: 2px solid #a7f3d0;
}

.welcome-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 24px;
    text-align: left;
}

.feature-box {
    padding: 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    transition: all 0.2s ease;
}

.feature-box-clickable {
    cursor: pointer !important;
    user-select: none;
}

.feature-box-clickable:hover {
    background: #ecfdf5;
    border-color: #10b981;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.12);
}

.feature-box-clickable:active {
    transform: scale(0.97);
    background: #d1fae5;
    border-color: #059669;
    box-shadow: none;
}

