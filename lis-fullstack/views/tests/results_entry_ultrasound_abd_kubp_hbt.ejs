<div class="card">
  <h3>Enter Ultrasound Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : '' %>">
      </div>
    </div>

    <div class="form-row">
      <label>Section Title</label>
      <input type="text" name="section_title" placeholder="Section title" value="<%= test && test.results && test.results.section_title ? test.results.section_title : 'ULTRASOUND RESULT' %>">
    </div>

    <div class="form-row">
      <label>Examination</label>
      <select name="examination_select" onchange="updateExaminationField(this)">
        <option value="">-- select --</option>
        <option value="WAB-P UTZ" <%= test && test.results && test.results.examination==='WAB-P UTZ' ? 'selected' : '' %>>WAB-P UTZ</option>
        <option value="KUBP-UTZ" <%= test && test.results && test.results.examination==='KUBP-UTZ' ? 'selected' : '' %>>KUBP-UTZ</option>
        <option value="HBT UTZ" <%= test && test.results && test.results.examination==='HBT UTZ' ? 'selected' : '' %>>HBT UTZ</option>
        <option value="Other" <%= test && test.results && test.results.examination && ['WAB-P UTZ','KUBP-UTZ','HBT UTZ'].indexOf(test.results.examination)===-1 && test.results.examination ? 'selected' : '' %>>Other (type...)</option>
      </select>
      <input type="text" name="examination_custom" id="examination_custom" placeholder="Type examination" style="display:none; margin-left:8px;" value="<%= (test && test.results && test.results.examination && ['WAB-P UTZ','KUBP-UTZ','HBT UTZ'].indexOf(test.results.examination)===-1) ? test.results.examination : '' %>">
      <input type="hidden" name="examination" id="examination_hidden" value="<%= test && test.results && test.results.examination ? test.results.examination : '' %>">
    </div>

    <script>
      function updateExaminationField() {
        var sel = document.querySelector('[name="examination_select"]');
        var custom = document.getElementById('examination_custom');
        var hidden = document.getElementById('examination_hidden');
        if (!sel || !hidden || !custom) return;
        if (sel.value === 'Other') {
          custom.style.display = 'inline-block';
          hidden.value = custom.value || '';
        } else {
          custom.style.display = 'none';
          hidden.value = sel.value || '';
        }
      }
      document.addEventListener('DOMContentLoaded', function(){
        updateExaminationField();
        var sel = document.querySelector('[name="examination_select"]');
        var custom = document.getElementById('examination_custom');
        if (sel) sel.addEventListener('change', updateExaminationField);
        if (custom) custom.addEventListener('input', function(){
          var hidden = document.getElementById('examination_hidden'); if (hidden) hidden.value = custom.value;
        });
        // ensure hidden is synced on submit
        var form = document.querySelector('form[action][method]');
        if (form) form.addEventListener('submit', function(){ updateExaminationField(); });
      });
    </script>

    <div style="margin-top:8px">
      <label>Findings / Examination (paragraphs)</label>
      <div style="margin-bottom:6px; display:flex; gap:8px; align-items:center;">
        <button type="button" class="button btn-small" onclick="wrapSelection('<b>','</b>')">B</button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<i>','</i>')"><em>I</em></button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<u>','</u>')">U</button>
        <button type="button" class="button btn-small" onclick="insertParagraph()">Insert Paragraph</button>
        <label style="margin-left:12px">Font:</label>
        <select name="paragraphsFontFamily">
          <option value="Times New Roman" <%= test.results && test.results.paragraphs_font_family==='Times New Roman' ? 'selected' : '' %>>Times New Roman</option>
          <option value="Courier New" <%= test.results && test.results.paragraphs_font_family==='Courier New' ? 'selected' : '' %>>Courier New</option>
          <option value="Arial" <%= test.results && test.results.paragraphs_font_family==='Arial' ? 'selected' : '' %>>Arial</option>
          <option value="Georgia" <%= test.results && test.results.paragraphs_font_family==='Georgia' ? 'selected' : '' %>>Georgia</option>
        </select>
        <label>Size:</label>
        <select name="paragraphsFontSize">
          <option value="14px" <%= (!test.results || !test.results.paragraphs_font_size || test.results.paragraphs_font_size==='14px') ? 'selected' : '' %>>14px</option>
          <option value="16px" <%= test.results && test.results.paragraphs_font_size==='16px' ? 'selected' : '' %>>16px</option>
          <option value="18px" <%= test.results && test.results.paragraphs_font_size==='18px' ? 'selected' : '' %>>18px</option>
        </select>
      </div>
      <textarea id="paragraphs" name="paragraphs" rows="8" spellcheck="true" style="width:100%; font-family:inherit;"><%= test && test.results && (test.results.paragraphs || test.results.findings || test.results.result) ? (test.results.paragraphs || test.results.findings || test.results.result) : 'Enter findings here.\n\nDescribe organ sizes, echotexture, focal lesions, measurements and other relevant observations.' %></textarea>
    </div>

    <div style="margin-top:8px">
      <label>Impression</label>
      <textarea name="impression" rows="4" style="width:100%"><%= test && test.results && (test.results.impression || test.results.impression_text) ? (test.results.impression || test.results.impression_text) : 'Enter impression here.' %></textarea>
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <div class="form-row">
      <label>Radiologist (Name)</label>
      <input type="text" name="pathName" placeholder="Radiologist name" value="<%= test.results && test.results.pathName ? test.results.pathName : (test.results && test.results.doctorName ? test.results.doctorName : '') %>">
    </div>
    <div class="form-row">
      <label>Radiologist License</label>
      <input type="text" name="pathLicense" placeholder="License number (optional)" value="<%= test.results && test.results.pathLicense ? test.results.pathLicense : (test.results && test.results.doctorLicense ? test.results.doctorLicense : '') %>">
    </div>
    <div class="form-row">
      <label>Designation</label>
      <input type="text" name="doctorDesignation" placeholder="e.g. MD, FPCR - Radiologist" value="<%= test.results && test.results.doctorDesignation ? test.results.doctorDesignation : 'Radiologist' %>">
    </div>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>

  <script>
    function wrapSelection(openTag, closeTag) {
      var ta = document.getElementById('paragraphs');
      var start = ta.selectionStart;
      var end = ta.selectionEnd;
      var selected = ta.value.substring(start, end);
      var newText = openTag + selected + closeTag;
      ta.value = ta.value.substring(0, start) + newText + ta.value.substring(end);
      ta.focus();
      ta.selectionStart = start + openTag.length;
      ta.selectionEnd = start + openTag.length + selected.length;
    }
    function insertParagraph(){
      var ta = document.getElementById('paragraphs');
      var pos = ta.selectionStart || ta.value.length;
      var p = '\n\n';
      ta.value = ta.value.substring(0,pos) + p + ta.value.substring(pos);
      ta.focus();
    }
  </script>
</div>
