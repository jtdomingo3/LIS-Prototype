                <input type="text" name="dop_pasp_trj" value="<%= r.dop_pasp_trj || '' %>" placeholder="" title="PASP by TRJ" style="width: 100%; height: 22px; padding: 2px 4px; font-size: 0.82em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; margin-bottom: 2px; box-sizing: border-box; background: #fff;">
                <input type="text" name="dop_total_pasp" value="<%= r.dop_total_pasp || '' %>" placeholder="" title="Total PASP" style="width: 100%; height: 22px; padding: 2px 4px; font-size: 0.82em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
