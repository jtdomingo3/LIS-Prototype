<%- include('../partials/test_patient_banner', { test, patient: typeof patient !== 'undefined' ? patient : (test ? test.patient : null) }) %>

<%
  const r = (test && test.results) ? test.results : {};
  const p = (test && test.patient) ? test.patient : {};
%>

<div class="card" style="padding: 24px 28px; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0;">
  <form action="/tests/<%= test.id %>/results" method="POST" id="echoForm">
    <input type="hidden" name="_method" value="POST">

    <!-- Timing & Meta Bar -->
    <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; padding: 12px 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Date:</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 135px;">
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Time Requested:</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>" style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 115px;">
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Time Released:</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>" style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 115px;">
      </div>
    </div>

    <!-- Biometrics & Clinical Indicators Bar -->
    <div style="display: flex; gap: 14px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; padding: 14px 18px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px;">
      <div style="display: flex; align-items: center; gap: 6px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Weight (kg):</label>
        <input type="text" name="weight" id="weight_field" placeholder="e.g. 70" value="<%= r.weight || (p && p.weight ? p.weight : '') %>" style="height: 34px; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.88em; width: 85px; font-weight: 600;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Height (cm):</label>
        <input type="text" name="height" id="height_field" placeholder="e.g. 167.3" value="<%= r.height || (p && p.height ? p.height : '') %>" style="height: 34px; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.88em; width: 85px; font-weight: 600;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">BSA (m²):</label>
        <input type="text" name="bsa" id="bsa_field" placeholder="Auto" value="<%= r.bsa || '' %>" style="height: 34px; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.88em; width: 75px; font-weight: 700; background: #f8fafc;" readonly>
      </div>
      <div style="display: flex; align-items: center; gap: 6px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Heart Rate (HR):</label>
        <input type="text" name="hr" id="hr_field" placeholder="e.g. 63 bpm" value="<%= r.hr || '' %>" style="height: 34px; padding: 4px 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.88em; width: 95px; font-weight: 600;">
      </div>
      <div style="display: flex; align-items: center; gap: 6px; flex: 1; min-width: 220px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Indication for study:</label>
        <input type="text" name="indication" id="indication_field" placeholder="e.g. Chest pain, Hypertension, Palpitations" value="<%= r.indication || r.indication_for_study || '' %>" style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 0.88em; width: 100%; font-weight: 500;">
      </div>
    </div>

    <!-- Main Navigation Tabs for the 2 Result Forms -->
    <div style="display: flex; gap: 8px; border-bottom: 2px solid #e2e8f0; margin-bottom: 24px;">
      <button type="button" id="tabBtnInfo" onclick="showFormTab('info')" style="padding: 10px 22px; font-weight: 700; font-size: 0.95em; border: none; background: #0284c7; color: #ffffff; border-radius: 8px 8px 0 0; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.15s;">
        <i class="fa fa-table"></i> Form 1: Echocardiography Information (Measurements Sheet)
      </button>
      <button type="button" id="tabBtnReading" onclick="showFormTab('reading')" style="padding: 10px 22px; font-weight: 700; font-size: 0.95em; border: none; background: #e2e8f0; color: #475569; border-radius: 8px 8px 0 0; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: all 0.15s;">
        <i class="fa fa-file-medical-alt"></i> Form 2: Interpretation & Reading (Clinical Report)
      </button>
    </div>

    <!-- ================================================================ -->
    <!-- TAB 1: ECHOCARDIOGRAPHY INFORMATION SHEET (Image 1)             -->
    <!-- ================================================================ -->
    <div id="formTabInfo" style="display: block;">
      
      <!-- Quick Fill Sample Action Bar -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding: 10px 16px; background: #f0f9ff; border: 1px solid #bae6fd; border-radius: 8px;">
        <div style="font-size: 0.88em; color: #0369a1; font-weight: 600;">
          <i class="fa fa-info-circle"></i> Input M-mode/2-D and Doppler study parameters. All values will fit cleanly into 1 Letter page.
        </div>
        <button type="button" onclick="loadSampleInformationData()" class="button" style="height: 32px; padding: 0 14px; font-size: 0.82em; font-weight: 700; background: #0284c7; color: #fff; border-radius: 6px; border: none; cursor: pointer;">
          ⚡ Load Sample Information Sheet Values (from Image 1)
        </button>
      </div>

      <!-- 3-Column M-Mode Measurements Form Grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 24px;">
        
        <!-- Column 1 Card -->
        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 14px 16px;">
          <div style="font-weight: 700; font-size: 0.92em; color: #0f172a; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1.5px solid #e2e8f0;">
            M-mode / 2-D measurements (Col 1)
          </div>

          <table style="width: 100%; border-collapse: collapse; font-size: 0.85em; table-layout: fixed;">
            <colgroup>
              <col style="width: 40%;">
              <col style="width: 82px;">
              <col style="width: auto;">
            </colgroup>
            <thead>
              <tr style="color: #64748b; border-bottom: 1px solid #e2e8f0;">
                <th style="text-align: left; padding: 5px 2px;">Parameter</th>
                <th style="text-align: center; padding: 5px 2px; width: 82px;">Value</th>
                <th style="text-align: right; padding: 5px 2px;">Normal Value</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVEDD</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvedd" value="<%= r.lvedd || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; line-height: 1.2; word-break: break-word; white-space: normal; padding: 4px 2px;">M(4.2-5.9cm) / F(3.9-5.3cm)</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVEDD by BSA</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvedd_bsa" value="<%= r.lvedd_bsa || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; line-height: 1.2; word-break: break-word; white-space: normal; padding: 4px 2px;">M(2.2-3.1) / F(2.4-3.2)</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVESD</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvesd" value="<%= r.lvesd || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">cm</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVEDV</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvedv" value="<%= r.lvedv || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">ml</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVESV</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvesv" value="<%= r.lvesv || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">ml</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">IVS (D)</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="ivs_d" value="<%= r.ivs_d || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; line-height: 1.2; word-break: break-word; white-space: normal; padding: 4px 2px;">M(0.6-1.0cm) / F(0.6-0.9cm)</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">IVS (S)</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="ivs_s" value="<%= r.ivs_s || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">-</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVPW (D)</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvpw_d" value="<%= r.lvpw_d || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; line-height: 1.2; word-break: break-word; white-space: normal; padding: 4px 2px;">M(0.6-1.0cm) / F(0.6-0.9cm)</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVPW (S)</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvpw_s" value="<%= r.lvpw_s || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">-</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">Mitral Annulus</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="mitral_annulus" value="<%= r.mitral_annulus || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">2.0 - 3.4 cm</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">Tricuspid Annulus</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="tricuspid_annulus" value="<%= r.tricuspid_annulus || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">1.3 - 2.8 cm</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Column 2 Card -->
        <div style="background: #ffffff; border: 1px solid #cbd5e1; border-radius: 10px; padding: 14px 16px;">
          <div style="font-weight: 700; font-size: 0.92em; color: #0f172a; margin-bottom: 12px; padding-bottom: 6px; border-bottom: 1.5px solid #e2e8f0;">
            M-mode / 2-D Measurements (Col 2)
          </div>

          <table style="width: 100%; border-collapse: collapse; font-size: 0.85em; table-layout: fixed;">
            <colgroup>
              <col style="width: 38%;">
              <col style="width: 82px;">
              <col style="width: auto;">
            </colgroup>
            <thead>
              <tr style="color: #64748b; border-bottom: 1px solid #e2e8f0;">
                <th style="text-align: left; padding: 5px 2px;">Parameter</th>
                <th style="text-align: center; padding: 5px 2px; width: 82px;">Value</th>
                <th style="text-align: right; padding: 5px 2px;">Normal Value</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVMI</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvmi" value="<%= r.lvmi || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; line-height: 1.2; word-break: break-word; white-space: normal; padding: 4px 2px;">M(&le;115) / F(&le;95) gm/m²</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">RWT</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="rwt" value="<%= r.rwt || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">&le; 0.42</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">SV</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="sv" value="<%= r.sv || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">ml / beat</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">CO</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="co" value="<%= r.co || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">L / min</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">EF (T)</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="ef_t" value="<%= r.ef_t || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">&ge; 55 %</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">S</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="s_wave" value="<%= r.s_wave || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">-</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">FS</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="fs" value="<%= r.fs || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">28 &ndash; 41 %</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">EPSS</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="epss" value="<%= r.epss || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">&lt; 1 cm</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">LVOT</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="lvot" value="<%= r.lvot || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">cm</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">AV Op</td>
                <td style="text-align: center; padding: 3px 2px;">
                  <input type="text" name="av_op" value="<%= r.av_op || '' %>" style="width: 76px; min-width: 76px; height: 28px; padding: 2px 4px; font-size: 0.92em; font-weight: 600; text-align: center; border-radius: 4px; border: 1px solid #cbd5e1; box-sizing: border-box; background: #fff;">
                </td>
                <td style="text-align: right; font-size: 0.76em; color: #64748b; padding: 4px 2px;">1.5 &ndash; 2 cm</td>
              </tr>
              <tr>
                <td style="padding: 5px 2px; font-weight: 500; font-size: 0.95em;">PA</td>
                <td style="text-align: center; padding: 3px 2px;">
