<div class="card">
  <h3>Enter Echocardiography (2D) Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>">
      </div>
    </div>

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div class="form-row" style="margin:0;">
        <label>Weight (kg)</label>
        <input type="text" name="weight" placeholder="e.g. 64.2" value="<%= test && test.results && test.results.weight ? test.results.weight : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Height (cm)</label>
        <input type="text" name="height" placeholder="e.g. 167.6" value="<%= test && test.results && test.results.height ? test.results.height : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>BSA (m²)</label>
        <input type="text" name="bsa" id="bsa_field" placeholder="Auto" value="<%= test && test.results && test.results.bsa ? test.results.bsa : '' %>">
      </div>
    </div>

    <script>
      // compute Mosteller BSA when weight or height changes
      function computeBsa() {
        var w = parseFloat(document.querySelector('[name="weight"]').value);
        var h = parseFloat(document.querySelector('[name="height"]').value);
        var bsaEl = document.getElementById('bsa_field');
        if (!isNaN(w) && !isNaN(h) && w > 0 && h > 0) {
          var bsa = Math.sqrt((h * w) / 3600);
          bsaEl.value = (Math.round(bsa * 100) / 100).toFixed(2);
        }
      }
      document.addEventListener('input', function(e){
        if (e.target && (e.target.name === 'weight' || e.target.name === 'height')) computeBsa();
      });
      // initial compute
      computeBsa();
    </script>

    <div class="form-row">
      <label>Section Title</label>
      <input type="text" name="section_title" placeholder="Section title" value="<%= test && test.results && test.results.section_title ? test.results.section_title : 'ECHOCARDIOGRAPHY REPORT' %>">
    </div>

    <div style="margin-top:8px">
      <label>Findings / Examination (paragraphs)</label>
      <div style="margin-bottom:6px; display:flex; gap:8px; align-items:center;">
        <button type="button" class="button btn-small" onclick="wrapSelection('<b>','</b>')">B</button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<i>','</i>')"><em>I</em></button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<u>','</u>')">U</button>
        <button type="button" class="button btn-small" onclick="insertParagraph()">Insert Paragraph</button>
        <label style="margin-left:12px">Font:</label>
        <select name="paragraphsFontFamily">
          <option value="Times New Roman" <%= test.results && test.results.paragraphs_font_family==='Times New Roman' ? 'selected' : '' %>>Times New Roman</option>
          <option value="Courier New" <%= (test.results && test.results.paragraphs_font_family==='Courier New') || (!test.results || !test.results.paragraphs_font_family) ? 'selected' : '' %>>Courier New</option>
          <option value="Arial" <%= test.results && test.results.paragraphs_font_family==='Arial' ? 'selected' : '' %>>Arial</option>
        </select>
        <label>Size:</label>
        <select name="paragraphsFontSize">
          <option value="12px" <%= test.results && test.results.paragraphs_font_size==='12px' ? 'selected' : '' %>>12px</option>
          <option value="14px" <%= (!test.results || !test.results.paragraphs_font_size || test.results.paragraphs_font_size==='14px') ? 'selected' : '' %>>14px</option>
          <option value="16px" <%= test.results && test.results.paragraphs_font_size==='16px' ? 'selected' : '' %>>16px</option>
        </select>
      </div>
      <textarea id="paragraphs" name="paragraphs" rows="8" spellcheck="true" style="width:100%; font-family:inherit;"><%= test && test.results && (test.results.paragraphs || test.results.findings || test.results.result) ? (test.results.paragraphs || test.results.findings || test.results.result) : 'Enter echocardiography findings here.\n\nDescribe chamber sizes, wall motion, valves, measurements and other observations.' %></textarea>
    </div>

    <div style="margin-top:10px; font-weight:700;">Color Flow Doppler Study</div>
    <div style="margin-top:6px">
      <textarea name="color_flow" rows="4" style="width:100%"><%= test && test.results && (test.results.color_flow || test.results.color_flow_study) ? (test.results.color_flow || test.results.color_flow_study) : 'Describe color flow Doppler findings here.' %></textarea>
    </div>

    <div style="margin-top:10px; font-weight:700;">Conclusion</div>
    <div style="margin-top:6px">
      <textarea name="conclusion" rows="4" style="width:100%"><%= test && test.results && (test.results.conclusion || test.results.impression || test.results.conclusion_text) ? (test.results.conclusion || test.results.impression || test.results.conclusion_text) : 'Enter conclusion here.' %></textarea>
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <%- include('../partials/signatory_select', { prefix: 'path', label: 'Physician', nameInput: 'pathName', licenseInput: 'pathLicense', existingName: (test.results && test.results.pathName) ? test.results.pathName : (test.results && test.results.doctorName ? test.results.doctorName : ''), existingLicense: (test.results && test.results.pathLicense) ? test.results.pathLicense : (test.results && test.results.doctorLicense ? test.results.doctorLicense : '') }) %>

    <div class="form-row">
      <label>Designation</label>
      <input type="text" name="doctorDesignation" placeholder="e.g. MD - Cardiologist" value="<%= test.results && test.results.doctorDesignation ? test.results.doctorDesignation : 'Cardiologist' %>">
    </div>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>

  <script>
    function wrapSelection(openTag, closeTag) {
      var ta = document.getElementById('paragraphs');
      var start = ta.selectionStart;
      var end = ta.selectionEnd;
      var selected = ta.value.substring(start, end);
      var newText = openTag + selected + closeTag;
      ta.value = ta.value.substring(0, start) + newText + ta.value.substring(end);
      ta.focus();
      ta.selectionStart = start + openTag.length;
      ta.selectionEnd = start + openTag.length + selected.length;
    }
    function insertParagraph(){
      var ta = document.getElementById('paragraphs');
      var pos = ta.selectionStart || ta.value.length;
      var p = '\n\n';
      ta.value = ta.value.substring(0,pos) + p + ta.value.substring(pos);
      ta.focus();
    }
  </script>
</div>
