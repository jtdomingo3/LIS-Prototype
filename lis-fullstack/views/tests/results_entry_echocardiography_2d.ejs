              </td>
              <td colspan="2" style="padding: 4px 6px; border: 1px solid #64748b; vertical-align: middle;">
                <div style="display: flex; align-items: center; gap: 4px; margin-bottom: 3px;">
                  <span style="font-size: 0.8em; font-weight: 700; color: #334155; width: 20px;">E':</span>
                  <input type="text" name="dop_tdi_lat_e" value="<%= r.dop_tdi_lat_e || '' %>" placeholder="13" title="Lateral E'" style="width: 44px; height: 24px; padding: 2px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
