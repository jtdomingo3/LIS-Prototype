                <input type="text" name="dop_peak_grad_pulmonic" value="<%= r.dop_peak_grad_pulmonic || '' %>" placeholder="" title="Pulmonic Peak Gradient" style="width: 100%; height: 24px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
              </td>
