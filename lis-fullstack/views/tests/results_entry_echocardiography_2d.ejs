                <input type="text" name="dop_pv_diastoles" value="<%= r.dop_pv_diastoles || '' %>" placeholder="0.30" title="Pulmonic Vein Diastoles" style="width: 100%; height: 22px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; margin-bottom: 2px; box-sizing: border-box; background: #fff;">
                <input type="text" name="dop_pv_systole" value="<%= r.dop_pv_systole || '' %>" placeholder="0.42" title="Pulmonic Vein Systole" style="width: 100%; height: 22px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; margin-bottom: 2px; box-sizing: border-box; background: #fff;">
                <input type="text" name="dop_pv_sys_dias" value="<%= r.dop_pv_sys_dias || '' %>" placeholder="1.3" title="Pulmonic Vein Sys / Dias" style="width: 100%; height: 22px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
              </td>
              <td style="border: 1px solid #64748b; background: #f8fafc;"></td>

              <!-- AORTIC (Left: Blank Value, Right: Reference/Label PASP) -->
              <td style="border: 1px solid #64748b; background: #f8fafc;"></td>
              <td style="padding: 4px 6px; border: 1px solid #64748b; font-size: 0.74em; color: #334155; font-weight: 600; vertical-align: middle; line-height: 1.35; white-space: nowrap;">
