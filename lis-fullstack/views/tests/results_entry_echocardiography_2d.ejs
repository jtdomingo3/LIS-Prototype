                  <input type="text" name="dop_tdi_lat_a" value="<%= r.dop_tdi_lat_a || '' %>" placeholder="11" title="Lateral A'" style="width: 44px; height: 24px; padding: 2px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
                </div>
                <div style="display: flex; align-items: center; gap: 4px;">
                  <span style="font-size: 0.8em; font-weight: 700; color: #334155; width: 20px;">E':</span>
                  <input type="text" name="dop_tdi_med_e" value="<%= r.dop_tdi_med_e || '' %>" placeholder="13" title="Media E'" style="width: 44px; height: 24px; padding: 2px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
                  <span style="font-size: 0.8em; font-weight: 700; color: #334155; margin-left: 6px; width: 20px;">A':</span>
                  <input type="text" name="dop_tdi_med_a" value="<%= r.dop_tdi_med_a || '' %>" placeholder="10" title="Media A'" style="width: 44px; height: 24px; padding: 2px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
                </div>
              </td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
            </tr>

            <!-- Row 6: Deceleration Time -->
            <tr>
              <td style="padding: 6px 8px; border: 1px solid #64748b; font-weight: 700; color: #0f172a;">Deceleration Time (m/sec)</td>
              <!-- MITRAL -->
              <td style="padding: 4px 3px; border: 1px solid #64748b; vertical-align: middle;">
                <input type="text" name="dop_decel_time" value="<%= r.dop_decel_time || '' %>" placeholder="340" title="Deceleration Time" style="width: 100%; height: 24px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
              </td>
              <td style="padding: 4px 3px; border: 1px solid #64748b; font-size: 0.8em; color: #334155; font-weight: 600; text-align: center; vertical-align: middle;">
