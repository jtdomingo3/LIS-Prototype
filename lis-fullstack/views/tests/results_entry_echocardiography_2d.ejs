              </td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
              <td colspan="2" style="border: 1px solid #64748b; background: #f8fafc;"></td>
            </tr>

            <!-- Row 7: IVRT -->
            <tr>
              <td style="padding: 6px 8px; border: 1px solid #64748b; font-weight: 700; color: #0f172a;">IVRT (m/sec)</td>
              <!-- MITRAL -->
              <td style="padding: 4px 3px; border: 1px solid #64748b; vertical-align: middle;">
                <input type="text" name="dop_ivrt" value="<%= r.dop_ivrt || '' %>" placeholder="116" title="IVRT" style="width: 100%; height: 24px; padding: 2px 4px; font-size: 0.85em; font-weight: 600; text-align: center; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #fff;">
