<div class="card">
  <h3>Enter Thyroid Panel Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '') %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : '' %>">
      </div>
    </div>

    <div class="form-row">
      <label>TSH (mIU/L)</label>
      <input type="text" name="tsh" value="<%= test.results && test.results.tsh ? test.results.tsh : '' %>">
    </div>

    <div class="form-row">
      <label>FT4 (pmol/L)</label>
      <input type="text" name="ft4" value="<%= test.results && test.results.ft4 ? test.results.ft4 : '' %>">
    </div>

    <div class="form-row">
      <label>FT3 (pmol/L)</label>
      <input type="text" name="ft3" value="<%= test.results && test.results.ft3 ? test.results.ft3 : '' %>">
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <div class="form-row">
      <label>Medical Technologist (Name)</label>
      <input type="text" name="mtName" value="<%= test.results && test.results.performedByName ? test.results.performedByName : '' %>">
    </div>
    <div class="form-row">
      <label>Medical Technologist License</label>
      <input type="text" name="mtLicense" value="<%= test.results && test.results.performedByLicense ? test.results.performedByLicense : '' %>">
    </div>

    <hr>
    <h4>Validation</h4>
    <div class="form-row">
      <label>2nd Medical Technologist (Validator Name)</label>
      <input type="text" name="validatedByName" value="<%= test.results && test.results.validatedByName ? test.results.validatedByName : '' %>">
    </div>
    <div class="form-row">
      <label>2nd Medical Technologist License</label>
      <input type="text" name="validatedByLicense" value="<%= test.results && test.results.validatedByLicense ? test.results.validatedByLicense : '' %>">
    </div>

    <div class="form-row">
      <label>Pathologist (Name)</label>
      <input type="text" name="pathName" value="<%= test.results && test.results.requestedByName ? test.results.requestedByName : '' %>">
    </div>
    <div class="form-row">
      <label>Pathologist License</label>
      <input type="text" name="pathLicense" value="<%= test.results && test.results.requestedByLicense ? test.results.requestedByLicense : '' %>">
    </div>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>
  <script>
    (function(){
      var form = document.querySelector('form[action="/tests/<%= test.id %>/results"]');
      if(!form) return;
      form.addEventListener('submit', function(e){
        var tsh = (form.querySelector('[name="tsh"]')||{}).value || '';
        var ft4 = (form.querySelector('[name="ft4"]')||{}).value || '';
        var ft3 = (form.querySelector('[name="ft3"]')||{}).value || '';
        if(!tsh.trim() && !ft4.trim() && !ft3.trim()){
          e.preventDefault();
          alert('Please enter at least one thyroid test result (TSH, FT4 or FT3).');
        }
      });
    })();
  </script>
</div>
