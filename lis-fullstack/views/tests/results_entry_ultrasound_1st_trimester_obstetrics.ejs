<div class="card">
  <h3>Enter Ultrasound - 1st Trimester Obstetrics Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>">
      </div>
    </div>

    <div style="margin-top:8px">
      <label>Section Title</label>
      <input type="text" name="section_title" value="<%= test && test.results && test.results.section_title ? test.results.section_title : '1st TRIMESTER OBSTETRICS (ULTRASOUND)' %>">
    </div>

    <div style="margin-bottom:8px">
      <label><input type="checkbox" id="isTwin" name="isTwin" <%= test && test.results && test.results.isTwin ? 'checked' : '' %> onchange="toggleTwin(this)"> Twin pregnancy</label>
    </div>

    <div id="singleBlock" style="display:<%= (test && test.results && test.results.isTwin) ? 'none' : 'block' %>">
      <div class="form-row">
        <label>GESTATIONAL SAC (length)</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="text" name="gestational_sac_length" placeholder="0.00" value="<%= test && test.results && test.results.gestational_sac_length ? test.results.gestational_sac_length : '' %>" style="width:120px"> 
          <label style="margin:0">cm</label>
          <input type="text" name="gestational_sac_age" placeholder="6w6d" value="<%= test && test.results && test.results.gestational_sac_age ? test.results.gestational_sac_age : '' %>" style="margin-left:8px; width:120px">
        </div>
      </div>

      <div class="form-row" style="margin-top:8px">
        <label>CRL</label>
        <div style="display:flex;gap:8px;align-items:center">
          <input type="text" name="crl_length" placeholder="0.00" value="<%= test && test.results && test.results.crl_length ? test.results.crl_length : '' %>" style="width:120px">
          <label style="margin:0">cm</label>
          <input type="text" name="crl_age" placeholder="6w6d" value="<%= test && test.results && test.results.crl_age ? test.results.crl_age : '' %>" style="margin-left:8px; width:120px">
        </div>
      </div>

      <div style="margin-top:8px">
        <label>COMMENTS</label>
        <div id="commentsList">
          <% let commentEntries = [];
             if (test && test.results && Array.isArray(test.results.comment_entries)) {
               commentEntries = test.results.comment_entries;
             } else if (test && test.results && (test.results.comment_yolk || test.results.comment_hemorrhage)) {
               if (test.results.comment_yolk) commentEntries.push({ sign: '-', text: test.results.comment_yolk });
               if (test.results.comment_hemorrhage) commentEntries.push({ sign: '-', text: test.results.comment_hemorrhage });
             } else {
               commentEntries = [{ sign: '-', text: 'Yolk sac' }, { sign: '-', text: 'Hemorrhage' }];
             }
          %>
          <% commentEntries.forEach(function(c, idx){ %>
            <div class="comment-row" style="display:flex;gap:8px;align-items:center;margin-top:6px">
              <select name="comment_sign[]" style="width:64px">
                <option value="+" <%= c && c.sign === '+' ? 'selected' : '' %> >(+)</option>
                <option value="-" <%= (!c || c.sign === '-' ) ? 'selected' : '' %> >(-)</option>
              </select>
              <input type="text" name="comment_text[]" placeholder="Comment" value="<%= c && c.text ? c.text : '' %>" style="flex:1">
              <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
            </div>
          <% }) %>
        </div>
        <div style="margin-top:8px">
          <button type="button" class="button" onclick="addCommentRow()">Add Comment</button>
        </div>
      </div>

      <div style="margin-top:8px">
        <label>AVERAGE ULTRASOUND AGE</label>
        <input type="text" name="average_ultrasound_age" placeholder="6w6d" value="<%= test && test.results && test.results.average_ultrasound_age ? test.results.average_ultrasound_age : '' %>">
      </div>

      <div style="margin-top:8px">
        <label>FETAL HEART RATE</label>
        <input type="text" name="fetal_heart_rate" placeholder="BPM" value="<%= test && test.results && test.results.fetal_heart_rate ? test.results.fetal_heart_rate : '' %>">
      </div>
    </div>

    <div id="twinBlock" style="display:<%= (test && test.results && test.results.isTwin) ? 'block' : 'none' %>">
      <div style="display:flex;gap:16px">
        <div style="flex:1">
          <h4>TWIN A</h4>
          <div class="form-row">
            <label>GESTATIONAL SAC (length)</label>
            <div style="display:flex;gap:8px;align-items:center">
              <input type="text" name="gestational_sac_length_A" placeholder="0.00" value="<%= test && test.results && test.results.gestational_sac_length_A ? test.results.gestational_sac_length_A : '' %>" style="width:120px"> 
              <label style="margin:0">cm</label>
              <input type="text" name="gestational_sac_age_A" placeholder="6w6d" value="<%= test && test.results && test.results.gestational_sac_age_A ? test.results.gestational_sac_age_A : '' %>" style="margin-left:8px; width:120px">
            </div>
          </div>

          <div class="form-row" style="margin-top:8px">
            <label>CRL</label>
            <div style="display:flex;gap:8px;align-items:center">
              <input type="text" name="crl_length_A" placeholder="0.00" value="<%= test && test.results && test.results.crl_length_A ? test.results.crl_length_A : '' %>" style="width:120px">
              <label style="margin:0">cm</label>
              <input type="text" name="crl_age_A" placeholder="6w6d" value="<%= test && test.results && test.results.crl_age_A ? test.results.crl_age_A : '' %>" style="margin-left:8px; width:120px">
            </div>
          </div>

          <div style="margin-top:8px">
            <label>COMMENTS (TWIN A)</label>
            <div id="commentsListA">
              <% let commentEntriesA = [];
                 if (test && test.results && Array.isArray(test.results.comment_entries_A)) {
                   commentEntriesA = test.results.comment_entries_A;
                 } else if (test && test.results && Array.isArray(test.results.comment_entries)) {
                   commentEntriesA = test.results.comment_entries.slice(0, Math.ceil(test.results.comment_entries.length/2));
                 } else {
                   commentEntriesA = [{ sign: '-', text: 'Yolk sac' }];
                 }
              %>
              <% commentEntriesA.forEach(function(c, idx){ %>
                <div class="comment-row" style="display:flex;gap:8px;align-items:center;margin-top:6px">
                  <select name="comment_sign_A[]" style="width:64px">
                    <option value="+" <%= c && c.sign === '+' ? 'selected' : '' %> >(+)</option>
                    <option value="-" <%= (!c || c.sign === '-' ) ? 'selected' : '' %> >(-)</option>
                  </select>
                  <input type="text" name="comment_text_A[]" placeholder="Comment" value="<%= c && c.text ? c.text : '' %>" style="flex:1">
                  <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
                </div>
              <% }) %>
            </div>
            <div style="margin-top:8px">
              <button type="button" class="button" onclick="addCommentRowA()">Add Comment A</button>
            </div>
          </div>
        </div>

        <div style="flex:1">
          <h4>TWIN B</h4>
          <div class="form-row">
            <label>GESTATIONAL SAC (length)</label>
            <div style="display:flex;gap:8px;align-items:center">
              <input type="text" name="gestational_sac_length_B" placeholder="0.00" value="<%= test && test.results && test.results.gestational_sac_length_B ? test.results.gestational_sac_length_B : '' %>" style="width:120px"> 
              <label style="margin:0">cm</label>
              <input type="text" name="gestational_sac_age_B" placeholder="6w6d" value="<%= test && test.results && test.results.gestational_sac_age_B ? test.results.gestational_sac_age_B : '' %>" style="margin-left:8px; width:120px">
            </div>
          </div>

          <div class="form-row" style="margin-top:8px">
            <label>CRL</label>
            <div style="display:flex;gap:8px;align-items:center">
              <input type="text" name="crl_length_B" placeholder="0.00" value="<%= test && test.results && test.results.crl_length_B ? test.results.crl_length_B : '' %>" style="width:120px">
              <label style="margin:0">cm</label>
              <input type="text" name="crl_age_B" placeholder="6w6d" value="<%= test && test.results && test.results.crl_age_B ? test.results.crl_age_B : '' %>" style="margin-left:8px; width:120px">
            </div>
          </div>

          <div style="margin-top:8px">
            <label>COMMENTS (TWIN B)</label>
            <div id="commentsListB">
              <% let commentEntriesB = [];
                 if (test && test.results && Array.isArray(test.results.comment_entries_B)) {
                   commentEntriesB = test.results.comment_entries_B;
                 } else if (test && test.results && Array.isArray(test.results.comment_entries)) {
                   const start = Math.ceil(test.results.comment_entries.length/2);
                   commentEntriesB = test.results.comment_entries.slice(start);
                 } else {
                   commentEntriesB = [{ sign: '-', text: 'Hemorrhage' }];
                 }
              %>
              <% commentEntriesB.forEach(function(c, idx){ %>
                <div class="comment-row" style="display:flex;gap:8px;align-items:center;margin-top:6px">
                  <select name="comment_sign_B[]" style="width:64px">
                    <option value="+" <%= c && c.sign === '+' ? 'selected' : '' %> >(+)</option>
                    <option value="-" <%= (!c || c.sign === '-' ) ? 'selected' : '' %> >(-)</option>
                  </select>
                  <input type="text" name="comment_text_B[]" placeholder="Comment" value="<%= c && c.text ? c.text : '' %>" style="flex:1">
                  <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
                </div>
              <% }) %>
            </div>
            <div style="margin-top:8px">
              <button type="button" class="button" onclick="addCommentRowB()">Add Comment B</button>
            </div>
          </div>
        </div>
      </div>

      <div style="margin-top:8px; display:flex; gap:12px;">
        <div style="flex:1">
          <label>AVERAGE ULTRASOUND AGE (TWIN A)</label>
          <input type="text" name="average_ultrasound_age_A" placeholder="6w6d" value="<%= test && test.results && test.results.average_ultrasound_age_A ? test.results.average_ultrasound_age_A : '' %>">
        </div>
        <div style="flex:1">
          <label>AVERAGE ULTRASOUND AGE (TWIN B)</label>
          <input type="text" name="average_ultrasound_age_B" placeholder="6w6d" value="<%= test && test.results && test.results.average_ultrasound_age_B ? test.results.average_ultrasound_age_B : '' %>">
        </div>
      </div>

      <div style="margin-top:8px; display:flex; gap:12px;">
        <div style="flex:1">
          <label>FETAL HEART RATE (TWIN A)</label>
          <input type="text" name="fetal_heart_rate_A" placeholder="BPM" value="<%= test && test.results && test.results.fetal_heart_rate_A ? test.results.fetal_heart_rate_A : '' %>">
        </div>
        <div style="flex:1">
          <label>FETAL HEART RATE (TWIN B)</label>
          <input type="text" name="fetal_heart_rate_B" placeholder="BPM" value="<%= test && test.results && test.results.fetal_heart_rate_B ? test.results.fetal_heart_rate_B : '' %>">
        </div>
      </div>
    </div>

    <div style="margin-top:8px">
      <label>EXPECTED DATE OF DELIVERY</label>
      <input type="date" name="expected_date_of_delivery" value="<%= test && test.results && test.results.expected_date_of_delivery ? (new Date(test.results.expected_date_of_delivery)).toISOString().slice(0,10) : '' %>">
    </div>

    <div style="margin-top:8px">
      <label>OTHERS</label>
      <input type="text" name="other" value="<%= test && test.results && test.results.other ? test.results.other : '' %>">
    </div>

    <div style="margin-top:8px">
      <label>IMPRESSION</label>
      <textarea name="impression" rows="4" style="width:100%"><%= test && test.results && test.results.impression ? test.results.impression : 'Enter impression here.' %></textarea>
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <div class="form-row">
      <label>Radiologist (Name)</label>
      <input type="text" name="pathName" placeholder="Radiologist name" value="<%= test.results && test.results.pathName ? test.results.pathName : (test.results && test.results.doctorName ? test.results.doctorName : '') %>">
    </div>
    <div class="form-row">
      <label>Radiologist License</label>
      <input type="text" name="pathLicense" placeholder="License number (optional)" value="<%= test.results && test.results.pathLicense ? test.results.pathLicense : (test.results && test.results.doctorLicense ? test.results.doctorLicense : '') %>">
    </div>
    <div class="form-row">
      <label>Designation</label>
      <input type="text" name="doctorDesignation" placeholder="e.g. MD, FPCR - Radiologist" value="<%= test.results && test.results.doctorDesignation ? test.results.doctorDesignation : 'Radiologist' %>">
    </div>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>
</div>

<script>
  function toggleTwin(cb) {
    const twin = cb.checked;
    document.getElementById('twinBlock').style.display = twin ? 'block' : 'none';
    document.getElementById('singleBlock').style.display = twin ? 'none' : 'block';
  }
  function addCommentRow() {
    const container = document.getElementById('commentsList');
    const div = document.createElement('div');
    div.className = 'comment-row';
    div.style.cssText = 'display:flex;gap:8px;align-items:center;margin-top:6px';
    div.innerHTML = `
      <select name="comment_sign[]" style="width:64px">
        <option value="+">(+)</option>
        <option value="-" selected>(-)</option>
      </select>
      <input type="text" name="comment_text[]" placeholder="Comment" style="flex:1">
      <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
    `;
    container.appendChild(div);
  }
  function addCommentRowA() {
    const container = document.getElementById('commentsListA');
    const div = document.createElement('div');
    div.className = 'comment-row';
    div.style.cssText = 'display:flex;gap:8px;align-items:center;margin-top:6px';
    div.innerHTML = `
      <select name="comment_sign_A[]" style="width:64px">
        <option value="+">(+)</option>
        <option value="-" selected>(-)</option>
      </select>
      <input type="text" name="comment_text_A[]" placeholder="Comment" style="flex:1">
      <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
    `;
    container.appendChild(div);
  }
  function addCommentRowB() {
    const container = document.getElementById('commentsListB');
    const div = document.createElement('div');
    div.className = 'comment-row';
    div.style.cssText = 'display:flex;gap:8px;align-items:center;margin-top:6px';
    div.innerHTML = `
      <select name="comment_sign_B[]" style="width:64px">
        <option value="+">(+)</option>
        <option value="-" selected>(-)</option>
      </select>
      <input type="text" name="comment_text_B[]" placeholder="Comment" style="flex:1">
      <button type="button" class="button btn-small" onclick="removeCommentRow(this)">Remove</button>
    `;
    container.appendChild(div);
  }
  function removeCommentRow(btn) {
    const row = btn && btn.parentNode;
    if (row && row.parentNode) row.parentNode.removeChild(row);
  }
</script>

