<div class="card">
  <h3>Enter Urinalysis Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap;">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>">
      </div>
    </div>

    <div class="form-row">
      <strong>Physical / Chemical Analysis</strong>
    </div>
    <div class="form-row">
      <label>Color</label>
      <select name="color">
        <option value=""></option>
        <option value="Yellow" <%= test.results && test.results.color === 'Yellow' ? 'selected' : '' %>>Yellow</option>
        <option value="Light Yellow" <%= test.results && test.results.color === 'Light Yellow' ? 'selected' : '' %>>Light Yellow</option>
        <option value="Dark Yellow" <%= test.results && test.results.color === 'Dark Yellow' ? 'selected' : '' %>>Dark Yellow</option>
        <option value="Amber" <%= test.results && test.results.color === 'Amber' ? 'selected' : '' %>>Amber</option>
        <option value="Red" <%= test.results && test.results.color === 'Red' ? 'selected' : '' %>>Red</option>
        <option value="Reddish Brown" <%= test.results && test.results.color === 'Reddish Brown' ? 'selected' : '' %>>Reddish Brown</option>
        <option value="Yellow Orange" <%= test.results && test.results.color === 'Yellow Orange' ? 'selected' : '' %>>Yellow Orange</option>
        <option value="Straw" <%= test.results && test.results.color === 'Straw' ? 'selected' : '' %>>Straw</option>
        <option value="Clear" <%= test.results && test.results.color === 'Clear' ? 'selected' : '' %>>Clear</option>
      </select>
    </div>

    <div class="form-row">
      <label>Transparency</label>
      <select name="appearance">
        <option value=""></option>
        <option value="Turbid" <%= test.results && test.results.appearance === 'Turbid' ? 'selected' : '' %>>Turbid</option>
        <option value="Slightly Turbid" <%= test.results && test.results.appearance === 'Slightly Turbid' ? 'selected' : '' %>>Slightly Turbid</option>
        <option value="Hazy" <%= test.results && test.results.appearance === 'Hazy' ? 'selected' : '' %>>Hazy</option>
        <option value="Clear" <%= test.results && test.results.appearance === 'Clear' ? 'selected' : '' %>>Clear</option>
        <option value="Slightly Hazy" <%= test.results && test.results.appearance === 'Slightly Hazy' ? 'selected' : '' %>>Slightly Hazy</option>
      </select>
    </div>

    <div class="form-row">
      <label>pH</label>
      <input type="text" name="ph" value="<%= test.results && test.results.ph ? test.results.ph : '' %>">
    </div>

    <div class="form-row">
      <label>Specific Gravity</label>
      <input type="text" name="specificGravity" value="<%= test.results && test.results.specificGravity ? test.results.specificGravity : '' %>">
    </div>

    <div class="form-row">
      <label>Glucose</label>
      <select name="glucose">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.glucose === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.glucose === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.glucose === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.glucose === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.glucose === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.glucose === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Protein</label>
      <select name="protein">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.protein === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.protein === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.protein === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.protein === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.protein === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.protein === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Leukocyte</label>
      <select name="leukocyte">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.leukocyte === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.leukocyte === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.leukocyte === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.leukocyte === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.leukocyte === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.leukocyte === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Nitrite</label>
      <select name="nitrite">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.nitrite === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.nitrite === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.nitrite === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.nitrite === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.nitrite === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.nitrite === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Urobilinogen</label>
      <select name="urobilinogen">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.urobilinogen === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.urobilinogen === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.urobilinogen === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.urobilinogen === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.urobilinogen === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.urobilinogen === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Blood</label>
      <select name="blood">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.blood === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.blood === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.blood === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.blood === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.blood === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.blood === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <div class="form-row">
      <label>Ketones</label>
      <select name="ketones">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.ketones === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.ketones === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.ketones === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.ketones === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.ketones === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.ketones === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>
    <div class="form-row">
      <label>Bilirubin</label>
      <select name="bilirubin">
        <option value=""></option>
        <option value="Negative" <%= test.results && test.results.bilirubin === 'Negative' ? 'selected' : '' %>>Negative</option>
        <option value="+" <%= test.results && test.results.bilirubin === '+' ? 'selected' : '' %>>+</option>
        <option value="++" <%= test.results && test.results.bilirubin === '++' ? 'selected' : '' %>>++</option>
        <option value="+++" <%= test.results && test.results.bilirubin === '+++' ? 'selected' : '' %>>+++</option>
        <option value="++++" <%= test.results && test.results.bilirubin === '++++' ? 'selected' : '' %>>++++</option>
        <option value="Trace" <%= test.results && test.results.bilirubin === 'Trace' ? 'selected' : '' %>>Trace</option>
      </select>
    </div>

    <hr>
    <h4>Microscopy Examination</h4>
    <div class="form-row">
      <label>WBC</label>
      <div style="display:flex;gap:8px;align-items:center;"><input type="text" name="wbc" value="<%= test.results && test.results.wbc ? test.results.wbc : '' %>"><span>hpf</span></div>
    </div>
    <div class="form-row">
      <label>RBC</label>
      <div style="display:flex;gap:8px;align-items:center;"><input type="text" name="rbc" value="<%= test.results && test.results.rbc ? test.results.rbc : '' %>"><span>hpf</span></div>
    </div>
    <div class="form-row">
      <label>Epithelial Cells</label>
      <select name="epithelial">
        <option value=""></option>
        <option value="Few" <%= test.results && test.results.epithelial === 'Few' ? 'selected' : '' %>>Few</option>
        <option value="Moderate" <%= test.results && test.results.epithelial === 'Moderate' ? 'selected' : '' %>>Moderate</option>
        <option value="Rare" <%= test.results && test.results.epithelial === 'Rare' ? 'selected' : '' %>>Rare</option>
        <option value="Many" <%= test.results && test.results.epithelial === 'Many' ? 'selected' : '' %>>Many</option>
        <option value="Loaded" <%= test.results && test.results.epithelial === 'Loaded' ? 'selected' : '' %>>Loaded</option>
        <option value="None" <%= test.results && test.results.epithelial === 'None' ? 'selected' : '' %>>None</option>
      </select>
    </div>
    <div class="form-row">
      <label>Mucus Threads</label>
      <select name="mucus">
        <option value=""></option>
        <option value="Few" <%= test.results && test.results.mucus === 'Few' ? 'selected' : '' %>>Few</option>
        <option value="Moderate" <%= test.results && test.results.mucus === 'Moderate' ? 'selected' : '' %>>Moderate</option>
        <option value="Rare" <%= test.results && test.results.mucus === 'Rare' ? 'selected' : '' %>>Rare</option>
        <option value="Many" <%= test.results && test.results.mucus === 'Many' ? 'selected' : '' %>>Many</option>
        <option value="Loaded" <%= test.results && test.results.mucus === 'Loaded' ? 'selected' : '' %>>Loaded</option>
        <option value="None" <%= test.results && test.results.mucus === 'None' ? 'selected' : '' %>>None</option>
      </select>
    </div>
    <div class="form-row">
      <label>Amorphous Crystals</label>
      <select name="amorphous">
        <option value=""></option>
        <option value="Few" <%= test.results && test.results.amorphous === 'Few' ? 'selected' : '' %>>Few</option>
        <option value="Moderate" <%= test.results && test.results.amorphous === 'Moderate' ? 'selected' : '' %>>Moderate</option>
        <option value="Rare" <%= test.results && test.results.amorphous === 'Rare' ? 'selected' : '' %>>Rare</option>
        <option value="Many" <%= test.results && test.results.amorphous === 'Many' ? 'selected' : '' %>>Many</option>
        <option value="Loaded" <%= test.results && test.results.amorphous === 'Loaded' ? 'selected' : '' %>>Loaded</option>
        <option value="None" <%= test.results && test.results.amorphous === 'None' ? 'selected' : '' %>>None</option>
      </select>
    </div>
    <div class="form-row">
      <label>Bacteria</label>
      <select name="bacteria">
        <option value=""></option>
        <option value="Few" <%= test.results && test.results.bacteria === 'Few' ? 'selected' : '' %>>Few</option>
        <option value="Moderate" <%= test.results && test.results.bacteria === 'Moderate' ? 'selected' : '' %>>Moderate</option>
        <option value="Rare" <%= test.results && test.results.bacteria === 'Rare' ? 'selected' : '' %>>Rare</option>
        <option value="Many" <%= test.results && test.results.bacteria === 'Many' ? 'selected' : '' %>>Many</option>
        <option value="Loaded" <%= test.results && test.results.bacteria === 'Loaded' ? 'selected' : '' %>>Loaded</option>
        <option value="None" <%= test.results && test.results.bacteria === 'None' ? 'selected' : '' %>>None</option>
      </select>
    </div>

    <div class="form-row">
      <label>Others</label>
      <input type="text" name="others" value="<%= test.results && test.results.others ? test.results.others : '' %>">
    </div>

    <div class="form-row">
      <label>Note</label>
      <textarea name="note" rows="3"><%= test.results && test.results.note ? test.results.note : '' %></textarea>
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <%- include('../partials/signatory_select', { prefix: 'mt', label: 'Medical Technologist', role: 'Medical Technologist', nameInput: 'mtName', licenseInput: 'mtLicense', existingName: (test.results && test.results.performedByName) ? test.results.performedByName : '', existingLicense: (test.results && test.results.performedByLicense) ? test.results.performedByLicense : '' }) %>

    <div class="form-row">
      <h4>Validation</h4>
    </div>
    <%- include('../partials/signatory_select', { prefix: 'validated', label: 'Validator', role: 'Medical Technologist', nameInput: 'validatedByName', licenseInput: 'validatedByLicense', existingName: (test.results && test.results.validatedByName) ? test.results.validatedByName : '', existingLicense: (test.results && test.results.validatedByLicense) ? test.results.validatedByLicense : '' }) %>

    <%- include('../partials/signatory_select', { prefix: 'path', label: 'Pathologist', role: 'Pathologist', nameInput: 'pathName', licenseInput: 'pathLicense', existingName: (test.results && test.results.requestedByName) ? test.results.requestedByName : '', existingLicense: (test.results && test.results.requestedByLicense) ? test.results.requestedByLicense : '' }) %>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>
</div>
