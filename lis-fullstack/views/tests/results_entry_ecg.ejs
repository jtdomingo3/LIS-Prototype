<div class="card">
  <h3>Enter ECG Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : '' %>">
      </div>
    </div>

    <div style="margin-top:8px">
      <label>Findings / Impression (paragraphs)</label>
      <div style="margin-bottom:6px; display:flex; gap:8px; align-items:center;">
        <button type="button" class="button btn-small" onclick="wrapSelection('<b>','</b>')">B</button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<i>','</i>')"><em>I</em></button>
        <button type="button" class="button btn-small" onclick="wrapSelection('<u>','</u>')">U</button>
        <button type="button" class="button btn-small" onclick="insertParagraph()">Insert Paragraph</button>
        <label style="margin-left:12px">Font:</label>
        <select name="paragraphsFontFamily">
          <option value="Times New Roman" <%= test.results && test.results.paragraphs_font_family==='Times New Roman' ? 'selected' : '' %>>Times New Roman</option>
          <option value="Courier New" <%= test.results && test.results.paragraphs_font_family==='Courier New' ? 'selected' : '' %>>Courier New</option>
          <option value="Arial" <%= test.results && test.results.paragraphs_font_family==='Arial' ? 'selected' : '' %>>Arial</option>
          <option value="Georgia" <%= test.results && test.results.paragraphs_font_family==='Georgia' ? 'selected' : '' %>>Georgia</option>
          <option value="Garamond" <%= test.results && test.results.paragraphs_font_family==='Garamond' ? 'selected' : '' %>>Garamond</option>
          <option value="Calibri" <%= test.results && test.results.paragraphs_font_family==='Calibri' ? 'selected' : '' %>>Calibri</option>
        </select>
        <label>Size:</label>
        <select name="paragraphsFontSize">
          <option value="14px">14px</option>
          <option value="16px" selected>16px</option>
          <option value="18px">18px</option>
        </select>
      </div>
      <textarea id="paragraphs" name="paragraphs" rows="8" spellcheck="true" style="width:100%; font-family:inherit;"><%= test && test.results && (test.results.paragraphs || test.results.result) ? (test.results.paragraphs || test.results.result) : '<p>Enter ECG findings and impression here.</p>' %></textarea>
    </div>

    <hr>
    <h4>Reading Physician</h4>
    <div class="form-row">
      <label>Doctor Name</label>
      <input type="text" name="doctorName" placeholder="Doctor's name" value="<%= test.results && test.results.doctorName ? test.results.doctorName : (test && test.requestedBy && test.requestedBy.name ? test.requestedBy.name : '') %>">
    </div>
    <div class="form-row">
      <label>License</label>
      <input type="text" name="doctorLicense" placeholder="License number" value="<%= test.results && test.results.doctorLicense ? test.results.doctorLicense : '' %>">
    </div>
    <div class="form-row">
      <label>Designation</label>
      <select name="doctorDesignation" id="doctorDesignationSelect" onchange="onDesignationChange()">
        <option value="Internist" <%= test.results && test.results.doctorDesignation==='Internist' ? 'selected' : '' %>>Internist</option>
        <option value="Physician" <%= test.results && test.results.doctorDesignation==='Physician' ? 'selected' : '' %>>Physician</option>
        <option value="Cardiologist" <%= test.results && test.results.doctorDesignation==='Cardiologist' ? 'selected' : '' %>>Cardiologist</option>
        <option value="Other" <%= test.results && test.results.doctorDesignation && ['Internist','Physician','Cardiologist'].indexOf(test.results.doctorDesignation)===-1 && test.results.doctorDesignation ? 'selected' : '' %>>Other</option>
      </select>
      <input type="text" name="doctorDesignationOther" id="doctorDesignationOther" placeholder="Enter designation title" style="margin-top:8px; display:none;" value="<%= test.results && test.results.doctorDesignation && ['Internist','Physician','Cardiologist'].indexOf(test.results.doctorDesignation)===-1 ? test.results.doctorDesignation : '' %>">
    </div>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>

  <script>
    function wrapSelection(openTag, closeTag) {
      var ta = document.getElementById('paragraphs');
      var start = ta.selectionStart;
      var end = ta.selectionEnd;
      var selected = ta.value.substring(start, end);
      var newText = openTag + selected + closeTag;
      ta.value = ta.value.substring(0, start) + newText + ta.value.substring(end);
      ta.focus();
      ta.selectionStart = start + openTag.length;
      ta.selectionEnd = start + openTag.length + selected.length;
    }
    function insertParagraph(){
      var ta = document.getElementById('paragraphs');
      var pos = ta.selectionStart || ta.value.length;
      var p = '<p>New paragraph...</p>';
      ta.value = ta.value.substring(0,pos) + p + ta.value.substring(pos);
      ta.focus();
    }
    function onDesignationChange(){
      var sel = document.getElementById('doctorDesignationSelect');
      var other = document.getElementById('doctorDesignationOther');
      if(!sel || !other) return;
      if(sel.value === 'Other'){
        other.style.display = 'block';
        other.focus();
      } else {
        other.style.display = 'none';
      }
    }
    // initialize visibility on load
    (function(){
      try{ onDesignationChange(); }catch(e){}
    })();
  </script>
</div>