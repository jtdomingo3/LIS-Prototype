<%- include('../partials/test_patient_banner', { test, patient: typeof patient !== 'undefined' ? patient : (test ? test.patient : null) }) %>

<div class="card" style="padding: 24px 28px; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0;">
  <form action="/tests/<%= test.id %>/results" method="POST" id="bloodTypingForm">
    <input type="hidden" name="_method" value="POST">

    <!-- Timing & Meta Bar -->
    <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 20px; flex-wrap: wrap; padding: 10px 18px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px;">
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Date:</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 135px;">
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Time Requested:</label>
        <input type="time" name="timeRequested" value="<%= test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '' %>" readonly style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 115px;">
      </div>
      <div style="display: flex; align-items: center; gap: 8px;">
        <label style="margin: 0; font-weight: 600; font-size: 0.88em; color: #475569; white-space: nowrap;">Time Released:</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>" style="height: 34px; padding: 4px 10px; border-radius: 6px; border: 1px solid #cbd5e1; background: #fff; font-size: 0.88em; width: 115px;">
      </div>
    </div>

    <!-- Parameter Fields -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 24px;">
      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px;">
        <label style="display: block; font-weight: 700; font-size: 0.95em; color: #0f172a; margin-bottom: 8px;">Specimen</label>
        <select name="specimen" required style="width: 100%; height: 38px; padding: 6px 12px; font-size: 0.92em; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; font-weight: 600;">
          <option value="">-- Select Specimen --</option>
          <option value="Whole Blood" <%= test.results && test.results.specimen === 'Whole Blood' ? 'selected' : '' %>>Whole Blood</option>
          <option value="Packed RBC" <%= test.results && test.results.specimen === 'Packed RBC' ? 'selected' : '' %>>Packed RBC</option>
          <option value="Plasma" <%= test.results && test.results.specimen === 'Plasma' ? 'selected' : '' %>>Plasma</option>
          <option value="Platelet" <%= test.results && test.results.specimen === 'Platelet' ? 'selected' : '' %>>Platelet</option>
        </select>
      </div>

      <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px 20px;">
        <label style="display: block; font-weight: 700; font-size: 0.95em; color: #0f172a; margin-bottom: 8px;">Blood Group & Rh Result</label>
        <select name="result" required style="width: 100%; height: 38px; padding: 6px 12px; font-size: 0.95em; border-radius: 8px; border: 1px solid #cbd5e1; background: #fff; font-weight: 700; color: #1e40af;">
          <option value="">-- Select Result --</option>
          <option value="AB+" <%= test.results && test.results.result === 'AB+' ? 'selected' : '' %>>AB Positive (AB+)</option>
          <option value="AB-" <%= test.results && test.results.result === 'AB-' ? 'selected' : '' %>>AB Negative (AB-)</option>
          <option value="A+" <%= test.results && test.results.result === 'A+' ? 'selected' : '' %>>A Positive (A+)</option>
          <option value="A-" <%= test.results && test.results.result === 'A-' ? 'selected' : '' %>>A Negative (A-)</option>
          <option value="B+" <%= test.results && test.results.result === 'B+' ? 'selected' : '' %>>B Positive (B+)</option>
          <option value="B-" <%= test.results && test.results.result === 'B-' ? 'selected' : '' %>>B Negative (B-)</option>
          <option value="O+" <%= test.results && test.results.result === 'O+' ? 'selected' : '' %>>O Positive (O+)</option>
          <option value="O-" <%= test.results && test.results.result === 'O-' ? 'selected' : '' %>>O Negative (O-)</option>
        </select>
      </div>
    </div>

    <!-- Signatures & Verification Section -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 20px; margin-top: 24px;">
      <div style="font-weight: 700; font-size: 0.88em; text-transform: uppercase; color: #475569; letter-spacing: 0.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
        <i class="fa fa-signature" style="color: #10b981;"></i> Medical Staff Signatures & Verification
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;">
          <%- include('../partials/signatory_select', { prefix: 'mt', label: 'Medical Technologist', role: 'Medical Technologist', nameInput: 'mtName', licenseInput: 'mtLicense', existingName: (test.results && test.results.performedByName) ? test.results.performedByName : '', existingLicense: (test.results && test.results.performedByLicense) ? test.results.performedByLicense : '' }) %>
        </div>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;">
          <%- include('../partials/signatory_select', { prefix: 'validated', label: '2nd MedTech (Validator)', role: 'Medical Technologist', nameInput: 'validatedByName', licenseInput: 'validatedByLicense', existingName: (test.results && test.results.validatedByName) ? test.results.validatedByName : '', existingLicense: (test.results && test.results.validatedByLicense) ? test.results.validatedByLicense : '' }) %>
        </div>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 12px 14px;">
          <%- include('../partials/signatory_select', { prefix: 'path', label: 'Pathologist', role: 'Pathologist', nameInput: 'pathName', licenseInput: 'pathLicense', existingName: (test.results && test.results.requestedByName) ? test.results.requestedByName : '', existingLicense: (test.results && test.results.requestedByLicense) ? test.results.requestedByLicense : '' }) %>
        </div>
      </div>
    </div>

    <!-- Sticky / Bottom Action Buttons -->
    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 24px; padding-top: 16px; border-top: 1px solid #e2e8f0;">
      <a href="/tests/<%= test.id %>" class="button btn-secondary" style="height: 42px; padding: 0 20px; border-radius: 8px; font-weight: 600;">Cancel</a>
      <button type="submit" class="button btn-primary" style="height: 42px; padding: 0 28px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fa fa-check"></i> Save Results
      </button>
    </div>

  </form>
</div>
