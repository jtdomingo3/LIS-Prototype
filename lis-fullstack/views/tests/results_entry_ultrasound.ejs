</style>

<script>
  var DEFAULT_TITLES = {
    'ultrasound-abd-kubp-hbt': 'ULTRASOUND RESULT',
    'ultrasound-transvaginal': 'TRANSVAGINAL ULTRASOUND',
    'ultrasound-pelvic': 'PELVIC ULTRASOUND',
    'ultrasound-pelvic-biometry': 'PELVIC ULTRASOUND',
    'ultrasound-biophysical': 'BIOPHYSICAL ULTRASOUND',
    'ultrasound-1st-trimester-obstetrics': '1st TRIMESTER OBSTETRICS (ULTRASOUND)'
  };

  var currentProcedure = '<%= currentType %>';

  function selectProcedure(type) {
    currentProcedure = type;
    var input = document.getElementById('ultrasoundTypeInput');
    if (input) input.value = type;

    // Update tab styles
    var tabs = document.querySelectorAll('.proc-tab');
    tabs.forEach(function(t){
      if (t.getAttribute('data-proc') === type) {
        t.classList.add('active-proc-tab');
      } else {
        t.classList.remove('active-proc-tab');
      }
    });

    // Toggle panels and enable/disable inputs so only active panel submits
    var panels = document.querySelectorAll('.proc-panel');
    panels.forEach(function(p){
      var isTarget = p.id === 'panel-' + type;
      if (isTarget) {
        p.style.display = 'block';
        p.querySelectorAll('input, select, textarea').forEach(function(el){
          el.disabled = false;
        });
      } else {
        p.style.display = 'none';
        p.querySelectorAll('input, select, textarea').forEach(function(el){
          el.disabled = true;
        });
      }
    });

    // Auto-update section title if default
    var titleInput = document.getElementById('section_title_input');
    if (titleInput) {
      var currentVal = titleInput.value.trim();
      var isDefaultTitle = !currentVal || Object.values(DEFAULT_TITLES).indexOf(currentVal) !== -1;
      if (isDefaultTitle && DEFAULT_TITLES[type]) {
        titleInput.value = DEFAULT_TITLES[type];
      }
    }
  }

  // Examination select custom input toggle for ABD/KUBP/HBT
  function updateExaminationField() {
    var sel = document.querySelector('[name="examination_select"]');
    var custom = document.getElementById('examination_custom');
    var hidden = document.getElementById('examination_hidden');
    if (!sel || !hidden || !custom) return;
    if (sel.value === 'Other') {
      custom.style.display = 'inline-block';
      hidden.value = custom.value || '';
    } else {
      custom.style.display = 'none';
      hidden.value = sel.value || '';
    }
  }

  // Toolbar functions for ABD/KUBP/HBT textarea
  function wrapSelection(textareaId, openTag, closeTag) {
    var ta = document.getElementById(textareaId);
    if (!ta) return;
    var start = ta.selectionStart;
    var end = ta.selectionEnd;
    var selected = ta.value.substring(start, end);
    var newText = openTag + selected + closeTag;
    ta.value = ta.value.substring(0, start) + newText + ta.value.substring(end);
    ta.focus();
    ta.selectionStart = start + openTag.length;
    ta.selectionEnd = start + openTag.length + selected.length;
  }

  function insertParagraph(textareaId) {
    var ta = document.getElementById(textareaId);
    if (!ta) return;
    var pos = ta.selectionStart || ta.value.length;
    var p = '\n\n';
    ta.value = ta.value.substring(0, pos) + p + ta.value.substring(pos);
    ta.focus();
  }

  // Comments List Row Management
