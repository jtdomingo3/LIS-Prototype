                  <input type="text" name="comment_text[]" value="<%= c.text || '' %>" placeholder="Comment description..." style="flex: 1; height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; padding: 4px 10px; font-size: 0.9em; font-weight: 500;">
