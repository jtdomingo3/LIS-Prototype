                  <select name="comment_sign[]" style="width: 70px; height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; font-weight: 700; padding: 2px 6px;">
                    <option value="-" <%= c.sign === '-' ? 'selected' : '' %>>-</option>
