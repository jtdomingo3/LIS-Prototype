  // =========================================================================
  // DATE FORMATTING (Month DD, YYYY)
  // =========================================================================
  var MONTH_NAMES = ['JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE', 'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'];

  function formatDateToWords(dateStr) {
    if (!dateStr) return '';
    var parts = String(dateStr).trim().split('-');
    if (parts.length === 3) {
      var year = parts[0];
      var monthIdx = parseInt(parts[1], 10) - 1;
      var day = parseInt(parts[2], 10);
      if (monthIdx >= 0 && monthIdx < 12 && !isNaN(day)) {
        return MONTH_NAMES[monthIdx] + ' ' + day + ', ' + year;
      }
    }
    var d = new Date(dateStr);
    if (!isNaN(d.getTime())) {
      return MONTH_NAMES[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();
    }
    return dateStr;
  }

  function updateEdcDisplay(prefix) {
    var input = document.getElementById('edc_' + prefix);
    var badge = document.getElementById('edc_badge_' + prefix);
    if (input && badge) {
      badge.innerText = input.value ? formatDateToWords(input.value) : '';
    }
  }

  function updateEddDisplay(prefix) {
    var input = document.getElementById('edd_' + prefix);
    var badge = document.getElementById('edd_badge_' + prefix);
    if (input && badge) {
      badge.innerText = input.value ? formatDateToWords(input.value) : '';
    }
  }

  // =========================================================================
  // SMART DROPDOWNS & CUSTOM INPUT
  // =========================================================================
  function handleDropdownWithCustom(selectEl, customId, hiddenId) {
    var custom = document.getElementById(customId);
    var hidden = document.getElementById(hiddenId);
    if (!selectEl || !hidden) return;

    if (selectEl.value === '__other__') {
      if (custom) {
        custom.style.display = 'block';
        custom.focus();
        hidden.value = custom.value || '';
        custom.oninput = function() { hidden.value = this.value; };
      }
    } else {
      if (custom) custom.style.display = 'none';
      hidden.value = selectEl.value;
    }
  }

  // =========================================================================
  // BIOPHYSICAL PROFILE SCORING (BPS 8/8)
  // =========================================================================
  function calculateBpsTotal() {
    var tone = parseInt((document.getElementById('fetal_tone_bps') || {}).value || '2', 10);
    var mov = parseInt((document.getElementById('fetal_movement_bps') || {}).value || '2', 10);
    var breath = parseInt((document.getElementById('fetal_breathing_bps') || {}).value || '2', 10);
    var af = parseInt((document.getElementById('amniotic_score_bps') || {}).value || '2', 10);

    var total = tone + mov + breath + af;
    var totalInput = document.getElementById('bps_total_bps');
    var badge = document.getElementById('bps_badge_bps');

    if (totalInput) totalInput.value = total + '/8';
    if (badge) {
      if (total >= 8) {
        badge.innerText = 'NORMAL (8/8)';
        badge.style.background = '#d1fae5';
        badge.style.color = '#065f46';
      } else if (total >= 6) {
        badge.innerText = 'EQUIVOCAL (6/8)';
        badge.style.background = '#fef3c7';
        badge.style.color = '#92400e';
      } else {
        badge.innerText = 'ABNORMAL (' + total + '/8)';
        badge.style.background = '#fee2e2';
        badge.style.color = '#991b1b';
      }
    }
  }

  function presetBpsScore(tone, mov, breath, af) {
    var toneEl = document.getElementById('fetal_tone_bps');
    var movEl = document.getElementById('fetal_movement_bps');
    var breathEl = document.getElementById('fetal_breathing_bps');
    var afEl = document.getElementById('amniotic_score_bps');

    if (toneEl) toneEl.value = tone;
    if (movEl) movEl.value = mov;
    if (breathEl) breathEl.value = breath;
    if (afEl) afEl.value = af;

    calculateBpsTotal();
  }

  // =========================================================================
  // IMPRESSION AUTO-GENERATION & TEMPLATES (FROM ULTRASOUND VON.XLSX)
  // =========================================================================
  function clearImpression() {
    var ta = document.getElementById('impression_textarea') || document.querySelector('[name="impression"]');
    if (ta) ta.value = '';
  }

  function setImpressionTemplate(tplKey) {
    var ta = document.getElementById('impression_textarea') || document.querySelector('[name="impression"]');
    if (!ta) return;

    var templates = {
      'standard_ob': 'SINGLE, LIVE, INTRAUTERINE PREGNANCY OF   __ W __ D   AOG\nAGE OF GESTATION, CEPHALIC PRESENTATION. NORMOHYDRAMNIOS,\nEDD: __________________.',
      'tvs_live': 'SINGLE, LIVE, INTRAUTERINE PREGNANCY OF   __ W __ D   AOG\nEDD: __________________.',
      'tvs_followup': 'EARLY INTRAUTERINE PREGNANCY.\nSUGGEST FOLLOW UP ULTRASOUND IN 1 - 2 WEEKS TO ASCERTAIN EMBRYONIC VIABILITY.',
      'twin_live': 'TWIN, LIVE, INTRAUTERINE PREGNANCY\nFETUS A: __ W __ D AOG, FHR: ___ BPM\nFETUS B: __ W __ D AOG, FHR: ___ BPM\nEDD: __________________.',
      'normal_pelvic': 'NORMAL STUDY OF THE URINARY BLADDER AND UTERUS.\nNO ADNEXAL MASS OR ABNORMAL FREE FLUID NOTED.'
    };

    if (templates[tplKey]) {
      ta.value = templates[tplKey];
      ta.focus();
    }
  }

  function autoGenerateImpression() {
    var ta = document.getElementById('impression_textarea') || document.querySelector('[name="impression"]');
    if (!ta) return;

    var text = '';

    if (currentProcedure === 'ultrasound-pelvic-biometry' || currentProcedure === 'ultrasound-biophysical') {
      var pfx = currentProcedure === 'ultrasound-pelvic-biometry' ? 'pb' : 'bps';
      
      var numEl = document.getElementById('number_of_fetus_' + pfx);
      var numFetus = (numEl ? numEl.value : 'SINGLE').trim().toUpperCase();

      var aoaText = '';
      var aoaEl = document.getElementById('aoa_text_' + pfx);
      if (aoaEl && aoaEl.value.trim()) {
        aoaText = aoaEl.value.trim();
      } else {
        var w = (document.getElementById('aoa_w_' + pfx) || {}).value || '';
        var d = (document.getElementById('aoa_d_' + pfx) || {}).value || '0';
        if (w) aoaText = w + ' W ' + d + ' D';
      }
      if (!aoaText) aoaText = '__ W __ D';

      var presEl = document.getElementById('presentation_' + pfx);
      var presentation = (presEl ? presEl.value : 'CEPHALIC').trim().toUpperCase();

      var afEl = document.getElementById('amniotic_fluid_' + pfx);
      var afRaw = (afEl ? afEl.value : 'ADEQUATE').trim().toUpperCase();
      var afStatus = 'NORMOHYDRAMNIOS';
      if (/OLIGO|DECREAS/i.test(afRaw)) {
        afStatus = 'OLIGOHYDRAMNIOS';
      } else if (/POLY|INCREAS/i.test(afRaw)) {
        afStatus = 'POLYHYDRAMNIOS';
      } else if (/ADEQUATE|NORMO/i.test(afRaw)) {
        afStatus = 'NORMOHYDRAMNIOS';
      } else if (afRaw) {
        afStatus = afRaw;
      }

      var eddDateEl = document.getElementById('edc_' + pfx) || document.getElementById('edd_' + pfx);
      var eddFormatted = eddDateEl && eddDateEl.value ? formatDateToWords(eddDateEl.value) : '__________________';

      text = numFetus + ', LIVE, INTRAUTERINE PREGNANCY OF   ' + aoaText + '   AOG\n' +
             'AGE OF GESTATION, ' + presentation + ' PRESENTATION. ' + afStatus + ',\n' +
             'EDD: ' + eddFormatted + '.';

    } else if (currentProcedure === 'ultrasound-transvaginal' || currentProcedure === 'ultrasound-pelvic') {
      var pfx = currentProcedure === 'ultrasound-transvaginal' ? 'tv' : 'pel';
      var aoaText = '';
      var aoaEl = document.getElementById('aoa_text_' + pfx);
      if (aoaEl && aoaEl.value.trim()) {
        aoaText = aoaEl.value.trim();
      } else {
        var w = (document.getElementById('aoa_w_' + pfx) || {}).value || '';
        var d = (document.getElementById('aoa_d_' + pfx) || {}).value || '0';
        if (w) aoaText = w + ' W ' + d + ' D';
      }
      if (!aoaText) aoaText = '__ W __ D';

      var eddEl = document.getElementById('edd_' + pfx);
      var eddFormatted = eddEl && eddEl.value ? formatDateToWords(eddEl.value) : '__________________';

      text = 'SINGLE, LIVE, INTRAUTERINE PREGNANCY OF   ' + aoaText + '   AOG\n' +
             'EDD: ' + eddFormatted + '.';

    } else if (currentProcedure === 'ultrasound-1st-trimester-obstetrics') {
      var isTwinCb = document.getElementById('isTwin');
      var isTwin = isTwinCb && isTwinCb.checked;
      var eddEl = document.getElementById('edd_ob');
      var eddFormatted = eddEl && eddEl.value ? formatDateToWords(eddEl.value) : '__________________';

      if (isTwin) {
        var aoaA = (document.getElementById('aoa_text_A') || {}).value || '';
        if (!aoaA) {
          var wA = (document.getElementById('aoa_w_A') || {}).value || '';
          var dA = (document.getElementById('aoa_d_A') || {}).value || '0';
          if (wA) aoaA = wA + ' W ' + dA + ' D';
        }
        var fhrA = (document.getElementById('fhr_A') || {}).value || '';

        var aoaB = (document.getElementById('aoa_text_B') || {}).value || '';
        if (!aoaB) {
          var wB = (document.getElementById('aoa_w_B') || {}).value || '';
          var dB = (document.getElementById('aoa_d_B') || {}).value || '0';
          if (wB) aoaB = wB + ' W ' + dB + ' D';
        }
        var fhrB = (document.getElementById('fhr_B') || {}).value || '';

        text = 'TWIN, LIVE, INTRAUTERINE PREGNANCY\n' +
               'FETUS A: ' + (aoaA || '__ W __ D') + ' AOG' + (fhrA ? ', FHR: ' + fhrA + ' BPM' : '') + '\n' +
               'FETUS B: ' + (aoaB || '__ W __ D') + ' AOG' + (fhrB ? ', FHR: ' + fhrB + ' BPM' : '') + '\n' +
               'EDD: ' + eddFormatted + '.';
      } else {
        var aoa = (document.getElementById('aoa_text_ob') || {}).value || '';
        if (!aoa) {
          var w = (document.getElementById('aoa_w_ob') || {}).value || '';
          var d = (document.getElementById('aoa_d_ob') || {}).value || '0';
          if (w) aoa = w + ' W ' + d + ' D';
        }
        var fhr = (document.getElementById('fhr_ob') || {}).value || '';

        text = 'SINGLE, LIVE, INTRAUTERINE PREGNANCY OF   ' + (aoa || '__ W __ D') + '   AOG\n' +
               (fhr ? 'FETAL HEART RATE: ' + fhr + ' BPM.\n' : '') +
               'EDD: ' + eddFormatted + '.';
      }
    } else {
      text = 'NORMAL ULTRASOUND STUDY OF THE EXAMINED ORGANS.\nNO REMARKABLE ABNORMALITY DETECTED.';
    }

    ta.value = text;
    ta.focus();
    ta.style.borderColor = '#10b981';
    ta.style.backgroundColor = '#ecfdf5';
    setTimeout(function(){
      ta.style.borderColor = '#cbd5e1';
      ta.style.backgroundColor = '#ffffff';
    }, 900);
  }

  // =========================================================================
  // LIFECYCLE INIT
  // =========================================================================
  document.addEventListener('DOMContentLoaded', function(){
    // Initialize active procedure state and disable non-active panel inputs
    selectProcedure(currentProcedure);

    updateExaminationField();
    var sel = document.querySelector('[name="examination_select"]');
    var custom = document.getElementById('examination_custom');
    if (sel) sel.addEventListener('change', updateExaminationField);
    if (custom) custom.addEventListener('input', function(){
      var hidden = document.getElementById('examination_hidden');
      if (hidden) hidden.value = custom.value;
    });

    // Initialize date badge displays
    ['tv', 'pel', 'pb', 'bps', 'ob'].forEach(function(pfx){
      updateEdcDisplay(pfx);
      updateEddDisplay(pfx);
    });

    // Initialize BPS scoring summary badge
    calculateBpsTotal();

    var form = document.getElementById('ultrasoundForm');
    if (form) {
      form.addEventListener('submit', function(){
        // Ensure active procedure is selected and inputs are properly enabled
        selectProcedure(currentProcedure);
        updateExaminationField();
      });
    }
  });
</script>
