              <div style="display: flex; flex-direction: column; gap: 10px;">
                <div>
                  <label style="margin: 0 0 4px 0; font-weight: 600; font-size: 0.85em; color: #1e293b; display: block;">Gestational Sac (GS)</label>
                  <div style="display: flex; gap: 6px;">
                    <input type="text" name="gestational_sac_length_B" placeholder="0.00 cm" value="<%= test && test.results && test.results.gestational_sac_length_B ? test.results.gestational_sac_length_B : '' %>" style="height: 34px; padding: 4px 8px; font-weight: 600; border-radius: 6px; border: 1px solid #cbd5e1; width: 60%;">
