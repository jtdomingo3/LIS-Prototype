                    <input type="text" name="crl_age_A" placeholder="6w6d" value="<%= test && test.results && test.results.crl_age_A ? test.results.crl_age_A : '' %>" style="height: 34px; padding: 4px 8px; font-weight: 600; border-radius: 6px; border: 1px solid #cbd5e1; width: 40%;">
