  // =========================================================================
  // BIOMETRY SYNCHRONIZATION & AGE FORMULAS
  // =========================================================================
  function updateBiometryRow(prefix, param) {
    var wInput = document.getElementById(param + '_w_' + prefix);
    var dInput = document.getElementById(param + '_d_' + prefix);
    var labelInput = document.getElementById(param + '_label_' + prefix);
    var badge = document.getElementById(param + '_badge_' + prefix);
    if (!wInput || !dInput) return;

    var w = wInput.value.trim();
    var d = dInput.value.trim();
    if (!w && !d) {
      if (labelInput) labelInput.value = '';
      if (badge) badge.innerText = '--';
      return;
    }

    var formatted = (w ? w : '0') + ' W ' + (d ? d : '0') + ' D';
    if (labelInput) labelInput.value = formatted;
    if (badge) badge.innerText = formatted;
  }

  function updateAOAInput(prefix) {
    var wInput = document.getElementById('aoa_w_' + prefix);
    var dInput = document.getElementById('aoa_d_' + prefix);
    var textInput = document.getElementById('aoa_text_' + prefix);
    if (!wInput || !dInput || !textInput) return;

    var w = wInput.value.trim();
    var d = dInput.value.trim();
    if (w || d) {
      textInput.value = (w ? w : '0') + ' W ' + (d ? d : '0') + ' D';
    }
  }

  function calculateAOA(prefix) {
    var params = ['bpd', 'hc', 'ac', 'fl'];
    var sumDays = 0;
    var count = 0;

    params.forEach(function(p){
      var wInput = document.getElementById(p + '_w_' + prefix);
      var dInput = document.getElementById(p + '_d_' + prefix);
      if (wInput && wInput.value.trim() !== '') {
        var w = parseInt(wInput.value.trim(), 10) || 0;
        var d = parseInt(dInput ? dInput.value.trim() : '0', 10) || 0;
        sumDays += (w * 7) + d;
        count++;
      }
    });

    if (count > 0) {
      var avgDays = Math.round(sumDays / count);
      var avgW = Math.floor(avgDays / 7);
      var avgD = avgDays % 7;

      var aoaW = document.getElementById('aoa_w_' + prefix);
      var aoaD = document.getElementById('aoa_d_' + prefix);
      var aoaText = document.getElementById('aoa_text_' + prefix);

      if (aoaW) aoaW.value = avgW;
      if (aoaD) aoaD.value = avgD;
      if (aoaText) aoaText.value = avgW + ' W ' + avgD + ' D';
    } else {
      alert('Please enter Weeks (W) for at least one biometry measurement (BPD, HC, AC, FL) first.');
    }
  }

  function copyCrlToAoa(prefix) {
    var crlW = document.getElementById('crl_w_' + prefix);
    var crlD = document.getElementById('crl_d_' + prefix);
    var aoaW = document.getElementById('aoa_w_' + prefix);
    var aoaD = document.getElementById('aoa_d_' + prefix);
