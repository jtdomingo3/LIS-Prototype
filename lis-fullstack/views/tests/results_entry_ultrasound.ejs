                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- TWIN PREGNANCY BLOCK -->
        <div id="twinBlock" style="display:<%= (test && test.results && test.results.isTwin) ? 'block' : 'none' %>">
