}

.manual-pre {
    background: #0f172a;
    color: #f8fafc;
    padding: 14px 18px;
    border-radius: 8px;
    overflow-x: auto;
    font-size: 0.9em;
    margin: 14px 0;
}

.manual-table {
    width: 100%;
    border-collapse: collapse;
    margin: 16px 0;
}

.manual-table th, .manual-table td {
    border: 1px solid #e2e8f0;
    padding: 10px 14px;
    text-align: left;
}

.manual-table th {
    background: #f8fafc;
    font-weight: 600;
}

.manual-hr {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 24px 0;
}

.step-arrow {
    display: inline-block;
    color: var(--secondary-green);
    font-weight: bold;
    margin: 0 4px;
}

.manual-math {
    font-style: italic;
    font-family: Cambria, 'Times New Roman', serif;
    padding: 0 2px;
}

/* Alert Boxes */
.manual-blockquote {
    border-left: 4px solid #cbd5e1;
    margin: 14px 0;
    padding: 10px 16px;
    background: #f8fafc;
    border-radius: 0 8px 8px 0;
}

.alert-box {
    margin: 16px 0;
    padding: 12px 16px;
    border-radius: 8px;
    border-left: 5px solid;
}

.alert-note {
    border-color: #3b82f6;
    background: #eff6ff;
    color: #1e40af;
}

.alert-warning {
    border-color: #f59e0b;
    background: #fffbeb;
    color: #92400e;
}

.alert-important {
    border-color: #ef4444;
    background: #fef2f2;
    color: #991b1b;
}

.alert-tip {
    border-color: #10b981;
    background: #ecfdf5;
    color: #065f46;
}

/* KaTeX Formula Styling in User Manual */
.katex-display {
    margin: 18px 0 !important;
    padding: 14px 20px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow-x: auto;
    overflow-y: hidden;
    text-align: center;
    box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
}

.katex-inline {
    display: inline-block;
    vertical-align: middle;
    padding: 0 2px;
}

.katex {
    font-size: 1.05em;
    text-rendering: auto;
}

/* Responsive adjustments */
@media (max-width: 992px) {
    .manual-layout {
        flex-direction: column;
    }
    .manual-sidebar {
        width: 100%;
        position: static;
        max-height: 250px;
        margin-bottom: 16px;
    }
}

@media print {
    .manual-sidebar, .manual-header-card, .sidebar, .header {
        display: none !important;
    }
    .main-content {
        margin: 0 !important;
        padding: 0 !important;
    }
    .manual-doc-card {
        border: none !important;
        box-shadow: none !important;
        padding: 0 !important;
    }
}
</style>

<script>
// Smooth scroll for TOC anchors
function handleTocClick(event, slug) {
    event.preventDefault();
    const el = document.getElementById(slug);
    if (el) {
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        // Update URL hash without jump
        history.pushState(null, null, '#' + slug);
    }
}

// Live Search in User Manual
function filterManualContent() {
    const input = document.getElementById('manualSearchInput');
    const clearBtn = document.getElementById('clearManualSearch');
    const query = (input.value || '').trim().toLowerCase();

    if (clearBtn) clearBtn.style.display = query ? 'block' : 'none';

    const card = document.getElementById('manualDocCard');
    if (!card) return;

    // Get all heading and paragraph blocks
    const blocks = card.querySelectorAll('.manual-h2, .manual-h3, .manual-p, .manual-list, .manual-table, .katex-display');

    if (!query) {
        // Reset view
        blocks.forEach(b => { b.style.display = ''; });
        return;
    }

    blocks.forEach(block => {
        const text = block.textContent.toLowerCase();
        if (text.includes(query)) {
            block.style.display = '';
            // Ensure previous heading is also visible
            let prev = block.previousElementSibling;
            while (prev && !prev.classList.contains('manual-h2')) {
                prev.style.display = '';
                prev = prev.previousElementSibling;
            }
            if (prev) prev.style.display = '';
        } else {
            block.style.display = 'none';
        }
    });
}

function clearSearch() {
    const input = document.getElementById('manualSearchInput');
    if (input) {
        input.value = '';
        filterManualContent();
        input.focus();
    }
}

// Render KaTeX Math in Document
function renderManualFormulas() {
    const card = document.getElementById('manualDocCard');
    if (!card) return;

    if (typeof renderMathInElement === 'function') {
        renderMathInElement(card, {
            delimiters: [
                { left: '$$', right: '$$', display: true },
                { left: '\\[', right: '\\]', display: true },
                { left: '$', right: '$', display: false },
                { left: '\\(', right: '\\)', display: false }
            ],
            ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
            throwOnError: false
        });
    } else if (typeof katex !== 'undefined') {
        card.querySelectorAll('[data-expr]').forEach(el => {
            const expr = el.getAttribute('data-expr');
            const isDisplay = el.classList.contains('katex-display');
            if (expr) {
                try {
                    katex.render(expr, el, { displayMode: isDisplay, throwOnError: false });
                } catch(e) {}
            }
        });
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderManualFormulas);
} else {
    renderManualFormulas();
}
</script>
