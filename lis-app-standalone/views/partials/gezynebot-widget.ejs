<script>
(function() {
    const launcher = document.getElementById('gezynebot-launcher');
    const badge = document.getElementById('gezynebot-badge');
    const panel = document.getElementById('gezynebot-panel');
    const closeBtn = document.getElementById('gezynebot-close-btn');
    const maxBtn = document.getElementById('gezynebot-maximize-btn');
    const input = document.getElementById('gezynebot-input');
    const sendBtn = document.getElementById('gezynebot-send-btn');
    const statusText = document.getElementById('gezynebot-status-text');
    const offlineAlert = document.getElementById('gezynebot-offline-alert');
    const messagesContainer = document.getElementById('gezynebot-messages');
    const chips = document.querySelectorAll('.gezynebot-chip');

    let currentConversationId = localStorage.getItem('gezynebot_active_conv') || null;
    let isSending = false;
    let isOnline = false;

    // Check online status via server API and/or Electron context bridge
    async function updateConnectivity() {
        let serverOnline = false;
        try {
            if (window.lisApp && typeof window.lisApp.getStatus === 'function') {
                const s = await window.lisApp.getStatus();
                if (s && s.online) serverOnline = true;
            }
            if (!serverOnline) {
                const res = await fetch('/chatbot/api/status');
                const data = await res.json();
                if (data && data.online) serverOnline = true;
            }
        } catch (_) {
            serverOnline = false;
        }

        isOnline = serverOnline;
        if (isOnline) {
            badge.className = 'gezynebot-status-badge online';
            statusText.innerHTML = '<span style="color:#10b981;">●</span> Server Connected';
            offlineAlert.style.display = 'none';
            input.disabled = false;
            input.placeholder = 'Ask GezyneBot anything...';
            sendBtn.disabled = isSending;
        } else {
            badge.className = 'gezynebot-status-badge offline';
            statusText.innerHTML = '<span style="color:#ef4444;">●</span> Server Offline (Disabled)';
            offlineAlert.style.display = 'flex';
            input.disabled = true;
            input.placeholder = 'Offline: Central LIS server connection required...';
            sendBtn.disabled = true;
        }
    }

    // Listen for network status changes if running in Electron
    if (window.lisApp && typeof window.lisApp.onNetworkStatus === 'function') {
        window.lisApp.onNetworkStatus((data) => {
            updateConnectivity();
        });
    }

    // Initial check + periodic heartbeat
    updateConnectivity();
    setInterval(updateConnectivity, 8000);

    // Toggle panel open/close
    function togglePanel() {
        const isOpen = panel.classList.contains('active');
        if (isOpen) {
            panel.classList.remove('active');
        } else {
            panel.classList.add('active');
            updateConnectivity();
            if (isOnline) input.focus();
            scrollToBottom();
        }
    }

    if (launcher) launcher.addEventListener('click', togglePanel);
    if (closeBtn) closeBtn.addEventListener('click', () => panel.classList.remove('active'));

    // Maximize to dedicated page
    if (maxBtn) {
        maxBtn.addEventListener('click', () => {
            const url = currentConversationId 
                ? `/chatbot?conversationId=${encodeURIComponent(currentConversationId)}` 
                : '/chatbot';
            window.location.href = url;
        });
    }

    // Auto-expand textarea
    if (input) {
        input.addEventListener('input', () => {
            input.style.height = '42px';
            const h = Math.max(42, Math.min(input.scrollHeight, 100));
            input.style.height = h + 'px';
        });

        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });
    }

    if (sendBtn) sendBtn.addEventListener('click', sendMessage);

    // Quick chips
    chips.forEach(chip => {
        chip.addEventListener('click', () => {
            if (!isOnline) {
                alert('GezyneBot is disabled while offline. Please connect to the central LIS server.');
                return;
            }
            const query = chip.dataset.query;
            if (query) {
                input.value = query;
                sendMessage();
            }
        });
    });

    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Markdown Parser
    function formatMarkdown(text) {
        if (!text) return '';
        let escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        escaped = escaped.replace(/\*(.*?)\*/g, '<em>$1</em>');

        const lines = escaped.split('\n');
        let html = '';
        let inList = null;
        let inTable = false;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const trimmed = line.trim();

            if (!trimmed) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                if (inTable) { html += '</tbody></table>'; inTable = false; }
                continue;
            }

            if (trimmed.startsWith('|') && trimmed.endsWith('|')) {
                const cells = trimmed.split('|').slice(1, -1).map(c => c.trim());
                if (cells.every(c => /^:?-+:?$/.test(c))) continue;
                if (!inTable) {
                    if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                    inTable = true;
                    html += '<table class="bot-table"><thead><tr>' + cells.map(c => '<th>' + c + '</th>').join('') + '</tr></thead><tbody>';
                } else {
                    html += '<tr>' + cells.map(c => '<td>' + c + '</td>').join('') + '</tr>';
                }
                continue;
            } else if (inTable) {
                html += '</tbody></table>';
                inTable = false;
            }

            if (trimmed.startsWith('#### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h5>' + trimmed.substring(5) + '</h5>';
                continue;
            }
            if (trimmed.startsWith('### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h4>' + trimmed.substring(4) + '</h4>';
                continue;
            }
            if (trimmed.startsWith('## ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(3) + '</h3>';
                continue;
            }
            if (trimmed.startsWith('# ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(2) + '</h3>';
                continue;
            }

            if (trimmed.startsWith('> ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<blockquote>' + trimmed.substring(2) + '</blockquote>';
                continue;
            }

            if (/^(\-{3,}|\*{3,}|_{3,})$/.test(trimmed)) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<hr>';
                continue;
            }

            if (/^[-*+]\s+/.test(trimmed)) {
                if (inList !== 'ul') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ul>';
                    inList = 'ul';
                }
                html += '<li>' + trimmed.replace(/^[-*+]\s+/, '') + '</li>';
                continue;
            }

            if (/^\d+\.\s+/.test(trimmed)) {
                if (inList !== 'ol') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ol>';
                    inList = 'ol';
                }
                html += '<li>' + trimmed.replace(/^\d+\.\s+/, '') + '</li>';
                continue;
            }

            if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
            html += '<p>' + trimmed + '</p>';
        }

        if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
        if (inTable) html += '</tbody></table>';
        return html;
    }

    // Append Message to UI
    function appendMessage(role, text) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `gezynebot-msg gezynebot-msg-${role}`;
        
        const bubble = document.createElement('div');
        bubble.className = 'gezynebot-bubble';
        
        if (role === 'bot') {
            bubble.innerHTML = formatMarkdown(text);
        } else {
            const p = document.createElement('p');
            p.textContent = text;
            bubble.appendChild(p);
        }

        msgDiv.appendChild(bubble);
        messagesContainer.appendChild(msgDiv);
        scrollToBottom();
        return msgDiv;
    }

    // Send Message function
    async function sendMessage() {
        if (!isOnline) {
            alert('GezyneBot requires connection to the central LIS server.');
            return;
        }

        const text = (input.value || '').trim();
        if (!text || isSending) return;

        isSending = true;
        sendBtn.disabled = true;
        input.value = '';
        input.style.height = '42px';

        appendMessage('user', text);

        const typingDiv = document.createElement('div');
        typingDiv.className = 'gezynebot-msg gezynebot-msg-bot';
        typingDiv.innerHTML = `
            <div class="gezynebot-bubble gezynebot-typing">
                <span class="gezynebot-typing-dot"></span>
                <span class="gezynebot-typing-dot"></span>
                <span class="gezynebot-typing-dot"></span>
            </div>
        `;
        messagesContainer.appendChild(typingDiv);
        scrollToBottom();

        try {
            const res = await fetch('/chatbot/api/query', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    question: text,
                    conversationId: currentConversationId
                })
            });

            const data = await res.json();
            typingDiv.remove();

            if (data && data.offline) {
                updateConnectivity();
                appendMessage('bot', data.answer || 'GezyneBot is unavailable in offline mode.');
            } else if (data && data.answer) {
                appendMessage('bot', data.answer);
                if (data.conversationId) {
                    currentConversationId = data.conversationId;
                    localStorage.setItem('gezynebot_active_conv', currentConversationId);
                }
            } else {
                appendMessage('bot', '⚠️ Sorry, an error occurred while querying GezyneBot.');
            }
        } catch (err) {
            typingDiv.remove();
            appendMessage('bot', '⚠️ Failed to connect to server: ' + err.message);
            updateConnectivity();
        } finally {
            isSending = false;
            sendBtn.disabled = !isOnline;
            if (isOnline) input.focus();
        }
    }
})();
</script>
