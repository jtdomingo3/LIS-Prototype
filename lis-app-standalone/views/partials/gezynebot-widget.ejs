<!-- GezyneBot Floating AI Assistant Widget (Standalone Edition) -->
<div id="gezynebot-container">
    <!-- Floating Launcher Button -->
    <button id="gezynebot-launcher" class="gezynebot-launcher-btn" type="button" title="Open GezyneBot Assistant">
        <span class="gezynebot-launcher-icon">🤖</span>
        <span class="gezynebot-status-badge" id="gezynebot-badge"></span>
    </button>

    <!-- Floating Chat Popup Panel -->
    <div id="gezynebot-panel" class="gezynebot-panel">
        <!-- Header -->
        <div class="gezynebot-header">
            <div class="gezynebot-header-info">
                <div class="gezynebot-avatar">🤖</div>
                <div>
                    <h3 class="gezynebot-title">GezyneBot</h3>
                    <p class="gezynebot-subtitle" id="gezynebot-status-text">Connecting to Server...</p>
                </div>
            </div>
            <div class="gezynebot-header-actions">
                <button id="gezynebot-maximize-btn" class="gezynebot-action-btn" type="button" title="Maximize to full page">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="15 3 21 3 21 9"></polyline>
                        <polyline points="9 21 3 21 3 15"></polyline>
                        <line x1="21" y1="3" x2="14" y2="10"></line>
                        <line x1="3" y1="21" x2="10" y2="14"></line>
                    </svg>
                </button>
                <button id="gezynebot-close-btn" class="gezynebot-action-btn" type="button" title="Close Assistant">✕</button>
            </div>
        </div>

        <!-- Offline Notice Banner (Dynamic) -->
        <div id="gezynebot-offline-alert" class="gezynebot-offline-alert" style="display:none;">
            <span class="offline-icon">⚠️</span>
            <span class="offline-text"><strong>Offline:</strong> Central LIS server connection required.</span>
        </div>

        <!-- Quick Suggestion Chips -->
        <div class="gezynebot-chips-bar" id="gezynebot-chips">
            <button class="gezynebot-chip" type="button" data-query="What is the CLSI tube order of draw?">🧪 Order of Draw</button>
            <button class="gezynebot-chip" type="button" data-query="What are the patient fasting guidelines for Lipid Profile and FBS?">🩸 Fasting Rules</button>
            <button class="gezynebot-chip" type="button" data-query="What are the critical panic lab values for potassium, glucose, and platelets?">⚠️ Panic Values</button>
            <button class="gezynebot-chip" type="button" data-query="How do I capture chemistry results from Analyser.MDB?">🔬 Import Analyzer</button>
        </div>

        <!-- Message Body -->
        <div id="gezynebot-messages" class="gezynebot-messages">
            <div class="gezynebot-msg gezynebot-msg-bot">
                <div class="gezynebot-bubble">
                    <p>Hello! I am <strong>GezyneBot</strong>, your LIS & Clinical Laboratory Assistant.</p>
                    <p style="font-size:0.86em; color:#64748b; margin-top:4px;">I operate through your central LIS server to assist with phlebotomy protocols, normal ranges, and system workflows.</p>
                </div>
            </div>
        </div>

        <!-- Input Composer -->
        <div class="gezynebot-composer">
            <textarea id="gezynebot-input" placeholder="Ask GezyneBot anything..." rows="1"></textarea>
            <button id="gezynebot-send-btn" class="gezynebot-send-btn" type="button" title="Send message">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>
</div>

