}

/* Composer */
.chatbot-main-composer {
    padding: 16px 24px;
    background: #ffffff;
    border-top: 1px solid #f1f5f9;
    display: flex;
    gap: 12px;
    align-items: flex-end;
}

.chatbot-main-composer textarea {
    flex: 1;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 12px 18px;
    font-size: 0.96em;
    font-family: inherit;
    resize: none;
    height: 48px;
    min-height: 48px;
    max-height: 140px;
    outline: none;
    transition: all 0.2s;
    line-height: 1.45;
    box-sizing: border-box;
}

.chatbot-main-composer textarea:focus {
    border-color: #10b981;
    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.12);
}

.main-send-btn {
    height: 48px;
    padding: 0 24px;
    border-radius: 12px;
    background: #10b981;
    color: #ffffff;
    border: none;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.95em;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.2s;
    flex-shrink: 0;
}

.main-send-btn:hover {
    background: #059669;
    transform: translateY(-1px);
}

.main-send-btn:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
    transform: none;
}
</style>

<script>
(function() {
    let conversations = [];
    let activeConversationId = null;
    let isSubmitting = false;
    let isOnline = <%= isOnline ? 'true' : 'false' %>;

    const conversationsList = document.getElementById('conversationsList');
    const loadingTopics = document.getElementById('loadingTopics');
    const newTopicBtn = document.getElementById('newTopicBtn');
    const topicSearch = document.getElementById('topicSearch');
    const activeTopicTitle = document.getElementById('activeTopicTitle');
    const activeTopicDate = document.getElementById('activeTopicDate');
    const modelSelect = document.getElementById('modelSelect');
    const clearChatBtn = document.getElementById('clearChatBtn');
    const messagesContainer = document.getElementById('mainMessagesContainer');
    const chatInput = document.getElementById('chatInput');
    const sendBtn = document.getElementById('mainSendBtn');
    const quickChips = document.querySelectorAll('.quick-chip');
    const statusBanner = document.getElementById('standaloneStatusBanner');
    const statusText = document.getElementById('standaloneStatusText');
    const mainOfflineBanner = document.getElementById('mainOfflineBanner');

    const urlParams = new URLSearchParams(window.location.search);
    const queryConvId = urlParams.get('conversationId');

    async function checkConnectivity() {
        let serverOnline = false;
        try {
            if (window.lisApp && typeof window.lisApp.getStatus === 'function') {
                const s = await window.lisApp.getStatus();
                if (s && s.online) serverOnline = true;
            }
            if (!serverOnline) {
                const res = await fetch('/chatbot/api/status');
                const data = await res.json();
                if (data && data.online) serverOnline = true;
            }
        } catch (_) {
            serverOnline = false;
        }

        isOnline = serverOnline;
        if (isOnline) {
            statusBanner.className = 'standalone-status-box online';
            statusText.textContent = 'Connected to Central Server';
            mainOfflineBanner.style.display = 'none';
            chatInput.disabled = false;
            chatInput.placeholder = 'Ask GezyneBot anything (Press Enter to send, Shift+Enter for new line)...';
            sendBtn.disabled = isSubmitting;
        } else {
            statusBanner.className = 'standalone-status-box offline';
            statusText.textContent = 'Offline (Server Required)';
            mainOfflineBanner.style.display = 'flex';
            chatInput.disabled = true;
            chatInput.placeholder = 'Offline: Central LIS server connection required...';
            sendBtn.disabled = true;
        }
    }

    if (window.lisApp && typeof window.lisApp.onNetworkStatus === 'function') {
        window.lisApp.onNetworkStatus(() => {
            checkConnectivity();
            loadConversations();
        });
    }

    setInterval(checkConnectivity, 10000);

    // Load Conversations from Central Server
    async function loadConversations() {
        if (!isOnline) {
            loadingTopics.innerHTML = '<span style="color:#ef4444;">●</span> Offline: Central server required for conversation history.';
            return;
        }

        try {
            const res = await fetch('/chatbot/api/conversations');
            const data = await res.json();
            if (data && data.conversations) {
                conversations = data.conversations;
                renderConversationsList(conversations);

                if (queryConvId && conversations.some(c => c.id === queryConvId)) {
                    selectConversation(queryConvId);
                } else if (conversations.length > 0 && !activeConversationId) {
                    selectConversation(conversations[0].id);
                }
            }
        } catch (e) {
            loadingTopics.textContent = 'Could not load topics from central server.';
        }
    }

    function renderConversationsList(list) {
        conversationsList.innerHTML = '';
        if (list.length === 0) {
            conversationsList.innerHTML = '<div style="color:#64748b; font-size:0.84em; text-align:center; padding:20px;">No conversation topics found.</div>';
            return;
        }

        list.forEach(c => {
            const item = document.createElement('div');
            item.className = `conversation-item ${c.id === activeConversationId ? 'active' : ''}`;
            item.dataset.id = c.id;

            const timeStr = c.updated_at ? new Date(c.updated_at).toLocaleDateString() : '';

            item.innerHTML = `
                <div class="topic-meta">
                    <div class="topic-name">${escapeHtml(c.title || 'Discussion')}</div>
                    <div class="topic-time">${timeStr}</div>
                </div>
                <button class="delete-topic-btn" type="button" title="Delete topic">🗑️</button>
            `;

            item.addEventListener('click', (e) => {
                if (e.target.classList.contains('delete-topic-btn')) {
                    e.stopPropagation();
                    deleteConversation(c.id);
                    return;
                }
                selectConversation(c.id);
            });

            conversationsList.appendChild(item);
        });
    }

    function escapeHtml(str) {
        return (str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Select Conversation
    async function selectConversation(id) {
        activeConversationId = id;
        localStorage.setItem('gezynebot_active_conv', id);

        document.querySelectorAll('.conversation-item').forEach(el => {
            el.classList.toggle('active', el.dataset.id === id);
        });

        const conv = conversations.find(c => c.id === id);
        if (conv) {
            activeTopicTitle.textContent = conv.title || 'Discussion';
            activeTopicDate.textContent = 'Topic ID: ' + conv.id + ' • Central Server Storage';
        }

        try {
            const res = await fetch(`/chatbot/api/conversations/${encodeURIComponent(id)}`);
            const data = await res.json();
            if (data && data.messages) {
                renderMessages(data.messages);
            }
        } catch (e) {
            console.error('Failed to load messages:', e);
        }
    }

    // Delete Conversation
    async function deleteConversation(id) {
        if (!confirm('Are you sure you want to delete this topic from the server?')) return;
        try {
            const res = await fetch(`/chatbot/api/conversations/${encodeURIComponent(id)}`, { method: 'DELETE' });
            const data = await res.json();
            if (data && data.success) {
                conversations = conversations.filter(c => c.id !== id);
                renderConversationsList(conversations);
                if (activeConversationId === id) {
                    activeConversationId = null;
                    if (conversations.length > 0) {
                        selectConversation(conversations[0].id);
                    } else {
                        activeTopicTitle.textContent = 'Select or start a topic';
                        messagesContainer.innerHTML = '';
                    }
                }
            }
        } catch (e) {
            alert('Failed to delete topic: ' + e.message);
        }
    }

    // Render Messages Feed
    function renderMessages(messages) {
        messagesContainer.innerHTML = '';
        if (messages.length === 0) {
            messagesContainer.innerHTML = `
                <div style="text-align:center; padding:40px 20px; color:#94a3b8;">
                    <span style="font-size:36px;">💬</span>
                    <p style="margin-top:10px; font-size:0.95em;">No messages yet in this topic. Ask GezyneBot anything!</p>
                </div>
            `;
            return;
        }

        messages.forEach(m => {
            appendMainMessage(m.role, m.content, m.created_at);
        });
        scrollToBottom();
    }

    // Append Message to Main Feed
    function appendMainMessage(role, content, timestamp) {
        const msgDiv = document.createElement('div');
        msgDiv.className = `main-msg main-msg-${role}`;

        const timeStr = timestamp ? new Date(timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : 'Just now';

        const bubble = document.createElement('div');
        bubble.className = 'main-bubble';

        const header = document.createElement('div');
        header.className = 'bubble-header';
        header.innerHTML = `
            <strong>${role === 'user' ? '👤 You' : '🤖 GezyneBot'}</strong>
            <span class="bubble-time">${timeStr}</span>
        `;

        const body = document.createElement('div');
        body.className = 'bubble-content';

        if (role === 'bot') {
            body.innerHTML = formatMarkdown(content);
        } else {
            const p = document.createElement('p');
            p.textContent = content;
            body.appendChild(p);
        }

        bubble.appendChild(header);
        bubble.appendChild(body);
        msgDiv.appendChild(bubble);
        messagesContainer.appendChild(msgDiv);
        scrollToBottom();
    }

    // Markdown Parser
    function formatMarkdown(text) {
        if (!text) return '';
        let escaped = text
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');

        escaped = escaped.replace(/`([^`]+)`/g, '<code>$1</code>');
        escaped = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        escaped = escaped.replace(/\*(.*?)\*/g, '<em>$1</em>');

        const lines = escaped.split('\n');
        let html = '';
        let inList = null;
        let inTable = false;

        for (let i = 0; i < lines.length; i++) {
            const line = lines[i];
            const trimmed = line.trim();

            if (!trimmed) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                if (inTable) { html += '</tbody></table>'; inTable = false; }
                continue;
            }

            if (trimmed.startsWith('|') && trimmed.endsWith('|')) {
                const cells = trimmed.split('|').slice(1, -1).map(c => c.trim());
                if (cells.every(c => /^:?-+:?$/.test(c))) continue;
                if (!inTable) {
                    if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                    inTable = true;
                    html += '<table class="bot-table"><thead><tr>' + cells.map(c => '<th>' + c + '</th>').join('') + '</tr></thead><tbody>';
                } else {
                    html += '<tr>' + cells.map(c => '<td>' + c + '</td>').join('') + '</tr>';
                }
                continue;
            } else if (inTable) {
                html += '</tbody></table>';
                inTable = false;
            }

            if (trimmed.startsWith('#### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h5>' + trimmed.substring(5) + '</h5>';
                continue;
            }
            if (trimmed.startsWith('### ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h4>' + trimmed.substring(4) + '</h4>';
                continue;
            }
            if (trimmed.startsWith('## ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(3) + '</h3>';
                continue;
            }
            if (trimmed.startsWith('# ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<h3>' + trimmed.substring(2) + '</h3>';
                continue;
            }

            if (trimmed.startsWith('> ')) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<blockquote>' + trimmed.substring(2) + '</blockquote>';
                continue;
            }

            if (/^(\-{3,}|\*{3,}|_{3,})$/.test(trimmed)) {
                if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
                html += '<hr>';
                continue;
            }

            if (/^[-*+]\s+/.test(trimmed)) {
                if (inList !== 'ul') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ul>';
                    inList = 'ul';
                }
                html += '<li>' + trimmed.replace(/^[-*+]\s+/, '') + '</li>';
                continue;
            }

            if (/^\d+\.\s+/.test(trimmed)) {
                if (inList !== 'ol') {
                    if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
                    html += '<ol>';
                    inList = 'ol';
                }
                html += '<li>' + trimmed.replace(/^\d+\.\s+/, '') + '</li>';
                continue;
            }

            if (inList) { html += inList === 'ul' ? '</ul>' : '</ol>'; inList = null; }
            html += '<p>' + trimmed + '</p>';
        }

        if (inList) html += inList === 'ul' ? '</ul>' : '</ol>';
        if (inTable) html += '</tbody></table>';
        return html;
    }

    function scrollToBottom() {
        if (messagesContainer) {
            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }
    }

    // Auto-growing textarea
    chatInput.addEventListener('input', () => {
        chatInput.style.height = '48px';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px';
    });

    chatInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            sendQuestion();
        }
    });

    sendBtn.addEventListener('click', sendQuestion);

    // Quick chips
    quickChips.forEach(chip => {
        chip.addEventListener('click', () => {
            if (!isOnline) {
                alert('GezyneBot is disabled while offline. Connect to the central server.');
                return;
            }
            const query = chip.dataset.query;
            if (query) {
                chatInput.value = query;
                sendQuestion();
            }
        });
    });

    // New Topic Button
    newTopicBtn.addEventListener('click', async () => {
        if (!isOnline) {
            alert('Cannot create topics while offline. Central server connection required.');
            return;
        }

        try {
            const res = await fetch('/chatbot/api/conversations', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    title: 'New Discussion',
                    model: modelSelect.value
                })
            });
            const data = await res.json();
            if (data && data.success && data.conversation) {
                activeConversationId = data.conversation.id;
                localStorage.setItem('gezynebot_active_conv', activeConversationId);
                await loadConversations();
                selectConversation(activeConversationId);
            }
        } catch (e) {
            alert('Failed to start new topic: ' + e.message);
        }
    });

    // Clear Chat Button
    clearChatBtn.addEventListener('click', () => {
        messagesContainer.innerHTML = `
            <div style="text-align:center; padding:40px 20px; color:#94a3b8;">
                <p>View cleared for this session.</p>
            </div>
        `;
    });

    // Search topics filter
    topicSearch.addEventListener('input', (e) => {
        const query = (e.target.value || '').toLowerCase();
        const filtered = conversations.filter(c => (c.title || '').toLowerCase().includes(query));
        renderConversationsList(filtered);
    });

    // Send Question
    async function sendQuestion() {
        if (!isOnline) {
            alert('GezyneBot is disabled while offline.');
            return;
        }

        const question = (chatInput.value || '').trim();
        if (!question || isSubmitting) return;

        isSubmitting = true;
        sendBtn.disabled = true;
        chatInput.value = '';
        chatInput.style.height = '48px';

        appendMainMessage('user', question);

        const typingDiv = document.createElement('div');
        typingDiv.className = 'main-msg main-msg-bot';
        typingDiv.innerHTML = `
            <div class="main-bubble" style="background:#ffffff; border:1px solid #e2e8f0; padding:10px 16px;">
                <span style="color:#10b981; font-weight:600; font-size:0.9em;">Thinking via Central Server...</span>
            </div>
        `;
        messagesContainer.appendChild(typingDiv);
        scrollToBottom();

        try {
            const res = await fetch('/chatbot/api/query', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    question,
                    conversationId: activeConversationId || null,
                    model: modelSelect.value
                })
            });

            const data = await res.json();
            typingDiv.remove();

            if (data && data.offline) {
                checkConnectivity();
                appendMainMessage('bot', data.answer || 'GezyneBot is unavailable in offline mode.');
            } else if (data && data.answer) {
                appendMainMessage('bot', data.answer);
                if (data.conversationId && data.conversationId !== activeConversationId) {
                    activeConversationId = data.conversationId;
                    localStorage.setItem('gezynebot_active_conv', activeConversationId);
                    await loadConversations();
                    selectConversation(activeConversationId);
                }
            } else {
                appendMainMessage('bot', '⚠️ Sorry, an error occurred while querying GezyneBot.');
            }
        } catch (e) {
            typingDiv.remove();
            appendMainMessage('bot', '⚠️ Connection error: ' + e.message);
            checkConnectivity();
        } finally {
            isSubmitting = false;
            sendBtn.disabled = !isOnline;
            if (isOnline) chatInput.focus();
        }
    }

    // Initial setup
    checkConnectivity();
    loadConversations();
})();
</script>
