}

.main-msg-bot .bubble-content li {
    margin-bottom: 4px;
}

.main-msg-bot .bubble-content code {
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    color: #0f766e;
