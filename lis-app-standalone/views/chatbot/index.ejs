}

.sidebar-search {
    padding: 12px 18px;
}

.sidebar-search input {
    width: 100%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-radius: 8px;
    padding: 8px 12px;
