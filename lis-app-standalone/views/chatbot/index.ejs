<!-- Dedicated Full-Page Conversation Workspace (Standalone Edition) -->
<div class="chatbot-layout">
    <!-- Left Sidebar: Conversations & Topics -->
    <div class="chatbot-sidebar">
        <div class="sidebar-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <span style="font-size:22px;">🤖</span>
                <h2 style="margin:0; font-size:1.15em; color:var(--text-white);">GezyneBot</h2>
            </div>
            <button id="newTopicBtn" class="new-topic-btn" type="button" title="Start new discussion topic">
                <span>+</span> New Topic
            </button>
        </div>

        <!-- Connection Status Indicator -->
        <div id="standaloneStatusBanner" class="standalone-status-box <%= isOnline ? 'online' : 'offline' %>">
            <span class="status-dot"></span>
            <span id="standaloneStatusText"><%= isOnline ? 'Connected to Central Server' : 'Offline (Server Required)' %></span>
        </div>

        <!-- Search Topics Filter -->
        <div class="sidebar-search">
            <input type="text" id="topicSearch" placeholder="Search discussions..." />
        </div>

        <!-- Conversation Topics List -->
        <div class="conversations-list" id="conversationsList">
            <div class="loading-topics" id="loadingTopics">
                <span class="spinner"></span> Loading topics...
            </div>
        </div>
    </div>

    <!-- Main Conversation Workspace -->
    <div class="chatbot-main">
        <!-- Top Workspace Bar -->
        <div class="chatbot-main-header">
            <div class="active-topic-info">
                <h2 id="activeTopicTitle" style="margin:0; font-size:1.15em; color:#0f172a;">Select or start a topic</h2>
                <span id="activeTopicDate" style="font-size:0.8em; color:#64748b;">Central LIS Server: <%= serverUrl || 'http://127.0.0.1:3000' %></span>
            </div>
            <div class="main-header-actions">
                <select id="modelSelect" class="model-select" title="Selected AI Model on Central Server">
                    <option value="openai/gpt-4o-mini" selected>GPT-4o Mini (Default)</option>
                    <option value="google/gemini-2.0-flash-001">Gemini 2.0 Flash</option>
                    <option value="meta-llama/llama-3.3-70b-instruct">Llama 3.3 70B</option>
                </select>
                <button id="clearChatBtn" class="ghost-btn" type="button" title="Clear current view">Clear View</button>
            </div>
        </div>

        <!-- Offline Banner (Visible when disconnected) -->
        <div id="mainOfflineBanner" class="main-offline-alert" style="<%= isOnline ? 'display:none;' : '' %>">
            <div style="font-size:24px;">⚠️</div>
            <div>
                <h4 style="margin:0 0 2px 0; color:#b45309;">Central LIS Server is Offline</h4>
                <p style="margin:0; font-size:0.88em; color:#92400e;">GezyneBot relies completely on the central LIS server. Chat and past conversation topics are disabled while offline. Connect your PC to the server network to restore access.</p>
            </div>
        </div>

        <!-- Quick Knowledge Prompts -->
        <div class="chatbot-quick-bar" id="quickBar">
            <span style="font-size:0.82em; font-weight:600; color:#64748b; padding-left:4px;">Suggested Prompts:</span>
            <button class="quick-chip" type="button" data-query="What is the CLSI tube order of draw for venipuncture?">🧪 CLSI Order of Draw</button>
            <button class="quick-chip" type="button" data-query="What are the patient fasting rules for FBS, Lipid Profile, and OGTT?">🩸 Fasting Guidelines</button>
            <button class="quick-chip" type="button" data-query="What are panic critical lab values requiring immediate doctor notification?">⚠️ Panic Critical Values</button>
            <button class="quick-chip" type="button" data-query="How to export and verify chemistry analyzer results from Analyser.MDB?">🔬 Analyser.MDB Workflow</button>
        </div>

        <!-- Chat Messages Feed -->
        <div class="chatbot-main-messages" id="mainMessagesContainer">
            <div class="main-msg main-msg-bot">
                <div class="main-bubble">
                    <div class="bubble-header">
                        <strong>🤖 GezyneBot AI</strong>
                        <span class="bubble-time">System Assistant</span>
                    </div>
                    <div class="bubble-content">
                        <p>Welcome to <strong>GezyneBot</strong> on Gezyne LIS Standalone!</p>
                        <p>I provide instant answers for clinical laboratory procedures, phlebotomy tube sequencing, patient preparation guidelines, reference ranges, and LIS operational steps.</p>
                        <% if (!isOnline) { %>
                        <div style="background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:10px 14px; margin-top:8px; color:#b45309;">
                            <strong>Note:</strong> Central LIS server is currently unreachable. Reconnect to chat.
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

        <!-- Message Composer -->
        <div class="chatbot-main-composer">
            <textarea id="chatInput" placeholder="<%= isOnline ? 'Ask GezyneBot anything (Press Enter to send, Shift+Enter for new line)...' : 'Offline: Central LIS server connection required...' %>" rows="1" <%= isOnline ? '' : 'disabled' %>></textarea>
            <button id="mainSendBtn" class="main-send-btn" type="button" <%= isOnline ? '' : 'disabled' %>>
                <span>Send</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
            </button>
        </div>
    </div>
</div>

<style>
.chatbot-layout {
    display: flex;
    height: calc(100vh - 85px);
    margin: -24px;
    background: #f8fafc;
    overflow: hidden;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

/* Left Sidebar */
.chatbot-sidebar {
    width: 310px;
    background: #09090b;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
}

.sidebar-header {
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.new-topic-btn {
    background: #10b981;
    color: #ffffff;
    border: none;
    padding: 7px 13px;
    border-radius: 8px;
    font-size: 0.85em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    align-items: center;
    gap: 5px;
}

.new-topic-btn:hover {
    background: #059669;
    transform: translateY(-1px);
}

.standalone-status-box {
    margin: 12px 18px 0 18px;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.78em;
    display: flex;
    align-items: center;
    gap: 8px;
}

.standalone-status-box.online {
    background: rgba(16, 185, 129, 0.15);
    color: #34d399;
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.standalone-status-box.offline {
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
