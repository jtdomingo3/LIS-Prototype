}

.topic-time {
    font-size: 0.72em;
    opacity: 0.6;
    margin-top: 2px;
}

.delete-topic-btn {
    opacity: 0;
    background: transparent;
    border: none;
    color: #ef4444;
    cursor: pointer;
    font-size: 13px;
    padding: 4px 6px;
    border-radius: 4px;
}

.conversation-item:hover .delete-topic-btn {
    opacity: 0.8;
}

.loading-topics {
    color: #64748b;
    font-size: 0.86em;
    text-align: center;
    padding: 30px 10px;
}

/* Main Workspace */
.chatbot-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    overflow: hidden;
}

.chatbot-main-header {
    padding: 14px 24px;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #ffffff;
}

.main-header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

.model-select {
    padding: 7px 12px;
    border-radius: 8px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    font-size: 0.85em;
    color: #334155;
    outline: none;
}

.ghost-btn {
    background: transparent;
    border: 1px solid #e2e8f0;
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 0.85em;
    color: #64748b;
    cursor: pointer;
    transition: all 0.15s;
}

.ghost-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
}

.main-offline-alert {
    background: #fffbeb;
    border-bottom: 1px solid #fef3c7;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 16px;
}

.chatbot-quick-bar {
    padding: 10px 24px;
    background: #f8fafc;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
    white-space: nowrap;
}

.quick-chip {
    padding: 5px 12px;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 16px;
    font-size: 0.8em;
    color: #334155;
    cursor: pointer;
    transition: all 0.15s;
    flex-shrink: 0;
}

.quick-chip:hover {
    border-color: #10b981;
    color: #047857;
    background: #ecfdf5;
}

.chatbot-main-messages {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
    background: #f8fafc;
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.main-msg {
    display: flex;
    flex-direction: column;
    max-width: 82%;
}

.main-msg-bot {
    align-self: flex-start;
}

.main-msg-user {
    align-self: flex-end;
}

.main-bubble {
    padding: 16px 20px;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.main-msg-bot .main-bubble {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    color: #1e293b;
    border-bottom-left-radius: 4px;
}

.main-msg-user .main-bubble {
    background: #10b981;
    color: #ffffff;
    border-bottom-right-radius: 4px;
}

.bubble-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 8px;
    font-size: 0.84em;
}

.main-msg-user .bubble-header strong {
    color: #ffffff;
}

.main-msg-bot .bubble-header strong {
    color: #047857;
}

.bubble-time {
    font-size: 0.78em;
    opacity: 0.75;
}

.bubble-content {
    font-size: 0.95em;
    line-height: 1.6;
    word-break: break-word;
}

.main-msg-bot .bubble-content h3 {
    margin: 14px 0 6px 0;
    font-size: 1.15em;
    font-weight: 700;
    color: #0f172a;
    border-bottom: 1px solid #f1f5f9;
    padding-bottom: 4px;
}

.main-msg-bot .bubble-content h4 {
    margin: 12px 0 4px 0;
    font-size: 1.05em;
    font-weight: 700;
    color: #047857;
    display: flex;
    align-items: center;
    gap: 6px;
}

.main-msg-bot .bubble-content h4::before {
    content: '';
    display: inline-block;
    width: 3px;
    height: 14px;
    background: #10b981;
    border-radius: 2px;
}

.main-msg-bot .bubble-content h5 {
    margin: 10px 0 4px 0;
    font-size: 0.96em;
    font-weight: 600;
    color: #334155;
}

.main-msg-bot .bubble-content blockquote {
    margin: 10px 0;
    padding: 8px 14px;
    border-left: 3px solid #10b981;
    background: #f8fafc;
    color: #475569;
    font-style: italic;
    border-radius: 0 8px 8px 0;
}

.main-msg-bot .bubble-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: 0.92em;
}

.main-msg-bot .bubble-content th,
.main-msg-bot .bubble-content td {
    border: 1px solid #e2e8f0;
    padding: 8px 12px;
    text-align: left;
}

.main-msg-bot .bubble-content th {
    background: #f8fafc;
    font-weight: 600;
    color: #0f172a;
}

.main-msg-bot .bubble-content p {
    margin: 0 0 10px 0;
}

.main-msg-bot .bubble-content p:last-child {
