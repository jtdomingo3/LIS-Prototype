    <script>
      (function() {
        const SNOOZE_KEY = 'lis_inv_critical_snooze_until';

        function checkCriticalInventoryStock() {
          <% if (typeof sessionUser === 'undefined' || !sessionUser) { %>
            return;
          <% } %>

          // Suppress intrusive pop-up dialog when user is already actively working in the Inventory module
          if (window.location.pathname.startsWith('/inventory')) {
            return;
          }

          try {
            const snoozeUntil = localStorage.getItem(SNOOZE_KEY);
            if (snoozeUntil && Number(snoozeUntil) > Date.now()) {
              return; // Currently snoozed
            }

            fetch('/inventory/critical-check', {
              headers: { 'Accept': 'application/json' }
            })
            .then(res => {
              if (!res.ok) return null;
              return res.json();
            })
            .then(data => {
              if (!data || !data.hasCritical || !data.items || data.items.length === 0) return;
              renderCriticalModal(data.items);
            })
            .catch(() => {});
          } catch(e) {}
        }

        function renderCriticalModal(items) {
          const container = document.getElementById('globalCriticalItemsContainer');
          const modal = document.getElementById('globalCriticalStockModal');
          if (!container || !modal) return;

          container.innerHTML = items.map(item => `
            <div style="padding:10px 0; border-bottom:1px solid #fee2e2; display:flex; justify-content:space-between; align-items:center; gap:10px;">
              <div>
                <strong style="color:#1e293b; font-size:0.95rem;">${escapeHtml(item.name)}</strong>
                <div style="font-size:0.8rem; color:#64748b;">
                  REF: ${escapeHtml(item.sku)} &bull; ${escapeHtml(item.area || 'General')} ${item.location ? `&bull; Loc: ${escapeHtml(item.location)}` : ''}
                </div>
              </div>
              <div style="text-align:right; white-space:nowrap;">
                <div style="font-size:1.15rem; font-weight:700; color:#dc2626;">
                  ${item.totalStock} ${escapeHtml(item.unit)}
                </div>
                <div style="font-size:0.75rem; color:#991b1b; font-weight:600;">
                  Critical Level: &le; ${item.criticalThreshold}
                </div>
              </div>
            </div>
          `).join('');

          modal.style.display = 'flex';
        }

        window.snoozeCriticalModal = function(minutes) {
          try {
            const until = Date.now() + (minutes * 60 * 1000);
            localStorage.setItem(SNOOZE_KEY, until.toString());
          } catch(e) {}
          closeCriticalModal();
        };

        window.closeCriticalModal = function() {
          const modal = document.getElementById('globalCriticalStockModal');
          if (modal) modal.style.display = 'none';
        };

        function escapeHtml(text) {
          if (!text) return '';
          return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        // Run check after initial page render
        setTimeout(checkCriticalInventoryStock, 1500);
      })();
    </script>

    <!-- GezyneBot Floating AI Assistant Widget (lower-right) -->
    <%- include('partials/gezynebot-widget') %>
</body>
</html>