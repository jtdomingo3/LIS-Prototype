<div style="width: 100%; box-sizing: border-box;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <a href="/costing?month=<%= selectedMonth %>" style="color: #64748b; text-decoration: none; font-size: 1.2rem;">←</a>
                <h2 style="margin: 0; font-size: 1.5rem; color: #0f172a; font-weight: 700;">Laboratory Expense Log</h2>
            </div>
            <p style="margin: 4px 0 0 28px; color: #64748b; font-size: 0.88rem;">
                Detailed tracking of reagent purchases, maintenance, facility overhead, and manual expenses
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <form action="/costing/expenses" method="GET" style="display: flex; align-items: center; gap: 8px;">
                <label for="monthPicker" style="font-size: 0.85rem; font-weight: 600; color: #475569;">Month:</label>
                <input type="month" id="monthPicker" name="month" value="<%= selectedMonth %>" onchange="this.form.submit()" style="padding: 7px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 600; color: #0f172a; background: #fff;">
            </form>
            <button onclick="document.getElementById('addExpenseModal').style.display='flex'" class="btn btn-primary" style="padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                <span>➕</span> Record New Expense
            </button>
        </div>
    </div>

    <!-- Category Filter Tabs -->
    <div style="display: flex; gap: 8px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 8px;">
        <a href="/costing/expenses?month=<%= selectedMonth %>" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= !categoryFilter ? 'background: #0f172a; color: white;' : 'background: #f1f5f9; color: #475569;' %>">All Categories</a>
        <a href="/costing/expenses?month=<%= selectedMonth %>&category=reagent_purchase" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= categoryFilter === 'reagent_purchase' ? 'background: #ef4444; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Reagents & Supplies</a>
        <a href="/costing/expenses?month=<%= selectedMonth %>&category=personnel" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= categoryFilter === 'personnel' ? 'background: #3b82f6; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Personnel & Payroll</a>
        <a href="/costing/expenses?month=<%= selectedMonth %>&category=overhead" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= categoryFilter === 'overhead' ? 'background: #f59e0b; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Facility Overhead</a>
        <a href="/costing/expenses?month=<%= selectedMonth %>&category=equipment_service" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= categoryFilter === 'equipment_service' ? 'background: #8b5cf6; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Equipment Maintenance</a>
        <a href="/costing/expenses?month=<%= selectedMonth %>&category=misc" style="padding: 6px 14px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; <%= categoryFilter === 'misc' ? 'background: #64748b; color: white;' : 'background: #f1f5f9; color: #475569;' %>">Miscellaneous</a>
    </div>

    <!-- Expenses Table Card -->
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04); overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <span style="font-weight: 700; color: #0f172a;"><%= expenses.length %> Expense Items Recorded</span>
            <span style="font-size: 1.05rem; font-weight: 800; color: #dc2626;">Total: ₱<%= totalAmount.toLocaleString('en-US', { minimumFractionDigits: 2 }) %></span>
        </div>

        <% if (expenses.length === 0) { %>
            <div style="padding: 50px 20px; text-align: center; color: #94a3b8;">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">📋</div>
                <div style="font-weight: 600; font-size: 1rem; color: #475569;">No expenses found</div>
                <p style="font-size: 0.85rem; margin: 4px 0 16px 0;">No expense records match the selected month and filter.</p>
                <button onclick="document.getElementById('addExpenseModal').style.display='flex'" class="btn btn-primary btn-small" style="padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    + Record First Expense
                </button>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px;">
                            <th style="padding: 12px 18px;">Date</th>
                            <th style="padding: 12px 18px;">Category</th>
                            <th style="padding: 12px 18px;">Description</th>
                            <th style="padding: 12px 18px;">Vendor / Supplier</th>
                            <th style="padding: 12px 18px; text-align: right;">Amount (PHP)</th>
                            <th style="padding: 12px 18px;">Recorded By</th>
                            <th style="padding: 12px 18px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% expenses.forEach(e => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9; hover: background #f8fafc;">
                                <td style="padding: 12px 18px; color: #475569; font-weight: 500; white-space: nowrap;">
                                    <%= e.expenseDate ? e.expenseDate.slice(0, 10) : '' %>
                                </td>
                                <td style="padding: 12px 18px;">
                                    <span style="display: inline-block; padding: 3px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; background: #f1f5f9; color: #334155;">
                                        <%= e.category.replace('_', ' ') %>
                                    </span>
                                </td>
                                <td style="padding: 12px 18px; color: #0f172a; font-weight: 600;">
                                    <%= e.description %>
                                    <% if (e.notes) { %>
                                        <div style="font-size: 0.78rem; color: #94a3b8; font-weight: normal;"><%= e.notes %></div>
                                    <% } %>
                                </td>
                                <td style="padding: 12px 18px; color: #64748b;">
                                    <%= e.vendorSupplier || '—' %>
                                </td>
                                <td style="padding: 12px 18px; text-align: right; font-weight: 700; color: #dc2626;">
                                    ₱<%= (Number(e.amount) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 12px 18px; color: #64748b; font-size: 0.85rem;">
                                    <%= e.recordedBy || 'System' %>
                                </td>
                                <td style="padding: 12px 18px; text-align: center; white-space: nowrap;">
                                    <form action="/costing/expenses/<%= e.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete this expense record?');">
                                        <button type="submit" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; font-size: 0.9rem;" title="Delete">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal: Record New Expense -->
<div id="addExpenseModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 520px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
        <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #0f172a;">Record New Expense</h3>
            <button onclick="document.getElementById('addExpenseModal').style.display='none'" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #94a3b8;">✕</button>
        </div>
        <form action="/costing/expenses" method="POST" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Category *</label>
                <select name="category" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; background: #fff;">
                    <option value="overhead">Facility Overhead (Rent, Electricity, Water, Internet)</option>
                    <option value="reagent_purchase">Reagent & Chemical Purchase</option>
                    <option value="equipment_service">Equipment Calibration & Maintenance</option>
                    <option value="personnel">Personnel & Staff Allowance</option>
                    <option value="misc">Miscellaneous</option>
                </select>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Description *</label>
                <input type="text" name="description" required placeholder="e.g. Meralco Electricity Bill Oct 2024" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Amount (PHP) *</label>
                    <input type="number" step="0.01" min="0" name="amount" required placeholder="0.00" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 700; color: #0f172a; box-sizing: border-box;">
                </div>
                <div>
                    <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Expense Date *</label>
                    <input type="date" name="expenseDate" value="<%= new Date().toISOString().slice(0, 10) %>" required style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Vendor / Payee / Supplier</label>
                <input type="text" name="vendorSupplier" placeholder="e.g. Meralco / PLDT / Biomark" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Notes / Official Receipt #</label>
                <textarea name="notes" rows="2" placeholder="OR No. / Voucher No. / Special remarks..." style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem; box-sizing: border-box;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('addExpenseModal').style.display='none'" style="padding: 10px 18px; border: 1px solid #cbd5e1; background: #fff; color: #475569; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel</button>
                <button type="submit" style="padding: 10px 22px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Save Expense</button>
            </div>
        </form>
    </div>
</div>
