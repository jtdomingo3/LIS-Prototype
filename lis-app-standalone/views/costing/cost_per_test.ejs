<div style="width: 100%; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <a href="/costing" style="color: #64748b; text-decoration: none; font-size: 1.2rem;">←</a>
                <h2 style="margin: 0; font-size: 1.5rem; color: #0f172a; font-weight: 700;">Reagent Cost Mapping Per Test Type</h2>
            </div>
            <p style="margin: 4px 0 0 28px; color: #64748b; font-size: 0.88rem;">
                Define standard reagent consumption & supply cost per test type to automatically compute Cost of Goods Sold (COGS)
            </p>
        </div>
        <button onclick="document.getElementById('addMappingModal').style.display='flex'" class="btn btn-primary" style="padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
            <span>➕</span> Add Test Cost Mapping
        </button>
    </div>

    <!-- Mappings Table -->
    <div style="background: white; border-radius: 14px; border: 1px solid #e2e8f0; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.04); overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #e2e8f0;">
            <span style="font-weight: 700; color: #0f172a;"><%= mappings.length %> Configured Test Mappings</span>
        </div>

        <% if (mappings.length === 0) { %>
            <div style="padding: 50px 20px; text-align: center; color: #94a3b8;">
                <div style="font-size: 2.5rem; margin-bottom: 10px;">🧪</div>
                <div style="font-weight: 600; font-size: 1rem; color: #475569;">No Cost Mappings Defined</div>
                <p style="font-size: 0.85rem; margin: 4px 0 16px 0;">Map your laboratory tests to inventory reagents to track per-test margins.</p>
                <button onclick="document.getElementById('addMappingModal').style.display='flex'" class="btn btn-primary btn-small" style="padding: 8px 16px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 600; cursor: pointer;">
                    + Create First Mapping
                </button>
            </div>
        <% } else { %>
            <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem; text-align: left;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 0.8rem; text-transform: uppercase;">
                            <th style="padding: 12px 18px;">Test Type / Category</th>
                            <th style="padding: 12px 18px;">Mapped Consumables / Reagents</th>
                            <th style="padding: 12px 18px; text-align: right;">Estimated Reagent Cost</th>
                            <th style="padding: 12px 18px;">Last Updated By</th>
                            <th style="padding: 12px 18px; text-align: center;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% mappings.forEach(m => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;">
                                    <%= m.testType %>
                                    <% if (m.notes) { %>
                                        <div style="font-size: 0.78rem; color: #94a3b8; font-weight: normal;"><%= m.notes %></div>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; color: #475569;">
                                    <% if (m.inventoryItems && m.inventoryItems.length > 0) { %>
                                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                            <% m.inventoryItems.forEach(it => { %>
                                                <span style="background: #f1f5f9; padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; color: #334155;">
                                                    <%= it.name || it.inventoryId %> (<%= it.quantityPerTest %> <%= it.unit || 'unit' %>)
                                                </span>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <span style="color: #94a3b8; font-size: 0.82rem;">Flat estimate</span>
                                    <% } %>
                                </td>
                                <td style="padding: 14px 18px; text-align: right; font-weight: 700; color: #dc2626;">
                                    ₱<%= (Number(m.estimatedCost) || 0).toLocaleString('en-US', { minimumFractionDigits: 2 }) %>
                                </td>
                                <td style="padding: 14px 18px; color: #64748b; font-size: 0.82rem;">
                                    <%= m.updatedBy || 'Admin' %>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <form action="/costing/cost-per-test/<%= m.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Delete mapping for <%= m.testType %>?');">
                                        <button type="submit" style="background: none; border: none; color: #ef4444; cursor: pointer;" title="Delete">🗑️</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>
</div>

<!-- Modal: Add Test Mapping -->
<div id="addMappingModal" style="display: none; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.6); backdrop-filter: blur(4px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
    <div style="background: white; border-radius: 16px; width: 100%; max-width: 500px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
        <div style="padding: 20px 24px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: #0f172a;">New Cost-per-Test Mapping</h3>
            <button onclick="document.getElementById('addMappingModal').style.display='none'" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: #94a3b8;">✕</button>
        </div>
        <form action="/costing/cost-per-test" method="POST" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Select Test / Procedure *</label>
                <input list="templateList" name="testType" required placeholder="Type or select test (e.g. Complete Blood Count)" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; box-sizing: border-box;">
                <datalist id="templateList">
                    <% (templates || []).forEach(t => { %>
                        <option value="<%= t.name || t.testType %>"></option>
                    <% }) %>
                    <option value="Complete Blood Count (CBC)"></option>
                    <option value="Urinalysis"></option>
                    <option value="Fecalysis"></option>
                    <option value="Fasting Blood Sugar (FBS)"></option>
                    <option value="Lipid Profile"></option>
                    <option value="Blood Uric Acid (BUA)"></option>
                    <option value="Creatinine"></option>
                    <option value="SGPT / ALT"></option>
                    <option value="SGOT / AST"></option>
                    <option value="Chest X-Ray PA View"></option>
                </datalist>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Estimated Reagent & Supply Cost (PHP) *</label>
                <input type="number" step="0.01" min="0" name="estimatedCost" required placeholder="0.00" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.9rem; font-weight: 700; box-sizing: border-box;">
                <small style="color: #64748b; font-size: 0.78rem;">Average direct consumable cost (tubes, reagent volume, tips, slides) for 1 test run.</small>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #475569; margin-bottom: 6px; text-transform: uppercase;">Notes / Methodology</label>
                <textarea name="notes" rows="2" placeholder="e.g. Calculated based on 500 test kit price divided by 500 tests" style="width: 100%; padding: 10px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 0.85rem; box-sizing: border-box;"></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" onclick="document.getElementById('addMappingModal').style.display='none'" style="padding: 10px 18px; border: 1px solid #cbd5e1; background: #fff; color: #475569; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancel</button>
                <button type="submit" style="padding: 10px 22px; background: #10b981; color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer;">Save Mapping</button>
            </div>
        </form>
    </div>
</div>
