<style>
  .template-detail { max-width: 800px; }
  .template-detail .detail-row {
    display: flex;
    gap: 8px;
    margin-bottom: 6px;
    align-items: baseline;
  }
  .template-detail .detail-label {
    font-weight: 700;
    color: var(--text-gray);
    min-width: 110px;
    font-size: 0.9em;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .template-detail .detail-value {
    color: var(--primary-black);
  }
  .field-list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: #f9fafb;
    border: 1px solid var(--border-gray);
    border-radius: 8px;
    margin-bottom: 8px;
    transition: border-color 0.2s;
  }
  .field-list-item:hover {
    border-color: var(--secondary-green);
  }
  .field-list-item .field-idx {
    background: rgba(16,185,129,0.1);
    color: var(--secondary-green-dark);
    font-size: 0.75em;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    min-width: 28px;
    text-align: center;
  }
  .field-list-item .field-info {
    flex: 1;
  }
  .field-list-item .field-info strong {
    color: var(--primary-black);
  }
  .field-list-item .field-meta {
    font-size: 0.85em;
    color: var(--text-gray);
    margin-top: 2px;
  }
  .field-list-item .field-meta span {
    margin-right: 12px;
  }
  .field-list-item .field-badge {
    font-size: 0.78em;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }
  .field-badge.type-text { background: rgba(59,130,246,0.1); color: #1e40af; }
  .field-badge.type-number { background: rgba(16,185,129,0.1); color: #059669; }
  .field-badge.type-select { background: rgba(249,115,22,0.1); color: #b45309; }
  .field-badge.type-textarea { background: rgba(139,92,246,0.1); color: #6d28d9; }
</style>

<div class="card template-detail">
  <h3><i class="fa fa-file-alt"></i> Template Details</h3>

  <div class="card">
    <div class="detail-row">
      <span class="detail-label">Name:</span>
      <span class="detail-value"><strong><%= template.name %></strong></span>
    </div>
    <div class="detail-row">
      <span class="detail-label">Test Type:</span>
      <span class="detail-value"><%= template.testType %></span>
    </div>
    <% if (template.createdBy && template.createdBy.name) { %>
    <div class="detail-row">
      <span class="detail-label">Created By:</span>
      <span class="detail-value"><%= template.createdBy.name %></span>
    </div>
    <% } %>
    <% if (template.createdAt) { %>
    <div class="detail-row">
      <span class="detail-label">Created:</span>
      <span class="detail-value"><%= new Date(template.createdAt).toLocaleDateString() %></span>
    </div>
    <% } %>

    <hr style="margin: 16px 0; border: none; border-top: 1px solid var(--border-gray);">

    <p style="margin-bottom: 10px;"><strong>Fields (<%= template.fields && Array.isArray(template.fields) ? template.fields.length : 0 %>)</strong></p>
    <% if (template.fields && Array.isArray(template.fields) && template.fields.length) { %>
      <% template.fields.forEach((f, idx) => { %>
        <div class="field-list-item">
          <span class="field-idx">#<%= idx + 1 %></span>
          <div class="field-info">
            <strong><%= f.name %></strong>
            <% if (f.unit) { %><span style="color:var(--text-gray); font-size:0.9em;"> (<%= f.unit %>)</span><% } %>
            <div class="field-meta">
              <% if (f.normalValues) { %><span>📊 Normal: <strong><%= f.normalValues %></strong></span><% } %>
              <% if (f.placeholder) { %><span>💬 Placeholder: <%= f.placeholder %></span><% } %>
              <% if (f.options) { %><span>📋 Options: <%= f.options %></span><% } %>
              <% if (f.required) { %><span style="color:var(--danger);">⚠ Required</span><% } %>
            </div>
          </div>
          <span class="field-badge type-<%= f.type || 'text' %>"><%= f.type || 'text' %></span>
        </div>
      <% }) %>
    <% } else { %>
      <p style="color: var(--text-gray); font-style: italic;">No fields defined.</p>
    <% } %>

    <% if (template.footerNotes) { %>
    <hr style="margin: 16px 0; border: none; border-top: 1px solid var(--border-gray);">
    <p><strong>Footer Notes:</strong></p>
    <p style="color: var(--text-gray);"><%= template.footerNotes %></p>
    <% } %>
  </div>

  <div class="action-buttons mt-20">
    <% if (!template.isStatic) { %>
    <a href="/templates/<%= template.id %>/edit" class="button btn-primary"><i class="fa fa-edit"></i> Edit</a>
    <form action="/templates/<%= template.id %>?_method=DELETE" method="POST" style="display:inline-block;" onsubmit="return confirm('Are you sure you want to delete this template?');">
      <button class="button btn-danger"><i class="fa fa-trash"></i> Delete</button>
    </form>
    <% } %>
    <a href="/templates" class="button btn-secondary"><i class="fa fa-arrow-left"></i> Back to Templates</a>
  </div>
</div>
