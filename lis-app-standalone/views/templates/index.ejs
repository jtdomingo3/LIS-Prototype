<%
  const visibleTemplates = (templates || []).filter(t => {
    const name = (t.name || '').toLowerCase();
    if (name === 'full letter' || name === 'half letter') return false;
    const compact = name.replace(/[-\s]/g, '');
    if (/^[0-9a-f]{20,}$/.test(compact)) return false;
    return true;
  });
%>

<div class="card" style="padding:24px 28px; border-radius:16px; box-shadow:0 4px 20px rgba(0,0,0,0.03); background:#ffffff; border:1px solid #e2e8f0;">
  <!-- Toolbar -->
  <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:22px; padding-bottom:18px; border-bottom:1px solid #f1f5f9;">
    <div>
      <a href="/templates/new" class="button btn-primary no-guard" style="display:inline-flex; align-items:center; gap:8px; font-weight:700; padding:10px 20px; border-radius:10px; box-shadow:0 2px 8px rgba(16,185,129,0.25);">
        <i class="fas fa-plus-circle"></i>
        <span>Create New Template</span>
      </a>
    </div>

    <div style="display:flex; gap:10px; align-items:center; flex:1; justify-content:flex-end; max-width:460px;">
      <div style="position:relative; width:100%;">
        <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.88rem; pointer-events:none;"></i>
        <input type="text" id="templateSearchInput" placeholder="Filter templates by name or test type..." onkeyup="filterTemplates()" style="width:100%; height:42px; padding-left:38px; padding-right:14px; font-size:0.88rem; box-sizing:border-box; border-radius:10px; border:1px solid #cbd5e1; background:#f8fafc; transition:all 0.2s;" onfocus="this.style.background='#ffffff'; this.style.borderColor='#0284c7'; this.style.boxShadow='0 0 0 3px rgba(2,132,199,0.1)';" onblur="this.style.background='#f8fafc'; this.style.borderColor='#cbd5e1'; this.style.boxShadow='none';" />
      </div>
    </div>
  </div>

  <!-- Templates Table -->
  <div class="table-responsive" style="overflow-x:auto; border:1px solid #e2e8f0; border-radius:12px;">
    <table id="templatesTable" style="width:100%; border-collapse:collapse; margin-bottom:0; font-size:0.88rem;">
      <thead>
        <tr style="background:#f8fafc; border-bottom:2px solid #e2e8f0; text-align:left;">
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; min-width:220px;">Template Name</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; min-width:200px;">Diagnostic Department / Type</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; white-space:nowrap;">Field Parameters</th>
          <th style="padding:14px 16px; font-size:0.75rem; text-transform:uppercase; font-weight:700; color:#64748b; letter-spacing:0.05em; text-align:right; white-space:nowrap;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (visibleTemplates && visibleTemplates.length) { %>
          <% visibleTemplates.forEach(t => { %>
            <tr class="template-row" style="border-bottom:1px solid #f1f5f9; transition:background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='#ffffff'">
              <td style="padding:14px 16px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <strong class="template-name" style="color:#0f172a; font-size:0.95rem;"><%= t.name %></strong>
                  <% if (t.isStatic) { %>
                    <span style="display:inline-block; background:#eff6ff; color:#1d4ed8; font-size:0.72rem; font-weight:700; padding:2px 8px; border-radius:10px; border:1px solid #bfdbfe;">Static</span>
                  <% } else { %>
                    <span style="display:inline-block; background:#ecfdf5; color:#065f46; font-size:0.72rem; font-weight:700; padding:2px 8px; border-radius:10px; border:1px solid #a7f3d0;">Dynamic</span>
                  <% } %>
                </div>
              </td>
              <td style="padding:14px 16px;">
                <span class="template-type" style="font-weight:600; color:#475569; background:#f1f5f9; padding:4px 10px; border-radius:8px; font-size:0.82rem; border:1px solid #e2e8f0;">
                  <%= t.testType || 'General' %>
                </span>
              </td>
              <td style="padding:14px 16px;">
                <% if (t.fields && Array.isArray(t.fields) && t.fields.length) { %>
                  <span style="display:inline-flex; align-items:center; gap:4px; background:#ecfdf5; color:#065f46; font-size:0.78rem; font-weight:700; padding:4px 10px; border-radius:10px; border:1px solid #a7f3d0;">
                    <i class="fas fa-list-check" style="font-size:0.75rem;"></i>
                    <span><%= t.fields.length %> parameters</span>
                  </span>
                <% } else { %>
                  <span style="color:#94a3b8; font-size:0.88rem;">—</span>
                <% } %>
              </td>
              <td style="padding:14px 16px; text-align:right; white-space:nowrap;">
                <a href="/templates/<%= t.id %>" class="button btn-success btn-small" style="padding:6px 12px; font-size:0.8rem; font-weight:700; border-radius:8px; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                  <i class="fas fa-eye"></i>
                  <span>View</span>
                </a>
                <a href="/templates/<%= t.id %>/edit" class="button btn-orange btn-small" style="padding:6px 12px; font-size:0.8rem; font-weight:700; border-radius:8px; display:inline-flex; align-items:center; gap:4px; text-decoration:none;">
                  <i class="fas fa-pen"></i>
                  <span>Edit</span>
                </a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="4" style="text-align:center; color:#94a3b8; padding:54px 20px;">
              <div style="width:64px; height:64px; border-radius:18px; background:#f0f9ff; color:#0284c7; display:inline-flex; align-items:center; justify-content:center; font-size:1.8rem; margin-bottom:14px; box-shadow:0 4px 12px rgba(2,132,199,0.1);">
                <i class="fas fa-file-medical"></i>
              </div>
              <strong style="font-size:1.15rem; color:#0f172a; display:block; margin-bottom:4px;">No Templates Found</strong>
              <p style="font-size:0.88rem; color:#64748b; margin:0 0 16px 0;">Create a report template to standardize laboratory result printouts.</p>
              <a href="/templates/new" class="button btn-primary no-guard" style="display:inline-flex; align-items:center; gap:8px; font-weight:700; padding:8px 18px; border-radius:8px;">
                <i class="fas fa-plus-circle"></i>
                <span>Create New Template</span>
              </a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
function filterTemplates() {
  const input = document.getElementById('templateSearchInput');
  const filter = input.value.toLowerCase().trim();
  const rows = document.querySelectorAll('.template-row');

  rows.forEach(row => {
    const name = row.querySelector('.template-name') ? row.querySelector('.template-name').textContent.toLowerCase() : '';
    const type = row.querySelector('.template-type') ? row.querySelector('.template-type').textContent.toLowerCase() : '';
    if (name.includes(filter) || type.includes(filter)) {
      row.style.display = '';
    } else {
      row.style.display = 'none';
    }
  });
}
</script>
