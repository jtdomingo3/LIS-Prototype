<div class="card" style="padding: 28px 32px; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0; max-width: 960px; margin: 0 auto;">
  
  <!-- Header Banner -->
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; flex-wrap: wrap; padding-bottom: 24px; border-bottom: 1px solid #f1f5f9;">
    <div style="display: flex; align-items: center; gap: 16px;">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 1.5em; font-weight: 700; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);">
        <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div>
        <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
          <h2 style="margin: 0; font-size: 1.35em; font-weight: 700; color: #0f172a;"><%= user.name %></h2>
          <span style="background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; padding: 2px 10px; border-radius: 20px; font-size: 0.78em; font-weight: 600; text-transform: uppercase;">
            <%= user.role %>
          </span>
          <span style="display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 0.78em; font-weight: 700; text-transform: uppercase; background: <%= user.status === 'Active' ? '#dcfce7' : '#f1f5f9' %>; color: <%= user.status === 'Active' ? '#15803d' : '#475569' %>; border: 1px solid <%= user.status === 'Active' ? '#bbf7d0' : '#cbd5e1' %>;">
            <%= user.status || 'Active' %>
          </span>
        </div>
        <div style="font-size: 0.85em; color: #64748b; margin-top: 4px;">
          <i class="fa fa-envelope" style="margin-right: 4px;"></i> <%= user.email %>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="action-buttons" style="display: flex; gap: 8px; flex-wrap: wrap; margin: 0; align-items: center;">
      <a href="/users/<%= user.id %>/edit" class="button btn-primary" style="height: 38px; padding: 0 16px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.88em;">
        <i class="fa fa-edit"></i> Edit User
      </a>
      
      <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'Admin') { %>
        <form action="/users/<%= user.id %>/reset-password" method="POST" style="display:inline-flex; margin:0;" onsubmit="return confirm('Reset this user\'s password to default (gezyne)?');">
          <button type="submit" class="button btn-warning" style="height: 38px; padding: 0 14px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.88em;">
            <i class="fa fa-key"></i> Reset Password
          </button>
        </form>
      <% } %>

      <form action="/users/<%= user.id %>?_method=DELETE" method="POST" style="display:inline-flex; margin:0;" onsubmit="return confirm('Are you sure you want to delete this user?');">
        <button type="submit" class="button btn-secondary" style="height: 38px; padding: 0 12px; border-radius: 8px; font-weight: 600; color: #ef4444; border-color: #fecaca; display: inline-flex; align-items: center; gap: 4px; font-size: 0.88em;">
          <i class="fa fa-trash"></i> Delete
        </button>
      </form>

      <a href="/users" class="button btn-secondary" style="height: 38px; padding: 0 14px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.88em;">
        <i class="fa fa-arrow-left"></i> Back to Users
      </a>
    </div>
  </div>

  <!-- User Details Grid -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 24px;">
    
    <!-- Account Information Tile -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
      <div style="font-weight: 700; font-size: 0.9em; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
        <i class="fa fa-id-card" style="color: #3b82f6;"></i> Account Credentials
      </div>

      <div style="display: flex; flex-direction: column; gap: 12px;">
        <div>
          <span style="font-size: 0.78em; text-transform: uppercase; color: #64748b; font-weight: 600; display: block;">Full Name</span>
          <span style="font-size: 0.95em; font-weight: 600; color: #0f172a;"><%= user.name %></span>
        </div>
        <div>
          <span style="font-size: 0.78em; text-transform: uppercase; color: #64748b; font-weight: 600; display: block;">Email Address</span>
          <span style="font-size: 0.95em; font-weight: 600; color: #0f172a;"><%= user.email %></span>
        </div>
        <div>
          <span style="font-size: 0.78em; text-transform: uppercase; color: #64748b; font-weight: 600; display: block;">PRC License Number</span>
          <span style="font-size: 0.95em; font-weight: 600; color: #0f172a;"><%= user.licenseNumber || 'None recorded' %></span>
        </div>
        <div>
          <span style="font-size: 0.78em; text-transform: uppercase; color: #64748b; font-weight: 600; display: block;">Account Created</span>
          <span style="font-size: 0.9em; color: #334155;"><%= new Date(user.createdAt).toLocaleString() %></span>
        </div>
      </div>
    </div>

    <!-- Digital Signature & Authorization -->
    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
      <div style="font-weight: 700; font-size: 0.9em; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
        <i class="fa fa-signature" style="color: #10b981;"></i> Digital Signature File
      </div>

      <% const sigPath = user.signature ? ('/assets/signature/' + user.signature) : null; %>
      <div style="width: 100%; height: 80px; border: 1px dashed #cbd5e1; border-radius: 8px; background: #ffffff; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 6px; margin-bottom: 10px;">
        <% if (sigPath) { %>
          <img src="<%= sigPath %>" alt="signature" style="max-height: 68px; max-width: 100%; object-fit: contain;" onerror="this.onerror=null; this.parentElement.innerHTML='<span style=\'font-size:0.8em;color:#94a3b8;\'>Signature file not found on disk</span>';" />
        <% } else { %>
          <span style="font-size: 0.8em; color: #94a3b8;">No digital signature uploaded</span>
        <% } %>
      </div>
      <div style="font-size: 0.8em; color: #64748b;">
        Used automatically on laboratory and diagnostic report release sign-offs if authorized.
      </div>
    </div>

  </div>

  <!-- Permissions List -->
  <div style="margin-top: 24px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px;">
    <div style="font-weight: 700; font-size: 0.9em; color: #1e293b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
      <i class="fa fa-user-shield" style="color: #6366f1;"></i> Module Access Privileges
    </div>

    <% 
      const permLabels = {
        dashboard: 'Dashboard (Analytics & Financials)',
        reception: 'Reception (Patient Intake & Queue)',
        patients: 'Patients (Demographics & Records)',
        tests: 'Tests (Worklist & Results Entry)',
        reports: 'Reports (Sign-off & Printouts)',
        worksheet: 'Worksheet (Batch Bench Sheet)',
        inventory: 'Inventory (Supplies Management)',
        templates: 'Report Templates (Responsible Person)',
        users: 'Users (Staff Management)',
        delete: 'Delete Records (Deletion Authority)'
      };
      const userPerms = user.permissions || {};
      const activeKeys = Object.keys(userPerms).filter(k => userPerms[k]);
    %>

    <% if (activeKeys.length > 0) { %>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        <% activeKeys.forEach(k => { %>
          <span style="background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; padding: 4px 12px; border-radius: 20px; font-size: 0.82em; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa fa-check" style="font-size: 0.75em;"></i> <%= permLabels[k] || k %>
          </span>
        <% }) %>
      </div>
    <% } else { %>
      <div style="font-size: 0.88em; color: #64748b;">
        Standard privileges assigned based on the <strong><%= user.role %></strong> role.
      </div>
    <% } %>
  </div>

</div>
