<div class="card">
  <h3>Edit User</h3>

  <form action="/users/<%= user.id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label>Name</label>
      <input type="text" name="name" value="<%= user.name || '' %>" required>
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="<%= user.email || '' %>" required>
    </div>

    <div class="form-group">
      <label>New Password (leave blank to keep current)</label>
      <input type="password" name="password">
    </div>

    <div class="form-group">
      <label>Confirm Password</label>
      <input type="password" name="confirmPassword">
    </div>

    <div class="form-group">
      <label>Role</label>
      <select name="role">
        <option value="Receptionist" <%= user.role === 'Receptionist' ? 'selected' : '' %>>Receptionist</option>
        <option value="Technician" <%= user.role === 'Technician' ? 'selected' : '' %>>Technician</option>
        <option value="Medical Technologist" <%= user.role === 'Medical Technologist' ? 'selected' : '' %>>Medical Technologist</option>
        <option value="X-Ray Technologist" <%= user.role === 'X-Ray Technologist' ? 'selected' : '' %>>X-Ray Technologist</option>
        <option value="Doctor" <%= user.role === 'Doctor' ? 'selected' : '' %>>Doctor</option>
        <option value="Internist" <%= user.role === 'Internist' ? 'selected' : '' %>>Internist</option>
        <option value="Pathologist" <%= user.role === 'Pathologist' ? 'selected' : '' %>>Pathologist</option>
        <option value="Radiologist" <%= user.role === 'Radiologist' ? 'selected' : '' %>>Radiologist</option>
        <option value="Encoder" <%= user.role === 'Encoder' ? 'selected' : '' %>>Encoder</option>
        <option value="Drugtest Analyst" <%= user.role === 'Drugtest Analyst' ? 'selected' : '' %>>Drugtest Analyst</option>
        <option value="Sonographer" <%= user.role === 'Sonographer' ? 'selected' : '' %>>Sonographer</option>
        <option value="Manager" <%= user.role === 'Manager' ? 'selected' : '' %>>Manager</option>
        <option value="Owner" <%= user.role === 'Owner' ? 'selected' : '' %>>Owner</option>
        <option value="Admin" <%= user.role === 'Admin' ? 'selected' : '' %>>Admin</option>
      </select>
    </div>

    <div class="form-group">
      <label>License Number</label>
      <input type="text" name="licenseNumber" value="<%= user.licenseNumber || '' %>">
    </div>

    <div class="form-group">
      <label style="font-weight: 700; margin-bottom: 8px; display: block;">User Permissions & Access Control</label>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; background: #f8fafc; border: 1px solid var(--border-gray); padding: 14px; border-radius: 10px;">
        <% 
          const permList = [
            { key: 'dashboard', label: 'Dashboard', desc: 'Analytics & Financials' },
            { key: 'reception', label: 'Reception', desc: 'Patient Intake & Queue' },
            { key: 'patients', label: 'Patients', desc: 'Demographics & Records' },
            { key: 'tests', label: 'Tests', desc: 'Worklist & Results Entry' },
            { key: 'reports', label: 'Reports', desc: 'Sign-off & Printouts' },
            { key: 'worksheet', label: 'Worksheet', desc: 'Batch Bench Sheet' },
            { key: 'inventory', label: 'Inventory', desc: 'Reagents, Films & Supplies' },
            { key: 'templates', label: 'Report Templates', desc: 'Responsible Person Only', highlight: true },
            { key: 'users', label: 'Users', desc: 'Staff Management' },
            { key: 'delete', label: 'Delete Records', desc: 'Deletion Authority' }
          ];
        %>
        <% permList.forEach(p => { %>
          <label style="display: flex; align-items: flex-start; gap: 8px; padding: 8px 10px; border-radius: 8px; background: <%= p.highlight ? '#fef2f2' : '#ffffff' %>; border: 1px solid <%= p.highlight ? '#fca5a5' : '#e2e8f0' %>; cursor: pointer;">
            <input type="checkbox" name="permissions[<%= p.key %>]" value="1" <%= user.permissions && user.permissions[p.key] ? 'checked' : '' %> style="margin-top: 3px; accent-color: var(--secondary-green);" />
            <div>
              <div style="font-weight: 600; font-size: 0.9em; color: <%= p.highlight ? '#b91c1c' : 'var(--text-dark)' %>;"><%= p.label %></div>
              <small style="font-size: 0.75em; color: <%= p.highlight ? '#991b1b' : 'var(--text-gray)' %>; display: block;"><%= p.desc %></small>
            </div>
          </label>
        <% }) %>
      </div>
    </div>

    <div class="form-group">
      <label>Status</label>
      <select name="status">
        <option value="Active" <%= user.status === 'Active' ? 'selected' : '' %>>Active</option>
        <option value="Inactive" <%= user.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
      </select>
    </div>

    <button class="button btn-primary">Update User</button>
    <a href="/users" class="button btn-secondary">Cancel</a>
  </form>
</div>
