<style>
  @page { size: Letter; margin: 0.25in; }
  body { margin:0; padding:0; box-sizing:border-box; font-family: Arial, Helvetica, sans-serif; }
  .report-page{ position:relative; width:100%; max-width:calc(8.5in - 0.4in); margin:0 auto; padding:0.25in; color:#000; box-sizing:border-box; }
  .header{ display:flex; align-items:flex-start; gap:12px }
  .logo{ width:72px; height:auto; margin-right:8px }
  .lab-title{ text-align:center; flex:1; min-width:0 }
  .lab-title h1{ margin:0; font-size:22px; color:#009957; letter-spacing:1px; font-weight:700 }
  .lab-sub{ font-size:10px; margin-top:4px; color:#009957 }
  .patient-box{ margin-top:8px; width:100%; border-collapse:collapse; font-size:12px; table-layout:fixed }
  .patient-box td{ padding:4px 6px; border:1px solid #000; box-sizing:border-box }
  
  .section-title{ text-align:center; margin:26px 0 18px; font-size:22px; font-weight:800; letter-spacing:0.5px; text-transform:uppercase; color:#000 }
  
  .report-body{ width:76%; margin:0 auto; color:#000 }
  .table-heading{ font-size:13px; font-weight:700; margin-bottom:6px; color:#000; font-family: Arial, Helvetica, sans-serif; }
  
  .report-table{ width:100%; border-collapse:collapse; font-size:12px; color:#000; table-layout:fixed }
  .report-table td{ border:1px solid #000; padding:3px 8px; vertical-align:middle; font-weight:700; box-sizing:border-box }
  
  .biometry-table{ margin-bottom:20px }
  .biometry-table .col-param{ width:38%; text-align:left; font-family: Arial, Helvetica, sans-serif; }
  .biometry-table .col-size{ width:28%; text-align:center; font-family: 'Courier New', Courier, monospace; }
  .biometry-table .col-w{ width:17%; text-align:center; font-family: 'Courier New', Courier, monospace; }
  .biometry-table .col-d{ width:17%; text-align:center; font-family: 'Courier New', Courier, monospace; }
  
  .clinical-table{ margin-bottom:22px }
  .clinical-table .clinical-label{ width:54%; text-align:left; font-family: Arial, Helvetica, sans-serif; }
  .clinical-table .clinical-val{ width:46%; text-align:center; text-transform:uppercase; font-family: 'Courier New', Courier, monospace; }
  
  .impression-section{ margin-bottom:18px }
  .impression-heading{ font-size:13px; font-weight:700; margin-bottom:8px; color:#000; font-family: Arial, Helvetica, sans-serif; }
  .impression-body{ font-family: 'Courier New', monospace; font-size:12.5px; font-weight:700; line-height:1.55; color:#000 }
  
  .signatures{ display:flex; justify-content:flex-end; font-family: 'Times New Roman', Times, serif }
  .sig{ position:relative; text-align:center; width:280px; min-height:80px; font-family: 'Times New Roman', Times, serif }
  .sig-line{ border-top:1px solid #000; margin-bottom:6px }
  .sig-name{ font-weight:700; font-size:13px; text-transform:uppercase }
  .sig-lic{ font-size:11px; font-weight:700; margin-top:2px }
  .sig-title{ font-weight:600; font-size:12px; text-transform:uppercase; margin-top:2px }
  .signature-overlay{ position:absolute; pointer-events:none; left:50%; transform-origin:center; }
  
  .watermark{ position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:52%; opacity:0.06; pointer-events:none; z-index:0 }
  .report-container{ position:relative; z-index:1 }
</style>

<%- include('./_highlight') %>

<%
function parseWD(w, d, label) {
  let weeks = '';
  let days = '';
  if (w !== undefined && w !== null && String(w).trim() !== '') {
    weeks = String(w).trim();
  }
  if (d !== undefined && d !== null && String(d).trim() !== '') {
    days = String(d).trim();
  }
  if (!weeks && !days && label) {
    const l = String(label).trim();
    const mW = l.match(/(\d+)\s*(?:w|wk|wks|weeks?)\b/i) || l.match(/^(\d+)\s*W/i);
    const mD = l.match(/(\d+)\s*(?:d|days?)\b/i);
    if (mW) weeks = mW[1];
    if (mD) days = mD[1];
    if (!mW && !mD) {
      weeks = l;
    }
  }
  return {
    wStr: weeks ? (weeks.toUpperCase().endsWith('W') ? weeks.toUpperCase() : weeks + ' W') : '',
    dStr: days !== '' ? (days.toUpperCase().endsWith('D') ? days.toUpperCase() : days + ' D') : (weeks ? '0 D' : '')
  };
}

function formatSizeCM(val) {
  if (!val && val !== 0) return '';
  const s = String(val).trim().replace(/\s*cm$/i, '');
  return s ? s + ' CM' : '';
}

function formatAgeWD(age, w, d) {
  if (w !== undefined && w !== null && String(w).trim() !== '') {
    const ww = String(w).trim();
    const dd = (d !== undefined && d !== null && String(d).trim() !== '') ? String(d).trim() : '0';
    return ww + ' W ' + dd + ' D';
  }
  if (age) {
    return String(age).trim().toUpperCase();
  }
  return '';
}

function formatMMDDYY(d) {
  if (!d) return '';
  const dt = new Date(d);
  if (isNaN(dt.getTime())) return String(d);
  const mm = String(dt.getMonth() + 1).padStart(2, '0');
  const dd = String(dt.getDate()).padStart(2, '0');
  const yy = String(dt.getFullYear()).slice(-2);
  return mm + '/' + dd + '/' + yy;
}

function formatGrams(val) {
  if (!val && val !== 0) return '';
  const s = String(val).trim().replace(/\s*g$/i, '');
  return s ? s + ' g' : '';
}

function formatBPM(val) {
  if (!val && val !== 0) return '';
  const s = String(val).trim().replace(/\s*bpm$/i, '');
  return s ? s + ' bpm' : '';
}
%>

<div class="report-page">
  <div class="report-container">
    <div class="header">
      <div>
        <img src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" class="logo" alt="logo">
      </div>
      <div class="lab-title">
        <h1>GEZYNE CLINICAL LABORATORY</h1>
        <div class="lab-sub">0330 VERGEL DE DIOS ST POBLACION PLARIDEL</div>
        <div class="lab-sub">NEAR MUNICIPAL BASKETBALL COURT</div>
        <div class="lab-sub">0917-649-0807 / 0960-390-0921 / 795-5007</div>
        <div class="lab-sub">Lic. No. 03-435-15CL-20</div>
      </div> 
      <div style="min-width:180px; font-size:12px; text-align:right">
        <table style="border-collapse:collapse; width:100%; font-size:12px">
          <tr><td style="border:1px solid #000; padding:4px">Date:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleDateString() : new Date().toLocaleDateString() %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Requested:</td><td style="border:1px solid #000; padding:4px"><%= test && test.testDate ? (new Date(test.testDate)).toLocaleTimeString() : '' %></td></tr>
          <tr><td style="border:1px solid #000; padding:4px">Time Released:</td><td style="border:1px solid #000; padding:4px"><%= test && test.completedAt ? (new Date(test.completedAt)).toLocaleTimeString() : '' %></td></tr>
        </table>
      </div>
    </div>

    <table class="patient-box">
      <tr>
        <td style="width:23%; white-space:nowrap;">Patient's Reference No. :</td>
        <td style="width:27%"><strong><%= test && test.testId ? test.testId : '' %></strong></td>
        <td style="width:15%">DOB:</td>
        <td style="width:15%"><strong><%= test && test.patient && test.patient.dateOfBirth ? (new Date(test.patient.dateOfBirth)).toLocaleDateString() : '' %></strong></td>
        <td style="width:10%">Sex:</td>
        <td style="width:10%"><strong><%= test && test.patient && test.patient.sex ? test.patient.sex : '' %></strong></td>
      </tr>
      <tr>
        <td>Name:</td>
        <td colspan="3"><strong><%= test && test.patient ? (test.patient.lastName + ', ' + test.patient.firstName) : '' %></strong></td>
        <td>Age:</td>
        <td><strong><%= test && test.patient ? (test.patient.age !== null && test.patient.age !== undefined && test.patient.age !== '' ? test.patient.age : (test.patient.ageManual || '')) : '' %></strong></td>
      </tr>
      <tr>
        <td>Physician:</td>
        <td colspan="5"><strong><%= (test && test.patient && (test.patient.physician || test.patient.physicianName)) ? (test.patient.physician || test.patient.physicianName) : '' %></strong></td>
      </tr>
      <tr>
        <td>Examination:</td>
        <td colspan="5"><strong><%= (test && test.results && test.results.examination) ? test.results.examination : ((test && (test.examination || test.examinationName)) ? (test.examination || test.examinationName) : ((test && test.results && test.results.section_title) ? test.results.section_title.replace(/\s*ULTRASOUND\s*/i, '').trim() : 'BIOPHYSICAL')) %></strong></td>
      </tr>
    </table>

    <div class="section-title"><%= (test && test.results && test.results.section_title) ? test.results.section_title : 'BIOPHYSICAL ULTRASOUND' %></div>

    <div class="report-body">
      <!-- BIOMETRY TABLE -->
      <div class="table-heading">BIOMETRY:</div>
      <table class="report-table biometry-table">
        <tbody>
          <tr>
            <td class="col-param">BPD:</td>
            <td class="col-size"><%= formatSizeCM(test && test.results && test.results.bpd_size) %></td>
            <td class="col-w"><%= parseWD(test && test.results && test.results.bpd_w, test && test.results && test.results.bpd_d, test && test.results && test.results.bpd_label).wStr %></td>
            <td class="col-d"><%= parseWD(test && test.results && test.results.bpd_w, test && test.results && test.results.bpd_d, test && test.results && test.results.bpd_label).dStr %></td>
          </tr>
          <tr>
            <td class="col-param">HC:</td>
            <td class="col-size"><%= formatSizeCM(test && test.results && test.results.hc_size) %></td>
            <td class="col-w"><%= parseWD(test && test.results && test.results.hc_w, test && test.results && test.results.hc_d, test && test.results && test.results.hc_label).wStr %></td>
            <td class="col-d"><%= parseWD(test && test.results && test.results.hc_w, test && test.results && test.results.hc_d, test && test.results && test.results.hc_label).dStr %></td>
          </tr>
          <tr>
            <td class="col-param">AC:</td>
            <td class="col-size"><%= formatSizeCM(test && test.results && test.results.ac_size) %></td>
            <td class="col-w"><%= parseWD(test && test.results && test.results.ac_w, test && test.results && test.results.ac_d, test && test.results && test.results.ac_label).wStr %></td>
            <td class="col-d"><%= parseWD(test && test.results && test.results.ac_w, test && test.results && test.results.ac_d, test && test.results && test.results.ac_label).dStr %></td>
          </tr>
          <tr>
            <td class="col-param">FL:</td>
            <td class="col-size"><%= formatSizeCM(test && test.results && test.results.fl_size) %></td>
            <td class="col-w"><%= parseWD(test && test.results && test.results.fl_w, test && test.results && test.results.fl_d, test && test.results && test.results.fl_label).wStr %></td>
            <td class="col-d"><%= parseWD(test && test.results && test.results.fl_w, test && test.results && test.results.fl_d, test && test.results && test.results.fl_label).dStr %></td>
          </tr>
          <% if (test && test.results && Array.isArray(test.results.biometry) && test.results.biometry.length) { %>
            <% test.results.biometry.forEach(function(b){ %>
              <tr>
                <td class="col-param"><%= b.label %>:</td>
                <td class="col-size"><%= formatSizeCM(b.size) %></td>
                <td class="col-w"><%= parseWD(b.w, b.d, b.label_wd || b.age).wStr %></td>
                <td class="col-d"><%= parseWD(b.w, b.d, b.label_wd || b.age).dStr %></td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>

      <!-- CLINICAL PARAMETERS TABLE -->
      <table class="report-table clinical-table">
        <tbody>
          <tr>
            <td class="clinical-label">NUMBER OF FETUS:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.number_of_fetus) ? test.results.number_of_fetus : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">AVERAGE ULTRASOUND AGE:</td>
            <td class="clinical-val"><%= formatAgeWD(test && test.results && test.results.average_ultrasound_age, test && test.results && test.results.average_ultrasound_age_w, test && test.results && test.results.average_ultrasound_age_d) %></td>
          </tr>
          <tr>
            <td class="clinical-label">PRESENTATION:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.presentation) ? test.results.presentation : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">EDC BY ULTRASOUND:</td>
            <td class="clinical-val"><%= formatMMDDYY(test && test.results && test.results.edc_by_ultrasound) %></td>
          </tr>
          <tr>
            <td class="clinical-label">EFW:</td>
            <td class="clinical-val"><%= formatGrams(test && test.results && test.results.efw) %></td>
          </tr>
          <tr>
            <td class="clinical-label">FETAL HEART RATE:</td>
            <td class="clinical-val"><%= formatBPM(test && test.results && test.results.fetal_heart_rate) %></td>
          </tr>
          <tr>
            <td class="clinical-label">PLACENTAL LOCATION:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.placental_location) ? test.results.placental_location : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">MATURITY:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.maturity) ? test.results.maturity : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">AMNIOTIC FLUID:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.amniotic_fluid) ? test.results.amniotic_fluid : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">GENDER:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.gender) ? test.results.gender : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">FETAL TONE:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.fetal_tone) ? test.results.fetal_tone : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">FETAL MOVEMENT:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.fetal_movement) ? test.results.fetal_movement : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">FETAL BREATHING:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.fetal_breathing) ? test.results.fetal_breathing : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">AFI:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.afi) ? test.results.afi : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">BPS:</td>
            <td class="clinical-val"><%= (test && test.results && test.results.bps) ? test.results.bps : '' %></td>
          </tr>
          <tr>
            <td class="clinical-label">ESTIMATED DATE OF DELIVERY:</td>
            <td class="clinical-val"><%= formatMMDDYY(test && test.results && (test.results.estimated_date_of_delivery || test.results.edc_by_ultrasound)) %></td>
          </tr>
        </tbody>
      </table>

      <!-- IMPRESSION -->
      <div class="impression-section">
        <div class="table-heading" style="margin-bottom:8px">IMPRESSION:</div>
        <div class="impression-body">
          <% var raw = (test && test.results && test.results.impression) ? test.results.impression : ''; %>
          <% if (raw && !/<\/?[a-z][\s\S]*>/i.test(raw)) { %>
            <% var parts = raw.split(/\r?\n\r?\n/).map(function(p){ return p.trim(); }).filter(Boolean); %>
            <% if (parts.length) { %>
              <% parts.forEach(function(p){ %>
                <p style="margin:0 0 4px 0"><%- p.replace(/\r?\n/g, '<br>') %></p>
              <% }) %>
            <% } else { %>
              <%- raw.replace(/\r?\n/g, '<br>') %>
            <% } %>
          <% } else { %>
            <%- raw %>
          <% } %>
        </div>
      </div>

      <!-- SIGNATURE -->
      <% function findSigFor(displayName){
           if (!displayName) return null;
           const sigs = (test && test.results && test.results.signatures) ? test.results.signatures : {};
           for (const k in sigs){
             const s = sigs[k];
             if (s && s.name && String(s.name).trim() === String(displayName).trim()) return s;
           }
           return null;
         }
      %>
      <div class="signatures" style="margin-top:<%= (test && test.results && test.results.impression_spacing) ? test.results.impression_spacing : '28px' %>">
        <div class="sig">
          <div class="sig-line"></div>
          <div class="sig-name"><span style="white-space:nowrap; display:inline-block"><%= (test && test.results && (test.results.doctorName || test.results.pathName || test.results.performedByName)) || (test && test.performedBy && test.performedBy.name) || '' %></span></div>
          <% const _performedName = (test && test.results && (test.results.doctorName || test.results.pathName || test.results.performedByName)) || (test && test.performedBy && test.performedBy.name) || '';
             const _performedSig = findSigFor(_performedName);
          %>
          <% if (_performedSig && _performedSig.filename) { %>
            <% const p = _performedSig.placement || { x:0, y:-56, scale:1 }; %>
            <img src="/assets/signature/<%= _performedSig.filename %>" class="signature-overlay" style="left:50%; top:<%= p.y %>px; transform:translateX(-50%) scale(<%= p.scale %>); max-height:96px;" alt="signature" />
          <% } %>
          <% if (test && test.results && (test.results.doctorLicense || test.results.pathLicense || test.results.performedByLicense)) { %>
            <div class="sig-lic">Lic. No. <%= (test.results.doctorLicense || test.results.pathLicense || test.results.performedByLicense) %></div>
          <% } %>
          <div class="sig-title"><%= (test && test.results && (test.results.doctorDesignation)) ? test.results.doctorDesignation : 'RADIOLOGIST' %></div>
        </div>
      </div>
    </div>
  </div>

  <img class="watermark" src="<%= inlineLogo || '/assets/gezyne-logo.png' %>" alt="" />
</div>

<% if (typeof print !== 'undefined' && print) { %>
  <script>setTimeout(function(){ window.print(); }, 300);</script>
<% } %>
