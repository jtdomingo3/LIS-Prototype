<div class="card">
  <form action="/tests" method="POST">
    <div class="form-group">
      <label>Patient</label>
      <div style="display:flex; flex-direction:column; gap:6px;">
        <input id="patientSearch" type="text" placeholder="Type to search patients by name or ID..." autocomplete="off" style="padding:10px; font-size:14px;">
        <select id="patientSelect" name="patient" required style="padding:8px; font-size:14px;">
          <option value="">-- Select Patient --</option>
          <% if (patients && patients.length) { %>
            <% patients.forEach(p => { %>
              <option value="<%= p.id %>" <%= (test.patient && test.patient === p.id) ? 'selected' : '' %>><%= p.lastName %>, <%= p.firstName %> (<%= p.patientId %>)</option>
            <% }) %>
          <% } %>
        </select>
      </div>
    </div>

    <div class="card" style="margin-top:12px;">
      <h4>Select Requested Tests</h4>
      <p>Choose the tests/services to request for this patient. You can specify amount and remarks per item.</p>
      <div style="display:grid; grid-template-columns: repeat(4, 1fr); gap:8px; margin-top:8px; align-items:start;">
        <% (templates || []).forEach(t => {
             const rawKey = String(t.testType || t.name || '').trim();
             const slug = rawKey.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'');
        %>
          <label style="display:flex; align-items:center; gap:6px; padding:8px 10px; border-radius:6px; background:#fff; border:1px solid #e2e8f0; flex-direction:column; align-items:stretch; transition: border-color 0.15s;">
            <div style="display:flex; align-items:center; gap:8px;">
              <input type="checkbox" class="test-checkbox" data-key="<%= slug %>" name="selectedTests" value="<%= rawKey %>">
              <span style="font-size:0.92em; font-weight:500; flex:1;"><%= t.name || t.testType %></span>
              <input type="number" step="0.01" min="0" name="amount_<%= slug %>" class="test-amount" placeholder="Amount" style="width:105px; padding:4px 8px; font-size:13px; display:none;">
            </div>
            <div class="test-remark-container" style="display:none; margin-top:6px;">
              <textarea name="remark_<%= slug %>" class="test-remark" placeholder="Remarks" rows="2" style="width:100%; height:42px; min-height:40px; max-height:44px; font-size:12.5px; line-height:1.25; padding:4px 8px; border:1px solid #cbd5e1; border-radius:4px; box-sizing:border-box; resize:none;"></textarea>
            </div>
          </label>
        <% }) %>
      </div>

      <div style="margin-top:12px; display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
        <label style="display:inline-flex; align-items:center; gap:8px; margin-right:12px;">
          <input type="checkbox" class="sendout-checkbox" data-key="sendout" name="forSendOut" value="1" >
          <span style="font-size:0.95em; font-weight:500;">For Send Out</span>
        </label>
        <input type="number" step="0.01" min="0" name="amount_sendout" class="test-amount" placeholder="Amount" style="width:105px; padding:4px 8px; font-size:13px; display:none;">
        <div class="sendout-remark-container" style="display:none; margin-left:6px; flex:1; max-width:320px;">
          <textarea name="remark_sendout" class="test-remark" placeholder="Remarks" rows="2" style="width:100%; height:42px; min-height:40px; max-height:44px; font-size:12.5px; line-height:1.25; padding:4px 8px; border:1px solid #cbd5e1; border-radius:4px; box-sizing:border-box; resize:none;"></textarea>
        </div>
      </div>

      <h5 style="margin-top:12px;">Doctor's Check-up</h5>
      <% const DOCS = (typeof DOCTOR_AREAS !== 'undefined' && DOCTOR_AREAS && DOCTOR_AREAS.length) ? DOCTOR_AREAS : ["Doctor's Check-up - Dr. Lorenzo","Doctor's Check-up - Dr. Arcilla"]; %>
      <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:6px;">
        <% DOCS.forEach(d => { %>
          <label style="display:inline-flex; align-items:center; gap:6px;">
            <input type="checkbox" name="requiredAreas" value="<%= d %>">
            <%= d %>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- Test Date and Priority removed — defaults will be applied by server -->

    <div class="form-row" style="display:flex; gap:12px; align-items:center; flex-wrap:nowrap; justify-content:flex-start;">
      <div style="display:flex; gap:12px; align-items:center;">
        <a href="<%= (typeof returnTo !== 'undefined' && returnTo) ? returnTo : '/tests' %>" class="button btn-secondary" style="white-space:nowrap;" id="backButton">
          <%= (typeof returnTo !== 'undefined' && returnTo && returnTo.startsWith('/patients')) ? 'Back to Patient' : 'Back to Tests' %>
        </a>
      </div>

      <div style="flex:0 0 auto; margin-left:8px;">
        <button class="button btn-primary" style="white-space:nowrap;">Create Test</button>
      </div>

      <div style="display:flex; gap:8px; align-items:center; margin-left:8px;">
        <label style="display:inline-flex; align-items:center; gap:8px; white-space:nowrap;">
          <input type="checkbox" name="printAfterAssign" value="1" <%= test.printAfterAssign ? 'checked' : '' %>> Print receipt after assign
        </label>
      </div>
    </div>
    <input type="hidden" name="returnTo" id="returnTo" value="<%= typeof returnTo !== 'undefined' ? returnTo : '' %>">
  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function(){
    // Patient search -> filter patient select options
    (function(){
      const input = document.getElementById('patientSearch');
      const select = document.getElementById('patientSelect');
      if (!input || !select) return;

      function filter() {
        const q = String(input.value || '').toLowerCase().trim();
        let visibleCount = 0;
        for (let i = 0; i < select.options.length; i++) {
          const opt = select.options[i];
          if (!opt.value) { opt.hidden = false; visibleCount++; continue; }
          const txt = (opt.text || '').toLowerCase();
          const match = q === '' || txt.indexOf(q) !== -1;
          opt.hidden = !match;
          if (match) visibleCount++;
        }
        // expand select to show matches when typing
        if (q !== '' && visibleCount > 1) select.size = Math.min(8, visibleCount);
        else select.size = 1;

        // if exactly one match, auto-select it
        if (q !== '' && visibleCount === 1) {
          for (let i = 0; i < select.options.length; i++) {
            const opt = select.options[i];
            if (!opt.hidden && opt.value) { select.value = opt.value; break; }
          }
        }
      }

      input.addEventListener('input', filter);
      // When the select changes, only collapse the expanded list; do NOT overwrite the typed search value.
      select.addEventListener('change', function(){
        select.size = 1;
      });
        // populate hidden returnTo input so server can redirect back after create
        try {
          const rtField = document.getElementById('returnTo');
          const backBtn = document.getElementById('backButton');
          const params = new URLSearchParams(window.location.search || '');
          let rt = params.get('returnTo');
          if (!rt && document.referrer) {
            try {
              const refUrl = new URL(document.referrer);
              if (refUrl.pathname !== '/tests/new') {
                rt = refUrl.pathname + (refUrl.search || '');
              }
            } catch (_) {}
          }
          if (rt) {
            if (rtField && !rtField.value) rtField.value = rt;
            if (backBtn) {
              backBtn.href = rt;
              if (rt.startsWith('/patients')) backBtn.textContent = 'Back to Patient';
            }
          }
        } catch (e) {}
    })();

    document.querySelectorAll('.test-checkbox').forEach(cb => {
      const key = cb.getAttribute('data-key');
      const amt = document.querySelector('input[name="amount_' + key + '"]');
      const remark = document.querySelector('[name="remark_' + key + '"]');
      const container = remark ? (remark.closest('.test-remark-container') || remark) : null;

      function update() {
        if (!amt || !remark) return;
        if (cb.checked) {
          amt.style.display = '';
          amt.disabled = false;
          remark.disabled = false;
          if (container) container.style.display = 'block';
          const card = cb.closest('label');
          if (card) card.style.borderColor = '#10b981';
        } else {
          amt.style.display = 'none';
          amt.disabled = true;
          remark.disabled = true;
          if (container) container.style.display = 'none';
          const card = cb.closest('label');
          if (card) card.style.borderColor = '#e2e8f0';
        }
      }
      cb.addEventListener('change', update);
      update();
    });

    document.querySelectorAll('.sendout-checkbox').forEach(cb => {
      const amt = document.querySelector('input[name="amount_sendout"]');
      const remark = document.querySelector('textarea[name="remark_sendout"]');
      const container = remark ? (remark.closest('.sendout-remark-container') || remark) : null;
      function update() {
        if (!amt || !remark) return;
        if (cb.checked) {
          amt.style.display = '';
          amt.disabled = false;
          remark.disabled = false;
          if (container) container.style.display = 'block';
        } else {
          amt.style.display = 'none';
          amt.disabled = true;
          remark.disabled = true;
          if (container) container.style.display = 'none';
        }
      }
      cb.addEventListener('change', update);
      update();
    });
  });
</script>
