<div class="card" style="padding: 28px 32px; border-radius: 16px; box-shadow: 0 4px 18px rgba(0,0,0,0.03); background: #ffffff; border: 1px solid #e2e8f0; max-width: 800px; margin: 0 auto;">
  
  <!-- Header Banner -->
  <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 20px; margin-bottom: 24px; border-bottom: 1px solid #f1f5f9; flex-wrap: wrap; gap: 12px;">
    <div style="display: flex; align-items: center; gap: 12px;">
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 1.25em;">
        <i class="fa fa-edit"></i>
      </div>
      <div>
        <h2 style="margin: 0; font-size: 1.35em; font-weight: 700; color: #0f172a;">Edit Test</h2>
        <div style="font-size: 0.82em; color: #64748b; margin-top: 2px;">Modify patient assignment, procedure type, or test order date</div>
      </div>
    </div>
    <a href="/tests/<%= test.id %>" class="button btn-secondary" style="height: 38px; padding: 0 16px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; font-size: 0.88em;">
      <i class="fa fa-arrow-left"></i> Back to Test
    </a>
  </div>

  <form action="/tests/<%= test.id %>?_method=PUT" method="POST">
    
    <!-- Test Configuration Card -->
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px 22px; margin-bottom: 24px;">
      <div style="font-weight: 700; font-size: 0.95em; color: #0f172a; padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; display: flex; align-items: center; gap: 8px; margin-bottom: 18px;">
        <i class="fa fa-flask" style="color: #3b82f6;"></i> Test Order Information
      </div>

      <div style="margin-bottom: 16px;">
        <label style="display: block; font-weight: 600; font-size: 0.88em; color: #334155; margin-bottom: 6px;">Patient <span style="color: #ef4444;">*</span></label>
        <select name="patient" required style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.92em; font-weight: 500; background: #ffffff; box-sizing: border-box;">
          <% if (patients && patients.length) { %>
            <% patients.forEach(p => { %>
              <option value="<%= p.id %>" <%= test.patient && (test.patient.id === p.id || test.patient === p.id) ? 'selected' : '' %>>
                <%= p.lastName %>, <%= p.firstName %> (<%= p.patientId %>)
              </option>
            <% }) %>
          <% } %>
        </select>
      </div>

      <div style="margin-bottom: 16px;">
        <label style="display: block; font-weight: 600; font-size: 0.88em; color: #334155; margin-bottom: 6px;">Test Type <span style="color: #ef4444;">*</span></label>
        <% if (templates && templates.length) { %>
          <select name="testType" required style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.92em; font-weight: 500; background: #ffffff; box-sizing: border-box;">
            <option value="">-- Select Test Type --</option>
            <% templates.forEach(tpl => { %>
              <option value="<%= tpl.testType || tpl.name %>" <%= test.testType === (tpl.testType || tpl.name) ? 'selected' : '' %>>
                <%= tpl.name %> (<%= tpl.testType %>)
              </option>
            <% }) %>
          </select>
        <% } else { %>
          <input type="text" name="testType" value="<%= test.testType %>" required style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.92em; font-weight: 500; box-sizing: border-box;" />
        <% } %>
      </div>

      <div>
        <label style="display: block; font-weight: 600; font-size: 0.88em; color: #334155; margin-bottom: 6px;">Test Date <span style="color: #ef4444;">*</span></label>
        <input type="date" name="testDate" value="<%= test.testDate ? new Date(test.testDate).toISOString().substr(0,10) : '' %>" required style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid #cbd5e1; padding: 6px 12px; font-size: 0.92em; font-weight: 500; box-sizing: border-box;" />
      </div>
    </div>

    <!-- Actions Footer -->
    <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
      <a href="/tests/<%= test.id %>" class="button btn-secondary" style="height: 42px; padding: 0 20px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
        Cancel
      </a>
      <button type="submit" class="button btn-primary" style="height: 42px; padding: 0 28px; border-radius: 8px; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
        <i class="fa fa-save"></i> Save Changes
      </button>
    </div>

  </form>
</div>
