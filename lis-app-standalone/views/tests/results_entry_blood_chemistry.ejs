<div class="card">
  <h3>Enter Blood Chemistry Results - <%= test.testId %></h3>

  <form action="/tests/<%= test.id %>/results" method="POST">
    <input type="hidden" name="_method" value="POST">

    <div style="display:flex;gap:12px;align-items:center;margin-bottom:8px;flex-wrap:wrap;">
      <div class="form-row" style="margin:0;">
        <label>Date</label>
        <input type="date" name="entryDate" value="<%= test && test.testDate ? (new Date(test.testDate)).toISOString().slice(0,10) : (new Date()).toISOString().slice(0,10) %>" readonly>
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Requested</label>
        <input type="time" name="timeRequested" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (test && test.testDate ? (new Date(test.testDate)).toTimeString().slice(0,5) : '') %>">
      </div>
      <div class="form-row" style="margin:0;">
        <label>Time Released</label>
        <input type="time" name="timeReleased" value="<%= test && test.completedAt ? (new Date(test.completedAt)).toTimeString().slice(0,5) : (new Date()).toTimeString().slice(0,5) %>">
      </div>
      <div style="margin-left:auto;">
        <button type="button" id="captureFromAnalyzer" class="button btn-outline">Capture from Analyzer</button>
      </div>
    </div>

    <div class="grid-2">
      <div class="form-row"><label>FBS</label><input type="text" name="fbs" value="<%= test.results && test.results.fbs ? test.results.fbs : '' %>" placeholder="70-110 mg/dL" title="Reference: 70.00 - 110.00 mg/dL"></div>
      <div class="form-row"><label>RBS</label><input type="text" name="rbs" value="<%= test.results && test.results.rbs ? test.results.rbs : '' %>" placeholder="80-130 mg/dL" title="Reference: 80.00 - 130.00 mg/dL"></div>
      <div class="form-row"><label>1st Hour</label><input type="text" name="firstHour" value="<%= test.results && test.results.firstHour ? test.results.firstHour : '' %>" placeholder="90-140 mg/dL" title="Reference: 90.00 - 140.00 mg/dL"></div>
      <div class="form-row"><label>2nd Hour</label><input type="text" name="secondHour" value="<%= test.results && test.results.secondHour ? test.results.secondHour : '' %>" placeholder="80-120 mg/dL" title="Reference: 80.00 - 120.00 mg/dL"></div>
      <div class="form-row"><label>Cholesterol</label><input type="text" name="cholesterol" value="<%= test.results && test.results.cholesterol ? test.results.cholesterol : '' %>" placeholder="0-200 mg/dL" title="Reference: 0.00 - 200.00 mg/dL"></div>
      <div class="form-row"><label>Triglyceride</label><input type="text" name="tg" value="<%= test.results && test.results.tg ? test.results.tg : '' %>" placeholder="60-150 mg/dL" title="Reference: 60.00 - 150.00 mg/dL"></div>
      <div class="form-row"><label>HDL-C</label><input type="text" name="hdl" value="<%= test.results && test.results.hdl ? test.results.hdl : '' %>" placeholder="35-80 mg/dL" title="Reference: 35.00 - 80.00 mg/dL"></div>
      <div class="form-row"><label>LDL</label><input type="text" name="ldl" value="<%= test.results && test.results.ldl ? test.results.ldl : '' %>" placeholder="66-178 mg/dL" title="Reference: 66.00 - 178.00 mg/dL"></div>
      <div class="form-row"><label>VLDL</label><input type="text" name="vldl" value="<%= test.results && test.results.vldl ? test.results.vldl : '' %>" placeholder="0-30 mg/dL" title="Reference: 0.00 - 30.00 mg/dL"></div>
      <div class="form-row"><label>Uric Acid</label><input type="text" name="uricAcid" value="<%= test.results && test.results.uricAcid ? test.results.uricAcid : '' %>" placeholder="2.4-5.7 mg/dL" title="Reference: 2.40 - 5.70 mg/dL"></div>
      <div class="form-row"><label>Creatinine</label><input type="text" name="creatinine" value="<%= test.results && test.results.creatinine ? test.results.creatinine : '' %>" placeholder="0.5-1.0 mg/dL" title="Reference: 0.50 - 1.00 mg/dL"></div>
      <div class="form-row"><label>Urea</label><input type="text" name="urea" value="<%= test.results && test.results.urea ? test.results.urea : '' %>" placeholder="10-50 mg/dL" title="Reference: 10.00 - 50.00 mg/dL"></div>
      <div class="form-row"><label>BUN</label><input type="text" name="bun" value="<%= test.results && test.results.bun ? test.results.bun : '' %>" placeholder="4.7-23.4 mg/dL" title="Reference: 4.67 - 23.36 mg/dL"></div>
      <div class="form-row"><label>SGPT (ALT)</label><input type="text" name="sgpt" value="<%= test.results && test.results.sgpt ? test.results.sgpt : '' %>" placeholder="0-32 U/L" title="Reference: 0.00 - 32.00 U/L"></div>
      <div class="form-row"><label>SGOT (AST)</label><input type="text" name="sgot" value="<%= test.results && test.results.sgot ? test.results.sgot : '' %>" placeholder="0-31 U/L" title="Reference: 0.00 - 31.00 U/L"></div>
      <div class="form-row"><label>Sodium</label><input type="text" name="sodium" value="<%= test.results && test.results.sodium ? test.results.sodium : '' %>" placeholder="136-148 mmol/L" title="Reference: 136.00 - 148.00 mmol/L"></div>
      <div class="form-row"><label>Potassium</label><input type="text" name="potassium" value="<%= test.results && test.results.potassium ? test.results.potassium : '' %>" placeholder="3.5-5.1 mmol/L" title="Reference: 3.50 - 5.10 mmol/L"></div>
      <div class="form-row"><label>Chloride</label><input type="text" name="chloride" value="<%= test.results && test.results.chloride ? test.results.chloride : '' %>" placeholder="98-107 mmol/L" title="Reference: 98.00 - 107.00 mmol/L"></div>
      <div class="form-row"><label>Hba1c</label><input type="text" name="hba1c" value="<%= test.results && test.results.hba1c ? test.results.hba1c : '' %>" placeholder="4.0-6.5 %" title="Reference: 4.00 - 6.50 %"></div>
      <div class="form-row"><label>ALB</label><input type="text" name="alb" value="<%= test.results && test.results.alb ? test.results.alb : '' %>" placeholder="3-6 g/L" title="Reference: 3.00 - 6.00 g/L"></div>
    </div>

    <hr>
    <h4>Signatures / Performers</h4>
    <%- include('../partials/signatory_select', { prefix: 'mt', label: 'Medical Technologist', role: 'Medical Technologist', nameInput: 'mtName', licenseInput: 'mtLicense', existingName: (test.results && test.results.performedByName) ? test.results.performedByName : '', existingLicense: (test.results && test.results.performedByLicense) ? test.results.performedByLicense : '' }) %>

    <hr>
    <h4>Validation</h4>
    <%- include('../partials/signatory_select', { prefix: 'validated', label: '2nd Medical Technologist (Validator)', role: 'Medical Technologist', nameInput: 'validatedByName', licenseInput: 'validatedByLicense', existingName: (test.results && test.results.validatedByName) ? test.results.validatedByName : '', existingLicense: (test.results && test.results.validatedByLicense) ? test.results.validatedByLicense : '' }) %>

    <%- include('../partials/signatory_select', { prefix: 'path', label: 'Pathologist', role: 'Pathologist', nameInput: 'pathName', licenseInput: 'pathLicense', existingName: (test.results && test.results.requestedByName) ? test.results.requestedByName : '', existingLicense: (test.results && test.results.requestedByLicense) ? test.results.requestedByLicense : '' }) %>

    <div class="form-row mt-12">
      <a href="/tests/<%= test.id %>" class="button btn-secondary">Cancel</a>
      <button class="button btn-primary">Save Results</button>
    </div>
  </form>
</div>

<script>
  (function(){
    const ANALYZER_MAP = <%- JSON.stringify(ANALYZER_MAP) %>;

    const btn = document.getElementById('captureFromAnalyzer');
    if (!btn) return;
    btn.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = 'Capturing...';
      try {
        const res = await fetch(`/tests/<%= test.id %>/analyzer/capture`);
        const json = await res.json();
        console.log('analyzer response', json);
        if (json.error) { alert('Analyzer error: ' + json.error); return; }

        if (json.rows && json.rows.length) {
          showAnalyzerPicker(json.rows);
          return;
        }

        if ((!json.rows || json.rows.length === 0) && (!json.mapped || Object.keys(json.mapped).length === 0)) {
          alert('Analyzer returned no data');
        }

        applyMapped(json.mapped || {});
        alert('Prefilled results from analyzer (review before saving)');
      } catch (err) {
        console.error('capture error', err);
        alert('Failed to capture: ' + err.message);
      } finally {
        btn.disabled = false; btn.textContent = 'Capture from Analyzer';
      }
    });

    function applyMapped(mapped) {
      Object.keys(mapped).forEach(k => {
        const el = document.querySelector(`[name="${k}"]`);
        if (el) el.value = mapped[k];
      });
    }

    function showAnalyzerPicker(rows) {
      const modal = document.createElement('div');
      modal.style = 'position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10000;';
      const box = document.createElement('div');
      box.style = 'background:#fff;margin:4rem auto;max-width:90%;max-height:80%;overflow:auto;padding:1rem;';

      const tbl = document.createElement('table');
      tbl.border = 1;
      const cols = Object.keys(rows[0]);
      const hdr = tbl.insertRow();
      cols.forEach(c => hdr.insertCell().textContent = c);
      rows.forEach(r => {
        const tr = tbl.insertRow();
        cols.forEach(c => tr.insertCell().textContent = r[c]);
        tr.style.cursor = 'pointer';
        tr.addEventListener('click', () => {
          const mapped = {};
          Object.keys(r).forEach(code => {
            const field = ANALYZER_MAP[code];
            if (field) mapped[field] = r[code];
          });
          applyMapped(mapped);
          document.body.removeChild(modal);
        });
      });
      box.appendChild(tbl);
      const cancel = document.createElement('button');
      cancel.textContent = 'Cancel';
      cancel.addEventListener('click', () => document.body.removeChild(modal));
      box.appendChild(cancel);
      modal.appendChild(box);
      document.body.appendChild(modal);
    }
  })();
</script>
