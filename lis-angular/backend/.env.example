PORT=3020
HOST=0.0.0.0
# Set a cryptographically secure random secret string for production JWT signing
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret
JWT_EXPIRES_IN=24h
DB_PATH=./data/lis.db
NODE_ENV=development
# Optional: preconfigure initial default admin password (otherwise auto-generated on startup)
DEFAULT_ADMIN_PASSWORD=
